									<Z>0</Z>
								</Vector3>
								<Vector3 name="Scale">
									<X>0.5</X>
									<Y>0.5</Y>
									<Z>0.5</Z>
								</Vector3>
								<Content name="TextureId"><url>http://www.roblox.com/asset/?id=32551377</url></Content>
								<Vector3 name="VertexColor">
