						<Item class="Script" referent="RBX3895">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Calling</string>
								<ProtectedString name="Source">CallsLeft = 3

local Rocket = Instance.new(&quot;Part&quot;)
local Tool = script.Parent

Rocket.CanCollide = false
Rocket.Locked = true
Rocket.BackSurface = 0
Rocket.BottomSurface = 0
Rocket.FrontSurface = 0
Rocket.LeftSurface = 0
Rocket.RightSurface = 0
Rocket.TopSurface = 0
Rocket.Size = Vector3.new(1,1,4)
Rocket.BrickColor = BrickColor.new(23)

Tool.RocketScript:clone().Parent = Rocket
Tool.Explosion:clone().Parent = Rocket

function fire(targetPos)
&#9;Tool.Handle.Fire:play()
&#9;local vCharacter = Tool.Parent;
&#9;
&#9;local vHandle = Tool:findFirstChild(&quot;Handle&quot;)
&#9;if vHandle == nil then
&#9;&#9;print(&quot;Handle not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;if vPlayer == nil then
&#9;&#9;print(&quot;Player not found&quot;)
&#9;end

&#9;-- first shot

&#9;vTarget1 = targetPos + Vector3.new(math.random(-14, 14), math.random(-5, 5), math.random(-14, 14))

&#9;local dir1 = vTarget1 - vHandle.Position - Vector3.new(0, 100, 0)

&#9;dir1 = computeDirection(dir1)

&#9;local pos1 = vHandle.Position + (dir1 * 6) + Vector3.new(0, 100, 0)
&#9;
&#9;local missile1 = Rocket:clone()
&#9;missile1.CFrame = CFrame.new(pos1,  pos1 + dir1)

&#9;local creator_tag1 = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag1.Value = vPlayer
&#9;creator_tag1.Name = &quot;creator&quot;
&#9;creator_tag1.Parent = missile1
&#9;Tool.Mesh:clone().Parent = missile1

&#9;--second shot

&#9;vTarget2 = targetPos + Vector3.new(math.random(-14, 14), math.random(-5, 5), math.random(-14, 14))

&#9;local dir2 = vTarget2 - vHandle.Position - Vector3.new(0, 100, 0)

&#9;dir2 = computeDirection(dir2)

&#9;local pos2 = vHandle.Position + (dir2 * 6) + Vector3.new(0, 100, 0)
&#9;
&#9;local missile2 = Rocket:clone()
&#9;missile2.CFrame = CFrame.new(pos2,  pos2 + dir2)

&#9;local creator_tag2 = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag2.Value = vPlayer
&#9;creator_tag2.Name = &quot;creator&quot;
&#9;creator_tag2.Parent = missile2
&#9;Tool.Mesh:clone().Parent = missile2

&#9;--

&#9;CallsLeft = CallsLeft - 1
&#9;if CallsLeft &lt;= 0 then 
&#9;&#9;script.Parent:remove()
&#9;end
&#9;wait(3)
&#9;local players = game.Players:children() 
&#9;x = math.random(1,5)
&#9;for i = 1, #players do 
&#9;&#9;if players[i].TeamColor == vPlayer.TeamColor then
&#9;&#9;&#9;if x == 1 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Friendly Mortars Launched!&quot;
&#9;&#9;&#9;elseif x == 2 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Mortar Coordinates Received, Firing For Effect&quot;
&#9;&#9;&#9;elseif x == 3 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Friendly Mortars Incoming!&quot;
&#9;&#9;&#9;elseif x == 4 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Friendly Mortars Deployed!&quot;
&#9;&#9;&#9;elseif x == 5 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Mortar Coordinates Received, Firing For Effect&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.GarbageMan.Disabled = false
&#9;&#9;else
&#9;&#9;&#9;if x == 1 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Hostile Mortars Incoming!&quot;
&#9;&#9;&#9;elseif x == 2 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Enemy Mortars Incoming!&quot;
&#9;&#9;&#9;elseif x == 3 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Hostile Mortars Deployed!&quot;
&#9;&#9;&#9;elseif x == 4 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Enemy Mortars Deployed!&quot;
&#9;&#9;&#9;elseif x == 5 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Hostile Mortars Incoming!&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.GarbageMan.Disabled = false
&#9;&#9;end
&#9;end
&#9;missile1.RocketScript.Disabled = false
&#9;missile1.Parent = game.Workspace
&#9;wait(math.random(0,200)/100)
&#9;missile2.RocketScript.Disabled = false
&#9;missile2.Parent = game.Workspace
end

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

Tool.Enabled = true
function onActivated()
&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint

&#9;fire(targetPos)
end

script.Parent.Activated:connect(onActivated)

</ProtectedString>
