&#9;&#9;wait(.05)
&#9;&#9;Tool.GripUp = Vector3.new(0.5, 1, 0)
&#9;&#9;wait(.05)
&#9;&#9;Tool.GripUp = Vector3.new(0.4, 1, 0)
&#9;&#9;wait(.05)
&#9;&#9;Tool.GripUp = Vector3.new(0.3, 1, 0)
&#9;&#9;wait(.05)
&#9;&#9;Tool.GripUp = Vector3.new(0.2, 1, 0)
&#9;&#9;wait(.05)
&#9;&#9;Tool.GripUp = Vector3.new(0.1, 1, 0)
&#9;&#9;wait(.05)
&#9;&#9;Tool.GripUp = Vector3.new(0, 1, 0)
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .8, 0.9) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.01, math.rad(-90))
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .85, 0.8) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.075, math.rad(-90))
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .95, 0.7) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.05, math.rad(-90))
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1.1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.025, math.rad(-90))
&#9;&#9;wait(.05)
&#9;end
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
end

function ReloadCheck1()
&#9;weld33.C1 = CFrame.new(-0.75, -0.6, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;wait(0.002)
&#9;weld33.C1 = CFrame.new(-0.75, -0.6, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;wait(0.002)
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;if Magazine.Value == 0 then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;end
end

function ReloadCheck2()
&#9;if Magazine.Value == 0 and MaxAmmo.Value &gt;= 1 then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;end
end

function Reload()
&#9;if Magazine.Value &lt; MaxAmmo.Value and Tool.Enabled == true and Tool.GunScript.Reload.Value == true and AmmoLeft.Value &gt;= 1 then
&#9;&#9;Tool.Enabled = false
&#9;&#9;ReloadSequence()
&#9;&#9;Recoil.Value = 0
&#9;&#9;if AmmoLeft.Value &gt;= MaxAmmo.Value then
&#9;&#9;&#9;AmmoLeft.Value = AmmoLeft.Value - MaxAmmo.Value + Magazine.Value
&#9;&#9;&#9;Magazine.Value = MaxAmmo.Value
&#9;&#9;elseif AmmoLeft.Value &lt; MaxAmmo.Value and AmmoLeft.Value &gt;= 1 then
&#9;&#9;&#9;Magazine.Value = AmmoLeft.Value 
&#9;&#9;&#9;AmmoLeft.Value = 0
&#9;&#9;end
&#9;&#9;Tool.Enabled = true
&#9;end
&#9;Tool.GunScript.Reload.Value = false
end

Magazine.Changed:connect(ReloadCheck1)
AmmoLeft.Changed:connect(ReloadCheck2)
Tool.GunScript.Reload.Changed:connect(Reload)

function Equip(mouse)
&#9;wait(0.01)
&#9;arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
