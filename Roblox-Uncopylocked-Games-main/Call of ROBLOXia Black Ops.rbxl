&#9;&#9;&#9;p1.BottomSurface = 0 
&#9;&#9;&#9;p1.TopSurface = 0 
&#9;&#9;&#9;p1.Locked = true 
&#9;&#9;&#9;game.Lighting.Uniform.BOHat2.Mesh:clone().Parent = p1
&#9;&#9;&#9;h1.Parent = Character
&#9;&#9;&#9;h1.AttachmentPos = Vector3.new(0,-.1,-0)
&#9;&#9;&#9;h2 = Instance.new(&quot;Hat&quot;)
