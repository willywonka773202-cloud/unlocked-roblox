						<Item class="Script" referent="RBX1783">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GunScript2</string>
								<ProtectedString name="Source">Tool = script.Parent;
debris = game:GetService(&quot;Debris&quot;)
local Magazine = Tool.GunScript.Magazine
local AmmoLeft = Tool.GunScript.AmmoLeft
local MaxAmmo = Tool.GunScript.MaxAmmo
local Recoil = Tool.GunScript.Recoil
Active = false

local arms = nil
local torso = nil
local weld33 = nil
local weld55 = nil
local welds = {}

local Knife = Tool.GunScript.Knife
function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function blow(hit)
&#9;if (hit.Parent == nil) then return end -- happens when bullet hits sword
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)
&#9;local hum = vCharacter:findFirstChild(&quot;Humanoid&quot;) -- non-nil if tool held by a character
&#9;if humanoid~=nil and humanoid ~= hum and hum ~= nil then
&#9;&#9;local Player = getPlayer(humanoid)
&#9;&#9;local right_arm = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
&#9;&#9;if (right_arm ~= nil) and vPlayer.TeamColor ~= Player.TeamColor then
&#9;&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;&#9;creator_tag.Parent = humanoid
&#9;&#9;&#9;humanoid.Health = humanoid.Health - 135
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = creator_tag
&#9;&#9;end
&#9;end
end

function slice()
&#9;if Tool.Parent:findFirstChild(&quot;Ninja&quot;) == nil then
&#9;&#9;Tool.Handle.KnifeSound:play()
&#9;end
&#9;Tool.Parent.CanFire.Value = false
&#9;local knife = Instance.new(&quot;Part&quot;)
&#9;knife.Size = Vector3.new(1,1,1)
&#9;knife.Parent = Tool
&#9;knife.BrickColor = BrickColor.new(&quot;Dark stone grey&quot;)
&#9;knife.Reflectance = 0.2
&#9;local knifeweld = Instance.new(&quot;Weld&quot;)
&#9;knifeweld.Parent = knife
&#9;knifeweld.Part0 = knife
&#9;knifeweld.Part1 = Tool.Parent[&quot;Left Arm&quot;]
&#9;knifeweld.C0 = CFrame.new(-.5,1,-.4)
&#9;local mesh = Tool.Mesh:clone()
&#9;mesh.Parent = knife
&#9;connection = knife.Touched:connect(blow)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(200), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-80), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(220), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-70), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(240), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-60), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(260), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(280), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(300), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(340), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(300), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-60), math.rad(-15), 0)
&#9;knife:remove()
&#9;connection:disconnect()
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(300), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-70), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-80), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld33.C1 = CFrame.new(-0.75, 0.5, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;wait(.05)
&#9;Tool.Parent.CanFire.Value = true
end

function Melee()
&#9;if Tool.Enabled == true then 
&#9;&#9;if Knife.Value == true then
&#9;&#9;&#9;Tool.Enabled = false
&#9;&#9;&#9;slice()
&#9;&#9;&#9;Tool.Enabled = true
&#9;&#9;end
&#9;end
&#9;Knife.Value = false
end

Knife.Changed:connect(Melee)

function ReloadSequence()
&#9;if Tool.Parent:findFirstChild(&quot;FastReload&quot;) ~= nil then
&#9;&#9;local mag = Instance.new(&quot;Part&quot;)
&#9;&#9;mag.Size = Vector3.new(1,1,1)
&#9;&#9;mag.BrickColor = BrickColor.new(26)
&#9;&#9;mag.CFrame = Tool.Handle.CFrame
&#9;&#9;mag.Parent = game.Workspace
&#9;&#9;local magmesh = Instance.new(&quot;BlockMesh&quot;)
&#9;&#9;magmesh.Scale = Vector3.new(.2,.75,.3)
&#9;&#9;magmesh.Parent = mag
&#9;&#9;game:GetService(&quot;Debris&quot;):addItem(mag,6)
&#9;&#9;wait(.025)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -0.2, math.rad(-90))
&#9;&#9;wait(.025)
