function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function tagStreak(location, player)
&#9;if location:findFirstChild(player.Name) == nil then
&#9;&#9;local killed = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;killed.Name = player.Name
&#9;&#9;killed.Parent = location
&#9;end
end



function DressUp(Character, Team)

&#9;wait(0.5)

&#9;local Children = Character:GetChildren()

&#9;for i = 1, #Children do
&#9;&#9;if Children[i].className == &quot;Pants&quot; or Children[i].className == &quot;Shirt&quot; or Children[i].className == &quot;Hat&quot; or Children[i].className == &quot;BodyColors&quot; or Children[i].className == &quot;ForceField&quot; then
&#9;&#9;&#9;Children[i]:remove() 
