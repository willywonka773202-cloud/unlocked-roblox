local Faces = {&quot;http://www.roblox.com/asset/?id=41832324&quot;, &quot;http://www.roblox.com/asset/?id=39718665&quot;, &quot;http://www.roblox.com/asset/?id=29759342&quot;, &quot;http://www.roblox.com/asset/?id=26086321&quot;, &quot;http://www.roblox.com/asset/?id=24191808&quot;, &quot;http://www.roblox.com/asset/?id=24191323&quot;, &quot;http://www.roblox.com/asset/?id=24331437&quot;, &quot;http://www.roblox.com/asset/?id=23849848&quot;, &quot;http://www.roblox.com/asset/?version=1&amp;id=1100320&quot;}
function DealWithBody()
&#9;local I = Instance.new(&quot;Model&quot;) 
&#9;I.Name = &quot;Dead Body&quot; 
&#9;I.Parent = Workspace 
&#9;k = script.Parent:GetChildren() 
&#9;for i = 1, #k do 
&#9;&#9;if k[i].className == &quot;Part&quot; then
&#9;&#9;&#9;local c = k[i]:clone() 
&#9;&#9;&#9;c.Parent = I 
&#9;&#9;&#9;k[i]:remove()
&#9;&#9;elseif k[i].className == &quot;Shirt&quot; or k[i].className == &quot;Pants&quot; or k[i].className == &quot;ShirtGraphic&quot; or k[i].className == &quot;Humanoid&quot; then
&#9;&#9;&#9;k[i]:clone().Parent = I
&#9;&#9;elseif k[i].className == &quot;Tool&quot; then
&#9;&#9;&#9;k[i]:remove()
&#9;&#9;elseif k[i].className == &quot;Hat&quot; then
&#9;&#9;&#9;if k[i]:findFirstChild(&quot;Handle&quot;) ~= nil then
&#9;&#9;&#9;&#9;k[i].Handle:clone().Parent = I
&#9;&#9;&#9;&#9;k[i]:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end 
&#9;Character = I
&#9;Humanoid = Character.Humanoid
&#9;Torso = Character.Torso

&#9;debris:AddItem(Character, 30)

&#9;Humanoid:remove()
&#9;Character:FindFirstChild(&quot;Head&quot;):remove()
&#9;if Torso then
&#9;&#9;local Head = Character:FindFirstChild(&quot;FakeHead&quot;)
&#9;&#9;if Head then
&#9;&#9;&#9;local Neck = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;Neck.Name = &quot;Neck&quot;
&#9;&#9;&#9;Neck.Part0 = Torso
&#9;&#9;&#9;Neck.Part1 = Head
&#9;&#9;&#9;Neck.C0 = CFrame.new(0, 1.5, 0)
&#9;&#9;&#9;Neck.C1 = CFrame.new()
&#9;&#9;&#9;Neck.Parent = Torso
&#9;&#9;&#9;Head.Transparency = 0
&#9;&#9;&#9;Head.face.Texture = Faces[math.random(1, #Faces)]
&#9;&#9;end
&#9;&#9;local Limb = Character:FindFirstChild(&quot;Right Arm&quot;)
&#9;&#9;if Limb then

&#9;&#9;&#9;Limb.CFrame = Torso.CFrame * CFrame.new(1.5, 0, 0)
&#9;&#9;&#9;local Joint = Instance.new(&quot;Glue&quot;)
&#9;&#9;&#9;Joint.Name = &quot;RightShoulder&quot;
&#9;&#9;&#9;Joint.Part0 = Torso
&#9;&#9;&#9;Joint.Part1 = Limb
&#9;&#9;&#9;Joint.C0 = CFrame.new(1.5, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0)
&#9;&#9;&#9;Joint.C1 = CFrame.new(-0, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0)
&#9;&#9;&#9;Joint.Parent = Torso

&#9;&#9;&#9;local B = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;B.TopSurface = 0
&#9;&#9;&#9;B.BottomSurface = 0
