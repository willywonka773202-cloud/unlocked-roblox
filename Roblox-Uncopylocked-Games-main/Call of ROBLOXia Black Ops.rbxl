&#9;weld55.C1 = CFrame.new(-0.35, .6, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -1.2, math.rad(-60))
&#9;local mag2 = Instance.new(&quot;Part&quot;)
&#9;mag2.Size = Vector3.new(1,1,1)
&#9;mag2.BrickColor = BrickColor.new(&quot;Black&quot;)
&#9;mag2.Parent = game.Workspace
&#9;local magmesh2 = Instance.new(&quot;SpecialMesh&quot;)
&#9;magmesh2.Scale = Vector3.new(0.667, 0.6, 0.267)
&#9;magmesh2.MeshType = &quot;Sphere&quot;
&#9;magmesh2.Parent = mag2
&#9;local magweld = Instance.new(&quot;Weld&quot;)
&#9;leftarm = Tool.Parent[&quot;Left Arm&quot;]
&#9;magweld.Parent = mag2
&#9;magweld.Part0 = mag2
&#9;magweld.Part1 = leftarm
&#9;magweld.C0 = CFrame.new(-1,0,0.3)
&#9;magweld.C0 = magweld.C0 * CFrame.fromEulerAnglesXYZ(0,0.6,1.6)
&#9;wait(.05)
&#9;weld55.C1 = CFrame.new(-0.35, .6, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -1, math.rad(-60))
