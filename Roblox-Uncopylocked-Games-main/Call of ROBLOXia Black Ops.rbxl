								<ProtectedString name="Source">debris = game:GetService(&quot;Debris&quot;)
local bomb = script.Parent
local Mesh = bomb.Mesh
local blink = false

debris:AddItem(bomb, 300)

function check()
&#9;local list = game.Workspace:children()
&#9;for i = 1, #list do 
&#9;&#9;local player = game.Players:GetPlayerFromCharacter(list[i])
&#9;&#9;if player ~= nil then
&#9;&#9;&#9;if list[i]:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;if (bomb.Position - list[i].Torso.Position).magnitude &lt;= 7.5 then
&#9;&#9;&#9;&#9;&#9;if bomb.creator.Value.TeamColor ~= player.TeamColor then
&#9;&#9;&#9;&#9;&#9;&#9;blowUp()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function blowUp()
&#9;bomb.Sound:play()
&#9;wait(0.83)
&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.Position = bomb.Position
&#9;explosion.BlastRadius = 10
&#9;explosion.BlastPressure = 0
&#9;explosion.Hit:connect(onPlayerBlownUp)
&#9;explosion.Parent = game.Workspace
&#9;bomb.Explode:play()
&#9;wait(0.1)
&#9;bomb:remove()
end

function onPlayerBlownUp(part) 
&#9;if part.Name == &quot;Torso&quot; then 
&#9;&#9;local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if humanoid ~= nil and part.Parent:findFirstChild(&quot;ForceField&quot;) == nil then
&#9;&#9;&#9;player = getPlayer(humanoid)
&#9;&#9;&#9;if bomb.creator.Value == player or bomb.creator.Value.TeamColor ~= player.TeamColor then
&#9;&#9;&#9;&#9;if part.Parent:findFirstChild(&quot;Flak Jacket&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - 47.25
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - 135
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;tagHumanoid(humanoid) 
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end 
end 

function tagHumanoid(humanoid)
&#9;local tag = bomb:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;debris:AddItem(tag, 2)
&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;killer.Parent = new_tag
&#9;end
end

function onTouched(hit)
&#9;if hit.Anchored == true then return end
&#9;if hit.Parent ~= nil then
&#9;&#9;if hit.Parent.className == &quot;Tool&quot; then return end
&#9;&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return end
&#9;&#9;if hit.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then return end
&#9;end

&#9;blowUp()
end
connection = bomb.Touched:connect(onTouched)

while true do
&#9;wait(0.5)
&#9;check()
&#9;blink = not blink
&#9;if blink then
&#9;&#9;Mesh.TextureId = &quot;http://www.roblox.com/asset/?id=28512114&quot;
&#9;else
&#9;&#9;Mesh.TextureId = &quot;http://www.roblox.com/asset/?id=33378623&quot;
&#9;end
&#9;wait(0.5)
&#9;check()
end
</ProtectedString>
