local MaxAmmo = 0
function GiveAmmo(tag)
&#9;if tag.Value.Character:findFirstChild(&quot;Scavenger&quot;) ~= nil then
&#9;&#9;list = tag.Value.Character:children()
&#9;&#9;for x = 1, #list do
&#9;&#9;&#9;if list[x].className == &quot;Tool&quot; and list[x]:findFirstChild(&quot;GunScript&quot;) ~= nil then
&#9;&#9;&#9;&#9;Ammo = list[x].GunScript.AmmoLeft
&#9;&#9;&#9;&#9;MaxAmmo = list[x].GunScript.MaxAmmo.Value*8
&#9;&#9;&#9;&#9;if Ammo.Value + list[x].GunScript.MaxAmmo.Value &gt; MaxAmmo then
&#9;&#9;&#9;&#9;&#9;Ammo.Value = MaxAmmo
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;Ammo.Value = Ammo.Value + list[x].GunScript.MaxAmmo.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end


killerfound = false
function onDeath() 
&#9;DealWithBody()
&#9;wait(0.1)
&#9;canfire.Value = false
&#9;local zHuman = script.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if script.Parent.Humanoid ~= nil then 
&#9;&#9;local zplayer = getPlayer(script.Parent.Humanoid)
&#9;&#9;if zplayer == nil then return end 
&#9;&#9;tags = zHuman:children()
&#9;&#9;for x = 1, #tags do
&#9;&#9;&#9;tag = tags[x]
&#9;&#9;&#9;if tag.Name == &quot;creator&quot; then
&#9;&#9;&#9;&#9;if tag.Value ~= nil then 
&#9;&#9;&#9;&#9;&#9;local stats = tag.Value:findFirstChild(&quot;leaderstats&quot;) 
&#9;&#9;&#9;&#9;&#9;if stats ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if tag.Value.Character ~= nil then &#9;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tag:findFirstChild(&quot;Killer&quot;) == nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Cr.Value = stats.Cr.Value + 10
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tag.Value.PlayerGui.CrGui.Text.Value = &quot;Assist&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if killerfound == true and Workspace.Hint.Text == &quot;&quot;..zplayer.Name..&quot; killed himself/herself&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Cr.Value = stats.Cr.Value + 200
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tag.Value.PlayerGui.CrGui.Text.Value = &quot;Assisted Suicide&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if killerfound == false then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;killerfound = true
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tag.Value.Name == zplayer.Name then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..zplayer.Name..&quot; killed himself/herself&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;zplayer.leaderstats.Streak.Value = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Streak.Value = stats.Streak.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Kill.Value = stats.Kill.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;zplayer.leaderstats.Streak.Value = 0
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tagStreak(tag.Value.Killed,zplayer)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;GiveAmmo(tag)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;x = math.random(1,13)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if x == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; killed &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 2 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; pwned &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 3 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; took out &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 4 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; annihilated &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 5 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; assassinated &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 6 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; executed &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 7 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; exterminated &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 8 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; finished &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 9 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; murdered &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 10 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; put &quot;..zplayer.Name..&quot; to death&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 11 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; slayed &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 12 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; wasted &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif x == 13 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; eliminated &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;if tag:findFirstChild(&quot;Airstike&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; called a airstrike on &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif tag:findFirstChild(&quot;Nova&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; nova striked &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif tag:findFirstChild(&quot;Mortar&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; mortared &quot;..zplayer.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif tag:findFirstChild(&quot;Headshot&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Cr.Value = stats.Cr.Value + 150
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tag.Value.PlayerGui.CrGui.Text.Value = &quot;Headshot&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..tag.Value.Name..&quot; gave &quot;..zplayer.Name..&quot; a headshot&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif tag.Value.Character.Humanoid.Health &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Cr.Value = stats.Cr.Value + 200
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tag.Value.PlayerGui.CrGui.Text.Value = &quot;Afterlife&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif zplayer.Killed:findFirstChild(tag.Value.Name) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Cr.Value = stats.Cr.Value + 150
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tag.Value.PlayerGui.CrGui.Text.Value = &quot;Payback&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;zplayer.Killed:findFirstChild(tag.Value.Name):remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif tag:findFirstChild(&quot;Stuck&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Cr.Value = stats.Cr.Value + 150
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tag.Value.PlayerGui.CrGui.Text.Value = &quot;Stuck&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;elseif tag:findFirstChild(&quot;Tomahawk&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Cr.Value = stats.Cr.Value + 150
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tag.Value.PlayerGui.CrGui.Text.Value = &quot;Scalper&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;stats.Cr.Value = stats.Cr.Value + 100
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;tag.Value.PlayerGui.CrGui.Text.Value = &quot;Kill&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if killerfound == false then
&#9;&#9;&#9;killerfound = true
&#9;&#9;&#9;Workspace.Hint.Text = &quot;&quot;..zplayer.Name..&quot; died&quot;
&#9;&#9;&#9;zplayer.leaderstats.Streak.Value = 0
&#9;&#9;end
&#9;end
&#9;script:remove() 
end 

