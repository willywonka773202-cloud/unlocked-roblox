						<Item class="Script" referent="RBX4347">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">MainScript</string>
								<ProtectedString name="Source">debris = game:GetService(&quot;Debris&quot;)
Frame = script.Parent
SubMenu = Frame.SubMenu
Visual = Frame.Visuals
Buttons = Frame.Buttons
Player = Frame.Parent.Parent.Parent

function onButtonClicked(ClickedButton)
&#9;if SubMenu.Value == &quot;Main&quot; then
&#9;&#9;if ClickedButton.Name == &quot;B1&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Primary&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B2&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Secondary&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B3&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Grenade&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B4&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Perk1&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B5&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Perk2&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B6&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Attachment&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B7&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Equipment&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B8&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Killstreak&quot;
&#9;&#9;end
&#9;elseif SubMenu.Value == &quot;Primary&quot; then
&#9;&#9;if ClickedButton.Name == &quot;B1&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Submachine Guns&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B2&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Assault Rifles&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B3&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Shotguns&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B4&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Light Machine Guns&quot;
&#9;&#9;elseif ClickedButton.Name == &quot;B5&quot; then
&#9;&#9;&#9;SubMenu.Value = &quot;Sniper Rifles&quot;
&#9;&#9;end
&#9;elseif SubMenu.Value == &quot;Submachine Guns&quot; then
&#9;&#9;Player.Inventory.Attachment.Value = &quot;&quot;
&#9;&#9;Visual.Title.Visible = true
&#9;&#9;Visual.Picture.Visible = true
&#9;&#9;Visual.Buy.Active = true
&#9;&#9;Visual.Buy.Visible = true
&#9;&#9;if ClickedButton.Text == &quot;MP5K&quot; then
&#9;&#9;&#9;if Player.Inventory.Primary.Value == game.Lighting.Tools:findFirstChild(&quot;MP5K&quot;) then
&#9;&#9;&#9;&#9;Visual.Buy.Active = false
&#9;&#9;&#9;&#9;Visual.Buy.Visible = false
&#9;&#9;&#9;elseif Player.Purchases:findFirstChild(&quot;MP5K&quot;) ~= nil then
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;EQUIP&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;PURCHASE&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;Visual.T0.Text = &quot;COST: 500&quot;
&#9;&#9;&#9;Visual.T1.Text = &quot;DAMAGE: 30-40&quot;
&#9;&#9;&#9;Visual.T2.Text = &quot;MAGAZINE SIZE: 30&quot;
&#9;&#9;&#9;Visual.T3.Text = &quot;AMMUNITION: 90 + 30&quot;
&#9;&#9;&#9;Visual.T4.Text = &quot;FIRE MODE: AUTOMATIC&quot;
&#9;&#9;&#9;Visual.Title.Text = &quot;MP5K&quot;
&#9;&#9;&#9;Visual.Picture.Image = &quot;http://www.roblox.com/asset/?id=47602779&quot;
&#9;&#9;&#9;Visual.Picture.Size = UDim2.new(0, 256,0, 128)
&#9;&#9;&#9;Visual.Picture.Position = UDim2.new(0.5,-128,0,100)
&#9;&#9;elseif ClickedButton.Text == &quot;AK74U&quot; then
&#9;&#9;&#9;if Player.Inventory.Primary.Value == game.Lighting.Tools:findFirstChild(&quot;AK74u&quot;) then
&#9;&#9;&#9;&#9;Visual.Buy.Active = false
&#9;&#9;&#9;&#9;Visual.Buy.Visible = false
&#9;&#9;&#9;elseif Player.Purchases:findFirstChild(&quot;AK74u&quot;) ~= nil then
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;EQUIP&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;PURCHASE&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;Visual.T0.Text = &quot;COST: 1000&quot;
&#9;&#9;&#9;Visual.T1.Text = &quot;DAMAGE: 20-35&quot;
&#9;&#9;&#9;Visual.T2.Text = &quot;MAGAZINE SIZE: 30&quot;
&#9;&#9;&#9;Visual.T3.Text = &quot;AMMUNITION: 90 + 30&quot;
&#9;&#9;&#9;Visual.T4.Text = &quot;FIRE MODE: AUTOMATIC&quot;
&#9;&#9;&#9;Visual.Title.Text = &quot;AK74U&quot;
&#9;&#9;&#9;Visual.Picture.Image = &quot;http://www.roblox.com/asset/?id=51984320&quot;
&#9;&#9;&#9;Visual.Picture.Size = UDim2.new(0, 256,0, 128)
&#9;&#9;&#9;Visual.Picture.Position = UDim2.new(0.5,-128,0,100)
&#9;&#9;elseif ClickedButton.Text == &quot;UZI&quot; then
&#9;&#9;&#9;if Player.Inventory.Primary.Value == game.Lighting.Tools:findFirstChild(&quot;Uzi&quot;) then
&#9;&#9;&#9;&#9;Visual.Buy.Active = false
&#9;&#9;&#9;&#9;Visual.Buy.Visible = false
&#9;&#9;&#9;elseif Player.Purchases:findFirstChild(&quot;Uzi&quot;) ~= nil then
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;EQUIP&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;PURCHASE&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;Visual.T0.Text = &quot;COST: 1500&quot;
&#9;&#9;&#9;Visual.T1.Text = &quot;DAMAGE: 20-30&quot;
&#9;&#9;&#9;Visual.T2.Text = &quot;MAGAZINE SIZE: 20&quot;
&#9;&#9;&#9;Visual.T3.Text = &quot;AMMUNITION: 60 + 20&quot;
&#9;&#9;&#9;Visual.T4.Text = &quot;FIRE MODE: AUTOMATIC&quot;
&#9;&#9;&#9;Visual.Title.Text = &quot;UZI&quot;
&#9;&#9;&#9;Visual.Picture.Image = &quot;http://www.roblox.com/asset/?id=47601657&quot;
&#9;&#9;&#9;Visual.Picture.Size = UDim2.new(0, 128,0, 128)
&#9;&#9;&#9;Visual.Picture.Position = UDim2.new(0.5,-64,0,100)
&#9;&#9;end
&#9;elseif SubMenu.Value == &quot;Assault Rifles&quot; then
&#9;&#9;Player.Inventory.Attachment.Value = &quot;&quot;
&#9;&#9;Visual.Title.Visible = true
&#9;&#9;Visual.Picture.Visible = true
&#9;&#9;Visual.Buy.Active = true
&#9;&#9;Visual.Buy.Visible = true
&#9;&#9;if ClickedButton.Text == &quot;AK-47&quot; then
&#9;&#9;&#9;if Player.Inventory.Primary.Value == game.Lighting.Tools:findFirstChild(&quot;AK-47&quot;) then
&#9;&#9;&#9;&#9;Visual.Buy.Active = false
&#9;&#9;&#9;&#9;Visual.Buy.Visible = false
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;EQUIP&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;Visual.T0.Text = &quot;COST: FREE&quot;
&#9;&#9;&#9;Visual.T1.Text = &quot;DAMAGE: 30-40&quot;
&#9;&#9;&#9;Visual.T2.Text = &quot;MAGAZINE SIZE: 30&quot;
&#9;&#9;&#9;Visual.T3.Text = &quot;AMMUNITION: 90 + 30&quot;
&#9;&#9;&#9;Visual.T4.Text = &quot;FIRE MODE: AUTOMATIC&quot;
&#9;&#9;&#9;Visual.Title.Text = &quot;AK-47&quot;
&#9;&#9;&#9;Visual.Picture.Image = &quot;http://www.roblox.com/asset/?id=47451730&quot;
&#9;&#9;&#9;Visual.Picture.Size = UDim2.new(0, 256,0, 64)
&#9;&#9;&#9;Visual.Picture.Position = UDim2.new(0.5,-128,0,100)
&#9;&#9;elseif ClickedButton.Text == &quot;M14&quot; then
&#9;&#9;&#9;if Player.Inventory.Primary.Value == game.Lighting.Tools:findFirstChild(&quot;M14&quot;) then
&#9;&#9;&#9;&#9;Visual.Buy.Active = false
&#9;&#9;&#9;&#9;Visual.Buy.Visible = false
&#9;&#9;&#9;elseif Player.Purchases:findFirstChild(&quot;M14&quot;) ~= nil then
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;EQUIP&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Visual.Buy.Text = &quot;PURCHASE&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;Visual.T0.Text = &quot;COST: 500&quot;
&#9;&#9;&#9;Visual.T1.Text = &quot;DAMAGE:40-50&quot;
&#9;&#9;&#9;Visual.T2.Text = &quot;MAGAZINE SIZE: 20&quot;
&#9;&#9;&#9;Visual.T3.Text = &quot;AMMUNITION: 60 + 20&quot;
