&#9;&#9;&#9;game.Lighting.Uniform.BOHat1.Mesh:clone().Parent = p
&#9;&#9;&#9;h.Parent = Character
&#9;&#9;&#9;h.AttachmentPos = Vector3.new(0, .38, 0)
&#9;&#9;elseif x == 2 then
&#9;&#9;&#9;game.Lighting.Uniform.BO2:findFirstChild(&quot;Shirt&quot;):Clone().Parent = Character
&#9;&#9;&#9;game.Lighting.Uniform.BO2:findFirstChild(&quot;Pants&quot;):Clone().Parent = Character
&#9;&#9;&#9;h1 = Instance.new(&quot;Hat&quot;)
