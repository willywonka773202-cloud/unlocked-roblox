						<Item class="Script" referent="RBX908">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">NadeScript</string>
								<ProtectedString name="Source">local grenade = script.Parent
debris = game:GetService(&quot;Debris&quot;)

function Touched(part)
&#9;con:disconnect()
&#9;wait(1)
&#9;flash = Instance.new(&quot;Part&quot;)
&#9;flash.formFactor = 0
&#9;flash.Size = Vector3.new(1, 1, 1)
&#9;flash.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;flash.Reflectance = 0
&#9;flash.Transparency = 0.3
&#9;flash.TopSurface = 0
&#9;flash.BottomSurface = 0
&#9;flash.Anchored = true
&#9;flash.Name = &quot;Dot&quot;
&#9;flash.CanCollide = true
&#9;mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;mesh.Parent = flash
&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;flash.Mesh.Scale = Vector3.new(1, 1, 2)

&#9;local spawnPos = grenade.Position

&#9;for i=1, 100 do
&#9;&#9;grenade.CFrame = CFrame.new(grenade.Position, Vector3.new(math.random(-360, 360), math.random(-360, 360), math.random(-360, 360)))
&#9;&#9;local lookAt = grenade.Position + Vector3.new(math.random(-100, 100)*0.01, math.random(-100, 100)*0.01, math.random(-100, 100)*0.01)
&#9;&#9;local v = (lookAt - grenade.Position).unit
&#9;&#9;local spawnPos = grenade.Position
&#9;&#9;local dot = flash
&#9;&#9;x = math.random(1,5)
&#9;&#9;if x == 5 then
&#9;&#9;&#9;grenade.Fire2:Play()
&#9;&#9;else
&#9;&#9;&#9;grenade.Fire:Play()
&#9;&#9;end

&#9;&#9;spawnPos  = spawnPos + v
&#9;&#9;dot.Position = spawnPos
&#9;&#9;dot.Parent = grenade.Parent
&#9;&#9;dot.CFrame = CFrame.new(spawnPos, spawnPos + v) * CFrame.Angles(0, 0, math.pi/2)
&#9;&#9;grenade.Velocity = v * 25

&#9;&#9;dot.Mesh.Scale = Vector3.new(1, 1, 2)
&#9;&#9;dot.Transparency = .3
&#9;&#9;wait(0.002)
&#9;&#9;dot.Mesh.Scale = Vector3.new(.5, .5, 1.5)
&#9;&#9;dot.Transparency = .8
&#9;&#9;wait(0.002)
&#9;&#9;dot.Transparency = 1
&#9;&#9;wait(0.07)
&#9;&#9;x = math.random(1,25)
&#9;&#9;if x == 25 then
&#9;&#9;&#9;grenade.Reload:Play()
&#9;&#9;end
&#9;end
&#9;script.Parent.Parent:remove()
end

con = grenade.Touched:connect(Touched)</ProtectedString>
