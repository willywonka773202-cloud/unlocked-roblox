&#9;&#9;&#9;Visual.Title.Text = &quot;MORTAR TEAM&quot;
&#9;&#9;&#9;Visual.Picture.Image = &quot;http://www.roblox.com/asset/?id=48046121&quot;
&#9;&#9;&#9;Visual.Picture.Size = UDim2.new(0, 128,0, 128)
&#9;&#9;&#9;Visual.Picture.Position = UDim2.new(0.5,-64,0,100)
&#9;&#9;end
&#9;end
end

function BuyStuff(Tool, Cost, Slot)
&#9;local Purchased = Player.Purchases:findFirstChild(Tool.Name) 
&#9;if Purchased ~= nil then 
&#9;&#9;Player.Inventory:findFirstChild(Slot).Value = Tool
&#9;&#9;if Slot == &quot;Primary&quot; then
&#9;&#9;&#9;Player.Inventory.Attachment.Value = &quot;&quot;
&#9;&#9;end
&#9;&#9;Visual.Buy.Active = false
&#9;&#9;Visual.Buy.Visible = false
&#9;else 
&#9;&#9;local Cash = Player.leaderstats.Cr 
&#9;&#9;if Cash.Value &gt;= Cost then 
&#9;&#9;&#9;Cash.Value = Cash.Value - Cost
&#9;&#9;&#9;Player.Inventory:findFirstChild(Slot).Value = Tool
&#9;&#9;&#9;local Tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;Tag.Name = &quot;&quot;..Tool.Name..&quot;&quot;
&#9;&#9;&#9;Tag.Parent = Player.Purchases
&#9;&#9;&#9;Visual.Buy.Active = false
&#9;&#9;&#9;Visual.Buy.Visible = false
&#9;&#9;end
&#9;end
end

function BuyAttachments(Attachment, Cost, Gun)
&#9;local Purchased = Player.Purchases:findFirstChild(Gun.Name):findFirstChild(Attachment) 
&#9;if Purchased ~= nil then 
&#9;&#9;Player.Inventory.Attachment.Value = Attachment
&#9;&#9;Visual.Buy.Active = false
&#9;&#9;Visual.Buy.Visible = false
&#9;else 
&#9;&#9;local Cash = Player.leaderstats.Cr 
&#9;&#9;if Cash.Value &gt;= Cost then 
&#9;&#9;&#9;Cash.Value = Cash.Value - Cost
&#9;&#9;&#9;Player.Inventory.Attachment.Value = Attachment
&#9;&#9;&#9;local Tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;Tag.Name = Attachment
&#9;&#9;&#9;Tag.Parent = Player.Purchases:findFirstChild(Gun.Name)
&#9;&#9;&#9;Visual.Buy.Active = false
&#9;&#9;&#9;Visual.Buy.Visible = false
&#9;&#9;end
&#9;end
end

