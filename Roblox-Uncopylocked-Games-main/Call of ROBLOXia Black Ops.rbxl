&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(5)
&#9;elseif script.Mode.Value == &quot;BombDefuse&quot; then
&#9;&#9;Winner = Bomb_Defuse_Winner()
&#9;&#9;workspace.BOScore.Value = 0
&#9;&#9;workspace.SpetsScore.Value = 0
