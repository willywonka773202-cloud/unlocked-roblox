							<ProtectedString name="Source">Humanoid = script.Parent.Humanoid
a = 0
b = 0
while true do
&#9;if Humanoid.Health &gt; 0 and Humanoid.Health &lt; Humanoid.MaxHealth then

&#9;&#9;if Humanoid.Health &gt;= health then

&#9;&#9;&#9;if a &gt;= 5 then
&#9;&#9;&#9;&#9;Humanoid.Health = Humanoid.MaxHealth
&#9;&#9;&#9;&#9;a = 0
&#9;&#9;&#9;else

&#9;&#9;&#9;&#9;a = a + 0.25
&#9;&#9;&#9;end
&#9;&#9;&#9;if b &gt;= 0.5 then

&#9;&#9;&#9;&#9;Humanoid.Health = Humanoid.Health + (0.025 * Humanoid.MaxHealth)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;b = b + 0.25

&#9;&#9;&#9;end
&#9;&#9;else

&#9;&#9;&#9;a = 0
&#9;&#9;&#9;b = 0
&#9;&#9;end
&#9;end
&#9;health = Humanoid.Health
&#9;wait(0.25)
end
