						<ProtectedString name="Source">hint = Instance.new(&quot;Hint&quot;) 
hint.Parent = game.Workspace 
hint.Name = &quot;Hint&quot;

-- Maps
Maps = game.Lighting.Maps
Nuketown = Maps:findFirstChild(&quot;Nuketown&quot;):clone()
NuketownFlags = Maps.NuketownFlags:clone()
NuketownBombs = Maps.NuketownBombs:clone()
FiringRange = Maps:findFirstChild(&quot;Firing Range&quot;):clone()
FiringRangeFlags = Maps.FiringRangeFlags:clone()
FiringRangeBombs = Maps.FiringRangeBombs:clone()
Summit = Maps:findFirstChild(&quot;Summit&quot;):clone()
SummitFlags = Maps.SummitFlags:clone()
SummitBombs = Maps.SummitBombs:clone()
Battlefield = Maps:findFirstChild(&quot;Battlefield&quot;):clone()
BattlefieldFlags = Maps.BattlefieldFlags:clone()
BattlefieldBombs = Maps.BattlefieldBombs:clone()
Maps:findFirstChild(&quot;Firing Range&quot;):remove()
Maps.FiringRangeFlags:remove()
Maps.FiringRangeBombs:remove()
Maps:findFirstChild(&quot;Nuketown&quot;):remove()
Maps.NuketownFlags:remove()
Maps.NuketownBombs:remove()
Maps:findFirstChild(&quot;Summit&quot;):remove()
Maps.SummitFlags:remove()
Maps.SummitBombs:remove()
Maps:findFirstChild(&quot;Battlefield&quot;):remove()
Maps.BattlefieldFlags:remove()
Maps.BattlefieldBombs:remove()
msg = Instance.new(&quot;Message&quot;) 

BO = game.Teams:findFirstChild(&quot;Black Ops&quot;) 

Spets = game.Teams:findFirstChild(&quot;Spetsnaz&quot;) 

function Team_Death_Match_Winner()
&#9;local Winner = nil
 &#9;local BlackopsKill = 0
 &#9;local SpetsnazKill = 0
&#9;local player = game.Players:getPlayers() 
&#9;for i = 1, #player do 
&#9;&#9;if player[i].TeamColor == BrickColor.new(&quot;Bright blue&quot;) then
&#9;&#9;&#9;BlackopsKill = BlackopsKill + player[i].leaderstats.Kill.Value
&#9;&#9;elseif player[i].TeamColor == BrickColor.new(&quot;Bright red&quot;) then
&#9;&#9;&#9;SpetsnazKill = SpetsnazKill + player[i].leaderstats.Kill.Value
&#9;&#9;end
&#9;&#9;player[i].Character.Humanoid.Health = 0
&#9;&#9;player[i].leaderstats.Kill.Value = 0
&#9;&#9;player[i].leaderstats.Streak.Value = 0
&#9;end
&#9;if BlackopsKill &gt; SpetsnazKill then
&#9;&#9;Winner = &quot;Black Ops&quot;
&#9;elseif SpetsnazKill &gt; BlackopsKill then
&#9;&#9;Winner = &quot;Spetnaz&quot;
&#9;elseif SpetsnazKill == BlackopsKill then
&#9;&#9;Winner = &quot;Tie&quot;
&#9;end
&#9;return Winner
end

function Domination_Winner()
&#9;local Winner = nil
 &#9;local BOScore = workspace.BOScore.Value
 &#9;local SpetsScore = workspace.SpetsScore.Value
&#9;local player = game.Players:getPlayers() 
&#9;for i = 1, #player do 
&#9;&#9;player[i].Character.Humanoid.Health = 0
&#9;&#9;player[i].leaderstats.Kill.Value = 0
&#9;&#9;player[i].leaderstats.Streak.Value = 0
&#9;end
&#9;if BOScore &gt; SpetsScore then
&#9;&#9;Winner = &quot;Black Ops&quot;
&#9;elseif SpetsScore &gt; BOScore then
&#9;&#9;Winner = &quot;Spetnaz&quot;
&#9;elseif SpetsScore == BOScore then
&#9;&#9;Winner = &quot;Tie&quot;
&#9;end
&#9;return Winner
end

function Bomb_Defuse_Winner()
&#9;local Winner = nil
 &#9;local BOScore = workspace.BOScore.Value
 &#9;local SpetsScore = workspace.SpetsScore.Value
&#9;local player = game.Players:getPlayers() 
&#9;for i = 1, #player do 
&#9;&#9;player[i].Character.Humanoid.Health = 0
&#9;&#9;player[i].leaderstats.Kill.Value = 0
&#9;&#9;player[i].leaderstats.Streak.Value = 0
&#9;end
&#9;if BOScore &gt; SpetsScore then
&#9;&#9;Winner = &quot;Black Ops&quot;
&#9;elseif SpetsScore &gt; BOScore then
&#9;&#9;Winner = &quot;Spetnaz&quot;
&#9;elseif SpetsScore == BOScore then
&#9;&#9;Winner = &quot;Tie&quot;
&#9;end
&#9;return Winner
end

while true do 
&#9;msg.Parent = game.Workspace 
&#9;msg.Text = &quot;5&quot;
&#9;wait(1)
&#9;msg.Text = &quot;4&quot;
