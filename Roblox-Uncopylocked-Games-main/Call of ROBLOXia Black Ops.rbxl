						<Item class="LocalScript" referent="RBX854">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Local Gui</string>
								<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;wait(.2)
&#9;enabled = true

end

function KeyDownFunctions(key)
&#9;if key == &quot;r&quot; then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;elseif key == &quot;v&quot; then
&#9;&#9;if Tool.Parent.CanFire.Value == true then 
&#9;&#9;&#9;Tool.GunScript.Knife.Value = true
&#9;&#9;end
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=49989240&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(KeyDownFunctions)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX855">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">BulletScript</string>
								<ProtectedString name="Source">ball = script.Parent
damage = math.random(10,30)
debris = game:GetService(&quot;Debris&quot;)
HitSound = Instance.new(&quot;Sound&quot;)
HitSound.Name = &quot;HitSound&quot;
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=11945266&quot;
HitSound.Pitch = .5
HitSound.Parent = ball

function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function onTouched(hit)
&#9;if hit.Name == &quot;Shell&quot; then return end
&#9;HitSound:Play()
&#9;if hit.Parent == &quot;Shell&quot; then return end
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local forcefield = hit.Parent:findFirstChild(&quot;ForceField&quot;) or hit.Parent.Parent:findFirstChild(&quot;ForceField&quot;)

&#9;if humanoid ~= nil and forcefield == nil then
&#9;&#9;Player = getPlayer(humanoid)
&#9;&#9;if ball.creator.Value.TeamColor ~= Player.TeamColor then
&#9;&#9;&#9;if humanoid.Health ~= 0 then
&#9;&#9;&#9;&#9;if hit.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - (damage * 1.4)
&#9;&#9;&#9;&#9;&#9;tagHeadshot(humanoid)
&#9;&#9;&#9;&#9;end&#9;&#9;
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;connection:disconnect()
&#9;ball.Parent = nil
end

function tagHumanoid(humanoid)
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;debris:AddItem(tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end

function tagHeadshot(humanoid)
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;local headshot = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;headshot.Name = &quot;Headshot&quot;
&#9;&#9;headshot.Parent = new_tag
&#9;&#9;debris:AddItem(tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(2.5)
ball.Parent = nil</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX856">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GunScript2</string>
								<ProtectedString name="Source">Tool = script.Parent;
debris = game:GetService(&quot;Debris&quot;)
local Magazine = Tool.GunScript.Magazine
local AmmoLeft = Tool.GunScript.AmmoLeft
local MaxAmmo = Tool.GunScript.MaxAmmo
local Recoil = Tool.GunScript.Recoil
Active = false

local arms = nil
local torso = nil
local weld33 = nil
local weld55 = nil
local welds = {}

local Knife = Tool.GunScript.Knife
function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function blow(hit)
&#9;if (hit.Parent == nil) then return end -- happens when bullet hits sword
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)
&#9;local hum = vCharacter:findFirstChild(&quot;Humanoid&quot;) -- non-nil if tool held by a character
&#9;if humanoid~=nil and humanoid ~= hum and hum ~= nil then
&#9;&#9;local Player = getPlayer(humanoid)
&#9;&#9;local right_arm = vCharacter:FindFirstChild(&quot;Right Arm&quot;)
&#9;&#9;if (right_arm ~= nil) and vPlayer.TeamColor ~= Player.TeamColor then
&#9;&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;&#9;creator_tag.Parent = humanoid
&#9;&#9;&#9;humanoid.Health = humanoid.Health - 135
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = creator_tag
&#9;&#9;end
&#9;end
end

function slice()
&#9;if Tool.Parent:findFirstChild(&quot;Ninja&quot;) == nil then
&#9;&#9;Tool.Handle.KnifeSound:play()
&#9;end
&#9;Tool.Parent.CanFire.Value = false
&#9;local knife = Instance.new(&quot;Part&quot;)
&#9;knife.Size = Vector3.new(1,1,1)
&#9;knife.Parent = Tool
&#9;knife.BrickColor = BrickColor.new(&quot;Dark stone grey&quot;)
&#9;knife.Reflectance = 0.2
&#9;local knifeweld = Instance.new(&quot;Weld&quot;)
&#9;knifeweld.Parent = knife
&#9;knifeweld.Part0 = knife
&#9;knifeweld.Part1 = Tool.Parent[&quot;Left Arm&quot;]
&#9;knifeweld.C0 = CFrame.new(-.5,1,-.4)
&#9;local mesh = Tool.Mesh:clone()
&#9;mesh.Parent = knife
&#9;connection = knife.Touched:connect(blow)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(200), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-80), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(220), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-70), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(240), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-60), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(260), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(280), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(300), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(340), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-50), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(300), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-60), math.rad(-15), 0)
&#9;knife:remove()
&#9;connection:disconnect()
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(300), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-70), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-80), math.rad(-15), 0)
&#9;wait(.025)
&#9;weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15),0)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;wait(.05)
&#9;Tool.Parent.CanFire.Value = true
end

function Melee()
&#9;if Tool.Enabled == true then 
&#9;&#9;if Knife.Value == true then
&#9;&#9;&#9;Tool.Enabled = false
&#9;&#9;&#9;slice()
&#9;&#9;&#9;Tool.Enabled = true
&#9;&#9;end
&#9;end
&#9;Knife.Value = false
end

Knife.Changed:connect(Melee)

function ShellInsert() -- this will be a pain in my blocky butt.
&#9;if Tool.Parent:findFirstChild(&quot;FastReload&quot;) ~= nil then
&#9;&#9;wait(.025)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.3, math.rad(-90))
&#9;&#9;wait(.025)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.6, math.rad(-90))
&#9;&#9;wait(.025)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.9, math.rad(-90))
&#9;&#9;local shell = Instance.new(&quot;Part&quot;)
&#9;&#9;shell.CFrame = Tool.Chamber.CFrame * CFrame.fromEulerAnglesXYZ(1.5,0,0)
&#9;&#9;shell.Size = Vector3.new(1,1,1)
&#9;&#9;shell.BrickColor = BrickColor.new(21)
&#9;&#9;shell.BottomSurface = 0
&#9;&#9;shell.TopSurface = 0
&#9;&#9;shell.Name = &quot;Shell&quot;
&#9;&#9;shell.Parent = game.Workspace
&#9;&#9;local magweld = Instance.new(&quot;Weld&quot;)
&#9;&#9;leftarm = Tool.Parent[&quot;Left Arm&quot;]
&#9;&#9;magweld.Parent = shell
&#9;&#9;magweld.Part0 = shell
&#9;&#9;magweld.Part1 = leftarm
&#9;&#9;magweld.C0 = CFrame.new(-.5,.4,-0.3)
&#9;&#9;shellmesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;shellmesh.Scale = Vector3.new(.3,.75,.3)
&#9;&#9;shellmesh.Parent = shell
&#9;&#9;shell.Parent = game.Workspace
&#9;&#9;wait(.025)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .8, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.6, math.rad(-90))
&#9;&#9;wait(.025)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .6, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.3, math.rad(-90))
&#9;&#9;wait(.025)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .8, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;wait(.025)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;Tool.Handle.Reload:play()
&#9;&#9;shell:remove()
&#9;&#9;wait(.025)
&#9;else
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.3, math.rad(-90))
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.6, math.rad(-90))
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.9, math.rad(-90))
&#9;&#9;local shell = Instance.new(&quot;Part&quot;)
&#9;&#9;shell.CFrame = Tool.Chamber.CFrame * CFrame.fromEulerAnglesXYZ(1.5,0,0)
&#9;&#9;shell.Size = Vector3.new(1,1,1)
&#9;&#9;shell.BrickColor = BrickColor.new(21)
&#9;&#9;shell.BottomSurface = 0
&#9;&#9;shell.TopSurface = 0
&#9;&#9;shell.Name = &quot;Shell&quot;
&#9;&#9;shell.Parent = game.Workspace
&#9;&#9;local magweld = Instance.new(&quot;Weld&quot;)
&#9;&#9;leftarm = Tool.Parent[&quot;Left Arm&quot;]
&#9;&#9;magweld.Parent = shell
&#9;&#9;magweld.Part0 = shell
&#9;&#9;magweld.Part1 = leftarm
&#9;&#9;magweld.C0 = CFrame.new(-.5,.4,-0.3)
&#9;&#9;shellmesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;shellmesh.Scale = Vector3.new(.3,.75,.3)
&#9;&#9;shellmesh.Parent = shell
&#9;&#9;shell.Parent = game.Workspace
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .8, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.6, math.rad(-90))
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .6, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), -.3, math.rad(-90))
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .8, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;wait(.05)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, 1, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;Tool.Handle.Reload:play()
&#9;&#9;shell:remove()
&#9;&#9;wait(.05)
&#9;end
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
end

function ReloadCheck1()
&#9;weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-100), math.rad(-15),0)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.2, math.rad(-90))
&#9;wait(0.025)
&#9;weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-110), math.rad(-15),0)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.4, math.rad(-90))
&#9;wait(0.025)
&#9;weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-100), math.rad(-15),0)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0.2, math.rad(-90))
&#9;wait(0.025)
&#9;weld33.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15),0)
&#9;weld55.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;if Magazine.Value == 0 then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;end
end

function ReloadCheck2()
&#9;if Magazine.Value == 0 and MaxAmmo.Value &gt;= 1 then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;end
end

function Reload()
&#9;if Magazine.Value &lt; MaxAmmo.Value and Tool.Enabled == true and Tool.GunScript.Reload.Value == true and AmmoLeft.Value &gt;= 1 then
&#9;&#9;Tool.Enabled = false
&#9;&#9;for i = 1,MaxAmmo.Value - Magazine.Value do
&#9;&#9;&#9;ShellInsert()
&#9;&#9;&#9;if Tool.Parent:findFirstChild(&quot;FastReload&quot;) ~= nil then
&#9;&#9;&#9;&#9;wait(.05)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;wait(.1)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;Recoil.Value = 0
&#9;&#9;if AmmoLeft.Value &gt;= MaxAmmo.Value then
&#9;&#9;&#9;AmmoLeft.Value = AmmoLeft.Value - MaxAmmo.Value + Magazine.Value
&#9;&#9;&#9;Magazine.Value = MaxAmmo.Value
&#9;&#9;elseif AmmoLeft.Value &lt; MaxAmmo.Value and AmmoLeft.Value &gt;= 1 then
&#9;&#9;&#9;Magazine.Value = AmmoLeft.Value 
&#9;&#9;&#9;AmmoLeft.Value = 0
&#9;&#9;end
&#9;&#9;Tool.Enabled = true
&#9;end
&#9;Tool.GunScript.Reload.Value = false
end
Magazine.Changed:connect(ReloadCheck1)
AmmoLeft.Changed:connect(ReloadCheck2)
Tool.GunScript.Reload.Changed:connect(Reload)

function Equip(mouse)
&#9;wait(0.01)
&#9;arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
&#9;torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;if arms ~= nil and torso ~= nil then
&#9;&#9;local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
&#9;&#9;if sh ~= nil then
&#9;&#9;&#9;local yes = true
&#9;&#9;&#9;if yes then
&#9;&#9;&#9;&#9;yes = false
&#9;&#9;&#9;&#9;sh[1].Part1 = nil
&#9;&#9;&#9;&#9;sh[2].Part1 = nil
&#9;&#9;&#9;&#9;local weld1 = Instance.new(&quot;Weld&quot;) -- left arm
&#9;&#9;&#9;&#9;weld55 = weld1
&#9;&#9;&#9;&#9;weld1.Part0 = torso
&#9;&#9;&#9;&#9;weld1.Parent = torso
&#9;&#9;&#9;&#9;weld1.Part1 = arms[1]
&#9;&#9;&#9;&#9;weld1.C1 = CFrame.new(-0.35, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
&#9;&#9;&#9;&#9;welds[1] = weld1
&#9;&#9;&#9;&#9;local weld2 = Instance.new(&quot;Weld&quot;) -- right arm
&#9;&#9;&#9;&#9;weld33 = weld2
&#9;&#9;&#9;&#9;weld2.Part0 = torso
&#9;&#9;&#9;&#9;weld2.Parent = torso
&#9;&#9;&#9;&#9;weld2.Part1 = arms[2]
&#9;&#9;&#9;&#9;weld2.C1 = CFrame.new(-0.75, 0.25, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;&#9;&#9;welds[2] = weld2
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;print(&quot;sh&quot;)
&#9;&#9;end
&#9;else
&#9;&#9;print(&quot;arms&quot;)
&#9;end
end

local legs = nil
local torso2 = nil
local welds2 = {}
local bodyforce = nil

function Unequip(mouse)
&#9;if arms ~= nil and torso ~= nil then
&#9;&#9;local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
&#9;&#9;if sh ~= nil then
&#9;&#9;&#9;local yes = true
&#9;&#9;&#9;if yes then
