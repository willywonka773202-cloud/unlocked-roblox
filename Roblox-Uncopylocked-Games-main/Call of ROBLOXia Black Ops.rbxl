					<Item class="Script" referent="RBX4304">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">GuiScript</string>
							<ProtectedString name="Source">Gui = script.Parent.Backdrop
Text = script.Parent.Text
TagNumber = 0

function Changed()
&#9;TagNumber = TagNumber + 1
&#9;local CurrentTagNumber = TagNumber
&#9;if Text.Value == &quot;Assist&quot; then
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;Assist&quot;
&#9;&#9;Gui.Text.Text = &quot;Help take down an enemy. +10 per hit&quot;
&#9;elseif Text.Value == &quot;Headshot&quot; then
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;Headshot&quot;
&#9;&#9;Gui.Text.Text = &quot;Killed an enemy with a bullet to the head. +150&quot;
&#9;elseif Text.Value == &quot;Payback&quot; then
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;Payback&quot;
&#9;&#9;Gui.Text.Text = &quot;Killed the enemy who killed you. +150&quot;
&#9;elseif Text.Value == &quot;Stuck&quot; then
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;Stuck&quot;
&#9;&#9;Gui.Text.Text = &quot;Stuck an enemy with an explosive. +150&quot;
&#9;elseif Text.Value == &quot;Scalper&quot; then
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;Scalper&quot;
&#9;&#9;Gui.Text.Text = &quot;Killed an enemy with a Tomahawk. +150&quot;
&#9;elseif Text.Value == &quot;Afterlife&quot; then
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;Afterlife&quot;
&#9;&#9;Gui.Text.Text = &quot;Killed an enemy while dead. +200&quot;
&#9;elseif Text.Value == &quot;Assisted Suicide&quot; then
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;Assisted Suicide&quot;
&#9;&#9;Gui.Text.Text = &quot;Injured an enemy that killed themselves. +200&quot;
&#9;elseif Text.Value == &quot;Kill&quot; then
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;Kill&quot;
&#9;&#9;Gui.Text.Text = &quot;Killed an enemy. +100&quot;
&#9;else
&#9;&#9;Gui.Visible = true
&#9;&#9;Gui.Title.Text = &quot;&quot;
&#9;&#9;Gui.Text.Text = Text.Value
&#9;end
&#9;wait(5)
&#9;if CurrentTagNumber == TagNumber then
&#9;&#9;Gui.Visible = false
&#9;end
end


Text.changed:connect(Changed)
</ProtectedString>
