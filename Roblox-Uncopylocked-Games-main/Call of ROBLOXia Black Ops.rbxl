&#9;if Tool.Enabled == true then 
&#9;&#9;if Knife.Value == true then
&#9;&#9;&#9;Tool.Enabled = false
&#9;&#9;&#9;slice()
&#9;&#9;&#9;Tool.Enabled = true
&#9;&#9;end
&#9;end
