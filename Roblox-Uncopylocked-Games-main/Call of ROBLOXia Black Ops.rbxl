							<string name="Name">ScoreScript</string>
							<ProtectedString name="Source">BOScore = Workspace.BOScore
SpetsScore = Workspace.SpetsScore

function Update (Box,Value)
&#9;Frame = script.Parent:findFirstChild(Box..&quot;Box&quot;)
&#9;if  Frame == nil then return end
&#9;Frame.Frame.Text.Text = tostring(Value) --didn&apos;t i could do know that!
end

Update(&quot;BOScore&quot;,BOScore.Value)
Update(&quot;SpetsScore&quot;,SpetsScore.Value)

BOScore.changed:connect(function ()
&#9;Update(&quot;BOScore&quot;,BOScore.Value)
end)
SpetsScore.changed:connect(function ()
&#9;Update(&quot;SpetsScore&quot;,SpetsScore.Value)
end)
</ProtectedString>
