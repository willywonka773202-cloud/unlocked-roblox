								<Y>0</Y>
								<Z>-0.5</Z>
								<R00>0</R00>
								<R01>0</R01>
								<R02>-1</R02>
								<R10>-1</R10>
								<R11>0</R11>
								<R12>0</R12>
								<R20>0</R20>
								<R21>1</R21>
								<R22>0</R22>
