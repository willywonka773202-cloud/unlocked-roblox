&#9;&#9;&#9;&#9;weld2.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-16), 0)
&#9;&#9;&#9;&#9;welds[2] = weld2
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;print(&quot;sh&quot;)
&#9;&#9;end
&#9;else
