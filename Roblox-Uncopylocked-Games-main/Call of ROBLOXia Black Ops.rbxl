						<Item class="Script" referent="RBX3029">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GunScript</string>
								<ProtectedString name="Source">Tool = script.Parent;
debris = game:GetService(&quot;Debris&quot;)
local Magazine = script.Magazine
local Recoil = script.Recoil
enabled = true

---------------------------------- START FIRING

function fire(v)
&#9;if Tool.Parent.CanFire.Value == false then return end
 &#9;if Magazine.Value == 0 then return end
&#9;Magazine.Value = Magazine.Value - 1

&#9;if Tool.Parent:findFirstChild(&quot;Ninja&quot;) == nil then
&#9;&#9;Tool.Handle.Fire:play()
&#9;end

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local missile = Instance.new(&quot;Part&quot;)        

&#9;local spawnPos = vCharacter.PrimaryPart.Position

&#9;spawnPos  = spawnPos + (v * 8)

&#9;missile.Position = spawnPos
&#9;missile.Size = Vector3.new(1,1,1)
&#9;missile.Velocity = v * 295
&#9;missile.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;missile.Shape = 0
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;Shell&quot;
&#9;missile.Elasticity = 0
&#9;missile.Reflectance = 0.15
&#9;missile.Friction = 0.3

&#9;missile.CFrame = CFrame.new(spawnPos, spawnPos + v) * CFrame.Angles(0, 0, math.pi/2)

&#9;local mesh = Instance.new(&quot;BlockMesh&quot;) 
&#9;mesh.Scale = Vector3.new(0.2,0.2,3) 
&#9;mesh.Parent = missile
&#9;
&#9;debris:AddItem(missile, 8)

&#9;local new_script = script.Parent.BulletScript:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile

&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,98,0) 
&#9;force.Parent = missile
&#9;missile.Parent = game.Workspace

&#9;Tool.Flash.Mesh.Scale = Vector3.new(0.5, 1.4, 0.5)
&#9;Tool.Flash.Transparency = .3
&#9;wait(0.1)
&#9;Tool.Flash.Mesh.Scale = Vector3.new(0.4, 1.3, 0.4)
&#9;Tool.Flash.Transparency = .8
&#9;wait(0.1)
&#9;Tool.Flash.Transparency = 1
   wait(0.5)
end

---------------------------------- END FIRING

function onActivated()
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit

&#9;fire(lookAt)
&#9;enabled = true

end

function onEquipped()
&#9;Humanoid = Tool.Parent.Humanoid
&#9;Humanoid.WalkSpeed = 15
end

function onUnequipped()
&#9;Humanoid.WalkSpeed = 16
end

script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
script.Parent.Activated:connect(onActivated)</ProtectedString>
							</Properties>
							<Item class="NumberValue" referent="RBX3030">
								<Properties>
									<string name="Name">Magazine</string>
									<double name="Value">5</double>
								</Properties>
							</Item>
							<Item class="NumberValue" referent="RBX3031">
								<Properties>
									<string name="Name">Recoil</string>
									<double name="Value">0</double>
								</Properties>
							</Item>
							<Item class="NumberValue" referent="RBX3032">
								<Properties>
									<string name="Name">MaxAmmo</string>
									<double name="Value">5</double>
								</Properties>
							</Item>
							<Item class="NumberValue" referent="RBX3033">
								<Properties>
									<string name="Name">AmmoLeft</string>
									<double name="Value">15</double>
								</Properties>
							</Item>
							<Item class="BoolValue" referent="RBX3034">
								<Properties>
									<string name="Name">Reload</string>
									<bool name="Value">false</bool>
								</Properties>
							</Item>
							<Item class="BoolValue" referent="RBX3035">
								<Properties>
									<string name="Name">Knife</string>
									<bool name="Value">false</bool>
								</Properties>
							</Item>
						</Item>
						<Item class="LocalScript" referent="RBX3036">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Local Gui</string>
								<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;wait(.2)
&#9;enabled = true

end

function KeyDownFunctions(key)
&#9;if key == &quot;r&quot; then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;elseif key == &quot;v&quot; then
&#9;&#9;if Tool.Parent.CanFire.Value == true then 
&#9;&#9;&#9;Tool.GunScript.Knife.Value = true
&#9;&#9;end
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=49989240&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(KeyDownFunctions)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
							</Properties>
						</Item>
						<Item class="LocalScript" referent="RBX3037">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Crouch</string>
								<ProtectedString name="Source">on = 0
Tool = script.Parent
welds = {}
sh = {}
arms = nil
torso = nil
f = nil

function Crouch(ison)
&#9;if arms == nil and torso == nil then
&#9;&#9;arms = {Tool.Parent:FindFirstChild(&quot;Left Leg&quot;), Tool.Parent:FindFirstChild(&quot;Right Leg&quot;)}
&#9;&#9;torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;end
&#9;if arms ~= nil and torso ~= nil then
&#9;&#9;sh = {torso:FindFirstChild(&quot;Left Hip&quot;), torso:FindFirstChild(&quot;Right Hip&quot;)}
&#9;&#9;if sh ~= nil then
&#9;&#9;&#9;local yes = true
&#9;&#9;&#9;if yes then
&#9;&#9;&#9;&#9;yes = false
&#9;&#9;&#9;&#9;if ison == 1 then
&#9;&#9;&#9;&#9;&#9;Tool.Parent.Humanoid.WalkSpeed = 7.5
&#9;&#9;&#9;&#9;&#9;sh[1].Part1 = nil
&#9;&#9;&#9;&#9;&#9;sh[2].Part1 = nil
&#9;&#9;&#9;&#9;&#9;local weld1 = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;&#9;weld1.Part0 = torso
&#9;&#9;&#9;&#9;&#9;weld1.Parent = torso
&#9;&#9;&#9;&#9;&#9;weld1.Part1 = arms[1]
&#9;&#9;&#9;&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.75, 1)
&#9;&#9;&#9;&#9;&#9;arms[1].Name = &quot;LDave&quot;
&#9;&#9;&#9;&#9;&#9;arms[1].CanCollide = true
&#9;&#9;&#9;&#9;&#9;welds[1] = weld1
&#9;&#9;&#9;&#9;&#9;-------------------------------------------
&#9;&#9;&#9;&#9;&#9;local weld2 = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;&#9;weld2.Part0 = torso
&#9;&#9;&#9;&#9;&#9;weld2.Parent = torso
&#9;&#9;&#9;&#9;&#9;weld2.Part1 = arms[2]
&#9;&#9;&#9;&#9;&#9;weld2.C1 = CFrame.new(0.5,0.495,1.25) * CFrame.fromEulerAnglesXYZ(math.rad(90),0,0)
&#9;&#9;&#9;&#9;&#9;arms[2].Name = &quot;RDave&quot;
&#9;&#9;&#9;&#9;&#9;arms[2].CanCollide = true
&#9;&#9;&#9;&#9;&#9;welds[2] = weld2
&#9;&#9;&#9;&#9;&#9;---------------------------------
&#9;&#9;&#9;&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;&#9;&#9;force.Parent = torso
&#9;&#9;&#9;&#9;&#9;f = force
&#9;&#9;&#9;&#9;&#9;wait(0.01)
&#9;&#9;&#9;&#9;elseif ison == 0 then
&#9;&#9;&#9;&#9;&#9;if arms then
&#9;&#9;&#9;&#9;&#9;&#9;Tool.Parent.Humanoid.WalkSpeed = 15
&#9;&#9;&#9;&#9;&#9;&#9;sh[1].Part1 = arms[1]
&#9;&#9;&#9;&#9;&#9;&#9;sh[2].Part1 = arms[2]
&#9;&#9;&#9;&#9;&#9;&#9;f.Parent = nil
&#9;&#9;&#9;&#9;&#9;&#9;arms[2].Name = &quot;Right Leg&quot;
&#9;&#9;&#9;&#9;&#9;&#9;arms[1].Name = &quot;Left Leg&quot;
&#9;&#9;&#9;&#9;&#9;&#9;welds[1].Parent = nil
&#9;&#9;&#9;&#9;&#9;&#9;welds[2].Parent = nil
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;print(&quot;sh&quot;)
&#9;&#9;end
&#9;else
&#9;print(&quot;arms&quot;)
&#9;end
end

function Key(key)
&#9;if key then
&#9;&#9;key = string.lower(key)
&#9;&#9;if (key==&quot;c&quot;) then
&#9;&#9;&#9;if on == 1 then
&#9;&#9;&#9;&#9;on = 0
&#9;&#9;&#9;elseif on == 0 then
&#9;&#9;&#9;&#9;on = 1
&#9;&#9;&#9;end
&#9;&#9;&#9;Crouch(on)
&#9;&#9;end
&#9;end
end

function Equip(mouse)
&#9;mouse.KeyDown:connect(Key)
end
script.Parent.Equipped:connect(Equip)

