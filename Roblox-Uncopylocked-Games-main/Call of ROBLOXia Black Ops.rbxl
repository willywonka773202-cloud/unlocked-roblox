&#9;&#9;&#9;if (bomb.Position - list[i].Torso.Position).magnitude &lt;= 10 then
&#9;&#9;&#9;&#9;if bomb.creator.Value.TeamColor ~= player.TeamColor then
&#9;&#9;&#9;&#9;&#9;if player.PlayerGui:FindFirstChild(&quot;Blur&quot;) == nil then
