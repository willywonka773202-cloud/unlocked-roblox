Streak = player.leaderstats.Streak
Tool = game.Lighting.Killstreaks:findFirstChild(&quot;Airstrike&quot;)

StreakNeeded = 3
function Changed()
&#9;if script.Parent:findFirstChild(&quot;Hardline&quot;) == nil then
&#9;&#9;if Streak.Value == StreakNeeded then
&#9;&#9;&#9;Tool:clone().Parent = player.Backpack
&#9;&#9;&#9;Streak.Value = 0
&#9;&#9;end
&#9;else
&#9;&#9;if Streak.Value == StreakNeeded - 1 then
&#9;&#9;&#9;Tool:clone().Parent = player.Backpack
&#9;&#9;&#9;Streak.Value = 0
&#9;&#9;end
&#9;end
end
