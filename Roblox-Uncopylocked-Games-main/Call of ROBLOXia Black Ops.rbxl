   Tool.B6.Transparency = 0
&#9;wait(0.002)
&#9;Tool.Flash.Mesh.Scale = Vector3.new(.5, 1.25, .5)
&#9;Tool.Flash.Transparency = .8
   wait(0.002)
&#9;Tool.Flash.Transparency = 1
