&#9;if Map ~= nil then
&#9;&#9;if MapValue == &quot;Nuketown&quot; then
&#9;&#9;&#9;Map.Radio1.MusicPart.Music:stop()
&#9;&#9;&#9;Map.Radio2.MusicPart.Music:stop()
&#9;&#9;end
&#9;&#9;Map:remove()
&#9;end
&#9;if script.Mode.Value == &quot;TeamDeathMatch&quot; then
&#9;&#9;Winner = Team_Death_Match_Winner()
&#9;&#9;script.TeamDeathMatchScript.Disabled = true
&#9;&#9;workspace.BOScore.Value = 0
&#9;&#9;workspace.SpetsScore.Value = 0
&#9;&#9;wait(5)
&#9;&#9;print(&quot;Winner&quot;)
&#9;&#9;if Winner ~= &quot;Tie&quot; then
&#9;&#9;&#9;msg.Text = &quot;The Winner of This Match is &quot;..Winner..&quot;!&quot;
&#9;&#9;&#9;if Winner == &quot;Black Ops&quot; then
&#9;&#9;&#9;&#9;local player = game.Players:getPlayers() 
&#9;&#9;&#9;&#9;for i = 1, #player do 
&#9;&#9;&#9;&#9;&#9;if player[i].TeamColor == BrickColor.new(&quot;Bright blue&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;player[i].leaderstats.Cr.Value = player[i].leaderstats.Cr.Value + 200
&#9;&#9;&#9;&#9;&#9;&#9;player[i].PlayerGui.CrGui.Text.Value = &quot;Match Winner +200&quot;
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif Winner == &quot;Spetnaz&quot; then
&#9;&#9;&#9;&#9;local player = game.Players:getPlayers() 
&#9;&#9;&#9;&#9;for i = 1, #player do 
&#9;&#9;&#9;&#9;&#9;if player[i].TeamColor == BrickColor.new(&quot;Bright red&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;player[i].leaderstats.Cr.Value = player[i].leaderstats.Cr.Value + 200
&#9;&#9;&#9;&#9;&#9;&#9;player[i].PlayerGui.CrGui.Text.Value = &quot;Match Winner +200&quot;
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;msg.Text = &quot;This Match is a Tie!&quot;
&#9;&#9;&#9;local player = game.Players:getPlayers() 
&#9;&#9;&#9;for i = 1, #player do 
&#9;&#9;&#9;&#9;player[i].PlayerGui.CrGui.Text.Value = &quot;You&apos;ll get them next time!&quot;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(5)
&#9;elseif script.Mode.Value == &quot;Domination&quot; then
&#9;&#9;Winner = Domination_Winner()
&#9;&#9;workspace.BOScore.Value = 0
&#9;&#9;workspace.SpetsScore.Value = 0
