&#9;&#9;&#9;&#9;Character = findCharacter(script.Parent.Position, Character)
&#9;&#9;&#9;&#9;if Character == nil then 
&#9;&#9;&#9;&#9;&#9;a = false
&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Name = &quot;Care Package&quot;
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Name = &quot;Care Package: 75%&quot;
&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;&#9;Character = findCharacter(script.Parent.Position, Character)
&#9;&#9;&#9;&#9;&#9;if Character == nil then 
&#9;&#9;&#9;&#9;&#9;&#9;a = false
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Name = &quot;Care Package&quot;
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;player = getPlayer(hit.Parent.Humanoid)
&#9;&#9;&#9;&#9;&#9;&#9;x = math.random(20,53)
&#9;&#9;&#9;&#9;&#9;&#9;if x &gt;= 20 and x &lt; 29 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.Killstreaks:findFirstChild(&quot;Airstrike&quot;):clone().Parent = player.Backpack
&#9;&#9;&#9;&#9;&#9;&#9;elseif x &gt;= 29 and x &lt; 34 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.Killstreaks:findFirstChild(&quot;Carpet&quot;):clone().Parent = player.Backpack
&#9;&#9;&#9;&#9;&#9;&#9;elseif x &gt;= 34 and x &lt; 39 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.Killstreaks:findFirstChild(&quot;Mortar&quot;):clone().Parent = player.Backpack
&#9;&#9;&#9;&#9;&#9;&#9;elseif x &gt;= 39 and x &lt; 44 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.Killstreaks:findFirstChild(&quot;Sentry&quot;):clone().Parent = player.Backpack
&#9;&#9;&#9;&#9;&#9;&#9;elseif x &gt;= 44 and x &lt;= 48 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;game.Lighting.Killstreaks:findFirstChild(&quot;Nova Strike&quot;):clone().Parent = player.Backpack
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if Character:findFirstChild(&quot;Hacker&quot;) == nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Name = &quot;Care Package Hacked!&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Position = script.Parent.Position
&#9;&#9;&#9;&#9;&#9;&#9;&#9;CFrame = script.Parent.CFrame
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;hackedPackage = game.Lighting.Killstreaks.hackedPackage:clone()

&#9;&#9;&#9;&#9;&#9;&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator_tag.Value = player
&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator_tag.Parent = hackedPackage

&#9;&#9;&#9;&#9;&#9;&#9;&#9;hackedPackage.Parent = Workspace
&#9;&#9;&#9;&#9;&#9;&#9;&#9;hackedPackage.Head.Position = Position
&#9;&#9;&#9;&#9;&#9;&#9;&#9;hackedPackage.Head.CFrame = CFrame
&#9;&#9;&#9;&#9;&#9;&#9;&#9;hackedPackage.Head.PackageScript.Disabled = false
&#9;&#9;&#9;&#9;&#9;&#9;&#9;debris:AddItem(hackedPackage, 300)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end 
