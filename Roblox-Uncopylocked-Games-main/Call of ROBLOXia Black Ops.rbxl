						<Item class="LocalScript" referent="RBX1765">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GuiScript</string>
								<ProtectedString name="Source">local Tool = script.Parent
local Ammo = Tool.GunScript.Magazine
local AmmoLeft = Tool.GunScript.AmmoLeft
local vPlayer
local Gui

function onChanged()
&#9;if Gui ~= nil then
&#9;&#9;if Ammo.Value &gt;= 1 then
&#9;&#9;&#9;Gui.Frame.Ammo.FontSize = &quot;Size18&quot;
&#9;&#9;&#9;Gui.Frame.Ammo.Text = string.rep(&quot;|&quot;, Ammo.Value)
&#9;&#9;&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;&#9;elseif math.floor(Ammo.Value) &lt;= 0 then
&#9;&#9;&#9;Gui.Frame.Ammo.FontSize = &quot;Size18&quot;
&#9;&#9;&#9;if AmmoLeft.Value == 0 then
&#9;&#9;&#9;&#9;Gui.Frame.Ammo.Text = &quot;No More Ammo&quot;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Gui.Frame.Ammo.Text = &quot;Reloading...&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;&#9;end
&#9;end
end

function setUpGui()
&#9;if vPlayer == nil or vPlayer:findFirstChild(&quot;PlayerGui&quot;) == nil then
&#9;&#9;return
&#9;end

&#9;Gui = game.Lighting.GunGui:clone()

&#9;Gui.Name = &quot;DragGui&quot;
&#9;Gui.Parent = vPlayer.PlayerGui

&#9;Gui.Frame.Ammo.Text = string.rep(&quot;|&quot;, Ammo.Value)
&#9;Gui.Frame.Ammo.FontSize = &quot;Size18&quot;
&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;Gui.Frame.GunImage.Image = &quot;http://www.roblox.com/asset/?id=47549183&quot;
&#9;Gui.Frame.GunImage.Size = UDim2.new(0, 181, 0, 50)
end

function onEquippedLocal(mouse)
&#9;vPlayer = game.Players.LocalPlayer

&#9;setUpGui()
end

function onUnequippedLocal(mouse)
&#9;if Gui then
&#9;&#9;Gui:remove()
&#9;end

&#9;Gui = nil
&#9;vPlayer = nil
end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
AmmoLeft.Changed:connect(onChanged)
Ammo.Changed:connect(onChanged)</ProtectedString>
