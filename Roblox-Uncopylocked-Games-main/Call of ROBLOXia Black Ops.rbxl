&#9;&#9;weld33.C1 = CFrame.new(-0.75, -0.8, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), math.rad(-15), 0)
&#9;&#9;weld55.C1 = CFrame.new(-0.35, .8, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(290), 0, math.rad(-90))
