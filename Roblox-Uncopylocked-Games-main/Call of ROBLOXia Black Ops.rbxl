							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GuiScript</string>
								<ProtectedString name="Source">local Tool = script.Parent
local Ammo = Tool.GunScript.Magazine
local AmmoLeft = Tool.GunScript.AmmoLeft
local vPlayer
local Gui

function onChanged()
&#9;if Gui ~= nil then
&#9;&#9;if Ammo.Value &gt;= 1 then
&#9;&#9;&#9;Gui.Frame.Ammo.FontSize = &quot;Size18&quot;
&#9;&#9;&#9;Gui.Frame.Ammo.Text = string.rep(&quot;|&quot;, Ammo.Value)
&#9;&#9;&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;&#9;elseif math.floor(Ammo.Value) &lt;= 0 then
&#9;&#9;&#9;Gui.Frame.Ammo.FontSize = &quot;Size18&quot;
&#9;&#9;&#9;if AmmoLeft.Value == 0 then
&#9;&#9;&#9;&#9;Gui.Frame.Ammo.Text = &quot;No More Ammo&quot;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Gui.Frame.Ammo.Text = &quot;Reloading...&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;&#9;end
&#9;end
end

function setUpGui()
&#9;if vPlayer == nil or vPlayer:findFirstChild(&quot;PlayerGui&quot;) == nil then
&#9;&#9;return
&#9;end

&#9;Gui = game.Lighting.GunGui:clone()

&#9;Gui.Name = &quot;AK47Gui&quot;
&#9;Gui.Parent = vPlayer.PlayerGui

&#9;Gui.Frame.Ammo.Text = string.rep(&quot;|&quot;, Ammo.Value)
&#9;Gui.Frame.Ammo.FontSize = &quot;Size18&quot;
&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;Gui.Frame.GunImage.Image = &quot;http://www.roblox.com/asset/?id=52030323&quot;
&#9;Gui.Frame.GunImage.Size = UDim2.new(0, 181, 0, 50)
end

function onEquippedLocal(mouse)
&#9;vPlayer = game.Players.LocalPlayer

&#9;setUpGui()
end

function onUnequippedLocal(mouse)
&#9;if Gui then
&#9;&#9;Gui:remove()
&#9;end

&#9;Gui = nil
&#9;vPlayer = nil
end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
AmmoLeft.Changed:connect(onChanged)
Ammo.Changed:connect(onChanged)</ProtectedString>
							</Properties>
						</Item>
						<Item class="LocalScript" referent="RBX3190">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Local Gui</string>
								<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = true
end


function onButton1Up(mouse)
enabled = false
Tool.Enabled = false
wait(0.5)
enabled = true
Tool.Enabled = true
end

function KeyDownFunctions(key)
&#9;if key == &quot;r&quot; then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;elseif key == &quot;f&quot; then
&#9;&#9;if Tool.Mode.Value == &quot;Normal&quot; then
&#9;&#9;&#9;if Tool.Parent.Attachment.Value == &quot;Masterkey&quot; then
&#9;&#9;&#9;&#9;Tool.Mode.Value = &quot;Masterkey&quot;
&#9;&#9;&#9;&#9;Tool.Name = &quot;Masterkey&quot;
&#9;&#9;&#9;elseif Tool.Parent.Attachment.Value == &quot;Grenade&quot; then
&#9;&#9;&#9;&#9;Tool.Mode.Value = &quot;Grenade&quot;
&#9;&#9;&#9;&#9;Tool.Name = &quot;Grenade&quot;
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;Tool.Mode.Value = &quot;Normal&quot;
&#9;&#9;&#9;Tool.Name = &quot;Famas&quot;
&#9;&#9;end
&#9;elseif key == &quot;v&quot; then
&#9;&#9;if Tool.Parent.CanFire.Value == true then 
&#9;&#9;&#9;Tool.GunScript.Knife.Value = true
&#9;&#9;end
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=49989240&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)&#9;
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse)end)
&#9;mouse.KeyDown:connect(KeyDownFunctions)
end


Tool.Equipped:connect(onEquippedLocal)
