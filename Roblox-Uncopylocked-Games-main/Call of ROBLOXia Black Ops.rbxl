								<string name="Name">NadeScript</string>
								<ProtectedString name="Source">local grenade = script.Parent
debris = game:GetService(&quot;Debris&quot;)

function PWNEM()
&#9;for i =1 ,8 do
&#9;&#9;local list = game.Workspace:children()
&#9;&#9;for i = 1, #list do 
&#9;&#9;&#9;local player = game.Players:GetPlayerFromCharacter(list[i])
&#9;&#9;&#9;if player ~= nil then
&#9;&#9;&#9;&#9;if (grenade.Position - list[i].Torso.Position).magnitude &lt;= 15 then
&#9;&#9;&#9;&#9;&#9;if grenade.creator.Value == player or grenade.creator.Value.TeamColor ~= player.TeamColor then
&#9;&#9;&#9;&#9;&#9;&#9;if list[i]:findFirstChild(&quot;Tactical Mask&quot;) == nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if player.PlayerGui:FindFirstChild(&quot;Blur&quot;) == nil then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Blur:clone().Parent = player.PlayerGui
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;&#9;list[i].Humanoid.Health = list[i].Humanoid.Health - 13
&#9;&#9;&#9;&#9;&#9;&#9;&#9;list[i].Humanoid.WalkSpeed = 5
&#9;&#9;&#9;&#9;&#9;&#9;&#9;tagHumanoid(list[i].Humanoid)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;elseif player.PlayerGui:findFirstChild(&quot;Blur&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;player.PlayerGui.Blur:remove()
&#9;&#9;&#9;&#9;&#9;list[i].Humanoid.WalkSpeed = 16
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(1)
&#9;end
&#9;local list = game.Workspace:children()
&#9;for i = 1, #list do 
&#9;&#9;local player = game.Players:GetPlayerFromCharacter(list[i])
&#9;&#9;if player ~= nil then
&#9;&#9;&#9;if player.PlayerGui:findFirstChild(&quot;Blur&quot;) ~= nil then
&#9;&#9;&#9;&#9;player.PlayerGui.Blur:remove()
&#9;&#9;&#9;&#9;list[i].Humanoid.WalkSpeed = 16
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;grenade.Parent:remove()
end

function tagHumanoid(humanoid)
&#9;local tag = grenade:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;debris:AddItem(new_tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end

function Touched(part)
&#9;con:disconnect()
&#9;wait(1)
&#9;grenade.Boom:Play()
&#9;flash = Instance.new(&quot;Part&quot;)
&#9;flash.formFactor = 0
&#9;flash.Size = Vector3.new(1, 1, 1)
&#9;flash.BrickColor = BrickColor.new(&quot;Cool yellow&quot;)
&#9;flash.Reflectance = 0
&#9;flash.Transparency = 0.75
&#9;flash.TopSurface = 0
&#9;flash.BottomSurface = 0
&#9;flash.Anchored = true
&#9;flash.Name = &quot;Dot&quot;
&#9;flash.CanCollide = false
&#9;mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;mesh.Parent = flash
&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;mesh.Scale = Vector3.new(7.5, 7.5, 7.5)
&#9;for i=1, 50 do
&#9;&#9;local dot = flash:clone()
&#9;&#9;dot.Position = grenade.Position + Vector3.new(math.random(-75,75)*0.1, math.random(-25,25)*0.1, math.random(-75,75)*0.1)
&#9;&#9;dot.Parent = grenade.Parent
&#9;&#9;debris:AddItem(dot, 8)
&#9;end
&#9;grenade.Anchored = true
&#9;grenade.Transparency = 1
&#9;PWNEM()
end

con = grenade.Touched:connect(Touched)</ProtectedString>
