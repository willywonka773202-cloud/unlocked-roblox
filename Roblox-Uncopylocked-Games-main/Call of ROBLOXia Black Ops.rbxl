&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;debris:AddItem(new_tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end

function onTouched(hit)
&#9;if hit.Anchored == true then return end
&#9;if hit.Parent ~= nil and hit.Parent.className == &quot;Tool&quot; then return end
&#9;if hit.Parent ~= nil and hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return end
