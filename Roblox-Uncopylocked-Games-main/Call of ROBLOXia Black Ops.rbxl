								<Item class="Script" referent="RBX5876">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">plate = script.Parent

function onTouched(hit)
&#9;if hit.Parent ~= plate.Parent then
&#9;&#9;plate.BrickColor = BrickColor.new(&quot;Really red&quot;)
&#9;&#9;plate.Hit.Value = true
&#9;&#9;wait()
&#9;&#9;plate.BrickColor = BrickColor.new(&quot;Instututional White&quot;)
&#9;end
end

function setTarget()
&#9;if plate.Hit.Value == true then
&#9;&#9;plate.BodyForce.force = Vector3.new(0,0,0)
&#9;&#9;wait(5)
&#9;&#9;plate.Hit.Value = false
&#9;elseif plate.Hit.Value == false then
&#9;&#9;plate.BodyForce.force = Vector3.new(0,10000,0)
&#9;end
end

plate.Touched:connect(onTouched)
plate.Hit.Changed:connect(setTarget)

</ProtectedString>
