						<Item class="LocalScript" referent="RBX4154">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Local Gui</string>
								<ProtectedString name="Source">local Tool = script.Parent;

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;

&#9;wait(0.5)

&#9;Tool.Handle.Fire:play()
&#9;local vCharacter = Tool.Parent;
&#9;
&#9;local vHandle = Tool:findFirstChild(&quot;Handle&quot;)
&#9;if vHandle == nil then
&#9;&#9;print(&quot;Handle not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;if vPlayer == nil then
&#9;&#9;print(&quot;Player not found&quot;)
&#9;end
&#9;
&#9;script.Parent:remove()
&#9;vPlayer.PlayerGui.SpecialGui.Text.Text = &quot;Sending In The Lockhead U-2...&quot;
&#9;vPlayer.PlayerGui.SpecialGui.GarbageMan.Disabled = false
&#9;wait(5)
&#9;local list = game.Workspace:children()
&#9;for i = 1, #list do 
&#9;&#9;local player = game.Players:GetPlayerFromCharacter(list[i])
&#9;&#9;if player ~= nil then
&#9;&#9;&#9;if player.TeamColor ~= vPlayer.TeamColor then
&#9;&#9;&#9;&#9;FakeHead = list[i].Character:findFirstChild(&quot;FakeHead&quot;)
&#9;&#9;&#9;&#9;Head = list[i].Character:findFirstChild(&quot;Head&quot;)
&#9;&#9;&#9;&#9;player.PlayerGui.SpecialGui.Text.Text = &quot;Hostile Spy Plane Above!&quot;
&#9;&#9;&#9;&#9;player.PlayerGui.SpecialGui.GarbageMan.Disabled = false
&#9;&#9;&#9;&#9;if FakeHead ~= nil and Head ~= nil then
&#9;&#9;&#9;&#9;&#9;FakeHead.Transparency = 1
&#9;&#9;&#9;&#9;&#9;Head.Transparency = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;player.PlayerGui.SpecialGui.Text.Text = &quot;Friendly Lockhead U-2 Circling!&quot;
&#9;&#9;&#9;&#9;player.PlayerGui.SpecialGui.GarbageMan.Disabled = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
