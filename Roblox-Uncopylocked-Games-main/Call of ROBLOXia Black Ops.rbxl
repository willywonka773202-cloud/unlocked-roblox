						<Item class="LocalScript" referent="RBX1507">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GuiScript</string>
								<ProtectedString name="Source">local Tool = script.Parent
local Ammo = Tool.GunScript.Magazine
local AmmoLeft = Tool.GunScript.AmmoLeft
local vPlayer
local Gui

function onChanged(value)
&#9;if Gui ~= nil then
&#9;&#9;if Ammo.Value &gt;= 1 then
&#9;&#9;&#9;Gui.Frame.Ammo.FontSize = &quot;Size48&quot;
&#9;&#9;&#9;Gui.Frame.Ammo.Text = string.rep(&quot;-&quot;, Ammo.Value)
&#9;&#9;&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;&#9;elseif math.floor(Ammo.Value) &lt;= 0 then
&#9;&#9;&#9;Gui.Frame.Ammo.FontSize = &quot;Size18&quot;
&#9;&#9;&#9;if AmmoLeft.Value == 0 then
&#9;&#9;&#9;&#9;Gui.Frame.Ammo.Text = &quot;No More Ammo&quot;&#9;&#9;&#9;&#9;&#9;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;Gui.Frame.Ammo.Text = &quot;Reloading...&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;&#9;end
&#9;end
end

function setUpGui()
&#9;if vPlayer == nil or vPlayer:findFirstChild(&quot;PlayerGui&quot;) == nil then
&#9;&#9;return
&#9;end

&#9;Gui = game.Lighting.GunGui:clone()

&#9;Gui.Name = &quot;CrossbowGui&quot;
&#9;Gui.Parent = vPlayer.PlayerGui

&#9;Gui.Frame.Ammo.Text = string.rep(&quot;-&quot;, Ammo.Value)
&#9;Gui.Frame.Ammo.FontSize = &quot;Size48&quot;
&#9;Gui.Frame.AmmoText.Text = &quot;&quot;..tostring(Ammo.Value)..&quot;/&quot;..tostring(AmmoLeft.Value)..&quot;&quot;
&#9;Gui.Frame.GunImage.Image = &quot;http://www.roblox.com/asset/?id=49153627&quot;
&#9;Gui.Frame.GunImage.Size = UDim2.new(0, 181, 0, 50)
end

function onEquippedLocal(mouse)
&#9;vPlayer = game.Players.LocalPlayer

&#9;setUpGui()
end

function onUnequippedLocal(mouse)
&#9;if Gui then
&#9;&#9;Gui:remove()
&#9;end

&#9;Gui = nil
&#9;vPlayer = nil
end

Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
AmmoLeft.Changed:connect(onChanged)
Ammo.Changed:connect(onChanged)</ProtectedString>
							</Properties>
						</Item>
						<Item class="LocalScript" referent="RBX1508">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Crouch</string>
								<ProtectedString name="Source">on = 0
Tool = script.Parent
welds = {}
sh = {}
arms = nil
torso = nil
f = nil

function Crouch(ison)
&#9;if arms == nil and torso == nil then
&#9;&#9;arms = {Tool.Parent:FindFirstChild(&quot;Left Leg&quot;), Tool.Parent:FindFirstChild(&quot;Right Leg&quot;)}
&#9;&#9;torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;end
&#9;if arms ~= nil and torso ~= nil then
&#9;&#9;sh = {torso:FindFirstChild(&quot;Left Hip&quot;), torso:FindFirstChild(&quot;Right Hip&quot;)}
&#9;&#9;if sh ~= nil then
&#9;&#9;&#9;local yes = true
&#9;&#9;&#9;if yes then
&#9;&#9;&#9;&#9;yes = false
&#9;&#9;&#9;&#9;if ison == 1 then
&#9;&#9;&#9;&#9;&#9;Tool.Parent.Humanoid.WalkSpeed = 9
&#9;&#9;&#9;&#9;&#9;sh[1].Part1 = nil
&#9;&#9;&#9;&#9;&#9;sh[2].Part1 = nil
&#9;&#9;&#9;&#9;&#9;local weld1 = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;&#9;weld1.Part0 = torso
&#9;&#9;&#9;&#9;&#9;weld1.Parent = torso
&#9;&#9;&#9;&#9;&#9;weld1.Part1 = arms[1]
&#9;&#9;&#9;&#9;&#9;weld1.C1 = CFrame.new(-0.5, 0.75, 1)
&#9;&#9;&#9;&#9;&#9;arms[1].Name = &quot;LDave&quot;
&#9;&#9;&#9;&#9;&#9;arms[1].CanCollide = true
&#9;&#9;&#9;&#9;&#9;welds[1] = weld1
&#9;&#9;&#9;&#9;&#9;-------------------------------------------
&#9;&#9;&#9;&#9;&#9;local weld2 = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;&#9;&#9;weld2.Part0 = torso
&#9;&#9;&#9;&#9;&#9;weld2.Parent = torso
&#9;&#9;&#9;&#9;&#9;weld2.Part1 = arms[2]
&#9;&#9;&#9;&#9;&#9;weld2.C1 = CFrame.new(0.5,0.495,1.25) * CFrame.fromEulerAnglesXYZ(math.rad(90),0,0)
&#9;&#9;&#9;&#9;&#9;arms[2].Name = &quot;RDave&quot;
&#9;&#9;&#9;&#9;&#9;arms[2].CanCollide = true
&#9;&#9;&#9;&#9;&#9;welds[2] = weld2
&#9;&#9;&#9;&#9;&#9;---------------------------------
&#9;&#9;&#9;&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;&#9;&#9;force.Parent = torso
&#9;&#9;&#9;&#9;&#9;f = force
&#9;&#9;&#9;&#9;&#9;wait(0.01)
&#9;&#9;&#9;&#9;elseif ison == 0 then
&#9;&#9;&#9;&#9;&#9;if arms then
&#9;&#9;&#9;&#9;&#9;&#9;Tool.Parent.Humanoid.WalkSpeed = 18
&#9;&#9;&#9;&#9;&#9;&#9;sh[1].Part1 = arms[1]
&#9;&#9;&#9;&#9;&#9;&#9;sh[2].Part1 = arms[2]
&#9;&#9;&#9;&#9;&#9;&#9;f.Parent = nil
&#9;&#9;&#9;&#9;&#9;&#9;arms[2].Name = &quot;Right Leg&quot;
&#9;&#9;&#9;&#9;&#9;&#9;arms[1].Name = &quot;Left Leg&quot;
&#9;&#9;&#9;&#9;&#9;&#9;welds[1].Parent = nil
&#9;&#9;&#9;&#9;&#9;&#9;welds[2].Parent = nil
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;print(&quot;sh&quot;)
&#9;&#9;end
&#9;else
&#9;print(&quot;arms&quot;)
&#9;end
end

function Key(key)
&#9;if key then
&#9;&#9;key = string.lower(key)
&#9;&#9;if (key==&quot;c&quot;) then
&#9;&#9;&#9;if on == 1 then
&#9;&#9;&#9;&#9;on = 0
&#9;&#9;&#9;elseif on == 0 then
&#9;&#9;&#9;&#9;on = 1
&#9;&#9;&#9;end
&#9;&#9;&#9;Crouch(on)
&#9;&#9;end
&#9;end
end

function Equip(mouse)
&#9;mouse.KeyDown:connect(Key)
end
script.Parent.Equipped:connect(Equip)

</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX1509">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Trail</string>
								<ProtectedString name="Source">-- this part makes the brick draw:
lastpoint = Vector3.new(0, 0, 0)
leds = {}
debris = game:GetService(&quot;Debris&quot;)
function makeled()
&#9;tip = script.Parent
&#9;if tip~= nil then
&#9;&#9;off = (tip.Mesh.Scale.z/tip.Size.z)/2
&#9;&#9;point = (tip.CFrame*CFrame.new(0, 0, -off)).p
&#9;&#9;unit = (lastpoint - point).unit
&#9;&#9;mag = (lastpoint - point).magnitude
&#9;&#9;if mag&gt;1 then
&#9;&#9;&#9;middle = lastpoint-(unit*(mag/2))
&#9;&#9;&#9;cf = CFrame.new(middle, point)
&#9;&#9;&#9;local l = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;l.Name = &quot;Led&quot;
&#9;&#9;&#9;l.Anchored = true
&#9;&#9;&#9;l.CanCollide = false
&#9;&#9;&#9;l.Transparency = 0.5
&#9;&#9;&#9;l.Reflectance = 0.25
&#9;&#9;&#9;l.Size = Vector3.new(1, 1, mag)
&#9;&#9;&#9;l.BrickColor = tip.BrickColor
&#9;&#9;&#9;l.TopSurface = 0
&#9;&#9;&#9;l.BottomSurface = 0
&#9;&#9;&#9;debris:AddItem(l, 3)
&#9;&#9;&#9;local m=  Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;&#9;m.MeshType = &quot;Brick&quot;
&#9;&#9;&#9;m.Scale = Vector3.new(.3, .3, mag)/l.Size
&#9;&#9;&#9;m.Parent = l
&#9;&#9;&#9;l.Parent = workspace
&#9;&#9;&#9;l.CFrame = cf
&#9;&#9;&#9;table.insert(leds, l)
&#9;&#9;&#9;lastpoint = point
&#9;&#9;end
&#9;end
end
function fade()
&#9;for i, v in pairs(leds) do
&#9;&#9;if v~= nil then
&#9;&#9;&#9;v.Transparency = v.Transparency+.02
&#9;&#9;&#9;if v.Transparency&gt;1 then
&#9;&#9;&#9;&#9;v:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
wait(0.1)
while true do
&#9;if script.Parent.Stuck.Value == false then
&#9;&#9;makeled()
&#9;end
&#9;wait(.004)
&#9;fade()
end






</ProtectedString>
