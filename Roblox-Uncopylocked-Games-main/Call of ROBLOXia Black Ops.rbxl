							<string name="Name">Script</string>
							<ProtectedString name="Source">Player = script.Parent.Parent.Parent.Character
s = Player.Humanoid


function Changed(Health)
&#9;if s.Health &gt;= 75 then
&#9;&#9;script.Parent.Health1.Visible = false
&#9;&#9;script.Parent.Health2.Visible = false
&#9;&#9;script.Parent.Health3.Visible = false
&#9;elseif s.Health &gt;= 50 then
&#9;&#9;script.Parent.Health1.Visible = true
&#9;&#9;script.Parent.Health2.Visible = false
&#9;&#9;script.Parent.Health3.Visible = false
&#9;elseif s.Health &gt;= 25 then
&#9;&#9;script.Parent.Health1.Visible = true
&#9;&#9;script.Parent.Health2.Visible = true
&#9;&#9;script.Parent.Health3.Visible = false
&#9;elseif s.Health &gt;= 0 then
&#9;&#9;script.Parent.Health1.Visible = true
&#9;&#9;script.Parent.Health2.Visible = true
&#9;&#9;script.Parent.Health3.Visible = true
&#9;end
end

s.Changed:connect(Changed)</ProtectedString>
