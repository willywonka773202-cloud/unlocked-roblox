						<Item class="Script" referent="RBX765">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GunScript</string>
								<ProtectedString name="Source">Tool = script.Parent;
debris = game:GetService(&quot;Debris&quot;)
local Magazine = script.Magazine
enabled = true
---------------------------------- START FIRING

function fire(v)
&#9;if Tool.Parent.CanFire.Value == false then return end

 &#9;if Magazine.Value == 0 then return end
&#9;Magazine.Value = Magazine.Value - 1

&#9;if Tool.Parent:findFirstChild(&quot;Ninja&quot;) == nil then
&#9;&#9;Tool.Handle.Fire:play()
&#9;end

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local missile = Instance.new(&quot;Part&quot;)        

&#9;local spawnPos = vCharacter.PrimaryPart.Position

&#9;spawnPos  = spawnPos + (v * 8)

&#9;missile.Position = spawnPos
&#9;missile.Size = Vector3.new(1,1,1)
&#9;missile.Velocity = v * 98
&#9;missile.BrickColor = BrickColor.new(&quot;Dark stone grey&quot;)
&#9;missile.Shape = 0
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;Shell&quot;
&#9;missile.Elasticity = 0
&#9;missile.Reflectance = 0.2
&#9;missile.Friction = 0.3

&#9;missile.CFrame = CFrame.new(spawnPos, spawnPos + v) * CFrame.Angles(0, 0, math.pi/2)

   local new_Mesh = script.Parent.Mesh:clone()
   new_Mesh.Parent = missile   

&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,80,0) 
&#9;Recoil = Vector3.new(math.random(-5,5), 0, 0)
&#9;if Tool.Parent.Attachment.Value == &quot;Grip&quot; then
&#9;&#9;Recoil = Recoil * Vector3.new(0.65,0.65,0)
&#9;end
&#9;if Tool.Parent:findFirstChild(&quot;SteadyAim&quot;) ~= nil then
&#9;&#9;Recoil = Recoil * Vector3.new(0.65,0.65,0)
&#9;end
&#9;force.force = force.force + Recoil
&#9;force.Parent = missile

&#9;local new_script = script.Parent.Knife:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile

&#9;local new_script2 = script.Parent.Knife2:clone()
&#9;new_script2.Disabled = false
&#9;new_script2.Parent = missile

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;
&#9;missile.Parent = game.Workspace

   Tool.A1.Transparency = 1
   Tool.A2.Transparency = 1
   Tool.A3.Transparency = 1
   Tool.B1.Transparency = 0
   Tool.B2.Transparency = 0
   Tool.B3.Transparency = 0&#9;&#9; 
&#9;wait(0.025)
   Tool.C1.Transparency = 1
   Tool.C2.Transparency = 1
   Tool.C3.Transparency = 1
   Tool.C4.Transparency = 1
   Tool.C5.Transparency = 1
   Tool.C6.Transparency = 1
   Tool.C7.Transparency = 1
   Tool.C8.Transparency = 1
   Tool.C9.Transparency = 1
&#9;Tool.C10.Transparency = 1
   Tool.C11.Transparency = 1
   Tool.C12.Transparency = 1
   Tool.C13.Transparency = 1
   Tool.C14.Transparency = 1
   Tool.C15.Transparency = 1
   Tool.C16.Transparency = 1
   Tool.C17.Transparency = 1
   Tool.C18.Transparency = 1
&#9;wait(0.025)
end

---------------------------------- END FIRING

function onActivated()
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit

&#9;fire(lookAt)

&#9;wait(0.2)

&#9;enabled = true

end

function onEquipped()
&#9;Humanoid = Tool.Parent.Humanoid
&#9;Humanoid.WalkSpeed = 18
end

function onUnequipped()
&#9;Humanoid.WalkSpeed = 16
end

script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
script.Parent.Activated:connect(onActivated)</ProtectedString>
