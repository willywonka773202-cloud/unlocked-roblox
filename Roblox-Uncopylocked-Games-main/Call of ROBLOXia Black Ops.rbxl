function Reload()
&#9;if Magazine.Value &lt; MaxAmmo.Value and Tool.Enabled == true and Tool.GunScript.Reload.Value == true and AmmoLeft.Value &gt;= 1 then
&#9;&#9;Tool.Enabled = false
&#9;&#9;ReloadSequence()
&#9;&#9;if AmmoLeft.Value &gt;= MaxAmmo.Value then
&#9;&#9;&#9;AmmoLeft.Value = AmmoLeft.Value - MaxAmmo.Value + Magazine.Value
&#9;&#9;&#9;Magazine.Value = MaxAmmo.Value
&#9;&#9;elseif AmmoLeft.Value &lt; MaxAmmo.Value and AmmoLeft.Value &gt;= 1 then
&#9;&#9;&#9;Magazine.Value = AmmoLeft.Value 
&#9;&#9;&#9;AmmoLeft.Value = 0
&#9;&#9;end
&#9;&#9;Tool.Enabled = true
&#9;end
&#9;Tool.GunScript.Reload.Value = false
end

function SpecialReload()
&#9;if  Tool.Enabled == true and Tool.GunScript.SpecialReload.Value == true then
&#9;&#9;Tool.Enabled = false
&#9;&#9;Pump()
&#9;&#9;Tool.Enabled = true
&#9;end
&#9;Tool.GunScript.SpecialReload.Value = false
end
