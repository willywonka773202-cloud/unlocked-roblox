						<Item class="Script" referent="RBX4075">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Calling</string>
								<ProtectedString name="Source">local Rocket = Instance.new(&quot;Part&quot;)
local Tool = script.Parent

Rocket.CanCollide = false
Rocket.Locked = true
Rocket.BackSurface = 0
Rocket.BottomSurface = 0
Rocket.FrontSurface = 0
Rocket.LeftSurface = 0
Rocket.RightSurface = 0
Rocket.TopSurface = 0
Rocket.Size = Vector3.new(1,1,4)
Rocket.BrickColor = BrickColor.new(23)

Tool.RocketScript:clone().Parent = Rocket
Tool.Explosion:clone().Parent = Rocket

function create_misile(targetPos, vHandle, vPlayer, Mesh)
&#9;vTarget = targetPos + Vector3.new(math.random(-50, 50), 0, math.random(-50,50))

&#9;local dir = vTarget - vHandle.Position - Vector3.new(0, 100, 0)

&#9;dir = computeDirection(dir)

&#9;local pos = vHandle.Position + (dir * 6) + Vector3.new(0, 100, 0)
&#9;
&#9;local missile = Rocket:clone()
&#9;missile.CFrame = CFrame.new(pos,  pos + dir)

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;Mesh:clone().Parent = missile
&#9;return missile
end

function fire(targetPos)
&#9;Tool.Handle.Fire:play()
&#9;local vCharacter = Tool.Parent;
&#9;
&#9;local vHandle = Tool:findFirstChild(&quot;Handle&quot;)
&#9;if vHandle == nil then
&#9;&#9;print(&quot;Handle not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;if vPlayer == nil then
&#9;&#9;print(&quot;Player not found&quot;)
&#9;end
&#9;
&#9;local Mesh = Tool.Mesh

&#9;script.Parent:remove()
&#9;vPlayer.PlayerGui.SpecialGui.Text.Text = &quot;Sending In a B-52 Bomber...&quot;
&#9;vPlayer.PlayerGui.SpecialGui.GarbageMan.Disabled = false
&#9;wait(5)
&#9;local players = game.Players:children() 
&#9;x = math.random(1,5)
&#9;for i = 1, #players do 
&#9;&#9;if players[i].TeamColor == vPlayer.TeamColor then
&#9;&#9;&#9;if x == 1 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Friendly Rolling Thunder Deployed!&quot;
&#9;&#9;&#9;elseif x == 2 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Friendly B-52 Bomber Above!&quot;
&#9;&#9;&#9;elseif x == 3 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Friendly Carpet Bomb Incoming!&quot;
&#9;&#9;&#9;elseif x == 4 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Friendly Carpet Bomb Deployed!&quot;
&#9;&#9;&#9;elseif x == 5 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Friendly Rolling Thunder Incoming!&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.GarbageMan.Disabled = false
&#9;&#9;else
&#9;&#9;&#9;if x == 1 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Hostile B-52 Bomber Above!&quot;
&#9;&#9;&#9;elseif x == 2 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Enemy B-52 Bomber Above!&quot;
&#9;&#9;&#9;elseif x == 3 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Hostile Carpet Bomb Deployed!&quot;
&#9;&#9;&#9;elseif x == 4 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Enemy Carpet Bomb Deployed!&quot;
&#9;&#9;&#9;elseif x == 5 then
&#9;&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.Text.Text = &quot;Hostile Rolling Thunder Incoming!&quot;
&#9;&#9;&#9;end
&#9;&#9;&#9;players[i].PlayerGui.SpecialGui.GarbageMan.Disabled = false
&#9;&#9;end
&#9;end
&#9;for i = 1, math.random(15,25) do
&#9;&#9;missile = create_misile(targetPos, vHandle, vPlayer, Mesh)
&#9;&#9;missile.RocketScript.Disabled = false
&#9;&#9;missile.Parent = game.Workspace
&#9;&#9;wait(0.5)
&#9;end
end

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

Tool.Enabled = true
function onActivated()
&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint

&#9;fire(targetPos)
end

script.Parent.Activated:connect(onActivated)

</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX4076">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">RocketScript</string>
								<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)

shaft = script.Parent
position = shaft.Position

script.Parent.Explosion.PlayOnRemove = true -- play explosion sound when projectile removed from game

function smoke(size, ahe)
&#9;p = Instance.new(&quot;Part&quot;)
&#9;p.Anchored = true
&#9;p.CanCollide = false
&#9;p.TopSurface = 0
&#9;p.BottomSurface = 0
&#9;m = 1
&#9;p.CFrame = CFrame.new(script.Parent.Position + (script.Parent.CFrame.lookVector * ahe) + Vector3.new(math.random(-m,m),math.random(-m,m),math.random(-m,m)))
&#9;p.Shape = &quot;Ball&quot;
&#9;p.Size = Vector3.new(size,size,size)
&#9;smo = script.SmokeScript:clone()
&#9;smo.Parent = p
&#9;p.Parent = game.Workspace
end

function fly()
&#9;direction = shaft.CFrame.lookVector 
&#9;position = position + direction * 8
&#9;error = position - shaft.Position
&#9;shaft.Velocity = 7*error
end

function blow(hit)
&#9;if hit.CanCollide == false then return end
&#9;if hit.Parent == nil then return end
&#9;if hit.Transparency == 1 then return end

&#9;shaft.Anchored = true
&#9;script.Parent.Explosion:remove()
&#9;connection:disconnect()
&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.Position = shaft.Position
&#9;explosion.BlastRadius = 20

&#9;local creator = script.Parent:findFirstChild(&quot;creator&quot;)
&#9;if creator ~= nil then
&#9;&#9;explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
&#9;end

&#9;explosion.Parent = game.Workspace
&#9;connection:disconnect()
&#9;shaft:remove()
end

function onPlayerBlownUp(part, distance, creator)
&#9;if part.Name == &quot;Head&quot; then
&#9;&#9;local humanoid = part.Parent.Humanoid
&#9;&#9;tagHumanoid(humanoid, creator)
&#9;end
end

function tagHumanoid(humanoid, creator)&#9;
&#9;if creator ~= nil then
&#9;&#9;local new_tag = creator:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;local mortar = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;mortar.Name = &quot;Mortar&quot;
&#9;&#9;mortar.Parent = new_tag
&#9;&#9;wait()
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end
connection = shaft.Touched:connect(blow)

t = 30

while shaft ~= nil do
&#9;fly()
&#9;smoke(2, -4)
&#9;wait(.1)
&#9;t = t - .1
&#9;if t == 0 then
&#9;&#9;script.Parent.Explosion.PlayOnRemove = false
&#9;&#9;shaft:remove()
&#9;end
end</ProtectedString>
							</Properties>
							<Item class="Script" referent="RBX4077">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">SmokeScript</string>
									<ProtectedString name="Source">wait(2)

for i = 1, 10 do
&#9;script.Parent.Transparency = script.Parent.Transparency + 0.1
&#9;script.Parent.CFrame = CFrame.new(script.Parent.Position + Vector3.new(math.random(-i * 0.1,i * 0.1), i * 0.1, math.random(-i * 0.1,i * 0.1)))
&#9;wait(0.1)
end

script.Parent:Remove()</ProtectedString>
