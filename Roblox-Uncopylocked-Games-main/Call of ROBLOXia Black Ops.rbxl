&#9;if Team == &quot;BO&quot; then
&#9;&#9;x = math.random(1,2)
&#9;&#9;if x == 1 then
&#9;&#9;&#9;game.Lighting.Uniform.BO1:findFirstChild(&quot;Shirt&quot;):Clone().Parent = Character
