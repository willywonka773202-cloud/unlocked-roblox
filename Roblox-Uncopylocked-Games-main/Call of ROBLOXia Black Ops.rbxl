&#9;&#9;if sh ~= nil then
&#9;&#9;&#9;local yes = true
&#9;&#9;&#9;if yes then
&#9;&#9;&#9;&#9;yes = false
&#9;&#9;&#9;&#9;sh[1].Part1 = nil
&#9;&#9;&#9;&#9;sh[2].Part1 = nil
&#9;&#9;&#9;&#9;falsearm1 = arms[1]:clone()
