							<string name="Name">BombScript</string>
							<ProtectedString name="Source">debris = game:GetService(&quot;Debris&quot;)
Bomb = script.Parent.Parent
Bomb.Name = &quot;Defused Bomb&quot;
ClosedLaptop = Bomb.ClosedLaptop
OpenLaptop = Bomb.Laptop
OpenLaptop.Parent = nil
Armed = Bomb.Armed
Percent = 0
a = false

function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function findCharacter(pos, Character, Name)
&#9;if Character:findFirstChild(&quot;Torso&quot;) ~= nil and (Character.Torso.Position - pos).magnitude &lt;= 10 then
&#9;&#9;return Character
&#9;else
&#9;&#9;a = false
