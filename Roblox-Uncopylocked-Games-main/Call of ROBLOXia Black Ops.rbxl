						<Item class="LocalScript" referent="RBX1766">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Local Gui</string>
								<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false

&#9;wait(.1)
&#9;enabled = true

end

function KeyDownFunctions(key)
&#9;if key == &quot;r&quot; then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;elseif key == &quot;f&quot; then
&#9;&#9;if Tool.Mode.Value == &quot;Normal&quot; then
&#9;&#9;&#9;if Tool.Parent.Attachment.Value == &quot;Masterkey&quot; then
&#9;&#9;&#9;&#9;Tool.Mode.Value = &quot;Masterkey&quot;
&#9;&#9;&#9;&#9;Tool.Name = &quot;Masterkey&quot;
&#9;&#9;&#9;elseif Tool.Parent.Attachment.Value == &quot;Grenade&quot; then
&#9;&#9;&#9;&#9;Tool.Mode.Value = &quot;Grenade&quot;
&#9;&#9;&#9;&#9;Tool.Name = &quot;Grenade&quot;
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;Tool.Mode.Value = &quot;Normal&quot;
&#9;&#9;&#9;Tool.Name = &quot;M16&quot;
&#9;&#9;end
&#9;elseif key == &quot;v&quot; then
&#9;&#9;if Tool.Parent.CanFire.Value == true then 
&#9;&#9;&#9;Tool.GunScript.Knife.Value = true
&#9;&#9;end
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=49989240&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(KeyDownFunctions)
end


Tool.Equipped:connect(onEquippedLocal)
