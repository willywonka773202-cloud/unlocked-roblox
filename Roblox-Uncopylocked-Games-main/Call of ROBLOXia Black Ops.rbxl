&#9;&#9;&#9;&#9;New_Script = game.Lighting.Tools.Scripts:findFirstChild(&quot;AUG(Masterkey)&quot;):clone()
&#9;&#9;&#9;&#9;New_Script.Parent = New_Primary
&#9;&#9;&#9;&#9;New_Script.Name = &quot;GunScript2&quot;
&#9;&#9;&#9;&#9;New_Script.Disabled = false
&#9;&#9;&#9;elseif New_Primary.Name == &quot;Commando&quot; then
&#9;&#9;&#9;&#9;New_Script = game.Lighting.Tools.Scripts:findFirstChild(&quot;Commando(Masterkey)&quot;):clone()
&#9;&#9;&#9;&#9;New_Script.Parent = New_Primary
&#9;&#9;&#9;&#9;New_Script.Name = &quot;GunScript2&quot;
&#9;&#9;&#9;&#9;New_Script.Disabled = false
&#9;&#9;&#9;elseif New_Primary.Name == &quot;M16&quot; then
&#9;&#9;&#9;&#9;New_Script = game.Lighting.Tools.Scripts:findFirstChild(&quot;M16(Masterkey)&quot;):clone()
&#9;&#9;&#9;&#9;New_Script.Parent = New_Primary
&#9;&#9;&#9;&#9;New_Script.Name = &quot;GunScript2&quot;
&#9;&#9;&#9;&#9;New_Script.Disabled = false
&#9;&#9;&#9;end
&#9;&#9;elseif Player.Inventory.Attachment.Value == &quot;Extended Mag&quot; then
&#9;&#9;&#9;Player.Character.Attachment.Value = &quot;Extended Mag&quot;
&#9;&#9;&#9;New_Script = game.Lighting.Tools.Scripts.ExtendedMag:clone()
&#9;&#9;&#9;New_Script.Parent = Player.Character
&#9;&#9;&#9;New_Script.Disabled = false
&#9;&#9;elseif Player.Inventory.Attachment.Value == &quot;Suppressor&quot; then
&#9;&#9;&#9;Player.Character.Attachment.Value = &quot;Suppressor&quot;
&#9;&#9;&#9;New_Script = game.Lighting.Tools.Scripts.Suppressor:clone()
&#9;&#9;&#9;New_Script.Parent = Player.Character
&#9;&#9;&#9;New_Script.Disabled = false
&#9;&#9;elseif Player.Inventory.Attachment.Value == &quot;Grip&quot; then
&#9;&#9;&#9;Player.Character.Attachment.Value = &quot;Grip&quot;
&#9;&#9;elseif Player.Inventory.Attachment.Value == &quot;Rapid Fire&quot; then
&#9;&#9;&#9;Player.Character.Attachment.Value = &quot;Rapid Fire&quot;
&#9;&#9;&#9;New_Script = game.Lighting.Tools.Scripts:findFirstChild(&quot;Rapid Fire&quot;):clone()
&#9;&#9;&#9;New_Script.Parent = Player.Character
&#9;&#9;end
&#9;&#9;if Player.Inventory.Equipment.Value ~= nil then
&#9;&#9;&#9;New_Equipment = Player.Inventory.Equipment.Value:clone()
&#9;&#9;&#9;New_Equipment.Parent = Player.Backpack
&#9;&#9;end
&#9;&#9;if Player.Inventory.Killstreak.Value ~= nil then
&#9;&#9;&#9;New_Script = Player.Inventory.Killstreak.Value:clone()
&#9;&#9;&#9;New_Script.Parent = Player.Character
&#9;&#9;&#9;New_Script.Disabled = false
&#9;&#9;end
&#9;&#9;telePlayer(Player.Character.Torso)
&#9;&#9;debris:AddItem(Player.Character.ForceField, 5)
&#9;&#9;Frame.Parent:remove()
&#9;elseif SubMenu.Value == &quot;Submachine Guns&quot; or SubMenu.Value == &quot;Assault Rifles&quot; or SubMenu.Value == &quot;Shotguns&quot; or SubMenu.Value == &quot;Light Machine Guns&quot; or SubMenu.Value == &quot;Sniper Rifles&quot; then
&#9;&#9;SubMenu.Value = &quot;Primary&quot;
&#9;else
&#9;&#9;SubMenu.Value = &quot;Main&quot;
&#9;end
end

