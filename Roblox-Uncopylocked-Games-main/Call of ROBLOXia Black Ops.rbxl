&#9;&#9;end
&#9;&#9;wait(.015)
&#9;&#9;weld55.C1 = CFrame.new(-0.15, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(300), 0.05, math.rad(-90))
&#9;&#9;wait(.015)
&#9;&#9;weld55.C1 = CFrame.new(-0.15, 1.2, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(300), 0, math.rad(-90))
