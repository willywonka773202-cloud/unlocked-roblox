&#9;&#9;Player.Inventory.Secondary.Value:clone().Parent = Player.Backpack
&#9;&#9;if Player.Inventory.Grenade.Value ~= nil then
&#9;&#9;&#9;Player.Inventory.Grenade.Value:clone().Parent = Player.Backpack
&#9;&#9;end
&#9;&#9;if Player.Inventory.Perk1.Value ~= nil then
&#9;&#9;&#9;New_Script = Player.Inventory.Perk1.Value:clone()
