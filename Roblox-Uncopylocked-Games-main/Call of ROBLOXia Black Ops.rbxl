								<string name="Name">GunScript</string>
								<ProtectedString name="Source">Tool = script.Parent;
debris = game:GetService(&quot;Debris&quot;)
local Magazine = script.Magazine
local Grenades = 2
local Masterkeys = 4

---------------------------------- START FIRING

function fire(v)
&#9;if Tool.Parent.CanFire.Value == false then return end

&#9;if Tool.Mode.Value == &quot;Normal&quot; then

&#9;&#9;if Magazine.Value == 0 then return end
&#9;&#9;Magazine.Value = Magazine.Value - 1

&#9;&#9;if Tool.Parent:findFirstChild(&quot;Ninja&quot;) == nil then
&#9;&#9;&#9;Tool.Handle.Fire:play()
&#9;&#9;end

&#9;&#9;local vCharacter = Tool.Parent
&#9;&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;&#9;local missile = Instance.new(&quot;Part&quot;)        

&#9;&#9;local spawnPos = vCharacter.PrimaryPart.Position

&#9;&#9;spawnPos  = spawnPos + (v * 8)

&#9;&#9;missile.Position = spawnPos
&#9;&#9;missile.Size = Vector3.new(1,1,1)
&#9;&#9;missile.Velocity = v * 295
&#9;&#9;missile.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;missile.Shape = 0
&#9;&#9;missile.BottomSurface = 0
&#9;&#9;missile.TopSurface = 0
&#9;&#9;missile.Name = &quot;Shell&quot;
&#9;&#9;missile.Elasticity = 0
&#9;&#9;missile.Reflectance = 0.15
&#9;&#9;missile.Friction = 0.3

&#9;&#9;missile.CFrame = CFrame.new(spawnPos, spawnPos + v) * CFrame.Angles(0, 0, math.pi/2)

&#9;&#9;local mesh = Instance.new(&quot;BlockMesh&quot;) 
&#9;&#9;mesh.Scale = Vector3.new(0.2,0.2,3) 
&#9;&#9;mesh.Parent = missile

&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;force.force = Vector3.new(0,98,0) 
&#9;&#9;Recoil = Vector3.new(math.random(-150,150), math.random(-100,150), 0)
&#9;&#9;if Tool.Parent.Attachment.Value == &quot;Grip&quot; then
&#9;&#9;&#9;Recoil = Recoil * Vector3.new(0.65,0.65,0)
&#9;&#9;end
&#9;&#9;if Tool.Parent:findFirstChild(&quot;SteadyAim&quot;) ~= nil then
&#9;&#9;&#9;Recoil = Recoil * Vector3.new(0.65,0.65,0)
&#9;&#9;end
&#9;&#9;force.force = force.force + Recoil
&#9;&#9;force.Parent = missile
&#9;&#9;
&#9;&#9;debris:AddItem(missile, 8)

&#9;&#9;local new_script = script.Parent.BulletScript:clone()
&#9;&#9;new_script.Disabled = false
&#9;&#9;new_script.Parent = missile

&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;creator_tag.Parent = missile
&#9;&#9;
&#9;&#9;missile.Parent = game.Workspace

&#9;&#9;Tool.Flash.Mesh.Scale = Vector3.new(.75, 1.5, .75)
&#9;&#9;Tool.Flash.Transparency = .5
&#9;&#9;Tool.A1.Mesh.Offset = Vector3.new(0, 0.3, 0)
&#9;&#9;wait(0.015)
&#9;&#9;Tool.Flash.Mesh.Scale = Vector3.new(.5, 1.5, .5)
&#9;&#9;Tool.Flash.Transparency = .8
&#9;&#9;Tool.A1.Mesh.Offset = Vector3.new(0, 0.15, 0)
&#9;&#9;wait(0.015)
&#9;&#9;Tool.Flash.Transparency = 1
&#9;&#9;Tool.A1.Mesh.Offset = Vector3.new(0, 0, 0)
&#9;elseif Tool.Mode.Value == &quot;Grenade&quot; then
&#9;&#9;if Grenades == 0 then return end
&#9;&#9;Grenades = Grenades - 1
&#9;&#9;Tool.Handle.FireGrenade:play()

&#9;&#9;local vCharacter = Tool.Parent
&#9;&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;&#9;local missile = Instance.new(&quot;Part&quot;)

&#9;&#9;local spawnPos = vCharacter.PrimaryPart.Position

&#9;&#9;spawnPos  = spawnPos + (v * 8)

&#9;&#9;missile.Position = spawnPos
&#9;&#9;missile.Size = Vector3.new(1,1,1)
&#9;&#9;missile.Velocity = v * 200
&#9;&#9;missile.BrickColor = BrickColor.new(26)
&#9;&#9;missile.Shape = 0
&#9;&#9;missile.BottomSurface = 0
&#9;&#9;missile.TopSurface = 0
&#9;&#9;missile.Name = &quot;Grenade&quot;
&#9;&#9;missile.Elasticity = 0
&#9;&#9;missile.Reflectance = 0
&#9;&#9;missile.Friction = .9

&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;force.force = Vector3.new(0,50,0)
&#9;&#9;force.Parent = missile

&#9;&#9;local mesh = Instance.new(&quot;SpecialMesh&quot;)
&#9;&#9;mesh.Scale = Vector3.new(.6,.6,.6)
&#9;&#9;mesh.MeshType = &quot;Sphere&quot;
&#9;&#9;mesh.Parent = missile

&#9;&#9;local new_script = script.Parent.GrenadeScript:clone()
&#9;&#9;new_script.Disabled = false
&#9;&#9;new_script.Parent = missile

&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;creator_tag.Parent = missile
&#9;&#9;
&#9;&#9;missile.Parent = game.Workspace

&#9;&#9;if Grenades ~= 0 then
&#9;&#9;&#9;script.SpecialReload.Value = true
&#9;&#9;end
&#9;elseif Tool.Mode.Value == &quot;Masterkey&quot; then
&#9;&#9;if Masterkeys == 0 then return end
&#9;&#9;Masterkeys = Masterkeys - 1
&#9;&#9;if Tool.Parent:findFirstChild(&quot;Ninja&quot;) == nil then
&#9;&#9;&#9;Tool.Handle.FireMasterkey1:play()
&#9;&#9;&#9;Tool.Handle.FireMasterkey2:play()
&#9;&#9;end

&#9;&#9;local vCharacter = Tool.Parent
&#9;&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;&#9;local missile = Instance.new(&quot;Part&quot;)        

&#9;&#9;local spawnPos = vCharacter.PrimaryPart.Position

&#9;&#9;spawnPos  = spawnPos + (v * 8)

&#9;&#9;missile.Position = spawnPos
&#9;&#9;missile.Size = Vector3.new(1,1,1)
&#9;&#9;missile.Velocity = v * 295
&#9;&#9;missile.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;missile.Shape = 0
&#9;&#9;missile.BottomSurface = 0
&#9;&#9;missile.TopSurface = 0
&#9;&#9;missile.Name = &quot;Shell&quot;
&#9;&#9;missile.Elasticity = 0
&#9;&#9;missile.Reflectance = 0.15
&#9;&#9;missile.Friction = 0.3

&#9;&#9;missile.CFrame = CFrame.new(spawnPos, spawnPos + v) * CFrame.Angles(0, 0, math.pi/2)

&#9;&#9;local mesh = Instance.new(&quot;BlockMesh&quot;) 
&#9;&#9;mesh.Scale = Vector3.new(0.2,0.2,3) 
&#9;&#9;mesh.Parent = missile
&#9;&#9;
&#9;&#9;debris:AddItem(missile, 8)

&#9;&#9;local new_script = script.Parent.BulletScript:clone()
&#9;&#9;new_script.Disabled = false
&#9;&#9;new_script.Parent = missile

&#9;&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;creator_tag.Value = vPlayer
&#9;&#9;creator_tag.Name = &quot;creator&quot;
&#9;&#9;creator_tag.Parent = missile

&#9;&#9;for i = 1, 8 do
&#9;&#9;&#9;local missileClone = missile:clone()
&#9;&#9;&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;&#9;&#9;local fireDirect = Vector3.new(v.x + math.random(-5,5)/50,v.y + math.random(-5,5)/50,v.z + math.random(-5,5)/50)
&#9;&#9;&#9;spawnPos  = spawnPos + (fireDirect * 10)

&#9;&#9;&#9;missileClone.Position = spawnPos
&#9;&#9;&#9;missileClone.Velocity = fireDirect * 200

&#9;&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;&#9;force.force = Vector3.new(0,98,0) 
&#9;&#9;&#9;Recoil = Vector3.new(math.random(-150,150), math.random(-150,150), 0)
&#9;&#9;&#9;if Tool.Parent.Attachment.Value == &quot;Grip&quot; then
&#9;&#9;&#9;&#9;Recoil = Recoil * Vector3.new(0.65,0.65,0)
&#9;&#9;&#9;end
&#9;&#9;&#9;if Tool.Parent:findFirstChild(&quot;SteadyAim&quot;) ~= nil then
&#9;&#9;&#9;&#9;Recoil = Recoil * Vector3.new(0.65,0.65,0)
&#9;&#9;&#9;end
&#9;&#9;&#9;force.force = force.force + Recoil
&#9;&#9;&#9;force.Parent = missile
&#9;&#9;&#9;if Tool.Parent:findFirstChild(&quot;SteadyAim&quot;) ~= nil then
&#9;&#9;&#9;&#9;force.force = force.force * Vector3.new(0.65, 1, 0.65)
&#9;&#9;&#9;end
&#9;&#9;&#9;force.Parent = missileClone

&#9;&#9;&#9;missileClone.Parent = game.Workspace
&#9;&#9;
&#9;&#9;end
&#9;&#9;
&#9;&#9;missile.Parent = game.Workspace

&#9;&#9;if Masterkeys ~= 0 then
&#9;&#9;&#9;script.SpecialReload.Value = true
&#9;&#9;end
&#9;end
end

---------------------------------- END FIRING

function check(en)
---------------------------------------Function start here.
if (Tool.Enabled == false) then
return false
end--end for if!
-------------------------------
if (Tool.Enabled == true) then
return true
end
---------------------------------------Function end here.
end


Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;--Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit
&#9;local player = game.Players.LocalPlayer&#9;
&#9;if (check()) then
&#9;&#9;fire(lookAt)
&#9;&#9;wait(0.12)
&#9;&#9;onActivated()
&#9;end
&#9;return

&#9;--Tool.Enabled = true
end

function onEquipped()
&#9;Humanoid = Tool.Parent.Humanoid
&#9;Humanoid.WalkSpeed = 15
end

function onUnequipped()
&#9;Humanoid.WalkSpeed = 16
end

script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
script.Parent.Activated:connect(onActivated)</ProtectedString>
