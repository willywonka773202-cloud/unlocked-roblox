						<Item class="LocalScript" referent="RBX2574">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Local Gui</string>
								<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;wait(.2)
&#9;enabled = true

end

function KeyDownFunctions(key)
&#9;if key == &quot;r&quot; then
&#9;&#9;Tool.GunScript.Reload.Value = true
&#9;elseif key == &quot;f&quot; then
&#9;&#9;if Tool.Mode.Value == &quot;Normal&quot; then
&#9;&#9;&#9;if Tool.Parent.Attachment.Value == &quot;Masterkey&quot; then
&#9;&#9;&#9;&#9;Tool.Mode.Value = &quot;Masterkey&quot;
&#9;&#9;&#9;&#9;Tool.Name = &quot;Masterkey&quot;
&#9;&#9;&#9;elseif Tool.Parent.Attachment.Value == &quot;Grenade&quot; then
&#9;&#9;&#9;&#9;Tool.Mode.Value = &quot;Grenade&quot;
&#9;&#9;&#9;&#9;Tool.Name = &quot;Grenade&quot;
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;Tool.Mode.Value = &quot;Normal&quot;
&#9;&#9;&#9;Tool.Name = &quot;M14&quot;
&#9;&#9;end
&#9;elseif key == &quot;v&quot; then
&#9;&#9;if Tool.Parent.CanFire.Value == true then 
&#9;&#9;&#9;Tool.GunScript.Knife.Value = true
&#9;&#9;end
&#9;end
end


function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=49989240&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(KeyDownFunctions)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX2575">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">BulletScript</string>
								<ProtectedString name="Source">ball = script.Parent
damage = math.random(40,50)
debris = game:GetService(&quot;Debris&quot;)
HitSound = Instance.new(&quot;Sound&quot;)
HitSound.Name = &quot;HitSound&quot;
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=11945266&quot;
HitSound.Pitch = .5
HitSound.Parent = ball

function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function onTouched(hit)
&#9;if hit.Name == &quot;Shell&quot; then return end
&#9;HitSound:Play()
&#9;if hit.Parent == &quot;Shell&quot; then return end
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local forcefield = hit.Parent:findFirstChild(&quot;ForceField&quot;) or hit.Parent.Parent:findFirstChild(&quot;ForceField&quot;)

&#9;if humanoid ~= nil and forcefield == nil then
&#9;&#9;Player = getPlayer(humanoid)
&#9;&#9;if ball.creator.Value.TeamColor ~= Player.TeamColor then
&#9;&#9;&#9;if humanoid.Health ~= 0 then
&#9;&#9;&#9;&#9;if hit.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - (damage * 1.5)
&#9;&#9;&#9;&#9;&#9;tagHeadshot(humanoid)
&#9;&#9;&#9;&#9;end&#9;&#9;
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;connection:disconnect()
&#9;ball.Parent = nil
end

function tagHumanoid(humanoid)
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;debris:AddItem(tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end

function tagHeadshot(humanoid)
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;local headshot = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;headshot.Name = &quot;Headshot&quot;
&#9;&#9;headshot.Parent = new_tag
&#9;&#9;debris:AddItem(tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(2.5)
ball.Parent = nil</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX2576">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GunScript</string>
								<ProtectedString name="Source">Tool = script.Parent;
debris = game:GetService(&quot;Debris&quot;)
local Magazine = script.Magazine
local Grenades = 2
local Masterkeys = 4
enabled = true
---------------------------------- START FIRING

function fire(v)
&#9;if Tool.Parent.CanFire.Value == false then return end
&#9;if Tool.Mode.Value == &quot;Normal&quot; then

&#9;&#9;if Magazine.Value == 0 then return end
&#9;&#9;Magazine.Value = Magazine.Value - 1

&#9;&#9;if Tool.Parent:findFirstChild(&quot;Ninja&quot;) == nil then
&#9;&#9;&#9;Tool.Handle.Fire:play()
&#9;&#9;end

&#9;&#9;local vCharacter = Tool.Parent
&#9;&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;&#9;local missile = Instance.new(&quot;Part&quot;)        

&#9;&#9;local spawnPos = vCharacter.PrimaryPart.Position

&#9;&#9;spawnPos  = spawnPos + (v * 8)

&#9;&#9;missile.Position = spawnPos
&#9;&#9;missile.Size = Vector3.new(1,1,1)
&#9;&#9;missile.Velocity = v * 295
&#9;&#9;missile.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;missile.Shape = 0
&#9;&#9;missile.BottomSurface = 0
&#9;&#9;missile.TopSurface = 0
&#9;&#9;missile.Name = &quot;Shell&quot;
&#9;&#9;missile.Elasticity = 0
&#9;&#9;missile.Reflectance = 0.15
&#9;&#9;missile.Friction = 0.3

&#9;&#9;missile.CFrame = CFrame.new(spawnPos, spawnPos + v) * CFrame.Angles(0, 0, math.pi/2)

&#9;&#9;local mesh = Instance.new(&quot;BlockMesh&quot;) 
&#9;&#9;mesh.Scale = Vector3.new(0.2,0.2,3) 
&#9;&#9;mesh.Parent = missile

&#9;&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;&#9;force.force = Vector3.new(0,98,0) 
&#9;&#9;Recoil = Vector3.new(math.random(-50,50),math.random(-50,50), 0)
&#9;&#9;if Tool.Parent.Attachment.Value == &quot;Grip&quot; then
&#9;&#9;&#9;Recoil = Recoil * Vector3.new(0.65,0.65,0)
&#9;&#9;end
&#9;&#9;if Tool.Parent:findFirstChild(&quot;SteadyAim&quot;) ~= nil then
