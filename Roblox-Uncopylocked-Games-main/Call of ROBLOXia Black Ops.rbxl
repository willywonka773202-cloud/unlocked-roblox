						<Item class="Script" referent="RBX1048">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">BulletScript</string>
								<ProtectedString name="Source">ball = script.Parent
damage = math.random(40,50)
debris = game:GetService(&quot;Debris&quot;)
HitSound = Instance.new(&quot;Sound&quot;)
HitSound.Name = &quot;HitSound&quot;
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=11945266&quot;
HitSound.Pitch = .5
HitSound.Parent = ball

function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function onTouched(hit)
&#9;if hit.Name == &quot;Shell&quot; then return end
&#9;HitSound:Play()
&#9;if hit.Parent == &quot;Shell&quot; then return end
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local forcefield = hit.Parent:findFirstChild(&quot;ForceField&quot;) or hit.Parent.Parent:findFirstChild(&quot;ForceField&quot;)

&#9;if humanoid ~= nil and forcefield == nil then
&#9;&#9;Player = getPlayer(humanoid)
&#9;&#9;if ball.creator.Value.TeamColor ~= Player.TeamColor then
&#9;&#9;&#9;if humanoid.Health ~= 0 then
&#9;&#9;&#9;&#9;if hit.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - (damage * 1.4)
&#9;&#9;&#9;&#9;&#9;tagHeadshot(humanoid)
&#9;&#9;&#9;&#9;end&#9;&#9;
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;connection:disconnect()
&#9;ball.Parent = nil
end

function tagHumanoid(humanoid)
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;debris:AddItem(tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end

function tagHeadshot(humanoid)
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;local headshot = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;headshot.Name = &quot;Headshot&quot;
&#9;&#9;headshot.Parent = new_tag
&#9;&#9;debris:AddItem(tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(2.5)

ball.Parent = nil</ProtectedString>
