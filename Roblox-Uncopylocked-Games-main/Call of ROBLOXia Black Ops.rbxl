end

function onPlayerEntered(newPlayer)
&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;

&#9;local cash = Instance.new(&quot;IntValue&quot;)
&#9;cash.Name = &quot;Cr&quot;
&#9;cash.Value = 0

&#9;local kills = Instance.new(&quot;IntValue&quot;)
&#9;kills.Name = &quot;Kill&quot;
&#9;kills.Value = 0

&#9;local streak = Instance.new(&quot;IntValue&quot;)
&#9;streak.Name = &quot;Streak&quot;
&#9;streak.Value = 0

&#9;local purchases = Instance.new(&quot;Model&quot;)
&#9;purchases.Name = &quot;Purchases&quot;
&#9;AK = Instance.new(&quot;ObjectValue&quot;)
&#9;AK.Name = &quot;AK-47&quot;
&#9;M9 = Instance.new(&quot;ObjectValue&quot;)
&#9;M9.Name = &quot;M9&quot;

&#9;local killed = Instance.new(&quot;Model&quot;)
&#9;killed.Name = &quot;Killed&quot;

&#9;local inventory = game.Lighting.Uniform.Inventory:clone()
&#9;inventory.Primary.Value = game.Lighting.Tools:findFirstChild(&quot;AK-47&quot;)
&#9;inventory.Secondary.Value = game.Lighting.Tools:findFirstChild(&quot;M9&quot;)

&#9;cash.Parent = stats
&#9;kills.Parent = stats
&#9;streak.Parent = stats
&#9;stats.Parent = newPlayer
&#9;purchases.Parent = newPlayer
&#9;AK.Parent = purchases
&#9;M9.Parent = purchases
&#9;killed.Parent = newPlayer
&#9;inventory.Parent = newPlayer

&#9;newPlayer.Changed:connect(function (property)
&#9;&#9;if (property == &quot;Character&quot;) then
&#9;&#9;&#9;onPlayerRespawned(newPlayer)
&#9;&#9;end
&#9;end)
end

game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
