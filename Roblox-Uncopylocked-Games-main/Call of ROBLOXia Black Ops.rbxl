						<Item class="Script" referent="RBX4320">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">ResetScript</string>
								<ProtectedString name="Source">function onButtonClicked()
&#9;script.Parent.Parent.Parent.Parent.Character.Humanoid.Health = 0
&#9;x = math.random(1,4)
&#9;if x == 1 then
&#9;&#9;workspace.Hint.Text = &quot;&quot;..script.Parent.Parent.Parent.Parent.Character.Name..&quot; commited suicide&quot;
&#9;elseif x == 2 then
&#9;&#9;workspace.Hint.Text = &quot;LOL! &quot;..script.Parent.Parent.Parent.Parent.Character.Name..&quot; commited suicide&quot;
&#9;elseif x == 3 then
&#9;&#9;workspace.Hint.Text = &quot;&quot;..script.Parent.Parent.Parent.Parent.Character.Name..&quot; reseted&quot;
&#9;elseif x == 4 then
&#9;&#9;workspace.Hint.Text = &quot;&quot;..script.Parent.Parent.Parent.Parent.Character.Name..&quot; clicked reset&quot;
&#9;end
end

script.Parent.MouseButton1Click:connect(onButtonClicked)
</ProtectedString>
