									<string name="Name">AmmoLeft</string>
									<double name="Value">12</double>
								</Properties>
							</Item>
							<Item class="BoolValue" referent="RBX143">
								<Properties>
									<string name="Name">Reload</string>
									<bool name="Value">false</bool>
								</Properties>
