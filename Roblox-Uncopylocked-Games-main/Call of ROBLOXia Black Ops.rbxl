							<string name="Name">TeamDeathMatchScript</string>
							<ProtectedString name="Source">while script.Disabled == false do
 &#9;local BlackopsKill = 0
 &#9;local SpetsnazKill = 0
&#9;local player = game.Players:getPlayers() 
&#9;for i = 1, #player do 
&#9;&#9;if player[i].TeamColor == BrickColor.new(&quot;Bright blue&quot;) then
&#9;&#9;&#9;BlackopsKill = BlackopsKill + player[i].leaderstats.Kill.Value
&#9;&#9;elseif player[i].TeamColor == BrickColor.new(&quot;Bright red&quot;) then
&#9;&#9;&#9;SpetsnazKill = SpetsnazKill + player[i].leaderstats.Kill.Value
&#9;&#9;end
&#9;end
&#9;workspace.BOScore.Value = BlackopsKill
&#9;workspace.SpetsScore.Value = SpetsnazKill
&#9;wait(5)
end
