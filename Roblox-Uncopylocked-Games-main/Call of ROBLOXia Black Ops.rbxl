&#9;weld33.C1 = CFrame.new(-0.75, -0.4, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-60), math.rad(-15), 0)
&#9;knife:remove()
&#9;connection:disconnect()
&#9;wait(.025)
