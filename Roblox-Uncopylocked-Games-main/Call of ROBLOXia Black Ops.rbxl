						<Item class="Script" referent="RBX902">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Knife</string>
								<ProtectedString name="Source">debris = game:GetService(&quot;Debris&quot;)
arrow = script.Parent
damage = 135 
local stuck = Instance.new(&quot;BoolValue&quot;)
stuck.Name = &quot;Stuck&quot;
stuck.Parent = arrow
stuck.Value = false

local HitSound = Instance.new(&quot;Sound&quot;)
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=11113679&quot;
HitSound.Parent = arrow
HitSound.Volume = .5

function getPlayer(humanoid) 
&#9;local players = game.Players:children() 
&#9;for i = 1, #players do 
&#9;&#9;if players[i].Character.Humanoid == humanoid then 
&#9;&#9;&#9;return players[i] 
&#9;&#9;end 
&#9;end 
&#9;return nil 
end 

function stick(hit)
&#9;local weld = Instance.new(&quot;Weld&quot;)

&#9;weld.Part0 = arrow
&#9;weld.Part1 = hit

&#9;local HitPos = arrow.Position

&#9;local CJ = CFrame.new(HitPos)
&#9;local C0 = arrow.CFrame:inverse() *CJ
&#9;local C1 = hit.CFrame:inverse() * CJ
&#9;
&#9;weld.C0 = C0
&#9;weld.C1 = C1

&#9;weld.Parent = arrow
end

function onTouched(hit)
&#9;
&#9;if hit.Parent == nil then return end
&#9;if hit.Name == &quot;Led&quot; then return end
&#9;if hit.Parent.className == &quot;Tool&quot; then return end
&#9;if stuck.Value == false then
&#9;&#9;stuck.Value = true
&#9;&#9;HitSound:Play()

&#9;&#9;humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;local forcefield = hit.Parent:findFirstChild(&quot;ForceField&quot;) or hit.Parent.Parent:findFirstChild(&quot;ForceField&quot;)

&#9;&#9;if humanoid ~= nil and forcefield == nil then
&#9;&#9;&#9;Player = getPlayer(humanoid)
&#9;&#9;&#9;if arrow.creator.Value.TeamColor ~= Player.TeamColor then
&#9;&#9;&#9;&#9;if humanoid.Health ~= 0 then
&#9;&#9;&#9;&#9;&#9;if hit.Name == &quot;Head&quot; then
&#9;&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - (damage * 1.4)
&#9;&#9;&#9;&#9;&#9;&#9;tagHeadshot(humanoid)
&#9;&#9;&#9;&#9;&#9;end&#9;&#9;
&#9;&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;stick(hit)
&#9;else
&#9;&#9;humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;knife = hit.Parent:findFirstChild(&quot;Tomahawk&quot;)
&#9;&#9;if humanoid~=nil and knife~=nil then
&#9;&#9;&#9;if humanoid.Health ~= 0 and knife.GunScript.AmmoLeft.Value &lt;= 1 then
&#9;&#9;&#9;&#9;knife.GunScript.AmmoLeft.Value = knife.GunScript.AmmoLeft.Value + 1
&#9;&#9;&#9;&#9;arrow.Parent = nil
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function tagHumanoid(humanoid)
&#9;local tag = arrow:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;debris:AddItem(tag, 2)
&#9;&#9;if humanoid.Health &lt;= 0 then
&#9;&#9;&#9;local killer = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;killer.Name = &quot;Killer&quot;
&#9;&#9;&#9;killer.Parent = new_tag
&#9;&#9;&#9;local special_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;special_tag.Name = &quot;Tomahawk&quot;
&#9;&#9;&#9;special_tag.Parent = new_tag
&#9;&#9;end
&#9;end
end

arrow.Touched:connect(onTouched)

wait(60)

arrow.Parent = nil</ProtectedString>
