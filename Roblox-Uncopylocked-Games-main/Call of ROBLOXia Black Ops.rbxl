								<int name="BrickColor">26</int>
								<CoordinateFrame name="CFrame">
									<X>0.37387085</X>
									<Y>2.41656566</Y>
									<Z>0.291976929</Z>
									<R00>0.96004355</R00>
									<R01>2.58976834e-005</R01>
									<R02>0.279850304</R02>
									<R10>-3.45246553e-005</R10>
									<R11>1</R11>
									<R12>2.58976834e-005</R12>
