							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Choose</string>
							<ProtectedString name="Source">local Buttons = script.Parent:GetChildren()

for i = 1,#Buttons do
	if (Buttons[i].className == &quot;TextButton&quot;) then
--If the object is a TextButton 
		Buttons[i].MouseButton1Click:connect(function()
			local Enter = script.Parent.Parent.Enter
			local NewButton = script.Parent:GetChildren()
			if (Buttons[i].BackgroundColor3 == Color3.new(0, 1, 0)) then
				for i = 1,#NewButton do
					if (NewButton[i].className == &quot;TextButton&quot;) then
						if (NewButton[i].BackgroundColor3 == Color3.new(0, 128, 0)) then
--If another object is selected then deselect it
							NewButton[i].BackgroundColor3 = Color3.new(0, 1, 0)
						end
					end
				end
				Buttons[i].BackgroundColor3 = Color3.new(0, 128, 0)
			elseif (Buttons[i].BackgroundColor3 == Color3.new(0, 128, 0)) then
				Buttons[i].BackgroundColor3 = Color3.new(0, 1, 0)
			end
		end)
	end
end

</ProtectedString>
