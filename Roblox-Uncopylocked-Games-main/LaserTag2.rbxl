				<Item class="Script" referent="RBX2749">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Display</string>
						<ProtectedString name="Source">local Resume = coroutine.resume
local Create =coroutine.create

local Time = 5

Resume(Create(function()
	local Go = 0
	while Go == 0 do
		wait()
		if (script.Parent.Visible == true) then
			if (script.Parent.Text ~= &quot;Enter&quot;) then
				for i = Time, 0, -1 do
					wait(1)
					if (script.Parent.Visible == true) then
						Time = i
						script.Parent.Enter.Text = Time
						if (i == 0) then
							script.Parent.Enter.Text = &quot;Enter&quot;
							Go = 1
						end
					else
						break
					end
				end
			end
		end
	end 
end))

Resume(Create(function()
	Game:GetService(&quot;RunService&quot;).Heartbeat:connect(function()
		local Spawn = script.Parent.Parent.SpawnPanel.Spawns:GetChildren()
		local Count = 0
		for i = 1, #Spawn do
			if (Spawn[i].className == &quot;TextButton&quot;) then
				if (Spawn[i].BackgroundColor3 == Color3.new(0, 128, 0)) then
					Count = Count + 1
				end
			end
		end
		local Weapon = script.Parent
		if (Count &gt; 0) then
			Weapon.Visible = true
		else
			Weapon.Visible = false
		end
	end)
end))</ProtectedString>
