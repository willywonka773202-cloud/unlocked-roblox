							<string name="Name">Firing</string>
							<ProtectedString name="Source">--Variables
local Player = Game.Players.LocalPlayer
local Hopperbin = script.Parent
local Sighted = script.Parent.Animation.Sighted
local Name = &quot;Gun&quot;

local MaxLen = 1000
local Pause = false
local Loading = false
local GrenadeThrow = false
local PauseTime = 4
local Damage = 100
local Recoil = 3
local LoadTime = 4
local MaxEnergy = 5
local Grenades = 5
local Energy = MaxEnergy

local Random = math.random
local Abs = math.abs
local Rad = math.rad
local Angles = CFrame.Angles
local Create = coroutine.create
local Resume = coroutine.resume
local Floor = math.floor

function Selected(Mouse)
--Mouse Click event
	Mouse.Button1Down:connect(function()
		Clicked(Mouse)
	end)
	Mouse.KeyDown:connect(Pressed)
--This prevents you from being able to deselect your weapon
	local P = Game.LocalBackpack:GetChildren()
	for i = 1,#P do
		P[i]:Remove()
	end
	Game:GetService(&quot;RunService&quot;).Heartbeat:connect(function()
		Player = Game.Players.LocalPlayer
		Character = Player.Character
		Head = Character.Head
		Camera = Workspace.CurrentCamera
--Displays the amount of energy in the weapon
		local EnergyGui = Player.PlayerGui.ScreenGui.Energy
		local Color = Color3.new(Player.TeamColor.r, Player.TeamColor.g, Player.TeamColor.b)
		EnergyGui.Visible = true
		EnergyGui.Energy.BackgroundColor3 = Color
		local Percent = Energy / MaxEnergy
		EnergyGui.Energy.Size = UDim2.new(Percent, 0, 1, 0)
		EnergyGui.Energy.Position = UDim2.new(1 - Percent, 0, 0, 0)
		EnergyGui.Header.Text = &quot;Weapon Energy: &quot;..Floor(Percent * 100)..&quot;%&quot;
		EnergyGui.Grenades.Text = &quot;Grenades: &quot;..Grenades
		if (Energy &lt;= 0) then
			if (Loading == false) then
				Reload()
			end
		end
	end)
end

function Clicked(Mouse)
	if (Character.Humanoid.Health &gt; 0) then
		if (Pause == false) then
			if (Loading == false) then
				Pause = true
				Energy = Energy - 1
				local Gun = Camera[Name].Gun
				local Start = Gun.CFrame.p
				local End = (Camera.CoordinateFrame * CFrame.new(0, 0, -MaxLen)).p
				local Distance = (Start - End).magnitude
--Randomizes your shots
				local Spread = 15
				local Rnd = Vector3.new((Random(-Spread, Spread) / 250) * Distance, (Random(-Spread, Spread) / 250) * Distance, (Random(-Spread, Spread) / 250) * Distance)
				local End = Sighted.Value == &quot;False&quot; and End + Rnd or End
--Firing with randomized shots
				local Dir = End - Start
				Dir = -GetDirection(Dir)
				local Position = CFrame.new(Start, Dir + Start)
				local Vector = Position * Vector3.new(0, 0, MaxLen * 2) - Start
				local Hit, Pos, Normal, Time = CastRay(Workspace, Start, Vector)
				FireTo(Start, Pos, Hit, Normal)
				RecoilCam()
				Gun.Fire:Play()
				Resume(Create(function()
					wait(PauseTime)
					Pause = false
				end))
			end
		end
	end
end

function RecoilCam()
	Resume(Create(function()
		Camera.Focus = Camera.Focus + Vector3.new(0, Recoil / 100, 0)
		local Interval = 10
		for i = 1, Interval do
			wait(0.05)
			Camera.Focus = Camera.Focus - Vector3.new(0, (Recoil / 100) / Interval, 0)
		end
	end))
end

function Pressed(Key)
	if (Key == &quot;f&quot;) then
		if (Grenades &gt; 0) then
			if (GrenadeThrow == false) then
				GrenadeThrow = true
				Grenades = Grenades - 1
				ThrowGrenade()
				Resume(Create(function()
					wait(5)
					GrenadeThrow = false
				end))
			end
		end
	elseif (Key == &quot;r&quot;) then
		if (Loading == false) then
			Reload()
		end
	end
end

function Reload()
	Resume(Create(function()
		Loading = true
		for i = Energy, MaxEnergy do
			wait(LoadTime / MaxEnergy)
			Energy = i
		end
		Loading = false
	end))
end

function FireTo(Start, End, Hit, Normal)
	local Distance = (Start - End).magnitude
--Creates the Ray
	local Ray = Instance.new(&quot;Part&quot;, Workspace)
	Ray.BrickColor = Player.TeamColor
	Ray.Transparency = 0.5
	Ray.Name = &quot;Ray&quot;
	Ray.Anchored = true
	Ray.formFactor = &quot;Symmetric&quot;
	Ray.CanCollide = false
	local Mesh = Instance.new(&quot;BlockMesh&quot;, Ray)
	Mesh.Scale = Vector3.new(0.1, 0.1, 1)
	Ray.Size = Vector3.new(1, 1, Distance)
	Ray.CFrame = CFrame.new(Start, End) * CFrame.new(0, 0, -Distance / 2)
	if (Hit ~= nil) then
		if (Hit.Parent:findFirstChild(&quot;Humanoid&quot;)) then
--If you have shot a player
			local Enemy = Game.Players:findFirstChild(Hit.Parent.Name)
			if (Enemy.TeamColor ~= Player.TeamColor) then
				local Humanoid = Hit.Parent.Humanoid
				if (Humanoid.Health &gt; 0) then
					Humanoid:TakeDamage(Damage)
					local HitMark = Game.Lighting.HitMarker:Clone()
					HitMark.Parent = Player.PlayerGui.ScreenGui
					HitMark.Visible = true
					Game.Debris:AddItem(HitMark, 2)
					if (Humanoid.Health &lt;= 0) then
						local Kills = Player.Kills
						Kills.Value = Kills.Value + 1
						local Victim = Player.Victim
						Victim.Value = Enemy.Name
						local Killer = Enemy.Killer
						Killer.Value = Player.Name
						Enemy.KilledBy.Value = script.Parent.Name
						Humanoid.Health = 0
					end
				end
			end
		else
--If you have shot any regular surface
			HoleEffect(Ray, End, Normal)
		end
	end
	Game.Debris:AddItem(Ray, 0.1)
end

function HoleEffect(Ray, End, Normal)
	local Hole = Instance.new(&quot;Part&quot;, Workspace)
	Hole.Name = &quot;Hole&quot;
	Hole.BrickColor = Ray.BrickColor
	Hole.Transparency = 1
	Hole.Size = Vector3.new(1, 1, 1)
	Hole.formFactor = &quot;Symmetric&quot;
	Hole.Anchored = true
	Hole.CanCollide = false
	local Mesh = Instance.new(&quot;CylinderMesh&quot;, Hole)
	Mesh.Scale = Vector3.new(0.1, 0.1, 0.1)
	Hole.CFrame = CFrame.new(End)
	Hole.CFrame = CFrame.new(End, End + Normal) * Angles(Rad(90), 0, 0)
	Resume(Create(function()
		Game.Debris:AddItem(Hole, 1)
		for A = 1, 10 do
			wait(0.05)
			Mesh.Scale = Mesh.Scale + Vector3.new(0.1, 0, 0.1)
			Hole.Transparency = Hole.Transparency - 0.05
		end
		for A = 1, 10 do
			wait(0.05)
			Mesh.Scale = Mesh.Scale + Vector3.new(0.1, 0, 0.1)
			Hole.Transparency = Hole.Transparency + 0.05
		end
	end))
end

function ThrowGrenade()
	local Direction = Camera.CoordinateFrame.lookVector
	local Speed = 100
	local Gun = Camera[Name].Gun
	local Start = Gun.CFrame.p
	local Grenade = Instance.new(&quot;Part&quot;, Workspace)
	Grenade.Name = &quot;Grenade&quot;
	Grenade.Size = Vector3.new(1, 1, 1)
	Grenade.Shape = &quot;Ball&quot;
	Grenade.Friction = 0.3
	Grenade.BrickColor = Player.TeamColor
	Grenade.CFrame = CFrame.new(Start)
	Grenade.Velocity = Direction * Speed
	Resume(Create(function()
		wait(2)
		Game.Debris:AddItem(Grenade, 0.1)
		Explode(Grenade.CFrame.p)
	end))
end

function Explode(Pos)
	local Blast = Instance.new(&quot;Part&quot;, Workspace)
	Blast.Name = &quot;Blast&quot;
	Blast.BrickColor = Player.TeamColor
	Blast.Size = Vector3.new(20, 20, 20)
	Blast.Anchored = true
	Blast.CanCollide = false
	Blast.Shape = &quot;Ball&quot;
	local Mesh = Instance.new(&quot;SpecialMesh&quot;, Blast)
	Mesh.MeshType = &quot;Sphere&quot;
	Mesh.Scale = Vector3.new(1, 1, 1)
	Blast.CFrame = CFrame.new(Pos)
	Game.Debris:AddItem(Blast, 1)
	Resume(Create(function()
		for i = 1, 10 do
			wait(0.1)
			Blast.Transparency = Blast.Transparency + 0.1
			Mesh.Scale = Mesh.Scale + Vector3.new(0.2, 0.2, 0.2)
		end
	end))
	local Start = Pos
	local Players = Game.Players:GetChildren()
	for i = 1, #Players do
		local End = Players[i].Character.Torso.CFrame.p
		local Distance = (Start - End).magnitude
		local MaxDistance = 20
		local Dir = End - Start
		Dir = -GetDirection(Dir)
		local Position = CFrame.new(Start, Dir + Start)
		local Vector = Position * Vector3.new(0, 0, MaxLen * 2) - Start
		local Hit, Pos, Normal, Time = CastRay(Workspace, Start, Vector)
		if (Hit ~= nil) then
			if (Hit.Parent:findFirstChild(&quot;Humanoid&quot;)) then
				local Humanoid = Hit.Parent.Humanoid
				local Enemy = Game.Players:findFirstChild(Hit.Parent.Name)
				if (Enemy.TeamColor ~= Player.TeamColor) then
					if (Hit.Parent.Humanoid.Health &gt; 0) and (Distance &lt; MaxDistance) then
						local RangeDamage = GetDamage(Distance)
						Hit.Parent.Humanoid:TakeDamage(RangeDamage)
						local HitMark = Game.Lighting.HitMarker:Clone()
						HitMark.Parent = Player.PlayerGui.ScreenGui
						HitMark.Visible = true
						Game.Debris:AddItem(HitMark, 2)
						if (Hit.Parent.Humanoid.Health == 0) then
							local Kills = Player.Kills
							Kills.Value = Kills.Value + 1
							local Victim = Player.Victim
							Victim.Value = Enemy.Name
							local Killer = Enemy.Killer
							Killer.Value = Player.Name
							Enemy.KilledBy.Value = &quot;Grenade&quot;
							Humanoid.Health = 0
						end
					end
				end
			end
		end
	end
end

function GetDamage(Distance)
	local Minimum = 10
	local RangeDamage = (Minimum * 100) / Distance
	return RangeDamage
end

Hopperbin.Selected:connect(Selected)

----------------------------------------------------------------------------------------------------------Ray Casting----------------------------------------------------------------------------------------------------------------------------------

function TestPart(Part)
	if (Part.Name == &quot;Gun&quot;) or (Part.Name == &quot;Ray&quot;) or (Part.Name == &quot;Hole&quot;) or (Part.Name == &quot;Blast&quot;) or (Part.Name == &quot;Grenade&quot;) or (Part:isDescendantOf(Character)) then
		return false
	end
	return true
end

function GetDirection(Vector)
	local Magnitude = Vector.magnitude
	local Inverse = 1 / Magnitude
	local Direction = Vector3.new(Vector.x * Inverse, Vector.y * Inverse, Vector.z * Inverse)
	return Direction
end

function Dot(VectorA, VectorB)
	local ReturnDot = (VectorA.x * VectorB.x + VectorA.y * VectorB.y + VectorA.z * VectorB.z)
	return ReturnDot
end

function CastRay(Model, Start, Vector)
	local Hit, Normal, Time = CastRayRecursive(Model, Start, Vector,  Vector.unit, Dot(Start, Vector.unit))
	if (Dot(Normal, Vector) &gt; 0) then
		Normal = -Normal
	end
	return Hit, Start + Time * Vector, Normal.unit, Time
end

function CastRayRecursive(Model, Start, Vector, VectorUnit, StartDist)
	if (Model.className == &quot;Part&quot;) then
		local Range = Model.Size.magnitude / 2
		local Dist = Dot(Model.Position, VectorUnit) - StartDist
		if (Dist + Range &gt; 0) and (Dist - Range &lt; Vector.magnitude) and ((Dist * VectorUnit + Start - Model.Position).magnitude &lt; Range) and TestPart(Model) then
			local Half = Model.Size / 2
			local Time = 1
			local Position = Model.CFrame - Model.Position
			local XVector = Position * Vector3.new(1, 0, 0)
			local YVector = Position * Vector3.new(0, 1, 0)
			local ZVector = Position * Vector3.new(0, 0, 1)
			local XDist = -Dot(XVector, Vector)
			local YDist = -Dot(YVector, Vector)
			local ZDist = -Dot(ZVector, Vector)
			local XMin, XMax, YMin, YMax, ZMin, ZMax = -1
			local DotProd = Dot(XVector, Start - Model.Position)
			if (XDist ~= 0) then
				XMin = (DotProd - Half.x) / XDist
				XMax = (DotProd + Half.x) / XDist
				if (XMax &lt; XMin) then
					local Temp = XMin
					XMin = XMax
					XMax = Temp
				end
			else
				if (math.abs(DotProd) &lt; Half.x) then
					XMax = 1
					XMin = 0
				else
					return nil, Vector3.new(0, 0, 0), 1
				end
			end
			local DotProd = Dot(YVector, Start - Model.Position)
			if (YDist ~= 0) then
				YMin = (DotProd - Half.y) / YDist
				YMax = (DotProd + Half.y) / YDist
				if (YMax &lt; YMin) then
					local Temp = YMin
					YMin = YMax
					YMax = Temp
				end
			else
				if (math.abs(DotProd) &lt; Half.y) then
					YMax = 1
					YMin = 0
				else
					return nil, Vector3.new(0, 0, 0), 1
				end
			end
			local DotProd = Dot(ZVector, Start - Model.Position)
			if (ZDist ~= 0) then
				ZMin = (DotProd - Half.z) / ZDist
				ZMax = (DotProd + Half.z) / ZDist
				if (ZMax &lt; ZMin) then
					local Temp = ZMin
					ZMin = ZMax
					ZMax = Temp
				end
			else
				if (Abs(DotProd) &lt; Half.z) then
					ZMax = 1
					ZMin = 0
				else
					return nil, Vector3.new(0, 0, 0), 1
				end
			end
			if (XMin &lt;= YMax) and (XMax &gt;= YMin) and (XMin &lt;= ZMax) and (XMax &gt;= ZMin) and (ZMin &lt;= YMax) and (ZMax &gt;= YMin) then
				local Normal = XVector
				local Min = XMin
				if (YMin &gt; Min) then
					Min = YMin
					Normal = YVector
				end
				if (ZMin &gt; Min) then
					Min = ZMin
					Normal = ZVector
				end
				if (Min &gt;= 0) and (Min &lt; 1) then
					Time = Min
				elseif (XMax &gt; 0) and (YMax &gt; 0) and (ZMax &gt; 0) and (Min &lt; 0) then
					Time = 0
					Normal = Vector3.new(0, 0, 0)
				end
				return Model, Normal, Time
			else
				return nil, Vector3.new(0, 0, 0), 1
			end
		end
		return nil, Vector3.new(0, 0, 0), 1
	elseif (Model.className==&quot;Model&quot;) or (Model == Workspace) then
		local Children = Model:GetChildren()
		local Time = 1
		local Normal = Vector3.new(0, 0, 0)
		local Hit = nil
		for A = 1, #Children do
			if Children[A]~= nil then
				local NewHit, NewNormal, NewTime = CastRayRecursive(Children[A], Start, Vector, VectorUnit, StartDist)
				if (NewTime &lt; Time) then
					Time = NewTime
					Hit = NewHit
					Normal = NewNormal
				end
			end
		end
		return Hit, Normal, Time
	else
		return nil, Vector3.new(0, 0, 0), 1
	end
end </ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="LocalScript" referent="RBX41">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Animation</string>
							<ProtectedString name="Source">--Variables
local Player = Game.Players.LocalPlayer
local Hopperbin = script.Parent
local Sighted = script.Sighted
local Name = &quot;Gun&quot;

local Rad = math.rad
local Create = coroutine.create
local Resume = coroutine.resume

local Crouch, Prone, Sprint, Sprinting = false, false, false, false
local Leaderboard = false

function Selected(Mouse)
	Mouse.Icon = &quot;http://www.roblox.com/asset/?id=15324984&quot;
--Key press event
	Mouse.KeyDown:connect(Pressed)
	Mouse.KeyUp:connect(UnPressed)
	Character = Player.Character
	Torso = Character.Torso
	NeckOrigin = Torso[&quot;Neck&quot;].C0
	Camera = Workspace.CurrentCamera
	Humanoid = Character.Humanoid
	Head = Character.Head
	RightLeg = Character[&quot;Right Leg&quot;]
	LeftLeg = Character[&quot;Left Leg&quot;]
--Gives the weapon handle to you
	local Guns = Camera:GetChildren()
	if (#Guns &gt; 0) then
		for i = 1, #Guns do
			if (Guns[i].Name == &quot;Gun&quot;) then
				Guns[i]:Remove()
			end
		end
	end
	Humanoid.Died:connect(function()
		wait(0.5)
		KillCam()
	end)
	Gun = Game.Lighting.Guns.Weapons[Name]:Clone()
	Gun.Parent = Camera
	Gun = Gun.Gun
	local Weld, Weld2 = Weld(Gun)
	FormCharacter()
--Formats your gun to you according to camera direction
	Resume(Create(function()
		while wait(0.05) do
			AlignWeapon(Weld, Weld2, Mouse)
			local Gui = Player.PlayerGui.ScreenGui.LeaderboardPanel
			if (Leaderboard == true) then
				Gui.Visible = true
			else
				Gui.Visible = false
			end
--Forces the user into First Person
			local Gui = Player.PlayerGui.ScreenGui
			if ((Camera.Focus.p - Camera.CoordinateFrame.p).magnitude &gt; 1) then
				Gui.Blocker.Visible = true
			else
				Gui.Blocker.Visible = false
			end
			GetWalkSpeeds()
		end
	end))
end

function Pressed(Key)
	if (Key == &quot;q&quot;) then
--When Q is pressed you toggle sights
		if (Sighted.Value == &quot;False&quot;) then
			Sighted.Value = &quot;True&quot;
		else
			Sighted.Value = &quot;False&quot;
		end
--When C is pressed you toggle crouch
	elseif (Key == &quot;c&quot;) then
		Prone = false
		Crouch = not Crouch
		DoCrouch()
--When X is pressed you toggle prone
	elseif (Key == &quot;x&quot;) then
		Crouch = false
		Prone = not Prone
		DoProne()
--When E is held the leaderboard appears
	elseif (Key == &quot;e&quot;) then
		Leaderboard = true
--When Shift is pressed you run
	elseif (Key == &quot;0&quot;) then
		if (Sprinting == false) then
			Sprinting, Sprint = true, true
			Crouch, Prone, Sighted.Value = false, false, &quot;False&quot;
			DoProne()
			DoCrouch()
			Resume(Create(function()
				local Time = 0
				repeat
					wait(0.1)
					Time = Time + 0.1
				until Crouch == true or Prone == true or Sighted.Value == &quot;True&quot; or Time &gt;= 5
				Sprint = false
				wait(2)
				Sprinting = false
			end))	
		end
	end
end

function UnPressed(Key)
--When E is unpressed the leaderboard disappears
	if (Key == &quot;e&quot;) then
		Leaderboard = false
	end
end

function AlignWeapon(Weld, Weld2, Mouse)
	local Target = Camera.CoordinateFrame * CFrame.new(0, 0, -100)
--Checks if you are in sights or not and formats the gun accordingly
	if (Sighted.Value == &quot;False&quot;) then
		Weld2.C0 = CFrame.new(0.75, -0.75, -0.75) * CFrame.Angles(Rad(90), 0, 0)
		Mouse.Icon = &quot;http://www.roblox.com/asset/?id=15324984&quot;
	else
		Weld2.C0 = CFrame.new(0.15, -0.45, -1) * CFrame.Angles(Rad(88), 0, 0)
		Mouse.Icon = &quot;http://www.roblox.com/asset/?id=22416261&quot;
	end
--Updates everything
	Weld.C0 = CFrame.new(0, 0, 0)
	Weld.C1 = (CFrame.new(Head.CFrame.p, Target.p) - Head.CFrame.p):inverse() * (Head.CFrame - Head.Position)
end

function GetWalkSpeeds()
	if (Sprint == false) then
		if (Sighted.Value == &quot;True&quot;) then
			if (Crouch == true) then
				Humanoid.WalkSpeed = 4
			else
				if (Prone == true) then
					Humanoid.WalkSpeed = 0
				else
					Humanoid.WalkSpeed = 8
				end
			end
		else
			if (Crouch == true) then
				Humanoid.WalkSpeed = 8
			else
				if (Prone == true) then
					Humanoid.WalkSpeed = 2
				else
					Humanoid.WalkSpeed = 16
				end
			end
		end
	else
		Humanoid.WalkSpeed = 24
	end
end

function KillCam()
	local Killer = Game.Players:findFirstChild(Player.Killer.Value)
	if (Killer) then
		if (Killer.Character) then
			if (Killer.Character:findFirstChild(&quot;Humanoid&quot;)) then
				Camera.CameraSubject = Killer.Character.Humanoid
				Camera.CoordinateFrame = Camera.CoordinateFrame + Vector3.new(0, 10, 10)
				Player.PlayerGui.ScreenGui.Blocker:Remove()
				Player.Killer.Value = &quot;&quot;
			end
		end
	end
end

function Weld(Model)
--Creates a new head and welds the gun to that
	local NewHead = Instance.new(&quot;Part&quot;)
	NewHead.CanCollide = false
	NewHead.Size = Vector3.new(1, 1, 1)
	NewHead.formFactor = &quot;Symmetric&quot;
	NewHead.Transparency = 1
	NewHead.Parent = Character
	local W = Instance.new(&quot;Weld&quot;, Head)
	W.Part0 = Head
	W.Part1 = NewHead
	local W2 = Instance.new(&quot;Weld&quot;, NewHead)
	W2.Part0 = NewHead
	W2.Part1 = Gun
	local W3 = Instance.new(&quot;Weld&quot;, Gun)
	local Sight = Gun.Parent.Front
	W3.Part0 = Gun
	W3.Part1 = Sight
	W3.C0 = Gun.CFrame:inverse() * CFrame.new(Gun.Position)
	W3.C1 = Sight.CFrame:inverse() * CFrame.new(Gun.Position)
	Gun.Anchored = false
	Sight.Anchored = false
--Returns the welds for further use
	return W, W2
end

function FormCharacter()
--Forms the new Body Parts
	local NewHead = Head:Clone()
	NewHead.Name = &quot;NewHead&quot;
	NewHead.Parent = Character
	local HeadWeld = Instance.new(&quot;Weld&quot;, Head)
	HeadWeld.Part0 = Head
	HeadWeld.Part1 = NewHead
	local NewTorso = Instance.new(&quot;Part&quot;, Character)
	NewTorso.Name = &quot;NewTorso&quot;
	NewTorso.BrickColor = Player.TeamColor
	NewTorso.Size = Vector3.new(2, 2, 1)
	NewTorso.formFactor = &quot;Symmetric&quot;
	NewTorso.CanCollide = false
	local TorsoWeld = Instance.new(&quot;Motor&quot;, Torso)
	TorsoWeld.Name = &quot;TorsoWeld&quot;
	TorsoWeld.Part0 = Torso
	TorsoWeld.Part1 = NewTorso
	TorsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, Rad(-45), 0)
	local RightArm = Character[&quot;Right Arm&quot;]
	local RightArmWeld = Instance.new(&quot;Motor&quot;, Torso)
	RightArmWeld.Part0 = Torso
	RightArmWeld.Part1 = RightArm
	RightArmWeld.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(Rad(90), 0, 0)
	local LeftArm = Character[&quot;Left Arm&quot;]
	local LeftArmWeld = Instance.new(&quot;Motor&quot;, Torso)
	LeftArmWeld.Part0 = Torso
	LeftArmWeld.Part1 = LeftArm
	LeftArmWeld.C0 = CFrame.new(0, 0.5, -1) * CFrame.Angles(Rad(90), 0, Rad(90))
	local RightLegWeld = Torso[&quot;Right Hip&quot;]
	RightLegWeld.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, Rad(45), 0)
	local LeftLegWeld = Torso[&quot;Left Hip&quot;]
	LeftLegWeld.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
--Formats the Visual Gun
	local NewGun = Game.Lighting.Guns.Weapons[Name].Gun:Clone()
	NewGun.Anchored = false
	NewGun.Parent = Character
	local GunWeld = Instance.new(&quot;Weld&quot;, RightArm)
	GunWeld.Part0 = RightArm
	GunWeld.Part1 = NewGun
	GunWeld.C0 = CFrame.new(0, -1, -0.5)
--Hides real Head / Torso
	Torso.Transparency = 1
	Head.Transparency = 1
end

function DoCrouch()
	local TorsoWeld = Torso[&quot;TorsoWeld&quot;]
	TorsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, Rad(-45), 0)
	local Neck = Torso[&quot;Neck&quot;]
	Neck.C0 = NeckOrigin
	if (Crouch == true) then
		local RightHip = Torso[&quot;Right Hip&quot;]
		RightHip.C0 = CFrame.new(1.3, -0.1, 0.1) * CFrame.Angles(0, Rad(45), Rad(-20))
		local LeftHip = Torso[&quot;Left Hip&quot;]
		LeftHip.C0 = RightHip.C0 * CFrame.new(0, 0, -1)
		RightLeg.Name = &quot;RightLeg&quot;
		LeftLeg.Name = &quot;LeftLeg&quot;
		RightLeg.CanCollide = true
		LeftLeg.CanCollide = true
	else
		local RightHip = Torso[&quot;Right Hip&quot;]
		RightHip.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, Rad(45), 0)
		local LeftHip = Torso[&quot;Left Hip&quot;]
		LeftHip.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
		RightLeg.Name = &quot;Right Leg&quot;
		LeftLeg.Name = &quot;Left Leg&quot;
		RightLeg.CanCollide = false
		LeftLeg.CanCollide = false
	end
end

function DoProne()
	local TorsoWeld = Torso[&quot;TorsoWeld&quot;]
	TorsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, Rad(-45), 0)
	local Neck = Torso[&quot;Neck&quot;]
	if (Prone == true) then
		TorsoWeld.C0 = CFrame.new(0, 0.5, 0) * CFrame.Angles(Rad(-90), 0, 0)
		local RightHip = Torso[&quot;Right Hip&quot;]
		RightHip.C0 = CFrame.new(1, 0.5, 1) * CFrame.Angles(Rad(-90), Rad(90), 0)
		local LeftHip = Torso[&quot;Left Hip&quot;]
		LeftHip.C0 = RightHip.C0 * CFrame.new(0, 0, -1)
		RightLeg.Name = &quot;RightLeg&quot;
		LeftLeg.Name = &quot;LeftLeg&quot;
		RightLeg.CanCollide = true
		LeftLeg.CanCollide = true
		RightHip.MaxVelocity = 0
		LeftHip.MaxVelocity = 0
		Neck.C0 = Neck.C0 - Vector3.new(0, 0, 0.5)
	else
		local RightHip = Torso[&quot;Right Hip&quot;]
		RightHip.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, Rad(45), 0)
		local LeftHip = Torso[&quot;Left Hip&quot;]
		LeftHip.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
		RightLeg.Name = &quot;Right Leg&quot;
		LeftLeg.Name = &quot;Left Leg&quot;
		RightLeg.CanCollide = false
		LeftLeg.CanCollide = false
		RightHip.MaxVelocity = 0.1
		LeftHip.MaxVelocity = 0.1
		Neck.C0 = Neck.C0 + Vector3.new(0, 0, 0.5)
	end
end

Hopperbin.Selected:connect(Selected)</ProtectedString>
