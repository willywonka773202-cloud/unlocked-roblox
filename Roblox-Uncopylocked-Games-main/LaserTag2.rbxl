							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Enter</string>
							<ProtectedString name="Source">script.Parent.MouseButton1Click:connect(function()
--When you click Enter it removes the panel
	local Weapons = script.Parent.Parent.Weapons:GetChildren()
	for i = 1,#Weapons do
		if (Weapons[i].className == &quot;TextButton&quot;) then
			if (Weapons[i].BackgroundColor3 == Color3.new(0, 128, 0)) then
				if (script.Parent.Text == &quot;Enter&quot;) then
					Spawn(Weapons[i])
				end
			end
		end
	end
end)

function Spawn(Gui)
	local Camera = Workspace.CurrentCamera
	local ScreenGui = script.Parent.Parent.Parent
	local Player = ScreenGui.Parent.Parent
	local Character = Player.Character
	local Torso = Character.Torso
	local Head = Character.Head
	local Humanoid = Character.Humanoid
--Gives you your weapon and spawns you
	local WeaponValue = script.Parent.Parent.Parent.Weapon
	WeaponValue.Value = Gui.Name
	local Weapon = Game.Lighting.Guns.Tools[WeaponValue.Value]:Clone()
	Weapon.Parent = Player.Backpack
	Player.Spawned.Value = &quot;True&quot;
	for i = 1, 5 do wait()
		if (Camera.CameraSubject.Name ~= &quot;Humanoid&quot;) then
			Torso.CFrame = CFrame.new(Camera.CameraSubject.CFrame.p)
		else
			Torso.CFrame = CFrame.new(Camera.CameraSubject.Parent.Head.CFrame.p)
		end
	end
	Camera.CameraSubject = Humanoid
	Camera.CoordinateFrame = Head.CFrame + Vector3.new(5, 5, 5)
	local Field = Instance.new(&quot;ForceField&quot;, Character)
	Game.Debris:AddItem(Field, 5)
	ScreenGui.SpectateButton:Remove()
	ScreenGui.SpectatePanel.Visible = false
	ScreenGui.SpawnPanel:Remove()
	script.Parent.Parent:Remove()
end

Game:GetService(&quot;RunService&quot;).Heartbeat:connect(function()
	local Weapons = script.Parent.Parent.Weapons:GetChildren()
	local Count = 0
	for i = 1, #Weapons do
		if (Weapons[i].className == &quot;TextButton&quot;) then
--If a weapon is selected then show up green
			if (Weapons[i].BackgroundColor3 == Color3.new(0, 128, 0)) then
				Count = Count + 1
			end
		end
	end
	if (Count &gt; 0) then
		if (script.Parent.Text == &quot;Enter battle!&quot;) then
			script.Parent.BackgroundColor3 = Color3.new(0, 1, 0)
		end
	else
		script.Parent.BackgroundColor3 = Color3.new(1, 0, 0)
	end
end)
	</ProtectedString>
