					<Item class="Script" referent="RBX2721">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Remove</string>
							<ProtectedString name="Source">script.Parent.Exit.MouseButton1Click:connect(function()
	local Spawn = script.Parent.Parent.Parent.SpawnPanel
	Spawn.Visible = true
	local Choose = script.Choose:Clone()
	Choose.Disabled = false
	Choose.Parent = Spawn.Spawns
	script.Parent.Parent:Remove()
end)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="LocalScript" referent="RBX2722">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Choose</string>
								<ProtectedString name="Source">local Player = Game.Players.LocalPlayer

local Current = &quot;None&quot;
local Previous = &quot;None&quot;
local View = &quot;None&quot;

local PlayerView = false

local Buttons = script.Parent:GetChildren()

local Create = coroutine.create
local Resume = coroutine.resume

for i = 1,#Buttons do
	if (Buttons[i].className == &quot;TextButton&quot;) then
		Buttons[i].MouseButton1Click:connect(function()
			Select(Buttons[i])
		end)
	end
end

function Select(Button)
	View = &quot;None&quot;
	local NewButton = script.Parent:GetChildren()
	if (Button.Chosen.Value == &quot;False&quot;) and (Button.Ready.Value == &quot;True&quot;) then
		for i = 1,#NewButton do
			if (NewButton[i].className == &quot;TextButton&quot;) then
				if (NewButton[i].Chosen.Value == &quot;True&quot;) then
					NewButton[i].Chosen.Value = &quot;False&quot;
				end
			end
		end
		Button.Chosen.Value = &quot;True&quot;
		Camera(Button)
	elseif (Button.Chosen.Value == &quot;True&quot;) then
		Button.Chosen.Value = &quot;False&quot;
	end
end

function Camera(Object)
	local Flag = Workspace.Map:findFirstChild(Object.Name)
	if (Flag) then
		View = &quot;Flag&quot;
		Current = Flag
		if (Current ~= Previous) then
			MoveCamera(Flag)
		end
		Previous = Current
	else
		View = &quot;Team&quot;
		Resume(Create(function()
			while wait() do
				if (View ~= &quot;Team&quot;) then
					break
				end
				local TeamMate = Object.Player.Value
				if (TeamMate) then
					local Character = TeamMate.Character
					if (Character) then
						Current = Character
						if (Current ~= Previous) then
							MoveCamera(Character)
						end
						Previous = Current
					end
				end
			end
		end))
	end
end 

function MoveCamera(Model)
	if (Model ~= nil) then
		local Head = Model:findFirstChild(&quot;Humanoid&quot;) ~= nil and Model.Humanoid or Model.Flag
		local Camera = Workspace.CurrentCamera
		Camera.CameraSubject = Head
		if (Head.Name ~= &quot;Humanoid&quot;) then
			Camera.CoordinateFrame = CFrame.new(Head.CFrame.p + Vector3.new(15, 10, 0), Head.CFrame.p)
		end
	end
end </ProtectedString>
