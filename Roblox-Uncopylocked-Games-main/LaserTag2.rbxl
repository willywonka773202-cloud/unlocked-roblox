					<ProtectedString name="Source">local Model = script.Parent
local Stand = Model.Stand
local Flag = Model.Flag

local Carry = false
local Player = &quot;None&quot;
local Character = nil
local MaxLen = 1000

local Abs = math.abs
local Rad = math.rad

Stand.Touched:connect(function(Object)
	if (Carry == false) then
		local Mod = Game.Players:findFirstChild(Object.Parent.Name)
		if (Mod) then
			if (Mod.Character.Humanoid.Health &gt; 0) then
				if (Mod.Character:findFirstChild(&quot;NewTorso&quot;)) then
					Carry = true
					Player = Mod
					Character = Player.Character
					Stand.Anchored = false
					Stand.CanCollide = false
					Flag.Anchored = false
					Flag.CanCollide = false
					Flag.BrickColor = Player.TeamColor
					local Weld = WeldTo(Character.NewTorso)
					local TeamColor = Color3.new(Player.TeamColor.r, Player.TeamColor.g, Player.TeamColor.b)
					shared.DisplayMessage(Player.Name..&quot; took the Flag!&quot;, TeamColor)
					local Players = Game.Players:GetChildren()
					for i = 1, #Players do
						if (Players[i]:findFirstChild(&quot;PlayerGui&quot;)) then
							shared.DisplayPlayer(Player.Name..&quot; took the Flag!&quot;, Player, Players[i])
						end
					end
					Character.Humanoid.Died:connect(function()
						Weld:Remove()
						Carry = false
						Stand.CanCollide = true
						Flag.CanCollide = true
						Flag.BrickColor = Game.Teams[&quot;Not Playing&quot;].TeamColor
						local TeamColor = Color3.new(Player.TeamColor.r, Player.TeamColor.g, Player.TeamColor.b)
						shared.DisplayMessage(Player.Name..&quot; dropped the Flag!&quot;, TeamColor)
						local Players = Game.Players:GetChildren()
						for i = 1, #Players do
							if (Players[i]:findFirstChild(&quot;PlayerGui&quot;)) then
								shared.DisplayPlayer(Player.Name..&quot; dropped the Flag!&quot;, Player, Players[i])
							end
						end
					end)
				end
			end
		end
	end
end)

function WeldTo(Object)
	local Weld = Instance.new(&quot;Weld&quot;, Object)
	Weld.Part0 = Weld.Parent
	Weld.Part1 = Stand
	Weld.C0 = CFrame.new(0, 0, 0.5) * CFrame.Angles(0, 0, Rad(-65))
	return Weld
end

function WeldFlag()
	local Weld = Instance.new(&quot;Weld&quot;, Stand)
	Weld.Part0 = Weld.Parent
	Weld.Part1 = Flag
	Weld.C0 = Weld.Part0.CFrame:inverse() * CFrame.new(Weld.Part0.Position)
	Weld.C1 = Weld.Part1.CFrame:inverse() * CFrame.new(Weld.Part0.Position)
	Flag.Anchored = false
end

