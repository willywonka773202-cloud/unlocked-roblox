				<Item class="Script" referent="RBX2827">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Color</string>
						<ProtectedString name="Source">local Player = script.Parent.Parent.Parent.Parent
local Gui = script.Parent.Spawns.TeamMate

function Color(Button)
	if (Button.Ready.Value == &quot;True&quot;) then
		if (Button.Chosen.Value == &quot;True&quot;) then
			Button.BackgroundColor3 = Color3.new(0, 128, 0)
		else
			Button.BackgroundColor3 = Color3.new(0, 1, 0)
		end
	else
		Button.BackgroundColor3 = Color3.new(0, 0, 0)
	end
end

Game:GetService(&quot;RunService&quot;).Heartbeat:connect(function()
--Checks for Team Mate
	local Team = {}
	local Players = Game.Players:GetChildren()
	for i = 1,#Players do
		if (Players[i].TeamColor == Player.TeamColor) and (Players[i] ~= Player) and (Players[i].Spawned.Value == &quot;True&quot;) then
			local Character = Players[i].Character
			if (Character) then
				if (Character.Humanoid.Health &gt; 0) then
					table.insert(Team, Players[i])
				end
			end
		end
	end
	if (#Team &gt; 0) then
		Gui.Ready.Value = &quot;True&quot;
		Gui.Player.Value = Team[1]
	else
		Gui.Ready.Value = &quot;False&quot;
		Gui.Chosen.Value = &quot;False&quot;
	end
	Color(Gui)
	if (Game.Workspace:findFirstChild(&quot;Map&quot;)) then
		local Flag = Workspace.Map:GetChildren()
		for i = 1, #Flag do
			if (Flag[i].Name ~= &quot;Map&quot;) and (Flag[i].Name ~= &quot;KingFlag&quot;) then
				local FlagGui = script.Parent.Spawns[Flag[i].Name]
				if (Flag[i].Flag.BrickColor == Player.TeamColor) then
					FlagGui.Ready.Value = &quot;True&quot;
				else
					FlagGui.Ready.Value = &quot;False&quot;
				end
				Color(FlagGui)
			end
		end
	end
end)</ProtectedString>
