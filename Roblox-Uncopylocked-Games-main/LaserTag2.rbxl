				<ProtectedString name="Source">local Teams = {&quot;Alpha&quot;, &quot;Bravo&quot;, &quot;Charlie&quot;, &quot;Delta&quot;}
local Modes = {&quot;Deathmatch&quot;, &quot;Last Team Standing&quot;, &quot;Conquest&quot;, &quot;Team Swap&quot;, &quot;King of the Flag&quot;}
local Times = {5, 3, 5, 5, 5}
local TeamFlags = {0, 0, 0, 0}
local TeamKills = {0, 0, 0, 0}
local PlayersLeft = {0, 0, 0, 0}
local TeamPoints = {0, 0, 0, 0}
local Mode = nil
local Playing = false
local Min = 2

local Random = math.random
local Hint = Instance.new(&quot;Hint&quot;, Workspace)

local Create = coroutine.create
local Resume = coroutine.resume
local Sub = string.sub
local Low = string.lower

--Workspace.Showcase:Remove()

function Entered(Player)
--Player Enter handling
	if (Game.Players.NumPlayers &gt; Game.Players.MaxPlayers) then
		Player:Remove()
	else
		local Text = Player.Name..&quot; has entered the game&quot;
		shared.DisplayMessage(Text, Color3.new(0, 0, 0))
		local Spawned = script.Spawned:Clone()
		Spawned.Parent = Player
		local Kills = script.Kills:Clone()
		Kills.Parent = Player
		local By = script.KilledBy:Clone()
		By.Parent = Player
		local Victim = script.Victim:Clone()
		Victim.Parent = Player
		local Killer = script.Killer:Clone()
		Killer.Parent = Player
	--Player Kill handling
		Kills.Changed:connect(function(Value)
			wait(0.5)
			local Enemy = Game.Players:findFirstChild(Player.Victim.Value)
			if (Enemy) then
				local Weapon = Enemy.KilledBy.Value
				if (Mode ~= &quot;Last Team Standing&quot;) and (Mode ~= &quot;Team Swap&quot;) then
					local Text = &quot;You killed &quot;..Enemy.Name..&quot; with &quot;..Weapon
					shared.DisplayPlayer(Text, Enemy, Player)
					Text = Player.Name..&quot; killed you with &quot;..Weapon
					shared.DisplayPlayer(Text, Player, Enemy)
					Text = Player.Name..&quot; killed &quot;..Enemy.Name..&quot; with &quot;..Weapon
					shared.DisplayMessage(Text, Color3.new(Player.TeamColor.r, Player.TeamColor.g, Player.TeamColor.b))
				elseif (Mode == &quot;Last Team Standing&quot;) then
					local Text = &quot;You eliminated &quot;..Enemy.Name..&quot; with &quot;..Weapon
					shared.DisplayPlayer(Text, Enemy, Player)
					Text = Player.Name..&quot; eliminated you with &quot;..Weapon
					shared.DisplayPlayer(Text, Player, Enemy)
					Text = Player.Name..&quot; eliminated &quot;..Enemy.Name..&quot; with &quot;..Weapon
					shared.DisplayMessage(Text, Color3.new(Player.TeamColor.r, Player.TeamColor.g, Player.TeamColor.b))
					shared.Notify(Enemy, &quot;You were eliminated by &quot;..Player.Name)
				elseif (Mode == &quot;Team Swap&quot;) then
					local Text = &quot;You killed &quot;..Enemy.Name..&quot; with &quot;..Weapon
					shared.DisplayPlayer(Text, Enemy, Player)
					Text = Player.Name..&quot; killed you with &quot;..Weapon
					shared.DisplayPlayer(Text, Player, Enemy)
					Text = Player.Name..&quot; killed &quot;..Enemy.Name..&quot; with &quot;..Weapon
					shared.DisplayMessage(Text, Color3.new(Player.TeamColor.r, Player.TeamColor.g, Player.TeamColor.b))
					shared.Notify(Enemy, &quot;You have been swapped to &quot;..Player.Name..&quot;&apos;s Team&quot;)
					Enemy.TeamColor = Player.TeamColor
				end
			end
		end)
	--Player Spawn handling
		Player.Changed:connect(function(Property)
			if Property == &quot;Character&quot; then
				local Gui = Game.Lighting.ScreenGui:Clone()
				Gui.Parent = Player.PlayerGui
				Player.CharacterAppearance = &quot;http://www.roblox.com/Asset/CharacterFetch.ashx?userId=100&amp;placeId=0&quot;
				Player.Spawned.Value = &quot;False&quot;
				if (Player.TeamColor ~= Game.Teams[&quot;Not Playing&quot;].TeamColor) then
					local Gui = Player.PlayerGui.ScreenGui
					Gui.InfoPanel.Visible = true
				end
				if (Mode == &quot;Last Team Standing&quot;) and (Playing == true) then
					if (Player.TeamColor == Game.Teams[&quot;Not Playing&quot;].TeamColor) then
						local Gui = Player.PlayerGui.ScreenGui
						Gui.SpectateButton.Visible = true
					end
				end
	--Player Death handling
				Player.Character.Humanoid.Died:connect(function()
					Player.Spawned.Value = &quot;False&quot;
					if (Mode == &quot;Last Team Standing&quot;) then
						Player.TeamColor = Game.Teams[&quot;Not Playing&quot;].TeamColor
					end
				end)
			end
		end)
	--Player Chat handling
		Player.Chatted:connect(function(Message)
			if (Low(Message) == &quot;reset&quot;) then
				local Character = Player.Character
				if (Character) then
					Character:BreakJoints()
				end
			end
			Message = Player.Name..&quot;: &quot;..Message
			local Color = Color3.new(Player.TeamColor.r, Player.TeamColor.g, Player.TeamColor.b)
			shared.DisplayMessage(Message, Color)
		end)
	end
end

--Function DisplayMessage
--Displays a Message in the chat box of all Players

shared.DisplayMessage = function(Message, Color)
	local NumGui = 5
	local Players = Game.Players:GetChildren()
	for a = 1, #Players do
		if (Players[a]:findFirstChild(&quot;PlayerGui&quot;)) then
			local Gui = Players[a].PlayerGui.ScreenGui.HUDPanel.Chat
			local Filled = 0
			for b = 1, NumGui do
				if (Gui[tostring(b)].className == &quot;TextLabel&quot;) and (Gui[tostring(b)].Name ~= &quot;Header&quot;) then
					if (Gui[tostring(b)].Text ~= &quot;&quot;) then
						Filled = Filled + 1
					end
				end
			end
			if (Filled == 0) then
				Gui[&quot;1&quot;].Text = Message
				Gui[&quot;1&quot;].TextColor3 = Color
			elseif (Filled &gt; 0) and (Filled &lt; NumGui) then
				Gui[tostring(Filled + 1)].Text = Message
				Gui[tostring(Filled + 1)].TextColor3 = Color
			elseif (Filled == NumGui) then
				for b = 2, NumGui do
					Gui[tostring(b - 1)].Text = Gui[tostring(b)].Text
					Gui[tostring(b - 1)].TextColor3 = Gui[tostring(b)].TextColor3
				end
				Gui[tostring(NumGui)].Text = Message
				Gui[tostring(NumGui)].TextColor3 = Color
			end
		end
	end
end

--Function Notify
--Notifies a Player of a Message

shared.Notify = function(Player, Text)
	if (Player:findFirstChild(&quot;PlayerGui&quot;)) then
		local Guis = Player.PlayerGui.ScreenGui:GetChildren()
		for i = 1, #Guis do
			if (Guis[i].Name == &quot;Notification&quot;) then
				Guis[i]:Remove()
			end
		end
		local Gui = Game.Lighting.Notification:Clone()
		Gui.Parent = Player.PlayerGui.ScreenGui
		Gui.Text = Text
		Game.Debris:AddItem(Gui, 5)
	end
end

--Function DisplayPlayer
--Displaysa Message and Image of a Player to a Player

shared.DisplayPlayer = function(Message, OfPlayer, ToPlayer)
	local Gui = ToPlayer.PlayerGui.ScreenGui.HUDPanel.Kill
	local Avatar = Gui.Avatar
	local Header = Gui.Header
	Avatar.Image = &quot;http://www.roblox.com/thumbs/avatar.ashx?x=150&amp;y=200&amp;format=png&amp;userId=&quot;..OfPlayer.userId..&quot;&amp;RAND=&quot;
	Header.Text = Message
end

--Function CheckTeam
--Checks if the Team that lost a flag still has any left

shared.CheckTeam = function(TeamColor, EnemyColor, Capturer, Flag)
	if (TeamColor ~= Game.Teams[&quot;Not Playing&quot;].TeamColor) then
		local Flags = Workspace.Map:GetChildren()
		local FlagNum = 0
		for i = 1, #Flags do
			if (Flags[i]:findFirstChild(&quot;Flag&quot;)) then
				if (Flags[i].Flag.BrickColor == TeamColor) then
					FlagNum = FlagNum + 1
				end
			end
		end
		if (FlagNum == 0) then
			local Players = Game.Players:GetChildren()
			for i = 1, #Players do
				if (Players[i].TeamColor == TeamColor) then
					if (Players[i].Character) then
						Players[i].Killer.Value = Capturer.Name
						Players[i].Character:BreakJoints()
						local Text = &quot;Your Team has lost control of all Flags and has joined &quot;..Capturer.Name..&quot;&apos;s Team&quot;
						shared.Notify(Players[i], Text)
					end
					Players[i].TeamColor = Capturer.TeamColor
				end
			end
			local Team = Game.Teams:GetChildren()
			for i = 1, #Team do
				if (Team[i].TeamColor == TeamColor) then
					Team[i]:Remove()
				end
			end
			return Capturer.Name..&quot; Eliminated &quot;..Flag
		end
		return &quot;None&quot;
	end
	return &quot;None&quot;
end
	
Game.Players.ChildAdded:connect(Entered)

-----------------------------------------------------------------------------------------------------------Game Play--------------------------------------------------------------------------------------------------------------------------------

function Initialize()
--Chooses a random map
	local Message = Instance.new(&quot;Message&quot;, Workspace)
	local Maps = Game.Lighting.Maps:GetChildren()
	for i = 1, 10 do
		for i = 1, #Maps do
			wait(0.1)
			Message.Text = &quot;Choosing map: &quot;..Maps[i].Name
		end
	end
	local Map = Maps[Random(1, #Maps)]
	Message.Text = &quot;Map chosen: &quot;..Map.Name
	wait(3)
	for i = 1, 10 do
		for i = 1, #Modes do
			wait(0.1)
			Message.Text = &quot;Choosing mode: &quot;..Modes[i]
		end
	end
	local Choice = Random(1, #Modes)
	local Time = Times[Choice]
	Mode = Modes[Choice]
	Message.Text = &quot;Mode chosen: &quot;..Mode
	wait(3)
	if (Mode == &quot;Conquest&quot;) then
		Message.Text = &quot;Conquest: Capture Flags and eliminate Teams by stealing their Flags!&quot;
	elseif (Mode == &quot;Deathmatch&quot;) then
		Message.Text = &quot;Deathmatch: Kill enemies and the Team with the most kills wins!&quot;
	elseif (Mode == &quot;Last Team Standing&quot;) then
		Message.Text = &quot;Last Team Standing: Kill enemies to eliminate them. Last Team standing wins!&quot;
	elseif (Mode == &quot;Team Swap&quot;) then
		Message.Text = &quot;Team Swap: Kill enemies to swap them to your Team. Last Team standing wins!&quot;
	elseif (Mode == &quot;King of the Flag&quot;) then
		Message.Text = &quot;King of the Flag: Grab the flag and carry it to earn points. Team with most points wins!&quot; 
	end
	wait(5)
	Message.Text = &quot;Please read the controls. Don&apos;t complain if you don&apos;t&quot;
	Game.Debris:AddItem(Message, 5)
	wait(5)
	Map = Map:Clone()
	Map.Name = &quot;Map&quot;
	Map.Parent = Workspace
	local Flags = Map:GetChildren()
	for i = 1, #Flags do
		if (Flags[i].Name ~= &quot;Map&quot;) then
			local Color = script.Color:Clone()
			Color.Parent = Flags[i]
			if (Mode == &quot;Conquest&quot;) then
				local Capture = script.Capture:Clone()
				Capture.Parent = Flags[i]
			else
				if (Sub(Flags[i].Name, 1, 4) == &quot;Flag&quot;) then
					Flags[i]:Remove()
				end
			end
			if (Mode ~= &quot;King of the Flag&quot;) then
				if (Flags[i].Name == &quot;KingFlag&quot;) then
					Flags[i]:Remove()
				end
			else
				if (Flags[i].Name == &quot;KingFlag&quot;) then
					local King = script.King:Clone()
					King.Parent = Flags[i]
				end
			end
		end
	end
--Formats the teams and starts the match
	if (Mode ~= &quot;Last Team Standing&quot;) then
		Game.Teams[&quot;Not Playing&quot;].AutoAssignable = false
		local Team = Game.Teams:GetChildren()
		for i = 1, #Team do
			if (Team[i].Name ~= &quot;Not Playing&quot;) then
				Team[i].AutoAssignable = true
			end
		end
	else
		Game.Teams[&quot;Not Playing&quot;].AutoAssignable = true
		local Team = Game.Teams:GetChildren()
		for i = 1, #Team do
			if (Team[i].Name ~= &quot;Not Playing&quot;) then
				Team[i].AutoAssignable = false
			end
		end
	end
	local Players = Game.Players:GetChildren()
	local TeamNum = 0
	local Team = &quot;None&quot;
	for i = 1, #Players do
		local Character = Players[i].Character
		if (Character) then
			local Gui = Players[i].PlayerGui.ScreenGui
			Gui.InfoPanel.Visible = true
			TeamNum = TeamNum &lt; 4 and TeamNum + 1 or 1
			Team = Teams[TeamNum]
			TeamColor = Game.Teams[Team].TeamColor
			Players[i].TeamColor = TeamColor
		end
		if (Players[i]:findFirstChild(&quot;PlayerGui&quot;)) then
			Players[i].PlayerGui.ScreenGui.Header.Visible = true
		end
	end
	RunGame(Mode, Time)
end	

function RunGame(Mode, Time)
	Playing = true
	Hint.Parent = nil
	TeamFlags = {0, 0, 0, 0}
	TeamKills = {0, 0, 0, 0}
	PlayersLeft = {0, 0, 0, 0}
	TeamPoints = {0, 0, 0, 0}
	for Minutes = Time - 1, 0, -1 do
		for Seconds = 59, 0, -1 do
			wait(1)
			if (Mode == &quot;Conquest&quot;) then
				Conquest(Minutes, Seconds)
			elseif (Mode == &quot;Deathmatch&quot;) then
				Deathmatch(Minutes, Seconds)
			elseif (Mode == &quot;Last Team Standing&quot;) then
				Elimination(Minutes, Seconds)
			elseif (Mode == &quot;Team Swap&quot;) then
				Elimination(Minutes, Seconds)
			elseif (Mode == &quot;King of the Flag&quot;) then
				King(Minutes, Seconds)
			end
		end
	end
	if (Mode == &quot;Conquest&quot;) then
		local Winner, Score = GetWinner(TeamFlags)
		EndGame(&quot;Time&apos;s up! &quot;..Winner..&quot; won with &quot;..Score..&quot; Flags controlled&quot;)
	elseif (Mode == &quot;Deathmatch&quot;) then
		local Winner, Score = GetWinner(TeamKills)
		EndGame(&quot;Time&apos;s up! &quot;..Winner..&quot; won with &quot;..Score..&quot; Kills&quot;)
	elseif (Mode == &quot;Last Team Standing&quot;) then
		local Winner, Score = GetWinner(PlayersLeft)
		EndGame(&quot;Time&apos;s up! &quot;..Winner..&quot; won with &quot;..Score..&quot; Players alive&quot;)
	elseif (Mode == &quot;Team Swap&quot;) then
		local Winner, Score = GetWinner(PlayersLeft)
		EndGame(&quot;Time&apos;s up! &quot;..Winner..&quot; won with &quot;..Score..&quot; Players alive&quot;)
	elseif (Mode == &quot;King of the Flag&quot;) then
		local Winner, Score = GetWinner(TeamPoints)
		EndGame(&quot;Time&apos;s up! &quot;..Winner..&quot; won with &quot;..Score..&quot; Points&quot;)
	end
end

function Conquest(Minutes, Seconds)
	TeamFlags = {0, 0, 0, 0}
	for a = 1, #Teams do
		local Team = Game.Teams:findFirstChild(Teams[a])
		if (Team) then
			local Flag = Workspace.Map:GetChildren()
			for b = 1, #Flag do
				if (Flag[b]:findFirstChild(&quot;Flag&quot;)) then
					if (Flag[b].Flag.BrickColor == Team.TeamColor) then
						TeamFlags[a] = TeamFlags[a] + 1
					end
				end
			end
			local Players = Game.Players:GetChildren()
			local PlayerCount = 0
			for b = 1, #Players do
				if (Players[b].TeamColor == Team.TeamColor) then
					PlayerCount = PlayerCount + 1
				end
			end
			if (PlayerCount == 0) then
				if (Team.Name ~= &quot;Not Playing&quot;) then
					RemoveTeam(Team, &quot; Eliminated for having no Team members&quot;)
				end
			end
		end
	end
	local Text = &quot;Alpha Flags: &quot;..TeamFlags[1]..&quot;  Bravo Flags: &quot;..TeamFlags[2]..&quot;  Charlie Flags: &quot;..TeamFlags[3]..&quot;  Delta Flags: &quot;..TeamFlags[4]
	local TimeLeft = &quot; Time Remaining: &quot;..Minutes..&quot;:&quot;
	TimeLeft = Seconds &gt;= 10 and TimeLeft..Seconds or TimeLeft..&quot;0&quot;..Seconds
	Text = Text..TimeLeft
	local Players = Game.Players:GetChildren()
	for i = 1, #Players do
		if (Players[i]:findFirstChild(&quot;PlayerGui&quot;)) then
			local Gui = Players[i].PlayerGui.ScreenGui.LeaderboardPanel.Stats
			local Header = Players[i].PlayerGui.ScreenGui.Header
			Gui.Text = Text
			Header.Visible = true
			Header.Text = Mode
		end
	end
	local Team = Game.Teams:GetChildren()
	if (#Team == 2) then
		for a = 1, #Team do
			if (Team[a] ~= Game.Teams[&quot;Not Playing&quot;]) then
				EndGame(Team[a].Name..&quot; is the last Team standing&quot;)
			end
		end
	elseif (#Team == 1) then
		EndGame(&quot;It&apos;s a tie! All Teams were Eliminated!&quot;)
	end
end 

function Deathmatch(Minutes, Seconds)
	TeamKills = {0, 0, 0, 0}
	for a = 1, #Teams do
		local Team = Game.Teams:findFirstChild(Teams[a])
		if (Team) then
			local Players = Game.Players:GetChildren()
			for b = 1, #Players do
				if (Players[b].TeamColor == Team.TeamColor) then
					local PlayerKills = Players[b].Kills.Value
					TeamKills[a] = TeamKills[a] + PlayerKills
				end
			end
			local Players = Game.Players:GetChildren()
			local PlayerCount = 0
			for b = 1, #Players do
				if (Players[b].TeamColor == Team.TeamColor) then
					PlayerCount = PlayerCount + 1
				end
			end
			if (PlayerCount == 0) then
				if (Team.Name ~= &quot;Not Playing&quot;) then
					RemoveTeam(Team, &quot; Eliminated for having no Team members&quot;)
				end
			end
		end
	end
	local Text = &quot;Alpha Kills: &quot;..TeamKills[1]..&quot;  Bravo Kills: &quot;..TeamKills[2]..&quot;  Charlie Kills: &quot;..TeamKills[3]..&quot;  Delta Kills: &quot;..TeamKills[4]
	local TimeLeft = &quot; Time Remaining: &quot;..Minutes..&quot;:&quot;
	TimeLeft = Seconds &gt;= 10 and TimeLeft..Seconds or TimeLeft..&quot;0&quot;..Seconds
	Text = Text..TimeLeft
	local Players = Game.Players:GetChildren()
	for i = 1, #Players do
		if (Players[i]:findFirstChild(&quot;PlayerGui&quot;)) then
			local Gui = Players[i].PlayerGui.ScreenGui.LeaderboardPanel.Stats
			local Header = Players[i].PlayerGui.ScreenGui.Header
			Gui.Text = Text
			Header.Visible = true
			Header.Text = Mode
		end
	end
	local Team = Game.Teams:GetChildren()
	if (#Team == 2) then
		for a = 1, #Team do
			if (Team[a] ~= Game.Teams[&quot;Not Playing&quot;]) then
				EndGame(Team[a].Name..&quot; is the last Team standing&quot;)
			end
		end
	elseif (#Team == 1) then
		EndGame(&quot;It&apos;s a tie! All Teams were Eliminated!&quot;)
	end
end 

function Elimination(Minutes, Seconds)
	PlayersLeft = {0, 0, 0, 0}
	for a = 1, #Teams do
		local Team = Game.Teams:findFirstChild(Teams[a])
		if (Team) then
			local Players = Game.Players:GetChildren()
			local PlayerCount = 0
			for b = 1, #Players do
				if (Players[b].TeamColor == Team.TeamColor) then
					PlayerCount = PlayerCount + 1
				end
			end
			PlayersLeft[a] = PlayerCount
			if (PlayerCount == 0) then
				if (Team.Name ~= &quot;Not Playing&quot;) then
					RemoveTeam(Team, &quot; Eliminated&quot;)
				end
			end
		end
	end
	local Text = &quot;Alpha Players: &quot;..PlayersLeft[1]..&quot;  Bravo Players: &quot;..PlayersLeft[2]..&quot;  Charlie Players: &quot;..PlayersLeft[3]..&quot;  Delta Players: &quot;..PlayersLeft[4]
	local TimeLeft = &quot; Time Remaining: &quot;..Minutes..&quot;:&quot;
	TimeLeft = Seconds &gt;= 10 and TimeLeft..Seconds or TimeLeft..&quot;0&quot;..Seconds
	Text = Text..TimeLeft
	local Players = Game.Players:GetChildren()
	for i = 1, #Players do
		if (Players[i]:findFirstChild(&quot;PlayerGui&quot;)) then
			local Gui = Players[i].PlayerGui.ScreenGui.LeaderboardPanel.Stats
			local Header = Players[i].PlayerGui.ScreenGui.Header
			Gui.Text = Text
			Header.Visible = true
			Header.Text = Mode
		end
	end
	local Team = Game.Teams:GetChildren()
	if (#Team == 2) then
		for a = 1, #Team do
			if (Team[a] ~= Game.Teams[&quot;Not Playing&quot;]) then
				EndGame(Team[a].Name..&quot; is the last Team standing&quot;)
			end
		end
	elseif (#Team == 1) then
		EndGame(&quot;It&apos;s a tie! All Teams were Eliminated!&quot;)
	end
end 

function King(Minutes, Seconds)
	for a = 1, #Teams do
		local Team = Game.Teams:findFirstChild(Teams[a])
		if (Team) then
			local Players = Game.Players:GetChildren()
			local PlayerCount = 0
			for b = 1, #Players do
				if (Players[b].TeamColor == Team.TeamColor) then
					PlayerCount = PlayerCount + 1
				end
			end
			PlayersLeft[a] = PlayerCount
			if (PlayerCount == 0) then
				if (Team.Name ~= &quot;Not Playing&quot;) then
					RemoveTeam(Team, &quot; Eliminated for having no Team members&quot;)
				end
			end
			local FlagModel = Workspace.Map:findFirstChild(&quot;KingFlag&quot;)
			if (FlagModel) then
				local Flag = FlagModel.Flag
				local Color = Flag.BrickColor
				if (Color == Team.TeamColor) then
					TeamPoints[a] = TeamPoints[a] + 1
				end
			end
		end
	end
	local Text = &quot;Alpha Points: &quot;..TeamPoints[1]..&quot;  Bravo Points: &quot;..TeamPoints[2]..&quot;  Charlie Points: &quot;..TeamPoints[3]..&quot;  Delta Points: &quot;..TeamPoints[4]
	local TimeLeft = &quot; Time Remaining: &quot;..Minutes..&quot;:&quot;
	TimeLeft = Seconds &gt;= 10 and TimeLeft..Seconds or TimeLeft..&quot;0&quot;..Seconds
	Text = Text..TimeLeft
	local Players = Game.Players:GetChildren()
	for i = 1, #Players do
		if (Players[i]:findFirstChild(&quot;PlayerGui&quot;)) then
			local Gui = Players[i].PlayerGui.ScreenGui.LeaderboardPanel.Stats
			local Header = Players[i].PlayerGui.ScreenGui.Header
			Gui.Text = Text
			Header.Visible = true
			Header.Text = Mode
		end
	end
	local Team = Game.Teams:GetChildren()
	if (#Team == 2) then
		for a = 1, #Team do
			if (Team[a] ~= Game.Teams[&quot;Not Playing&quot;]) then
				EndGame(Team[a].Name..&quot; is the last Team standing&quot;)
			end
		end
	elseif (#Team == 1) then
		EndGame(&quot;It&apos;s a tie! All Teams were Eliminated!&quot;)
	end
end 

function RemoveTeam(Team, Text)
	local Map = Workspace:findFirstChild(&quot;Map&quot;)
	if (Map) then
		local Models = Map:GetChildren()
		for a = 1, #Models do
			if (Models[a]:findFirstChild(&quot;Flag&quot;)) then
				if (Models[a].Flag.BrickColor == Team.TeamColor) then
					Models[a].Flag.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
				end
			end
		end
		local Text = Team.Name..Text
		local Color = Color3.new(Team.TeamColor.r, Team.TeamColor.g, Team.TeamColor.b)
		shared.DisplayMessage(Text, Color)
		Team:Remove()
	end
end

function GetWinner(Points)
	local TeamNames = {&quot;Alpha&quot;, &quot;Bravo&quot;, &quot;Charlie&quot;, &quot;Delta&quot;}
	local Go = 0
	while Go == 0 do wait()
		Go = 1
		for i = 1, #TeamNames - 1 do
			if (Points[i] &lt; Points[i + 1]) then
				local Temp = Points[i]
				Points[i] = Points[i + 1]
				Points[i + 1] = Temp
				Temp = TeamNames[i]
				TeamNames[i] = TeamNames[i + 1]
				TeamNames[i + 1] = Temp
				Go = 0
			end
		end
	end
	return TeamNames[1], Points[1]
end
	
function EndGame(Text)
	Playing = false
	Game.Teams[&quot;Not Playing&quot;].AutoAssignable = true
	local Team = Game.Teams:GetChildren()
	for i = 1, #Team do
		if (Team[i].Name ~= &quot;Not Playing&quot;) then
			Team[i].AutoAssignable = false
		end
	end
	local Players = Game.Players:GetChildren()
	local PlayerNum = 0
	local Leaderboard = nil
	for i = 1, #Players do
		if (Players[i]:findFirstChild(&quot;PlayerGui&quot;)) then
			PlayerNum = PlayerNum + 1
			if (PlayerNum == 1) then
				Leaderboard = Players[i].PlayerGui.ScreenGui.LeaderboardPanel:Clone()
				Leaderboard.Leaderboard:Remove()
			else
				Leaderboard = Leaderboard:Clone()
			end
			local G = Players[i].PlayerGui.ScreenGui:GetChildren()
			local GuiRemoval = {&quot;LeaderboardPanel&quot;, &quot;InfoPanel&quot;, &quot;WeaponPanel&quot;, &quot;SpawnPanel&quot;, &quot;Blocker&quot;, &quot;SpectateButton&quot;, &quot;SpectatePanel&quot;}
			for b = 1, #G do
				for c = 1, #GuiRemoval do
					if (G[b].Name == GuiRemoval[c]) then
						G[b]:Remove()
					end
				end
			end
			Leaderboard.Name = &quot;EndGame&quot;
			Leaderboard.Visible = true
			Leaderboard.Parent = Players[i].PlayerGui.ScreenGui
			Players[i].PlayerGui.ScreenGui.Header.Visible = false
		end
		Players[i].TeamColor = BrickColor.new(&quot;Institutional white&quot;)
		if (Players[i].Character) then
			Players[i].Character:BreakJoints()
			Players[i].Killer.Value = &quot;&quot;
			Players[i].Victim.Value = &quot;No one&quot;
			Players[i].Kills.Value = 0
		end
		shared.Notify(Players[i], &quot;Game over! &quot;..Text)
	end
	wait(5)
	local Map = Workspace[&quot;Map&quot;]
	Map:Remove()
	wait(5)
	local Team = Game.Teams:GetChildren()
	for i = 1, #Team do
		Team[i]:Remove()
	end
	Team = Game.Lighting.Teams:GetChildren()
	for i = 1, #Team do
		Team[i]:Clone().Parent = Game.Teams
	end
	Restart()
end

function Restart()
	Hint.Parent = Workspace
	while wait() do
		local Players = Game.Players
		if (Players.NumPlayers &gt;= Min) then
			repeat
				wait()
				Players = Game.Players:GetChildren()
				Count = 0
				for i = 1, #Players do
					if (Players[i].Character ~= nil) then
						Count = Count + 1
					end
				end
				Hint.Text = &quot;Waiting for all characters to load...&quot;
			until Count == #Players
			Initialize()
		else
			Hint.Text = &quot;Waiting for &quot;..Min - Players.NumPlayers..&quot; more player(s)&quot;
		end
	end
end

