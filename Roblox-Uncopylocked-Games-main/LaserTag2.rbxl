					<string name="Name">Capture</string>
					<ProtectedString name="Source">--Variables
local Percent = 0
local Max = 100

local Paused = false
local Reset = false

local Create = coroutine.create
local Resume = coroutine.resume

local Flag = script.Parent.Flag
local Stand = script.Parent.Stand

local FlagInterval = Stand.Size.y - Flag.Size.y
local Set = Flag.CFrame

local FirstColor = &quot;None&quot;

--Main loop

Game:GetService(&quot;RunService&quot;).Heartbeat:connect(function()
	Flag.Transparency = 0
	local Capturer = &quot;None&quot;
	local Capturers = 0
	local Defenders = 0
	local Flag = script.Parent.Flag
	local FlagColor = Flag.BrickColor
	local Players = Game.Players:GetChildren()
	for i = 1, #Players do
		local Character = Players[i].Character
		if (Character) then
			local Torso = Character:findFirstChild(&quot;Torso&quot;)
			if (Torso) then
				local Humanoid = Character.Humanoid
				local Distance = (Torso.CFrame.p - Flag.CFrame.p).magnitude
				if (Distance &lt; 15 and Humanoid.Health &gt; 0) then
--If the player is in capturing range of the flag
					if (FirstColor == &quot;None&quot;) then
						FirstColor = Players[i].TeamColor
					end
					if (FirstColor ~= &quot;None&quot;) then
--Adds Capturer or Defender
						if (Players[i].TeamColor == FirstColor) then
							if (Players[i].TeamColor ~= FlagColor) then 
								Capturers = Capturers + 1
							end
						else
							Defenders = Defenders + 1
						end
					end
					Capturer = Players[i]
				end
			end
		end
	end
	if (Capturers &gt; 0) then
		if (Defenders == 0) then
--If someone is capturing with no one defending
			Flag.Transparency = 0
			if (Reset == false) then
				if (Percent &lt; Max) then
					Percent = Percent + (Capturers / 5)
				else
					Percent = Max
					Reset = true
				end
--When the flag is going back up
			elseif (Reset == true) then
				if (Percent &gt; 0) then
					Percent = Percent - (Capturers / 5)
				else
					local Color = Flag.BrickColor
					Percent = 0
					Reset = false
					Flag.BrickColor = FirstColor
					local Text = shared.CheckTeam(Color, FirstColor, Capturer, script.Parent.Name)
--Displays the capturer to all players
					Text = Text == &quot;None&quot; and Capturer.Name..&quot; captured &quot;..script.Parent.Name or Text
					local Players = Game.Players:GetChildren()
					for i = 1, #Players do
						shared.DisplayPlayer(Text, Capturer, Players[i])
						if (Players[i].TeamColor == Color) then
							shared.Notify(Players[i], &quot;You lost &quot;..script.Parent.Name)
						end
					end
					shared.DisplayMessage(Text, Color3.new(FirstColor.r, FirstColor.g, FirstColor.b))
					FirstColor = &quot;None&quot;
				end
			end
		else
--When someone is attemtping to capture while someone is defending
			Flag.Transparency = 0.5
		end
	else
--When no one is there
		FirstColor = &quot;None&quot;
		if (Percent &gt; 0) then
			Percent = Percent - 1
			Reset = false
		else
--Resets the flag
			Reset = false
		end
	end
--Moves the flag
	Flag.CFrame = Set - Vector3.new(0, (Percent / Max) * FlagInterval, 0)
end)
		
					
				</ProtectedString>
