					<Item class="LocalScript" referent="RBX53">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Animation</string>
							<ProtectedString name="Source">--Variables
local Player = Game.Players.LocalPlayer
local Hopperbin = script.Parent
local Sighted = script.Sighted
local Name = &quot;Gun&quot;

local Rad = math.rad
local Create = coroutine.create
local Resume = coroutine.resume

local Crouch, Prone, Sprint, Sprinting = false, false, false, false
local Leaderboard = false

function Selected(Mouse)
	Mouse.Icon = &quot;http://www.roblox.com/asset/?id=15324984&quot;
--Key press event
	Mouse.KeyDown:connect(Pressed)
	Mouse.KeyUp:connect(UnPressed)
	Character = Player.Character
	Torso = Character.Torso
	NeckOrigin = Torso[&quot;Neck&quot;].C0
	Camera = Workspace.CurrentCamera
	Humanoid = Character.Humanoid
	Head = Character.Head
	RightLeg = Character[&quot;Right Leg&quot;]
	LeftLeg = Character[&quot;Left Leg&quot;]
--Gives the weapon handle to you
	local Guns = Camera:GetChildren()
	if (#Guns &gt; 0) then
		for i = 1, #Guns do
			if (Guns[i].Name == &quot;Gun&quot;) then
				Guns[i]:Remove()
			end
		end
	end
	Humanoid.Died:connect(function()
		wait(0.5)
		KillCam()
	end)
	Gun = Game.Lighting.Guns.Weapons[Name]:Clone()
	Gun.Parent = Camera
	Gun = Gun.Gun
	local Weld, Weld2 = Weld(Gun)
	FormCharacter()
--Formats your gun to you according to camera direction
	Resume(Create(function()
		while wait(0.05) do
			AlignWeapon(Weld, Weld2, Mouse)
			local Gui = Player.PlayerGui.ScreenGui.LeaderboardPanel
			if (Leaderboard == true) then
				Gui.Visible = true
			else
				Gui.Visible = false
			end
--Forces the user into First Person
			local Gui = Player.PlayerGui.ScreenGui
			if ((Camera.Focus.p - Camera.CoordinateFrame.p).magnitude &gt; 1) then
				Gui.Blocker.Visible = true
			else
				Gui.Blocker.Visible = false
			end
			GetWalkSpeeds()
		end
	end))
end

function Pressed(Key)
	if (Key == &quot;q&quot;) then
--When Q is pressed you toggle sights
		if (Sighted.Value == &quot;False&quot;) then
			Sighted.Value = &quot;True&quot;
		else
			Sighted.Value = &quot;False&quot;
		end
--When C is pressed you toggle crouch
	elseif (Key == &quot;c&quot;) then
		Prone = false
		Crouch = not Crouch
		DoCrouch()
--When X is pressed you toggle prone
	elseif (Key == &quot;x&quot;) then
		Crouch = false
		Prone = not Prone
		DoProne()
--When E is held the leaderboard appears
	elseif (Key == &quot;e&quot;) then
		Leaderboard = true
--When Shift is pressed you run
	elseif (Key == &quot;0&quot;) then
		if (Sprinting == false) then
			Sprinting, Sprint = true, true
			Crouch, Prone, Sighted.Value = false, false, &quot;False&quot;
			DoProne()
			DoCrouch()
			Resume(Create(function()
				local Time = 0
				repeat
					wait(0.1)
					Time = Time + 0.1
				until Crouch == true or Prone == true or Sighted.Value == &quot;True&quot; or Time &gt;= 5
				Sprint = false
				wait(2)
				Sprinting = false
			end))	
		end
	end
end

function UnPressed(Key)
--When E is unpressed the leaderboard disappears
	if (Key == &quot;e&quot;) then
		Leaderboard = false
	end
end

function AlignWeapon(Weld, Weld2, Mouse)
	local Target = Camera.CoordinateFrame * CFrame.new(0, 0, -100)
--Checks if you are in sights or not and formats the gun accordingly
	if (Sighted.Value == &quot;False&quot;) then
		Weld2.C0 = CFrame.new(0.75, -0.75, -0.75) * CFrame.Angles(Rad(90), 0, 0)
		Mouse.Icon = &quot;http://www.roblox.com/asset/?id=15324984&quot;
	else
		Weld2.C0 = CFrame.new(0.15, -0.45, -1) * CFrame.Angles(Rad(88), 0, 0)
		Mouse.Icon = &quot;http://www.roblox.com/asset/?id=22416261&quot;
	end
--Updates everything
	Weld.C0 = CFrame.new(0, 0, 0)
	Weld.C1 = (CFrame.new(Head.CFrame.p, Target.p) - Head.CFrame.p):inverse() * (Head.CFrame - Head.Position)
end

function GetWalkSpeeds()
	if (Sprint == false) then
		if (Sighted.Value == &quot;True&quot;) then
			if (Crouch == true) then
				Humanoid.WalkSpeed = 4
			else
				if (Prone == true) then
					Humanoid.WalkSpeed = 0
				else
					Humanoid.WalkSpeed = 8
				end
			end
		else
			if (Crouch == true) then
				Humanoid.WalkSpeed = 8
			else
				if (Prone == true) then
					Humanoid.WalkSpeed = 2
				else
					Humanoid.WalkSpeed = 16
				end
			end
		end
	else
		Humanoid.WalkSpeed = 24
	end
end

function KillCam()
	local Killer = Game.Players:findFirstChild(Player.Killer.Value)
	if (Killer) then
		if (Killer.Character) then
			if (Killer.Character:findFirstChild(&quot;Humanoid&quot;)) then
				Camera.CameraSubject = Killer.Character.Humanoid
				Camera.CoordinateFrame = Camera.CoordinateFrame + Vector3.new(0, 10, 10)
				Player.PlayerGui.ScreenGui.Blocker:Remove()
				Player.Killer.Value = &quot;&quot;
			end
		end
	end
end

function Weld(Model)
--Creates a new head and welds the gun to that
	local NewHead = Instance.new(&quot;Part&quot;)
	NewHead.CanCollide = false
	NewHead.Size = Vector3.new(1, 1, 1)
	NewHead.formFactor = &quot;Symmetric&quot;
	NewHead.Transparency = 1
	NewHead.Parent = Character
	local W = Instance.new(&quot;Weld&quot;, Head)
	W.Part0 = Head
	W.Part1 = NewHead
	local W2 = Instance.new(&quot;Weld&quot;, NewHead)
	W2.Part0 = NewHead
	W2.Part1 = Gun
	local W3 = Instance.new(&quot;Weld&quot;, Gun)
	local Sight = Gun.Parent.Front
	W3.Part0 = Gun
	W3.Part1 = Sight
	W3.C0 = Gun.CFrame:inverse() * CFrame.new(Gun.Position)
	W3.C1 = Sight.CFrame:inverse() * CFrame.new(Gun.Position)
	Gun.Anchored = false
	Sight.Anchored = false
--Returns the welds for further use
	return W, W2
end

function FormCharacter()
--Forms the new Body Parts
	local NewHead = Head:Clone()
	NewHead.Name = &quot;NewHead&quot;
	NewHead.Parent = Character
	local HeadWeld = Instance.new(&quot;Weld&quot;, Head)
	HeadWeld.Part0 = Head
	HeadWeld.Part1 = NewHead
	local NewTorso = Instance.new(&quot;Part&quot;, Character)
	NewTorso.Name = &quot;NewTorso&quot;
	NewTorso.BrickColor = Player.TeamColor
	NewTorso.Size = Vector3.new(2, 2, 1)
	NewTorso.formFactor = &quot;Symmetric&quot;
	NewTorso.CanCollide = false
	local TorsoWeld = Instance.new(&quot;Motor&quot;, Torso)
	TorsoWeld.Name = &quot;TorsoWeld&quot;
	TorsoWeld.Part0 = Torso
	TorsoWeld.Part1 = NewTorso
	TorsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, Rad(-45), 0)
	local RightArm = Character[&quot;Right Arm&quot;]
	local RightArmWeld = Instance.new(&quot;Motor&quot;, Torso)
	RightArmWeld.Part0 = Torso
	RightArmWeld.Part1 = RightArm
	RightArmWeld.C0 = CFrame.new(1, 0.5, 0) * CFrame.Angles(Rad(90), 0, 0)
	local LeftArm = Character[&quot;Left Arm&quot;]
	local LeftArmWeld = Instance.new(&quot;Motor&quot;, Torso)
	LeftArmWeld.Part0 = Torso
	LeftArmWeld.Part1 = LeftArm
	LeftArmWeld.C0 = CFrame.new(0, 0.5, -1) * CFrame.Angles(Rad(90), 0, Rad(90))
	local RightLegWeld = Torso[&quot;Right Hip&quot;]
	RightLegWeld.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, Rad(45), 0)
	local LeftLegWeld = Torso[&quot;Left Hip&quot;]
	LeftLegWeld.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
--Formats the Visual Gun
	local NewGun = Game.Lighting.Guns.Weapons[Name].Gun:Clone()
	NewGun.Anchored = false
	NewGun.Parent = Character
	local GunWeld = Instance.new(&quot;Weld&quot;, RightArm)
	GunWeld.Part0 = RightArm
	GunWeld.Part1 = NewGun
	GunWeld.C0 = CFrame.new(0, -1, -0.5)
--Hides real Head / Torso
	Torso.Transparency = 1
	Head.Transparency = 1
end

function DoCrouch()
	local TorsoWeld = Torso[&quot;TorsoWeld&quot;]
	TorsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, Rad(-45), 0)
	local Neck = Torso[&quot;Neck&quot;]
	Neck.C0 = NeckOrigin
	if (Crouch == true) then
		local RightHip = Torso[&quot;Right Hip&quot;]
		RightHip.C0 = CFrame.new(1.3, -0.1, 0.1) * CFrame.Angles(0, Rad(45), Rad(-20))
		local LeftHip = Torso[&quot;Left Hip&quot;]
		LeftHip.C0 = RightHip.C0 * CFrame.new(0, 0, -1)
		RightLeg.Name = &quot;RightLeg&quot;
		LeftLeg.Name = &quot;LeftLeg&quot;
		RightLeg.CanCollide = true
		LeftLeg.CanCollide = true
	else
		local RightHip = Torso[&quot;Right Hip&quot;]
		RightHip.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, Rad(45), 0)
		local LeftHip = Torso[&quot;Left Hip&quot;]
		LeftHip.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
		RightLeg.Name = &quot;Right Leg&quot;
		LeftLeg.Name = &quot;Left Leg&quot;
		RightLeg.CanCollide = false
		LeftLeg.CanCollide = false
	end
end

function DoProne()
	local TorsoWeld = Torso[&quot;TorsoWeld&quot;]
	TorsoWeld.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(0, Rad(-45), 0)
	local Neck = Torso[&quot;Neck&quot;]
	if (Prone == true) then
		TorsoWeld.C0 = CFrame.new(0, 0.5, 0) * CFrame.Angles(Rad(-90), 0, 0)
		local RightHip = Torso[&quot;Right Hip&quot;]
		RightHip.C0 = CFrame.new(1, 0.5, 1) * CFrame.Angles(Rad(-90), Rad(90), 0)
		local LeftHip = Torso[&quot;Left Hip&quot;]
		LeftHip.C0 = RightHip.C0 * CFrame.new(0, 0, -1)
		RightLeg.Name = &quot;RightLeg&quot;
		LeftLeg.Name = &quot;LeftLeg&quot;
		RightLeg.CanCollide = true
		LeftLeg.CanCollide = true
		RightHip.MaxVelocity = 0
		LeftHip.MaxVelocity = 0
		Neck.C0 = Neck.C0 - Vector3.new(0, 0, 0.5)
	else
		local RightHip = Torso[&quot;Right Hip&quot;]
		RightHip.C0 = CFrame.new(0.7, -1, 0.7) * CFrame.Angles(0, Rad(45), 0)
		local LeftHip = Torso[&quot;Left Hip&quot;]
		LeftHip.C0 = CFrame.new(-0.7, -1, -0.7) * CFrame.Angles(0, -2.35, 0)
		RightLeg.Name = &quot;Right Leg&quot;
		LeftLeg.Name = &quot;Left Leg&quot;
		RightLeg.CanCollide = false
		LeftLeg.CanCollide = false
		RightHip.MaxVelocity = 0.1
		LeftHip.MaxVelocity = 0.1
		Neck.C0 = Neck.C0 + Vector3.new(0, 0, 0.5)
	end
end

Hopperbin.Selected:connect(Selected)</ProtectedString>
