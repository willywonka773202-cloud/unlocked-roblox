				<Item class="LocalScript" referent="RBX2848">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Players</string>
						<ProtectedString name="Source">wait(1)

local Teams = {&quot;Alpha&quot;, &quot;Bravo&quot;, &quot;Charlie&quot;, &quot;Delta&quot;}

local Team = script.Parent:GetChildren()
for a = 1, #Team do
	if (Team[a].className == &quot;TextLabel&quot;) and (Team[a].Name ~= &quot;Heading&quot;) then
		local Slot = Team[a]:GetChildren()	
		for b = 1, #Slot do
			Slot[b].MouseButton1Click:connect(function()
				local Player = Game.Players:findFirstChild(Slot[b].Text)
				if (Player) then
					Spectate(Player)
				end
			end)
		end
	end
end

function Spectate(Player)
	local Character = Player.Character
	if (Character) then
		local Humanoid = Character.Humanoid
		local Camera = Workspace.CurrentCamera
		Camera.CameraSubject = Humanoid
		script.Parent.Visible = false
	end
end

Game:GetService(&quot;RunService&quot;).Heartbeat:connect(function()
	local Players = Game.Players:GetChildren()
	for a = 1, #Teams do
		if (Game.Teams:findFirstChild(Teams[a])) then
			local Kills = {}
			local Names = {}
			for b = 1, #Players do
				if (Players[b].TeamColor == Game.Teams[Teams[a]].TeamColor) and (Players[b].Spawned.Value == &quot;True&quot;) then
					if (Players[b] ~= Game.Players.LocalPlayer) then
						table.insert(Kills, Players[b].Kills.Value)
						table.insert(Names, Players[b].Name)
					end
				end
			end
			local Go = 0
			while Go == 0 do wait()
				Go = 1
				for b = 1, #Names - 1 do
					if (Kills[b] &lt; Kills[b + 1]) then
						Temp = Kills[b]
						Kills[b] = Kills[b + 1]
						Kills[b + 1] = Temp
						Temp = Names[b]
						Names[b] = Names[b + 1]
						Names[b + 1] = Temp
						Go = 0
					end
				end
			end	
			local Gui = script.Parent[Teams[a]]
			local Num = 0
			for b = 1, #Names do
				Gui[b].Text = Names[b]
				Num = Num + 1
			end
			Gui = script.Parent[Teams[a]]:GetChildren()
			for b = 1, #Gui do
				if (tonumber(Gui[b].Name) &gt; Num) then
					Gui[b].Text = &quot;&quot;
				end
				if (Gui[b].Text == &quot;&quot;) then
					Gui[b].AutoButtonColor = false
				else
					Gui[b].AutoButtonColor = true
				end
			end
		else
			local Gui = script.Parent[Teams[a]]:GetChildren()
			for a = 1, #Gui do
				Gui[a].Text = &quot;&quot;
			end
		end
	end
end)

