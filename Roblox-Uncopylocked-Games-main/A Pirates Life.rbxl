					<Item class="Script" referent="RBX631">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local deb = false

script.Parent.Touched:connect(function(hit)
&#9;if not hit or not hit.Parent or deb or not hit.Parent:findFirstChild(&quot;Humanoid&quot;) then return end
&#9;deb = true
&#9;for i,j in pairs(hit.Parent:GetChildren()) do
&#9;&#9;if j:IsA(&quot;CharacterMesh&quot;) then
&#9;&#9;&#9;j:remove()
&#9;&#9;end
&#9;end
&#9;for i,j in pairs(script.Parent.Parent:GetChildren()) do
&#9;&#9;if j:IsA(&quot;CharacterMesh&quot;) then
&#9;&#9;&#9;j:clone().Parent = hit.Parent
&#9;&#9;end
&#9;end
&#9;wait(1)
&#9;deb = false
end)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
