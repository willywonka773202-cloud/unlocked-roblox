							<ProtectedString name="Source">local brick = script.Parent.Parent.GreenHealthBar

script.Parent.Changed:connect(function()
&#9;if script.Parent.Value &gt; 0 then
&#9;&#9;brick.Mesh.Scale = Vector3.new(script.Parent.Value / 100,1,1)
&#9;&#9;brick.Mesh.Offset = Vector3.new(brick.Mesh.Scale.x / -2,0,0)
&#9;else
&#9;&#9;brick.Transparency = 1
&#9;&#9;script.Parent.Parent.Engine.Gyro:remove()
&#9;&#9;for i = 1, 400 do
&#9;&#9;&#9;script.Parent.Parent.Engine.BPos.position = script.Parent.Parent.Engine.BPos.position + Vector3.new(0,-0.15,0)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;script.Parent.Parent:remove()
&#9;end
end)
</ProtectedString>
