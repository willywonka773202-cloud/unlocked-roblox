						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">local Tool = script.Parent
local halt = false
local mouse = nil

function onActivated()
&#9;if halt then return end
&#9;halt = true

&#9;local player = game.Players:GetPlayerFromCharacter(Tool.Parent)
&#9;local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if not h or not player or not mouse then
&#9;&#9;halt = false
&#9;&#9;return
&#9;end

&#9;local p = Tool.Handle:Clone()
&#9;
&#9;Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.7
&#9;Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3.6
&#9;wait(.1)
&#9;Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 1

&#9;local tosser = Instance.new(&quot;ObjectValue&quot;)
&#9;tosser.Value = player
&#9;tosser.Name = &quot;Tosser&quot;
&#9;tosser.Parent = p

&#9;local dir = CFrame.new(h.Parent.Head.CFrame.p,mouse.hit.p).lookVector--h.Parent.Head.CFrame.lookVector
&#9;p.Velocity = (dir * 60) + Vector3.new(0,45,0)
&#9;p.CanCollide = true
&#9;Tool.Glass:Clone().Parent = p
&#9;p.Glass.Disabled = false
&#9;p.Parent = game.Workspace

&#9;wait()
&#9;Tool:remove()
end

