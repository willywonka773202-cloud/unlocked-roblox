				<Item class="Script" referent="RBX6274">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PetScript</string>
						<ProtectedString name="Source">local following = true
local con = false
local haveBoundaries = false

function CheckCoords(pos,color)
&#9;if not haveBoundaries then return true end
&#9;if color == BrickColor.new(&quot;Bright red&quot;) then
&#9;&#9;if pos.x &gt; 340 then return true end
&#9;&#9;if pos.x &gt; 274 and pos.z &gt; 46.5 and pos.z &lt; 70.5 then return true end
&#9;elseif color == BrickColor.new(&quot;Really black&quot;) then
&#9;&#9;if pos.x &lt; -340 then return true end
&#9;&#9;if pos.x &lt; -274 and pos.z &gt; -0.5 and pos.z &lt; 23.5 then return true end
&#9;end
&#9;return false
end

wait()
if script.Parent.Parent.className == &quot;Workspace&quot; then
&#9;local h = Instance.new(&quot;Humanoid&quot;)
&#9;h.WalkSpeed = 11
&#9;h.Name = &quot;HumaBlarg&quot;
&#9;script.Parent:MakeJoints()
&#9;h.Parent = script.Parent
&#9;script.Parent.Name = script.Parent.Owner.Value .. &quot;&apos;s &quot; .. script.Parent.Name
&#9;while true do
&#9;&#9;wait(0.1)
&#9;&#9;local player = game.Players:findFirstChild(script.Parent.Owner.Value)
&#9;&#9;if player == nil then
&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;elseif player.Character ~= nil and player.Character:findFirstChild(&quot;Torso&quot;) then
&#9;&#9;&#9;if player.Character:findFirstChild(&quot;Humanoid&quot;) and not con then
&#9;&#9;&#9;&#9;con = true
&#9;&#9;&#9;&#9;player.Character.Humanoid.Died:connect(function()
&#9;&#9;&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;end
&#9;&#9;&#9;if following then
&#9;&#9;&#9;&#9;following = CheckCoords(script.Parent.Torso.Position,player.TeamColor)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;following = CheckCoords(player.Character.Torso.Position,player.TeamColor)
&#9;&#9;&#9;end
&#9;&#9;&#9;if following and script.mode.Value == &quot;follow&quot; then
&#9;&#9;&#9;&#9;local target = player.Character.Torso
&#9;&#9;&#9;&#9;if (script.Parent.Torso.Position - target.Position).magnitude &gt; 7 then
&#9;&#9;&#9;&#9;&#9;h:MoveTo(target.Position, target)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;h:MoveTo(script.Parent.Torso.Position, script.Parent.Torso)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;h:MoveTo(script.Parent.Torso.Position, script.Parent.Torso)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
</ProtectedString>
