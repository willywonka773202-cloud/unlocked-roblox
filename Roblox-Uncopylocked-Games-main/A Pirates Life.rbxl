						<Item class="Script" referent="RBX5070">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local colors = { &quot;Red Shirt&quot;, &quot;Green Shirt&quot;, &quot;Blue Shirt&quot;, &quot;Orange Shirt&quot;, &quot;Purple Shirt&quot;, &quot;Black Shirt&quot; }
local color = colors[math.random(1,#colors)]
script.Parent.Value = color

local phrases = {
{ &quot;I want a &quot;, &quot;.&quot; },
{ &quot;Gimme dat &quot;, &quot;.&quot; },
{ &quot;Eh... I want a &quot;, &quot;.&quot; },
{ &quot;Meh wants eh &quot;, &quot;.&quot; }
}

local phrase = phrases[math.random(1,#phrases)]
script.Parent.Parent.Saying.Name = phrase[1] .. color .. phrase[2]
</ProtectedString>
							</Properties>
						</Item>
					</Item>
				</Item>
			</Item>
