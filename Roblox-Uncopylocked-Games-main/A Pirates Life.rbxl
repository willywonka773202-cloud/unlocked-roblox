						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local guys = {}

for i = 1, 3 do
&#9;local guy = script.Parent[&quot;Guy&quot; .. tostring(i)]
&#9;guys[i] = guy:clone()
&#9;guy:remove()
end

while true do
&#9;wait(math.random(5,10))
&#9;local guyNum = math.random(1,3)
&#9;local guy = guys[guyNum]:clone()
&#9;guy.DesiredColor.Script.Disabled = false
&#9;guy.Parent = script.Parent
&#9;local doo = true
&#9;local num = 0
&#9;while doo do
&#9;&#9;wait(1)
&#9;&#9;num = num + 1
&#9;&#9;if script.Parent:findFirstChild(&quot;Guy&quot; .. tostring(guyNum)) == nil then doo = false end
&#9;&#9;if num == 30 then guy:remove() doo = false end
&#9;end
end
</ProtectedString>
