							<string name="Name">CannonBallScript</string>
							<ProtectedString name="Source">local MaxExplosionDamage = 100
local MinExplosionDamage = 50
local ExplosionRange = 10

local dbs = {}
local Hit = false

function damage(human,amount)
&#9;for i, j in pairs(dbs) do if j == human then return end end
&#9;table.insert(dbs, human)

&#9;local team = script.TeamColor.Value
&#9;local p = game.Players:GetPlayerFromCharacter(human.Parent)
&#9;if not p then return end
&#9;if p.TeamColor == team then return end
&#9;human:TakeDamage(amount)

&#9;wait(.6)
&#9;for i = #dbs, 1, -1 do
&#9;&#9;if dbs[i] == human then
&#9;&#9;&#9;table.remove(dbs, i)
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(function(hit)
&#9;if Hit then return end
&#9;if hit.Transparency == 1 and not hit.CanCollide then return end
&#9;if not hit or not hit.Parent then return end
&#9;local h = hit.Parent:findFirstChild(&quot;Health&quot;)
&#9;local t = hit.Parent:findFirstChild(&quot;TeamColor&quot;)
&#9;if h ~= nil and t ~= nil and t.Value ~= script.TeamColor.Value then
&#9;&#9;h.Value = h.Value - 50
&#9;end
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;damage(hit.Parent.Humanoid, hit.Parent.Humanoid.Health)
&#9;end
&#9;if hit.Name ~= &quot;Water&quot; and hit.Name ~= &quot;CannonTip&quot; and hit.Name ~= &quot;Cannon&quot; then
&#9;&#9;local e = Instance.new(&quot;Explosion&quot;)
&#9;&#9;e.BlastPressure = 0
&#9;&#9;e.BlastRadius = ExplosionRange
&#9;&#9;e.Position = script.Parent.Position
&#9;&#9;e.Parent = workspace
&#9;&#9;e.Hit:connect(function(obj, dist)
&#9;&#9;&#9;if not obj or not obj.Parent or not obj.Parent:findFirstChild(&quot;Humanoid&quot;) then return end
&#9;&#9;&#9;damage(obj.Parent.Humanoid, ((ExplosionRange-dist)*((MaxExplosionDamage-MinExplosionDamage)/ExplosionRange))+MinExplosionDamage)
&#9;&#9;end)
&#9;&#9;Hit = true
&#9;&#9;script.Parent.Anchored = true
&#9;&#9;script.Parent.CanCollide = false
&#9;&#9;script.Parent.Transparency = 1
&#9;&#9;wait(3)
&#9;&#9;script.Parent:remove()
&#9;end
end)

while true do
&#9;wait(.1)
&#9;script.Parent.BodyVelocity.velocity = script.Parent.BodyVelocity.velocity + Vector3.new(0,-3,0)
end
