				<Item class="LocalScript" referent="RBX6413">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">local pack = nil
local keepPack = false

function packOn()
&#9;if pack ~= nil then return end
&#9;local Model = game.Lighting.Pack:clone()
&#9;Model.Parent = script.Parent.Parent.Parent.Character
&#9;local P = Model:GetChildren()
&#9;for i = 1, #P do
&#9;&#9;if P[i].Name ~= &quot;Main&quot; then
&#9;&#9;&#9;local m = P[i]
&#9;&#9;&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;W.Part0 = Model.Main
&#9;&#9;&#9;W.Part1 = m
&#9;&#9;&#9;W.C0 = W.Part0.CFrame:inverse() * CFrame.new(W.Part0.Position)
&#9;&#9;&#9;W.C1 = W.Part1.CFrame:inverse() * CFrame.new(W.Part0.Position)
&#9;&#9;&#9;W.Parent = W.Part0
&#9;&#9;&#9;m.Anchored = false
&#9;&#9;end
&#9;end
&#9;Model.Main.Anchored = false
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = script.Parent.Parent.Parent.Character.Torso
&#9;W.Part1 = Model.Main
&#9;W.C0 = CFrame.new(0,0,0)
&#9;W.Parent = W.Part0
&#9;pack = Model
end

function packOff()
&#9;if pack == nil then return end
&#9;pack:remove()
&#9;pack = nil
end

script.Parent.Selected:connect(function(mouse)
&#9;packOn()
&#9;mouse.Button1Down:connect(function()
&#9;&#9;if pack == nil then return end
&#9;&#9;if mouse == nil or mouse.Target == nil or mouse.Target.Parent == nil then return end
&#9;&#9;if (mouse.hit.p - script.Parent.Parent.Parent.Character.Torso.Position).magnitude &gt; 15 then return end
&#9;&#9;if not keepPack then
&#9;&#9;&#9;if mouse.Target.Parent.Name == &quot;BerryBush&quot; and mouse.Target.Parent:findFirstChild(&quot;Ripe&quot;) then
&#9;&#9;&#9;&#9;local bush = mouse.Target.Parent
&#9;&#9;&#9;&#9;if bush.Ripe.Value then
&#9;&#9;&#9;&#9;&#9;bush.Ripe.Value = false
&#9;&#9;&#9;&#9;&#9;keepPack = true
&#9;&#9;&#9;&#9;&#9;pack.Berry.Transparency = 0
&#9;&#9;&#9;&#9;&#9;pack.Berry2.Transparency = 0
&#9;&#9;&#9;&#9;&#9;pack.Poc1.Transparency = 0
&#9;&#9;&#9;&#9;&#9;pack.Poc2.Transparency = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif mouse.Target.Name == &quot;Apple&quot; then
&#9;&#9;&#9;&#9;keepPack = true
&#9;&#9;&#9;&#9;mouse.Target.Parent:remove()
&#9;&#9;&#9;&#9;pack.Apple.Transparency = 0
&#9;&#9;&#9;&#9;pack.Apple2.Transparency = 0
&#9;&#9;&#9;&#9;pack.Poc1.Transparency = 0
&#9;&#9;&#9;&#9;pack.Poc2.Transparency = 0
&#9;&#9;&#9;elseif mouse.Target.Parent.Name == &quot;Cabbage&quot; then
&#9;&#9;&#9;&#9;keepPack = true
&#9;&#9;&#9;&#9;mouse.Target.Parent:remove()
&#9;&#9;&#9;&#9;pack.Cabbage.Transparency = 0
&#9;&#9;&#9;&#9;pack.Cabbage2.Transparency = 0
&#9;&#9;&#9;&#9;pack.Poc1.Transparency = 0
&#9;&#9;&#9;&#9;pack.Poc2.Transparency = 0
&#9;&#9;&#9;elseif mouse.Target.Name == &quot;Pumpkin&quot; then
&#9;&#9;&#9;&#9;keepPack = true
&#9;&#9;&#9;&#9;mouse.Target:remove()
&#9;&#9;&#9;&#9;pack.Pumpkin1.Transparency = 0
&#9;&#9;&#9;&#9;pack.Poc1.Transparency = 0
&#9;&#9;&#9;&#9;pack.Poc2.Transparency = 0
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;if mouse.Target.Parent.Name == &quot;FoodGuy&quot; then
&#9;&#9;&#9;&#9;keepPack = false
&#9;&#9;&#9;&#9;pack.Berry.Transparency = 1
&#9;&#9;&#9;&#9;pack.Berry2.Transparency = 1
&#9;&#9;&#9;&#9;pack.Poc1.Transparency = 1
&#9;&#9;&#9;&#9;pack.Poc2.Transparency = 1
&#9;&#9;&#9;&#9;pack.Pumpkin1.Transparency = 1
&#9;&#9;&#9;&#9;pack.Apple.Transparency = 1
&#9;&#9;&#9;&#9;pack.Apple2.Transparency = 1
&#9;&#9;&#9;&#9;pack.Cabbage.Transparency = 1
&#9;&#9;&#9;&#9;pack.Cabbage2.Transparency = 1
&#9;&#9;&#9;&#9;local Ff = script.Parent.Parent.Parent:findFirstChild(&quot;Food&quot;)
&#9;&#9;&#9;&#9;if Ff then
&#9;&#9;&#9;&#9;&#9;Ff.Value = Ff.Value + 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;for i = 1, 5 do
&#9;&#9;&#9;&#9;&#9;local t = script.Parent.Parent.Parent:findFirstChild(&quot;Treasure&quot;)
&#9;&#9;&#9;&#9;&#9;local m = script.Parent.Parent.Parent:findFirstChild(&quot;MaxMoney&quot;)
&#9;&#9;&#9;&#9;&#9;if t and m then
&#9;&#9;&#9;&#9;&#9;&#9;if t.Value &lt; m.Value then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;t.Value = t.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end)
script.Parent.Deselected:connect(function()
&#9;if not keepPack then
&#9;&#9;packOff()
&#9;end
end)
</ProtectedString>
