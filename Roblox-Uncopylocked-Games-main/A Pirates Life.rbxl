function weld(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;w.C0 = w.Part0.CFrame:inverse() * CFrame.new(w.Part0.Position)
&#9;w.C1 = w.Part1.CFrame:inverse() * CFrame.new(w.Part0.Position)
&#9;w.Parent = w.Part0
&#9;b.Anchored = false
&#9;return w
end

local halt = false
script.Parent.Selected:connect(function(mouse)
&#9;mouse.Button1Down:connect(function()
&#9;&#9;if halt then return end

&#9;&#9;if script.Parent.Cannon.Value:findFirstChild(&quot;ChargeATreasure&quot;) then

&#9;&#9;&#9;local t = script.Parent.Parent.Parent:findFirstChild(&quot;Treasure&quot;)
&#9;&#9;&#9;if not t then return end
&#9;&#9;&#9;if t.Value &lt;= 0 then
&#9;&#9;&#9;&#9;local h = Instance.new(&quot;Hint&quot;)
&#9;&#9;&#9;&#9;h.Text = &quot;It costs 1 treasure to shoot from this cannon.&quot;
&#9;&#9;&#9;&#9;h.Parent = script.Parent.Parent.Parent
&#9;&#9;&#9;&#9;game.Debris:AddItem(h,5)
&#9;&#9;&#9;&#9;--coroutine.resume(coroutine.create(function(h) wait(5) h.Parent = nil end),h)
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;end
&#9;&#9;&#9;t.Value = t.Value - 1

&#9;&#9;end

&#9;&#9;halt = true
&#9;&#9;local cannon = script.Parent.Cannon.Value

&#9;&#9;local launcher = cannon:findFirstChild(&quot;Launcher&quot;)
&#9;&#9;if not launcher then
&#9;&#9;&#9;if cannon:findFirstChild(&quot;Cannon&quot;) and cannon.Cannon:findFirstChild(&quot;Launcher&quot;) then
&#9;&#9;&#9;&#9;launcher = cannon.Cannon.Launcher
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;print(&quot;Could not find launcher from: &quot;..cannon:GetFullName())
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;local part = Instance.new(&quot;Part&quot;)
&#9;&#9;part.TopSurface = &quot;Smooth&quot;
&#9;&#9;part.BottomSurface = &quot;Smooth&quot;
