				<Item class="Script" referent="RBX6494">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">OnRespawnUpdate</string>
						<ProtectedString name="Source">script.Parent.SeasonFrame.SeasonImage.Image = workspace.GlobalGui.SeasonFrame.SeasonImage.Image
script.Parent.SeasonFrame.SeasonText.Text = workspace.GlobalGui.SeasonFrame.SeasonText.Text
script.Parent.TimeFrame.TimeText.Text = workspace.GlobalGui.TimeFrame.TimeText.Text

local hb = script.Parent.SeasonFrame.SeasonImage.Hide
local halt = false
hb.MouseButton1Down:connect(function()
&#9;if halt then return end
&#9;halt = true
&#9;if hb.Text == &quot;Show&quot; then
&#9;&#9;for i = 1, 105, 3 do
&#9;&#9;&#9;script.Parent.SeasonFrame.Position = UDim2.new(0.5, 0, 0.0, -105 + i)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;hb.Text = &quot;Hide&quot;
&#9;&#9;script.Parent.SeasonFrame.Position = UDim2.new(0.5, 0, 0.0, 0)
&#9;elseif hb.Text == &quot;Hide&quot; then
&#9;&#9;for i = 1, 105, 3 do
&#9;&#9;&#9;script.Parent.SeasonFrame.Position = UDim2.new(0.5, 0, 0.0, -i)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;hb.Text = &quot;Show&quot;
&#9;&#9;script.Parent.SeasonFrame.Position = UDim2.new(0.5, 0, 0.0, -105)
&#9;end
&#9;wait()
&#9;halt = false
end)
</ProtectedString>
					</Properties>
