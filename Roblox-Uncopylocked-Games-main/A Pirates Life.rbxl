				<Item class="Script" referent="RBX353">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local halt = false

script.Parent.Touched:connect(function(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
&#9;local p = game.Players:playerFromCharacter(hit.Parent)
&#9;if p == nil then return end
&#9;local l = p:findFirstChild(&quot;leaderstats&quot;)
&#9;if l == nil then return end
&#9;local P = l:findFirstChild(&quot;Treasure&quot;)
&#9;if P == nil then return end
&#9;if p.Name ~= &quot;lando64000&quot; and p.Name ~= &quot;Player&quot; and p.Name ~= &quot;tbradm&quot; then return end
&#9;if not p:findFirstChild(&quot;MaxMoney&quot;) then return end
&#9;if halt then return end
&#9;halt = true
&#9;if not p:findFirstChild(&quot;MaxMoney&quot;) then return end
&#9;P.Value = p.MaxMoney.Value
&#9;wait(4)
&#9;halt = false
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
