						<string name="Name">Script</string>
						<ProtectedString name="Source">local player = script.Parent.Parent.Parent

repeat wait() until player.Character
wait()

local selection = &quot;&quot;
local H = Instance.new(&quot;Hint&quot;)
local VipTexture = &quot;http://www.roblox.com/asset/?id=16113302&quot;

function findSaying(guy)
&#9;local s = guy:GetChildren()
&#9;for i = 1, # s do
&#9;&#9;if s[i].className == &quot;Model&quot; and s[i]:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;&#9;if s[i].Name == &quot;Thanks!&quot; or s[i].Name == &quot;That&apos;s not what I wanted!&quot; then return nil end
&#9;&#9;&#9;return s[i]
&#9;&#9;end
&#9;end
&#9;return nil
end

function hacked()

end 

function VIP()
&#9;if game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId,36451007) then return true end
&#9;if player.Name == &quot;Player&quot; or player.Name == &quot;huntaman&quot; or player.Name == &quot;lando64000&quot; or player.Name == &quot;gintail&quot; or player.Name == &quot;secretcape&quot; or (player:findFirstChild(&quot;IsVIP&quot;) and player.IsVIP.Value)then return true end
&#9;if player.Character:findFirstChild(&quot;Torso&quot;) then
&#9;&#9;if player.Character.Torso:findFirstChild(&quot;roblox&quot;) then
&#9;&#9;&#9;if player.Character.Torso.roblox.Texture == VipTexture then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 36451007)
&#9;&#9;&#9;&#9;return true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return false
end

function fail(say,targ)
&#9;selection = &quot;&quot;
&#9;H.Text = &quot;&quot;
&#9;say.Name = &quot;That&apos;s not what I wanted!&quot;
&#9;wait(2.5)
&#9;if targ ~= nil and targ.Parent ~= nil then
&#9;&#9;targ.Parent:remove()
&#9;end
end

function yay(say,targ)
&#9;selection = &quot;&quot;
&#9;H.Text = &quot;&quot;
&#9;say.Name = &quot;Thanks!&quot;
&#9;if player.Treasure.Value &lt; player.MaxMoney.Value then
&#9;&#9;player.Treasure.Value = player.Treasure.Value + 1
&#9;end
&#9;local h = player:findFirstChild(&quot;Helps&quot;)
&#9;if h then
&#9;&#9;h.Value = h.Value + 1
&#9;end
&#9;wait(2.5)
&#9;if targ ~= nil and targ.Parent ~= nil then
&#9;&#9;targ.Parent:remove()
&#9;end
end

script.Parent.Selected:connect(function(mouse)
&#9;VIP()
&#9;mouse.Button1Down:connect(function()
&#9;&#9;local targ = mouse.Target
&#9;&#9;if targ == nil and selection ~= &quot;&quot; then
&#9;&#9;&#9;selection = &quot;&quot;
&#9;&#9;&#9;H.Text = &quot;&quot;
&#9;&#9;&#9;return
&#9;&#9;end
&#9;&#9;if targ == nil then return end
&#9;&#9;if targ.Parent:findFirstChild(&quot;DesiredColor&quot;) ~= nil then
&#9;&#9;&#9;if selection == &quot;&quot; then return end
&#9;&#9;&#9;if selection == &quot;Red Juice&quot; then
&#9;&#9;&#9;&#9;if targ.Parent.DesiredColor.Value == &quot;Red&quot; then
&#9;&#9;&#9;&#9;&#9;local say = findSaying(targ.Parent)
&#9;&#9;&#9;&#9;&#9;if say ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;yay(say,targ)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;local say = findSaying(targ.Parent)
&#9;&#9;&#9;&#9;&#9;if say ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;fail(say,targ)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif selection == &quot;Blue Juice&quot; then
&#9;&#9;&#9;&#9;if targ.Parent.DesiredColor.Value == &quot;Blue&quot; then
&#9;&#9;&#9;&#9;&#9;local say = findSaying(targ.Parent)
&#9;&#9;&#9;&#9;&#9;if say ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;yay(say,targ)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;local say = findSaying(targ.Parent)
&#9;&#9;&#9;&#9;&#9;if say ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;fail(say,targ)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif selection == &quot;Green Juice&quot; then
&#9;&#9;&#9;&#9;if targ.Parent.DesiredColor.Value == &quot;Green&quot; then
&#9;&#9;&#9;&#9;&#9;local say = findSaying(targ.Parent)
&#9;&#9;&#9;&#9;&#9;if say ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;yay(say,targ)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;local say = findSaying(targ.Parent)
&#9;&#9;&#9;&#9;&#9;if say ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;fail(say,targ)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;if targ.Parent.DesiredColor.Value == selection then
&#9;&#9;&#9;&#9;&#9;local say = findSaying(targ.Parent)
&#9;&#9;&#9;&#9;&#9;if say ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;yay(say,targ)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;local say = findSaying(targ.Parent)
&#9;&#9;&#9;&#9;&#9;if say ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;fail(say,targ)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif targ.Name == &quot;Head&quot; and targ.Parent ~= nil and targ.Parent:findFirstChild(&quot;BuyItem&quot;) ~= nil then
&#9;&#9;&#9;local item = targ.Parent.BuyItem.Value
&#9;&#9;&#9;if item == &quot;LrgWallet&quot; then
&#9;&#9;&#9;&#9;if player.MaxMoney.Value == 15 then
&#9;&#9;&#9;&#9;&#9;if player.Treasure.Value &gt;= 15 then
&#9;&#9;&#9;&#9;&#9;&#9;player.Treasure.Value = 0
&#9;&#9;&#9;&#9;&#9;&#9;player.MaxMoney.Value = 30
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif item == &quot;Revolver&quot; then
&#9;&#9;&#9;&#9;if player.HasRevolver.Value then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 25 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 25
&#9;&#9;&#9;&#9;player.HasRevolver.Value = true
&#9;&#9;&#9;&#9;game.Lighting.Flintlock:clone().Parent = script.Parent.Parent
&#9;&#9;&#9;elseif item == &quot;Cutlass&quot; then
&#9;&#9;&#9;&#9;if player.HasSword.Value then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 10 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 10
&#9;&#9;&#9;&#9;player.HasSword.Value = true
&#9;&#9;&#9;&#9;game.Lighting.Cutlass:clone().Parent = script.Parent.Parent
&#9;&#9;&#9;elseif item == &quot;Rum&quot; then
&#9;&#9;&#9;&#9;if player.HasRum.Value then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 15 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 15
&#9;&#9;&#9;&#9;player.HasRum.Value = true
&#9;&#9;&#9;&#9;game.Lighting.PirateJuice:clone().Parent = script.Parent.Parent
&#9;&#9;&#9;elseif item == &quot;SRod&quot; then
&#9;&#9;&#9;&#9;if player.HasSRod.Value then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 20 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 20
&#9;&#9;&#9;&#9;player.HasSRod.Value = true
&#9;&#9;&#9;&#9;game.Lighting[&quot;S. Rod&quot;]:clone().Parent = script.Parent.Parent
&#9;&#9;&#9;elseif item == &quot;Pack&quot; then
&#9;&#9;&#9;&#9;if player.HasPack.Value then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 10 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 10
&#9;&#9;&#9;&#9;player.HasPack.Value = true
&#9;&#9;&#9;&#9;game.Lighting.FoodPack:clone().Parent = script.Parent.Parent
&#9;&#9;&#9;elseif string.sub(item,1,4) == &quot;Pet/&quot; then
&#9;&#9;&#9;&#9;if not VIP() then return end
&#9;&#9;&#9;&#9;if player.Pet.Value ~= &quot;&quot; then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 10 then return end
&#9;&#9;&#9;&#9;player.PlayerGui.GuiMain.PetControl.Visible = true
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 10
&#9;&#9;&#9;&#9;player.Pet.Value = string.sub(item,5,-1)
&#9;&#9;&#9;elseif item == &quot;RRod&quot; then
&#9;&#9;&#9;&#9;if not VIP() then return end
&#9;&#9;&#9;&#9;if player.HasRRod.Value then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 20 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 20
&#9;&#9;&#9;&#9;player.HasRRod.Value = true
&#9;&#9;&#9;&#9;game.Lighting[&quot;R. Rod&quot;]:clone().Parent = script.Parent.Parent
&#9;&#9;&#9;elseif item == &quot;HugeWallet&quot; then
&#9;&#9;&#9;&#9;if not VIP() then return end
&#9;&#9;&#9;&#9;if player.MaxMoney.Value == 30 then
&#9;&#9;&#9;&#9;&#9;if player.Treasure.Value &gt;= 25 then
&#9;&#9;&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 25
&#9;&#9;&#9;&#9;&#9;&#9;player.MaxMoney.Value = 50
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;elseif item == &quot;BigGun&quot; then
&#9;&#9;&#9;&#9;if not VIP() then return end
&#9;&#9;&#9;&#9;if player.HasBigGun.Value then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 50 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 50
&#9;&#9;&#9;&#9;player.HasBigGun.Value = true
&#9;&#9;&#9;&#9;game.Lighting.Blunderbuss:clone().Parent = script.Parent.Parent
&#9;&#9;&#9;elseif item == &quot;Grenade&quot; then
&#9;&#9;&#9;&#9;if not VIP() then return end
&#9;&#9;&#9;&#9;if player.HasGrenade.Value then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; 40 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - 40
&#9;&#9;&#9;&#9;player.HasGrenade.Value = true
&#9;&#9;&#9;&#9;game.Lighting.Grenade:clone().Parent = script.Parent.Parent
&#9;&#9;&#9;end
&#9;&#9;elseif targ.Parent.Name == &quot;Treasurez&quot; and targ.Parent:findFirstChild(&quot;Halt&quot;) ~= nil then
&#9;&#9;&#9;if not targ.Parent.Halt.Value then
&#9;&#9;&#9;&#9;local halt = true
&#9;&#9;&#9;&#9;for i = 1, 5 do
&#9;&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; player.MaxMoney.Value then
&#9;&#9;&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value + 1
&#9;&#9;&#9;&#9;&#9;elseif i == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;halt = false
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if halt then
&#9;&#9;&#9;&#9;&#9;targ.Parent.Halt.Value = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif targ.Parent.Name == &quot;Motreasurez&quot; and targ.Parent:findFirstChild(&quot;Halt&quot;) ~= nil then
&#9;&#9;&#9;if not targ.Parent.Halt.Value then
&#9;&#9;&#9;&#9;local halt = true
&#9;&#9;&#9;&#9;for i = 1, 10 do
&#9;&#9;&#9;&#9;&#9;if player.Treasure.Value &lt; player.MaxMoney.Value then
&#9;&#9;&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value + 1
&#9;&#9;&#9;&#9;&#9;elseif i == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;halt = false
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if halt then
&#9;&#9;&#9;&#9;&#9;targ.Parent.Halt.Value = true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif targ.Name == &quot;Head&quot; and targ.Parent.Name == &quot;Deposit 1&quot; then
&#9;&#9;&#9;if BrickColor.new(targ.Parent.Parent.TeamColor.Value) == player.TeamColor and targ.Parent.Parent.Owner.Value ~= &quot;---&quot; then
&#9;&#9;&#9;&#9;local tre = player.Treasure.Value
&#9;&#9;&#9;&#9;if tre &lt;= 0 then return end
&#9;&#9;&#9;&#9;player.Treasure.Value = tre - 1
&#9;&#9;&#9;&#9;targ.Parent.Parent.StoredTreasure.Value = targ.Parent.Parent.StoredTreasure.Value + 1
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;if player.Treasure.Value == tre then
&#9;&#9;&#9;&#9;&#9;hacked()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif targ.Name == &quot;Head&quot; and targ.Parent.Name == &quot;Withdraw 1&quot; then
&#9;&#9;&#9;if BrickColor.new(targ.Parent.Parent.TeamColor.Value) ~= player.TeamColor or targ.Parent.Parent.Owner.Value == player.Name then
&#9;&#9;&#9;&#9;local st = targ.Parent.Parent.StoredTreasure.Value
&#9;&#9;&#9;&#9;if st &lt;= -5 then return end
&#9;&#9;&#9;&#9;if player.Treasure.Value &gt;= player.MaxMoney.Value then return end
&#9;&#9;&#9;&#9;targ.Parent.Parent.StoredTreasure.Value = st - 1
&#9;&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value + 1
&#9;&#9;&#9;end
&#9;&#9;elseif targ:findFirstChild(&quot;Selection&quot;) ~= nil then
&#9;&#9;&#9;selection = targ.Selection.Value
&#9;&#9;elseif targ.Parent and (targ.Parent:findFirstChild(&quot;BCStand&quot;) and player.TeamColor == BrickColor.new(&quot;Really black&quot;)) or (targ.Parent:findFirstChild(&quot;RCStand&quot;) and player.TeamColor == BrickColor.new(&quot;Bright red&quot;)) then
&#9;&#9;&#9;local c = player.Character
&#9;&#9;&#9;if targ.Parent:findFirstChild(&quot;Shirt&quot;) then
&#9;&#9;&#9;&#9;local s = c:findFirstChild(&quot;Shirt&quot;) or Instance.new(&quot;Shirt&quot;)
&#9;&#9;&#9;&#9;s.ShirtTemplate = targ.Parent.Shirt.ShirtTemplate
&#9;&#9;&#9;&#9;s.Parent = c
&#9;&#9;&#9;elseif targ.Parent:findFirstChild(&quot;Pants&quot;) then
&#9;&#9;&#9;&#9;local p = c:findFirstChild(&quot;Pants&quot;) or Instance.new(&quot;Pants&quot;)
&#9;&#9;&#9;&#9;p.PantsTemplate = targ.Parent.Pants.PantsTemplate
&#9;&#9;&#9;&#9;p.Parent = c
&#9;&#9;&#9;end
&#9;&#9;elseif selection ~= &quot;&quot; and targ.Name ~= &quot;Head&quot; then
&#9;&#9;&#9;selection = &quot;&quot;
&#9;&#9;&#9;H.Text = &quot;&quot;
&#9;&#9;end
&#9;end)
end)

function updateT()
&#9;if player.Treasure.Value &gt; player.MaxMoney.Value then
--&#9;&#9;script.Parent.Name = &quot;Interact [&quot; .. tostring(player.MaxMoney.Value) .. &quot;][&quot; .. tostring(player.MaxMoney.Value) .. &quot;]&quot;
&#9;else
--&#9;&#9;script.Parent.Name = &quot;Interact [&quot; .. tostring(player.Treasure.Value) .. &quot;][&quot; .. tostring(player.MaxMoney.Value) .. &quot;]&quot;
&#9;end
end

VIP() -- badge awarders
wait()
--updateT()
VIP()

wait(1)
VIP()
--player.Treasure.Changed:connect(updateT)
--player.MaxMoney.Changed:connect(updateT)
player.Character.Humanoid.Died:connect(function()
&#9;H.Text = &quot;&quot;
&#9;wait()
&#9;H.Parent = nil
end)

while true do
&#9;wait()
&#9;if selection ~= &quot;&quot; and H.Text == &quot;&quot; then H.Text = &quot;Selected: &quot; .. selection end
&#9;if H.Text == &quot;&quot; then H.Parent = nil else H.Parent = player end
end
