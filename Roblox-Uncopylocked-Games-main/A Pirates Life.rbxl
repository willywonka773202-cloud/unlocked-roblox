				<Item class="Script" referent="RBX5727">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Control</string>
						<ProtectedString name="Source">--script.Parent:BreakJoints()
local bT = false
wait()
local gyro = script.Parent.Balance.Gyro
gyro.Parent = nil

local plankWeld

wait()
function weld(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;if b.Name == &quot;Plank&quot; then
&#9;&#9;plankWeld = w
&#9;end
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;w.C0 = w.Part0.CFrame:inverse() * CFrame.new(w.Part0.Position)
&#9;w.C1 = w.Part1.CFrame:inverse() * CFrame.new(w.Part0.Position)
&#9;w.Parent = w.Part0
&#9;b.Anchored = false
end

local t = script.Parent:getChildren()
for i = 1, #t do
&#9;if (t[i].className == &quot;Part&quot; and t[i].Name ~= &quot;Engine&quot;) or t[i].className == &quot;Seat&quot; or t[i].className == &quot;WedgePart&quot; then
&#9;&#9;weld(script.Parent.Engine, t[i])
&#9;elseif t[i].className == &quot;Model&quot; and t[i]:findFirstChild(&quot;Head&quot;) ~= nil and t[i].Name ~= &quot;Board Team Ship - 2&quot; then
&#9;&#9;weld(script.Parent.Engine, t[i].Head)
&#9;end
end

function Kraken()
&#9;local k = game.Lighting.Kraken:clone()
&#9;k.CFrame = script.Parent.Engine.CFrame * CFrame.fromEulerAnglesXYZ(0,0,math.pi)
&#9;k.CFrame = k.CFrame + Vector3.new(0,(script.Parent.Engine.Position.y - 82) * -1,0)
&#9;k.Parent = script.Parent
&#9;for i = 1, 85 do
&#9;&#9;wait()
&#9;&#9;k.CFrame = k.CFrame + Vector3.new(0,1,0)
&#9;end
&#9;weld(script.Parent.Engine, k)
&#9;for i = 1, 150 do
&#9;&#9;wait()
&#9;&#9;script.Parent.Engine.BPos.position = Vector3.new(script.Parent.Engine.Position.x,script.Parent.Engine.BPos.position.y - 0.5,script.Parent.Engine.Position.z)
&#9;end
&#9;local p = game.Players:findFirstChild(script.Parent.OwnerValue.Value)
&#9;if p ~= nil then
&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;b:AwardBadge(p.userId, 15844619)
&#9;end
&#9;script.Parent:remove()
end

weld(script.Parent.Engine, script.Parent.VehicleSeat)
script.Parent.Engine.Anchored = false

script.Parent.VehicleSeat.ChildAdded:connect(function(new)
&#9;wait()
&#9;local p = game.Players:playerFromCharacter(new.Part1.Parent)
&#9;if p ~= nil and p.Name ~= script.Parent.OwnerValue.Value then
&#9;&#9;local t = new.Part1
&#9;&#9;new.Parent = nil
&#9;&#9;if t ~= nil and t.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;&#9;t.Parent.Humanoid.Sit = false
&#9;&#9;&#9;t.Parent.Humanoid.Jump = true
&#9;&#9;&#9;wait()
&#9;&#9;&#9;t.Parent.Humanoid.Sit = false
&#9;&#9;&#9;t.Parent.Humanoid.Jump = true
&#9;&#9;end
&#9;end
end)

--/============= PLANK =============/

local value = false
local moving = false

script.Parent.Open.Changed:connect(function()
&#9;if moving then
&#9;&#9;script.Parent.Open.Value = value
&#9;&#9;return
&#9;end
&#9;if script.Parent.Open.Value == value then return end
&#9;value = script.Parent.Open.Value
&#9;if value then
&#9;&#9;moving = true
&#9;&#9;for i = 1, 70 do
&#9;&#9;&#9;plankWeld.C0 = plankWeld.C0 + Vector3.new(0.1,0,0)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;wait(3)
&#9;&#9;moving = false
&#9;else
&#9;&#9;moving = true
&#9;&#9;for i = 1, 70 do
&#9;&#9;&#9;plankWeld.C0 = plankWeld.C0 + Vector3.new(-0.1,0,0)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;wait(3)
&#9;&#9;moving = false
&#9;end
end)
script.Parent.Button.CD.MouseClick:connect(function() script.Parent.Open.Value = not script.Parent.Open.Value end)

--/===============================/

while true do
&#9;wait()
&#9;if script.Parent.Engine.Position.x &lt; 337 and script.Parent.Engine.Position.x &gt; 252 and script.Parent.Engine.Position.z &lt; -270 and script.Parent.Engine.Position.z &gt; -347  then
&#9;&#9;Kraken()
&#9;end
&#9;if script.Parent.VehicleSeat.Throttle == 1 then
&#9;&#9;script.Parent.Engine.BPos.position = Vector3.new(script.Parent.Mast.Position.x,script.Parent.Engine.BPos.position.y,script.Parent.Mast.Position.z)
&#9;elseif script.Parent.VehicleSeat.Throttle == -1 then
&#9;&#9;script.Parent.Engine.BPos.position = Vector3.new(script.Parent.Rev.Position.x,script.Parent.Engine.BPos.position.y,script.Parent.Rev.Position.z)
&#9;end
&#9;if script.Parent.VehicleSeat.Steer ~= 0 then
&#9;&#9;if bT then
&#9;&#9;&#9;bT = false
&#9;&#9;&#9;gyro.Parent = nil
&#9;&#9;end
&#9;&#9;script.Parent.Engine.BAVe.angularvelocity = Vector3.new(0,script.Parent.VehicleSeat.Steer*-600,0)
&#9;elseif not bT then
&#9;&#9;bT = true
&#9;&#9;gyro.cframe = script.Parent.Balance.CFrame
&#9;&#9;gyro.Parent = script.Parent.Balance
&#9;end
end
