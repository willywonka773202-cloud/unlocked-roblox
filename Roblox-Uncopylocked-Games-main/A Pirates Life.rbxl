			<Item class="Script" referent="RBX295">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game</string>
					<ProtectedString name="Source">local cons = {}

game.Players.ChildRemoved:connect(function()
&#9;local w = workspace:GetChildren()
&#9;for i = 1, #w do
&#9;&#9;if w[i].Name == &quot;Storage&quot; and w[i]:findFirstChild(&quot;Owner&quot;) ~= nil then
&#9;&#9;&#9;if game.Players:findFirstChild(w[i].Owner.Value) == nil then
&#9;&#9;&#9;&#9;w[i].Owner.Value = &quot;---&quot;
&#9;&#9;&#9;&#9;w[i].StoredTreasure.Value = -5 -- 0
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(w[i].Name,1,6) == &quot;Dinghy&quot; and w[i]:findFirstChild(&quot;Humanoid&quot;) == nil and w[i]:findFirstChild(&quot;OwnerValue&quot;) ~= nil and w[i]:findFirstChild(&quot;Health&quot;) ~= nil then
&#9;&#9;&#9;if game.Players:findFirstChild(w[i].OwnerValue.Value) == nil then
&#9;&#9;&#9;&#9;w[i].Health.Value = 0
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;for _, i in ipairs(cons) do
&#9;&#9;if game.Players:findFirstChild(i[4]) == nil and i[5] then
&#9;&#9;&#9;i[1]:disconnect()
&#9;&#9;&#9;i[2]:disconnect()
&#9;&#9;&#9;i[3]:disconnect()
&#9;&#9;&#9;i[5] = false
&#9;&#9;end
&#9;end
end)

function newGuy(new)
&#9;wait()
&#9;if new == nil then return end
--&#9;local l = Instance.new(&quot;IntValue&quot;)
&#9;local m = Instance.new(&quot;IntValue&quot;)
--&#9;l.Name = &quot;leaderstats&quot;
&#9;m.Name = &quot;Treasure&quot;
&#9;m.Value = 0
&#9;m.Parent = new--l
&#9;local M = Instance.new(&quot;IntValue&quot;)
&#9;M.Name = &quot;MaxMoney&quot;
&#9;M.Value = 15
&#9;M.Parent = new
&#9;local r = Instance.new(&quot;BoolValue&quot;)
&#9;r.Name = &quot;HasRevolver&quot;
&#9;r.Value = false
&#9;r.Parent = new
&#9;local s = Instance.new(&quot;BoolValue&quot;)
&#9;s.Name = &quot;HasSword&quot;
&#9;s.Value = false
&#9;s.Parent = new
&#9;s = Instance.new(&quot;BoolValue&quot;)
&#9;s.Name = &quot;HasRum&quot;
&#9;s.Value = false
&#9;s.Parent = new
&#9;s = Instance.new(&quot;BoolValue&quot;)
&#9;s.Name = &quot;HasSRod&quot;
&#9;s.Value = false
&#9;s.Parent = new
&#9;s = Instance.new(&quot;BoolValue&quot;)
&#9;s.Name = &quot;HasRRod&quot;
&#9;s.Value = false
&#9;s.Parent = new
&#9;s = Instance.new(&quot;BoolValue&quot;)
&#9;s.Name = &quot;HasPack&quot;
&#9;s.Value = false
&#9;s.Parent = new
&#9;s = Instance.new(&quot;BoolValue&quot;)
&#9;s.Name = &quot;HasBigGun&quot;
&#9;s.Value = false
&#9;s.Parent = new
&#9;local S = Instance.new(&quot;IntValue&quot;)
&#9;S.Name = &quot;Squids&quot;
&#9;S.Value = 0
&#9;S.Parent = new
&#9;local S2 = Instance.new(&quot;IntValue&quot;)
&#9;S2.Name = &quot;Helps&quot;
&#9;S2.Value = 0
&#9;S2.Parent = new
&#9;local S3 = Instance.new(&quot;IntValue&quot;)
&#9;S3.Name = &quot;Food&quot;
&#9;S3.Value = 0
&#9;S3.Parent = new
&#9;local VIP = Instance.new(&quot;BoolValue&quot;)
&#9;VIP.Name = &quot;IsVIP&quot;
&#9;VIP.Value = game:GetService(&quot;BadgeService&quot;):UserHasBadge(new.userId,36451007)
&#9;VIP.Parent = new
&#9;local pp = Instance.new(&quot;StringValue&quot;)
&#9;pp.Name = &quot;Pet&quot;
&#9;pp.Value = &quot;&quot;
&#9;pp.Parent = new
&#9;s = Instance.new(&quot;BoolValue&quot;)
&#9;s.Name = &quot;HasGrenade&quot;
&#9;s.Value = false
&#9;s.Parent = new
&#9;cons[#cons+1] = {
&#9;&#9;S.Changed:connect(function()
&#9;&#9;&#9;if S == nil or new == nil then return end
&#9;&#9;&#9;if S.Value &gt;= 3 then
&#9;&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;&#9;b:AwardBadge(new.userId, 15773837)
&#9;&#9;&#9;end
&#9;&#9;end),
&#9;&#9;S2.Changed:connect(function()
&#9;&#9;&#9;if S2 == nil or new == nil then return end
&#9;&#9;&#9;if S2.Value &gt;= 40 then
&#9;&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;&#9;b:AwardBadge(new.userId, 16049530)
&#9;&#9;&#9;end
&#9;&#9;end),
&#9;&#9;S3.Changed:connect(function()
&#9;&#9;&#9;if S3 == nil or new == nil then return end
&#9;&#9;&#9;if S3.Value &gt;= 20 then
&#9;&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;&#9;b:AwardBadge(new.userId, 16046448)
&#9;&#9;&#9;end
&#9;&#9;end),
&#9;&#9;new.Name,
&#9;&#9;true
&#9;}
--&#9;l.Parent = new
end
game.Players.ChildAdded:connect(newGuy)

wait()
for _, i in ipairs(workspace:GetChildren()) do
&#9;if i.Name == &quot;Storage&quot; and i:findFirstChild(&quot;Owner&quot;) ~= nil then
&#9;&#9;i.StoredTreasure.Changed:connect(function()
&#9;&#9;&#9;if i.StoredTreasure.Value &gt;= 95 then
&#9;&#9;&#9;&#9;local p = game.Players:findFirstChild(i.Owner.Value)
&#9;&#9;&#9;&#9;if p ~= nil then
&#9;&#9;&#9;&#9;&#9;print(&quot;Giving badge &apos;100 Stored Treasure&apos;&quot;)
&#9;&#9;&#9;&#9;&#9;local b = game:GetService(&quot;BadgeService&quot;)
&#9;&#9;&#9;&#9;&#9;b:AwardBadge(p.userId, 15873685)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end
end

wait(3)
if game.Players.NumPlayers == 1 then
&#9;if not (game.Players:GetChildren())[1]:findFirstChild(&quot;Treasure&quot;) then
&#9;&#9;newGuy((game.Players:GetChildren())[1])
&#9;end
end
</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX296">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Time</string>
						<ProtectedString name="Source">local Lights = {}
local dLight = workspace.DayLight
local gui = workspace.GlobalGui

local w = workspace:GetChildren()
for i = 1, #w do
&#9;if w[i].className == &quot;Part&quot; and w[i].Name == &quot;Light&quot; then
&#9;&#9;Lights[#Lights + 1] = w[i]
&#9;end
end

wait()
local time = 0
wait()

function Time(t)
&#9;local meridian = &quot;AM&quot;
&#9;if t%12 ~= t then meridian = &quot;PM&quot; end
&#9;local T = tostring(t)
&#9;if t == 0 then T = &quot;12&quot; elseif t &gt; 12 then T = tostring(t - 12) end
&#9;gui.TimeFrame.TimeText.Text = T .. &quot;:00 &quot; .. meridian
end

while true do
&#9;if time &lt; 10 then
&#9;&#9;game.Lighting.TimeOfDay = &quot;0&quot; .. tostring(time) .. &quot;:00:00&quot;
&#9;else
&#9;&#9;game.Lighting.TimeOfDay = tostring(time) .. &quot;:00:00&quot;
&#9;end
&#9;Time(time)
&#9;if time == 17 then
&#9;&#9;for j = 1, 3 do
&#9;&#9;&#9;for i = 1, #Lights do
&#9;&#9;&#9;&#9;Lights[i].Transparency = Lights[i].Transparency - 0.1
&#9;&#9;&#9;end
&#9;&#9;&#9;dLight.Transparency = dLight.Transparency + 0.1
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;elseif time == 7 then
&#9;&#9;for j = 1, 3 do
&#9;&#9;&#9;for i = 1, #Lights do
&#9;&#9;&#9;&#9;Lights[i].Transparency = Lights[i].Transparency + 0.1
&#9;&#9;&#9;end
&#9;&#9;&#9;dLight.Transparency = dLight.Transparency - 0.1
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end
&#9;wait(30)
&#9;time = time + 1
&#9;if time == 24 then time = 0 end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX297">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Seasons</string>
						<ProtectedString name="Source">local mod = workspace.SeasonStuff
local bushes = {}
local cabbage = { workspace.RedCabbage, workspace.BlackCabbage }
local pumpkins = { workspace.RedPumpkin, workspace.BlackPumpkin }
for i = 1, #cabbage do
&#9;local c = cabbage[i]:clone()
&#9;cabbage[i]:remove()
&#9;cabbage[i] = c
end
for i = 1, #pumpkins do
&#9;local c = pumpkins[i]:clone()
&#9;pumpkins[i]:remove()
&#9;pumpkins[i] = c
end
local apples = workspace.Apples:clone()
workspace.Apples:remove()
wait()
for _, i in ipairs(workspace:GetChildren()) do
&#9;if i.Name == &quot;BerryBush&quot; and i:findFirstChild(&quot;Ripe&quot;) then
&#9;&#9;bushes[#bushes+1] = i
&#9;&#9;i.Ripe.Value = true
&#9;end
end
wait()
for _, i in ipairs(bushes) do
&#9;i.Ripe.Value = false
end
local gui = workspace.GlobalGui

function storm()
&#9;coroutine.resume(coroutine.create(function(choosePos,script)
&#9;&#9;function bolt(pos)
&#9;&#9;&#9;local CF = CFrame.new(workspace.Cloud.Position,pos)
&#9;&#9;&#9;local sound = script.StrikeSound:clone()
&#9;&#9;&#9;sound.Volume = 1
&#9;&#9;&#9;sound.Name = &quot;Temp&quot;..sound.Name
&#9;&#9;&#9;sound.Parent = script
&#9;&#9;&#9;game.Debris:AddItem(sound,10)
&#9;&#9;&#9;for strike = 1, 8 do
&#9;&#9;&#9;&#9;lastPos = CF.p
&#9;&#9;&#9;&#9;local Parts = 7
&#9;&#9;&#9;&#9;local Arc = 20
&#9;&#9;&#9;&#9;game.Lighting.Ambient = script.Flash.Value
&#9;&#9;&#9;&#9;for i = 1, Parts do
&#9;&#9;&#9;&#9;&#9;local targpoint = CF.p + ((CF.lookVector*((CF.p-pos).magnitude/Parts))*i) + Vector3.new(math.random(-Arc,Arc),math.random(-Arc,Arc),math.random(-Arc,Arc))
&#9;&#9;&#9;&#9;&#9;if i == Parts then
&#9;&#9;&#9;&#9;&#9;&#9;targpoint = pos
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;local s = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;&#9;&#9;s.formFactor = 0
&#9;&#9;&#9;&#9;&#9;s.Size = Vector3.new(1,1,math.floor((lastPos-targpoint).magnitude))
&#9;&#9;&#9;&#9;&#9;s.CFrame = CFrame.new((lastPos+targpoint)/2,targpoint)
&#9;&#9;&#9;&#9;&#9;s.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;&#9;&#9;&#9;&#9;s.Anchored = true
&#9;&#9;&#9;&#9;&#9;s.CanCollide = false
&#9;&#9;&#9;&#9;&#9;local m = Instance.new(&quot;BlockMesh&quot;)
&#9;&#9;&#9;&#9;&#9;m.Scale = Vector3.new(5,5,1)
&#9;&#9;&#9;&#9;&#9;m.Parent = s
&#9;&#9;&#9;&#9;&#9;sc = script.BoltScript:clone()
&#9;&#9;&#9;&#9;&#9;sc.Disabled = false
&#9;&#9;&#9;&#9;&#9;sc.Parent = s
&#9;&#9;&#9;--[==[&#9;local clone = s:clone()
&#9;&#9;&#9;&#9;&#9;clone.Mesh.Scale = Vector3.new(5,5,1.1)
&#9;&#9;&#9;&#9;&#9;clone.BrickColor = BrickColor.new(&quot;White&quot;)
&#9;&#9;&#9;&#9;&#9;clone.Transparency = 0.5--]==]
&#9;&#9;&#9;&#9;&#9;s.Parent = workspace
&#9;&#9;&#9;&#9;--&#9;clone.Parent = s.Parent
&#9;&#9;&#9;&#9;&#9;lastPos = targpoint
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;wait(0.07)
&#9;&#9;&#9;&#9;game.Lighting.Ambient = script.Storm.Value
&#9;&#9;&#9;&#9;wait(0.01)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;function strike()
&#9;&#9;&#9;local targs = {}
&#9;&#9;&#9;for i,j in pairs(game.Players:GetChildren()) do
&#9;&#9;&#9;&#9;if j and j.Character and j.Character:findFirstChild(&quot;Humanoid&quot;) and j.Character:findFirstChild(&quot;Torso&quot;) and j.Character.Humanoid.Health &gt; 0 then
&#9;&#9;&#9;&#9;&#9;if (j.Character.Torso.Position.x &lt; 335 and j.Character.Torso.Position.x &gt; -335 and j.Character.Torso.Position.z &gt; -335 and j.Character.Torso.Position.z &lt; 335 and j.Character.Torso.Position.y &gt; 170 and not (j.Character.Torso.Position.y &lt; 245 and j.Character.Torso.Position.z &lt; 20 and j.Character.Torso.Position.z &gt; -15 and j.Character.Torso.Position.x &lt; 14 and j.Character.Torso.Position.x &gt; -19)) or 
&#9;&#9;&#9;&#9;&#9;--[[( OR )]] (j.Character.Torso.Position.x &lt; -196 and j.Character.Torso.Position.x &gt; -338 and j.Character.Torso.Position.z &lt; 422 and j.Character.Torso.Position.z &gt; 347) then
&#9;&#9;&#9;&#9;&#9;&#9;table.insert(targs,j.Character.Torso)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;local targ
&#9;&#9;&#9;if #targs &gt; 0 then
&#9;&#9;&#9;&#9;if #targs == 1 then
&#9;&#9;&#9;&#9;&#9;targ = targs[1]
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;targ = targs[math.random(1,#targs)]
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;local x, z = choosePos()
&#9;&#9;&#9;&#9;bolt(Vector3.new(x,170,z))
&#9;&#9;&#9;end
&#9;&#9;&#9;if targ and targ.Parent then
&#9;&#9;&#9;&#9;if targ.Parent:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;&#9;targ.Parent.Humanoid.Health = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if targ.Parent:findFirstChild(&quot;Head&quot;) then
&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;Fire&quot;).Parent = targ.Parent.Head
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;bolt(targ.Position)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(240)
&#9;&#9;local c = workspace.Cloud
&#9;&#9;local ambdif = Vector3.new((game.Lighting.Ambient.r-script.Storm.Value.r)/50,(game.Lighting.Ambient.g-script.Storm.Value.g)/50,(game.Lighting.Ambient.b-script.Storm.Value.b)/50)
&#9;&#9;for i = 1, 50 do
&#9;&#9;&#9;c.Transparency = 1 - (i*0.02)
&#9;&#9;&#9;game.Lighting.Ambient = Color3.new(game.Lighting.Ambient.r-ambdif.x,game.Lighting.Ambient.g-ambdif.y,game.Lighting.Ambient.b-ambdif.z)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;game.Lighting.Ambient = script.Storm.Value
&#9;&#9;wait(10)
&#9;&#9;local x, z = choosePos()
&#9;&#9;bolt(Vector3.new(x,170,z))
&#9;&#9;wait(10)
&#9;&#9;x, z = choosePos()
&#9;&#9;bolt(Vector3.new(x,170,z))
&#9;&#9;wait(10)
&#9;&#9;for i = 1, 8 do
&#9;&#9;&#9;strike()
&#9;&#9;&#9;wait(10)
&#9;&#9;&#9;local x, z = choosePos()
&#9;&#9;&#9;bolt(Vector3.new(x,170,z))
&#9;&#9;&#9;wait(10)
&#9;&#9;&#9;x, z = choosePos()
&#9;&#9;&#9;bolt(Vector3.new(x,170,z))
&#9;&#9;&#9;wait(10)
&#9;&#9;end
&#9;&#9;x, z = choosePos()
&#9;&#9;bolt(Vector3.new(x,170,z))
&#9;&#9;wait(10)
&#9;&#9;x, z = choosePos()
&#9;&#9;bolt(Vector3.new(x,170,z))
&#9;&#9;wait(10)
&#9;&#9;bolt(Vector3.new(-2.5, 246, 2.5))
&#9;&#9;game.Lighting.Trident:clone().Parent = workspace
&#9;&#9;wait(10)
&#9;&#9;for i = 1, 50 do
&#9;&#9;&#9;c.Transparency = (i*0.02)
&#9;&#9;&#9;game.Lighting.Ambient = Color3.new(game.Lighting.Ambient.r+ambdif.x,game.Lighting.Ambient.g+ambdif.y,game.Lighting.Ambient.b+ambdif.z)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end),choosePos,script)
end

function Spring()
&#9;ClearSeason()
&#9;game.Lighting.Ambient = script.Spring.Value
&#9;for _, i in ipairs(mod.TreeTops:GetChildren()) do
&#9;&#9;if i.className == &quot;Part&quot; then
&#9;&#9;&#9;i.Transparency = 1
&#9;&#9;end
&#9;end
&#9;for _, i in ipairs(mod.Grass:GetChildren()) do
&#9;&#9;if i.className == &quot;Part&quot; then
&#9;&#9;&#9;i.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;end
&#9;end
&#9;gui.SeasonFrame.SeasonImage.Image = &quot;http://www.roblox.com/asset/?id=16271911&quot;
&#9;gui.SeasonFrame.SeasonText.Text = &quot;Spring&quot;
&#9;gui.SeasonFrame.SeasonText.TextColor = BrickColor.new(&quot;Really black&quot;)
&#9;gui.SeasonFrame.SeasonText.BackgroundColor = BrickColor.new(&quot;Bright green&quot;)
&#9;gui.SeasonFrame.SeasonText.BorderColor = gui.SeasonFrame.SeasonText.BackgroundColor
&#9;storm()
end

function Summer()
&#9;ClearSeason()
&#9;game.Lighting.Ambient = script.Summer.Value
&#9;for _, i in ipairs(mod.TreeTops:GetChildren()) do
&#9;&#9;if i.className == &quot;Part&quot; then
&#9;&#9;&#9;i.BrickColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;&#9;i.Transparency = 0
&#9;&#9;end
&#9;end
&#9;gui.SeasonFrame.SeasonImage.Image = &quot;http://www.roblox.com/asset/?id=16271926&quot;
&#9;gui.SeasonFrame.SeasonText.Text = &quot;Summer&quot;
&#9;gui.SeasonFrame.SeasonText.TextColor = BrickColor.new(&quot;Really black&quot;)
&#9;gui.SeasonFrame.SeasonText.BackgroundColor = BrickColor.new(&quot;Bright yellow&quot;)
&#9;gui.SeasonFrame.SeasonText.BorderColor = gui.SeasonFrame.SeasonText.BackgroundColor
&#9;--if math.random(1,4) == 3 then storm() end
end

function Fall()
&#9;ClearSeason()
&#9;game.Lighting.Ambient = script.Fall.Value
&#9;for _, i in ipairs(mod.TreeTops:GetChildren()) do
&#9;&#9;if i.className == &quot;Part&quot; then
&#9;&#9;&#9;i.BrickColor = i.FallColor.Value
&#9;&#9;end
&#9;end
&#9;gui.SeasonFrame.SeasonImage.Image = &quot;http://www.roblox.com/asset/?id=16271941&quot;
&#9;gui.SeasonFrame.SeasonText.Text = &quot;Fall&quot;
&#9;gui.SeasonFrame.SeasonText.TextColor = BrickColor.new(&quot;Really black&quot;)
&#9;gui.SeasonFrame.SeasonText.BackgroundColor = BrickColor.new(&quot;Bright red&quot;)
&#9;gui.SeasonFrame.SeasonText.BorderColor = gui.SeasonFrame.SeasonText.BackgroundColor
end

function Winter()
&#9;ClearSeason()
&#9;game.Lighting.Ambient = script.Winter.Value
&#9;for _, i in ipairs(mod.TreeTops:GetChildren()) do
&#9;&#9;if i.className == &quot;Part&quot; then
&#9;&#9;&#9;i.Transparency = 1
&#9;&#9;end
&#9;end
&#9;for _, i in ipairs(mod.Grass:GetChildren()) do
&#9;&#9;if i.className == &quot;Part&quot; then
&#9;&#9;&#9;i.BrickColor = BrickColor.new(&quot;White&quot;)
&#9;&#9;end
&#9;end
&#9;for i = 1, 30 do genIce() end
&#9;game.Lighting.IceSicle:clone().Parent = mod.Temp
&#9;gui.SeasonFrame.SeasonImage.Image = &quot;http://www.roblox.com/asset/?id=16271951&quot;
&#9;gui.SeasonFrame.SeasonText.Text = &quot;Winter&quot;
&#9;gui.SeasonFrame.SeasonText.TextColor = BrickColor.new(&quot;Really black&quot;)
&#9;gui.SeasonFrame.SeasonText.BackgroundColor = BrickColor.new(&quot;White&quot;)
&#9;gui.SeasonFrame.SeasonText.BorderColor = gui.SeasonFrame.SeasonText.BackgroundColor
end

function choosePos()
&#9;local x, z = 0, 0
&#9;local m = math.random(1,33)
&#9;if m &lt;= 4 then
&#9;&#9;x, z = math.random(-330,-110), math.random(-330,-110)
&#9;elseif m &lt;= 8 then
&#9;&#9;x, z = math.random(-110,110), math.random(-330,-110)
&#9;elseif m &lt;= 12 then
&#9;&#9;x, z = math.random(110,330), math.random(-330,-110)
&#9;elseif m &lt;= 16 then
&#9;&#9;x, z = math.random(-330,-110), math.random(-110,110)
&#9;elseif m &lt;= 20 then
&#9;&#9;x, z = math.random(110,330), math.random(-110,110)
&#9;elseif m &lt;= 24 then
&#9;&#9;x, z = math.random(-330,-110), math.random(110,330)
&#9;elseif m &lt;= 28 then
&#9;&#9;x, z = math.random(-110,110), math.random(110,330)
&#9;elseif m &lt;= 32 then
&#9;&#9;x, z = math.random(110,330), math.random(110,330)
&#9;elseif m == 33 then
&#9;&#9;x, z = math.random(-337,-197), math.random(348,421)
&#9;end
&#9;return x, z
end

function genIce()
&#9;local x, z = choosePos()
&#9;local ice = game.Lighting.IceBlock:clone()
&#9;ice.CFrame = CFrame.new(Vector3.new(x,160,z))
&#9;ice.Parent = mod.Temp
end

function Color(r,g,b)
&#9;return Color3.new(r, g, b)
end

function ClearSeason()
&#9;for _, i in ipairs(mod.Temp:GetChildren()) do i:remove() end
end

function Season()
&#9;if script.Season.Value == 5 then
&#9;&#9;script.Season.Value = 1
&#9;&#9;return
&#9;end
&#9;local seas = script.Season.Value
&#9;if seas == 1 then
&#9;&#9;Spring()
&#9;&#9;wait(360)
&#9;elseif seas == 2 then
&#9;&#9;Summer()
&#9;&#9;wait(360)
&#9;&#9;local a = apples:clone()
&#9;&#9;a.Parent = mod.Temp
&#9;&#9;for _, i in ipairs(bushes) do
&#9;&#9;&#9;i.Ripe.Value = true
&#9;&#9;end
&#9;&#9;local c1, c2 = cabbage[1]:clone(), cabbage[2]:clone()
&#9;&#9;c1.Parent = mod.Temp
&#9;&#9;c2.Parent = mod.Temp
&#9;elseif seas == 3 then
&#9;&#9;Fall()
&#9;&#9;wait(360)
&#9;&#9;local a = apples:clone()
&#9;&#9;a.Parent = mod.Temp
&#9;&#9;for _, i in ipairs(bushes) do
&#9;&#9;&#9;i.Ripe.Value = true
&#9;&#9;end
&#9;&#9;local p1, p2 = pumpkins[1]:clone(), pumpkins[2]:clone()
&#9;&#9;p1.Parent = mod.Temp
&#9;&#9;p2.Parent = mod.Temp
&#9;elseif seas == 4 then
&#9;&#9;Winter()
&#9;&#9;wait(360)
&#9;end
end
script.Season.Changed:connect(Season)

while true do
&#9;script.Season.Value = script.Season.Value + 1
&#9;wait(720)
&#9;for _, i in ipairs(bushes) do
&#9;&#9;i.Ripe.Value = false
&#9;end
end
