					<Item class="Script" referent="RBX4704">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local model = workspace.BlackShip
local bu = model:clone()
model:remove()

script.Parent.Touched:connect(function(hit)
&#9;if script.Parent.BrickColor == BrickColor.new(&quot;White&quot;) then return end
&#9;if hit == nil or hit.Parent == nil then return end
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
&#9;local player = game.Players:playerFromCharacter(hit.Parent)
&#9;if player == nil then return end
&#9;if player.TeamColor ~= bu.TeamColor.Value then return end
&#9;local l = player--:findFirstChild(&quot;leaderstats&quot;)
&#9;if l == nil then return end
&#9;local t = l:findFirstChild(&quot;Treasure&quot;)
&#9;if t == nil then return end
&#9;if t.Value &lt; 30 then return end
&#9;script.Parent.BrickColor = BrickColor.new(&quot;White&quot;)
&#9;t.Value = t.Value - 30
&#9;local d = bu:clone()
&#9;d.Parent = workspace
&#9;d.OwnerValue.Value = player.Name
end)

while true do
&#9;wait(1.5)
&#9;if workspace:findFirstChild(bu.Name) ~= nil then
&#9;&#9;script.Parent.BrickColor = BrickColor.new(&quot;White&quot;)
&#9;else
&#9;&#9;script.Parent.BrickColor = BrickColor.new(&quot;Black&quot;)
&#9;end
end
</ProtectedString>
						</Properties>
					</Item>
				</Item>
