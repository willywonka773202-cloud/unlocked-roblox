					<Item class="Script" referent="RBX5610">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Welder</string>
							<ProtectedString name="Source">--script.Parent:BreakJoints()
wait()

function weld(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;w.C0 = w.Part0.CFrame:inverse() * CFrame.new(w.Part0.Position)
&#9;w.C1 = w.Part1.CFrame:inverse() * CFrame.new(w.Part0.Position)
&#9;w.Parent = w.Part0
&#9;b.Anchored = false
end

local t = script.Parent:getChildren()
for i = 1, #t do
&#9;if t[i].className == &quot;Part&quot; and t[i].Name ~= &quot;Base&quot; then
&#9;&#9;weld(script.Parent.Base, t[i])
&#9;end
end

script.Parent.Base.Anchored = false
weld(script.Parent.Base, script.Parent.Seat)
weld(script.Parent.Parent.Engine, script.Parent.Base)
</ProtectedString>
