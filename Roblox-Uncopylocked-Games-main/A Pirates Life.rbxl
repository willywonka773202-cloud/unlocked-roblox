					<string name="Name">Regened</string>
					<ProtectedString name="Source">wait()
local pet = nil
local pHalt = false
local petcon = false

local player = script.Parent.Parent
repeat wait() until player.Character ~= nil and player.Character:findFirstChild(&quot;Torso&quot;) and player.Character:findFirstChild(&quot;Humanoid&quot;)

local hasPet = false
function getPet()
--&#9;if hasPet then return end
&#9;local pp = game.Lighting.Pets:findFirstChild(player.Pet.Value)
&#9;if pp then
&#9;&#9;hasPet = true
&#9;&#9;local z = pp:clone()
&#9;&#9;pet = z
&#9;&#9;local s = game.Lighting.Pets.PetScript:clone()
&#9;&#9;s.Disabled = false
&#9;&#9;s.Parent = z
&#9;&#9;z.Owner.Value = script.Parent.Parent.Name
&#9;&#9;z.Parent = workspace
&#9;&#9;z:MakeJoints()
&#9;&#9;wait()
&#9;&#9;z.Torso.CFrame = script.Parent.Parent.Character.Torso.CFrame + Vector3.new(0,6,0)
&#9;&#9;z.Torso.Anchored = true
&#9;&#9;z.Torso.Velocity = Vector3.new(0,0,0)
&#9;&#9;wait()
&#9;&#9;z.Torso.Anchored = false
&#9;&#9;wait()
&#9;&#9;local h = z:findFirstChild(&quot;HumaBlarg&quot;)
&#9;&#9;if h then
&#9;&#9;&#9;if h.Health == 0 then
&#9;&#9;&#9;&#9;z:remove()
&#9;&#9;&#9;&#9;getPet()
&#9;&#9;&#9;else
&#9;&#9;&#9;--&#9;h.Died:connect(function()
&#9;&#9;&#9;--&#9;&#9;z:remove()
&#9;&#9;&#9;--&#9;&#9;getPet()
&#9;&#9;&#9;--&#9;end)
&#9;&#9;&#9;end
&#9;&#9;end&#9;&#9;
&#9;end
end

function connectPet()
&#9;if petcon then return end
&#9;petcon = true
&#9;local frame = player.PlayerGui.GuiMain.PetControl
&#9;frame.Visible = true
&#9;frame.CallButton.MouseButton1Down:connect(function()
&#9;&#9;if pHalt then return end
&#9;&#9;pHalt = true
&#9;&#9;if pet then
&#9;&#9;&#9;pet:remove()
&#9;&#9;&#9;pet = nil
&#9;&#9;&#9;getPet()
&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;pHalt = false
&#9;end)
&#9;frame.ThrowButton.MouseButton1Down:connect(function()

&#9;end)
&#9;frame.Stay.MouseButton1Down:connect(function()
&#9;&#9;if petmode == &quot;stay&quot; then return end
&#9;&#9;petmode = &quot;stay&quot;
&#9;&#9;local c = frame.Stay.BackgroundColor3
&#9;&#9;frame.Stay.BackgroundColor3 = frame.Follow.BackgroundColor3
&#9;&#9;frame.Stay.BorderColor3 = frame.Follow.BackgroundColor3
&#9;&#9;frame.Follow.BackgroundColor3 = c
&#9;&#9;frame.Follow.BorderColor3 = c
&#9;&#9;if pet then
&#9;&#9;&#9;local s = pet:findFirstChild(&quot;PetScript&quot;)
&#9;&#9;&#9;if s then
&#9;&#9;&#9;&#9;s.mode.Value = petmode
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
&#9;frame.Follow.MouseButton1Down:connect(function()
&#9;&#9;if petmode == &quot;follow&quot; then return end
&#9;&#9;petmode = &quot;follow&quot;
&#9;&#9;local c = frame.Stay.BackgroundColor3
&#9;&#9;frame.Stay.BackgroundColor3 = frame.Follow.BackgroundColor3
&#9;&#9;frame.Stay.BorderColor3 = frame.Follow.BackgroundColor3
&#9;&#9;frame.Follow.BackgroundColor3 = c
&#9;&#9;frame.Follow.BorderColor3 = c
&#9;&#9;if pet then
&#9;&#9;&#9;local s = pet:findFirstChild(&quot;PetScript&quot;)
&#9;&#9;&#9;if s then
&#9;&#9;&#9;&#9;s.mode.Value = petmode
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end

if script.Parent.Parent.HasRevolver.Value then
&#9;game.Lighting.Flintlock:clone().Parent = script.Parent
end
if script.Parent.Parent.HasSword.Value then
&#9;game.Lighting.Cutlass:clone().Parent = script.Parent
end
if script.Parent.Parent.HasRum.Value then
&#9;game.Lighting.PirateJuice:clone().Parent = script.Parent
end
if script.Parent.Parent.HasSRod.Value then
&#9;game.Lighting[&quot;S. Rod&quot;]:clone().Parent = script.Parent
end
if script.Parent.Parent.HasRRod.Value then
&#9;game.Lighting[&quot;R. Rod&quot;]:clone().Parent = script.Parent
end
if script.Parent.Parent.HasPack.Value then
&#9;game.Lighting.FoodPack:clone().Parent = script.Parent
end
if script.Parent.Parent.HasGrenade.Value then
&#9;game.Lighting.Grenade:clone().Parent = script.Parent
end
if script.Parent.Parent.HasBigGun.Value then
&#9;game.Lighting.Blunderbuss:clone().Parent = script.Parent
end
if player.Pet.Value ~= &quot;&quot; then
&#9;local petmode = &quot;follow&quot;
&#9;getPet()
&#9;connectPet()
end
player.Pet.Changed:connect(function()
&#9;getPet()
&#9;connectPet()
end)

player.Character.Humanoid.Died:connect(function()
&#9;if player.Treasure.Value &gt; 0 then
&#9;&#9;local T = player.Treasure.Value
&#9;&#9;if T &gt; player.MaxMoney.Value then
&#9;&#9;&#9;T = player.MaxMoney.Value
&#9;&#9;end
&#9;&#9;player.Treasure.Value = 0
&#9;&#9;if player.Character ~= nil then
&#9;&#9;&#9;if player.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;local t = game.Lighting.Treasure:clone()
&#9;&#9;&#9;&#9;t.Head.Position = player.Character.Torso.Position
&#9;&#9;&#9;&#9;t.Treas.Value = T
&#9;&#9;&#9;&#9;t.Head.Script.Disabled = false
&#9;&#9;&#9;&#9;t.Parent = workspace
&#9;&#9;&#9;&#9;print(&quot;dropped treasure&quot;)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
