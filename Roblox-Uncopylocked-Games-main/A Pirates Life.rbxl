								<ProtectedString name="Source">script.Parent.Changed:connect(function()
&#9;if script.Parent.Value then
&#9;&#9;local p = script.Parent.Parent:GetChildren()
&#9;&#9;for i = 1, #p do
&#9;&#9;&#9;if p[i].Name == &quot;Moneh&quot; then
&#9;&#9;&#9;&#9;p[i].Transparency = 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait(14)
&#9;&#9;for i = 1, #p do
&#9;&#9;&#9;if p[i].Name == &quot;Moneh&quot; then
&#9;&#9;&#9;&#9;p[i].Transparency = 0
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;script.Parent.Value = false
&#9;end
end)
</ProtectedString>
