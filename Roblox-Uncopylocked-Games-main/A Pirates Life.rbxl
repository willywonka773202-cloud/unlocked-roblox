				<Item class="LocalScript" referent="RBX5964">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Camera</string>
						<ProtectedString name="Source">local player = script.Parent.Parent.Parent
repeat wait() until player:findFirstChild(&quot;PlayerGui&quot;) and player.PlayerGui:findFirstChild(&quot;GuiMain&quot;) and player.PlayerGui.GuiMain:findFirstChild(&quot;Zoom&quot;)
local Z = player.PlayerGui.GuiMain.Zoom
local cost = 2
local range = 9
local zoom = 550
local mag = 4
local maxTime = 25

local time = 0
local cr = math.ceil(range/2)
local ws = 0
local cf = CFrame.new()
local lbi = {}
function endView()
&#9;Z.Visible = false
&#9;player.Character.Humanoid.WalkSpeed = ws
&#9;for i, j in pairs(lbi) do j.Parent = game.LocalBackpack end
&#9;lbi = {}
&#9;workspace.CurrentCamera.CoordinateFrame = CFrame.new(player.Character.Torso.CFrame.p + Vector3.new(10,10,10), player.Character.Torso.CFrame.p)
end

function frzCam()
&#9;workspace.CurrentCamera.CoordinateFrame = CFrame.new(math.huge,math.huge,math.huge)
end

Z.Frame.L.MouseButton1Down:connect(function()
&#9;if cr &lt; 1 then return end
&#9;cr = cr - 1
&#9;cf = cf * CFrame.fromEulerAnglesXYZ(0,-0.05,0)
&#9;workspace.CurrentCamera.CoordinateFrame = CFrame.new(cf.p+cf.lookVector*zoom,cf.p+cf.lookVector*(zoom+20))
&#9;frzCam()
end)
Z.Frame.R.MouseButton1Down:connect(function()
&#9;if cr &gt; (range-1) then return end
&#9;cr = cr + 1
&#9;cf = cf * CFrame.fromEulerAnglesXYZ(0,0.05,0)
&#9;workspace.CurrentCamera.CoordinateFrame = CFrame.new(cf.p+cf.lookVector*zoom,cf.p+cf.lookVector*(zoom+20))
&#9;frzCam()
end)
Z.Frame.C.MouseButton1Down:connect(function()
&#9;time = 0
&#9;endView()
end)

script.Parent.Selected:connect(function(mouse)
&#9;mouse.Button1Down:connect(function()
&#9;&#9;local targ = mouse.Target
&#9;&#9;if (player.Character.Torso.Position-mouse.hit.p).magnitude &gt; mag then return end
&#9;&#9;if not targ or not targ.Parent then return end
&#9;&#9;if targ.Parent.Name == &quot;BZoom&quot; or targ.Parent.Name == &quot;RZoom&quot; then
&#9;&#9;&#9;if player.Treasure.Value &lt; cost then return end
&#9;&#9;&#9;lbi = {}
&#9;&#9;&#9;cr = math.ceil(range/2)
&#9;&#9;&#9;player.Treasure.Value = player.Treasure.Value - cost
&#9;&#9;&#9;cf = targ.Parent.Main.CFrame * CFrame.fromEulerAnglesXYZ(-math.pi/2,0,0)
&#9;&#9;&#9;for i,j in pairs(game.LocalBackpack:GetChildren()) do table.insert(lbi,j) j.Parent = nil end
&#9;&#9;&#9;Z.Visible = true
&#9;&#9;&#9;ws = player.Character.Humanoid.WalkSpeed
&#9;&#9;&#9;player.Character.Humanoid.WalkSpeed = 0
&#9;&#9;&#9;workspace.CurrentCamera.CoordinateFrame = CFrame.new(cf.p+cf.lookVector*zoom,cf.p+cf.lookVector*(zoom+20))
&#9;&#9;&#9;frzCam()
&#9;&#9;&#9;time = maxTime
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;Z.Frame.Time.Text = &quot;Time left: &quot; .. tostring(time)
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;if time == 0 then
&#9;&#9;&#9;&#9;&#9;if Z.Visible then endView() end
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;time = time - 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end)
