				<Item class="Script" referent="RBX1188">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Update</string>
						<ProtectedString name="Source">script.Parent.SeasonFrame.SeasonImage.Changed:connect(function()
&#9;for i,j in pairs(game.Players:GetChildren()) do
&#9;&#9;if j and j:findFirstChild(&quot;PlayerGui&quot;) and j.PlayerGui:findFirstChild(&quot;PublicGui&quot;) and j.PlayerGui.PublicGui:findFirstChild(&quot;SeasonFrame&quot;) then
&#9;&#9;&#9;j.PlayerGui.PublicGui.SeasonFrame.SeasonImage.Image = script.Parent.SeasonFrame.SeasonImage.Image
&#9;&#9;end
&#9;end
end)
script.Parent.SeasonFrame.SeasonText.Changed:connect(function()
&#9;for i,j in pairs(game.Players:GetChildren()) do
&#9;&#9;if j and j:findFirstChild(&quot;PlayerGui&quot;) and j.PlayerGui:findFirstChild(&quot;PublicGui&quot;) and j.PlayerGui.PublicGui:findFirstChild(&quot;SeasonFrame&quot;) then
&#9;&#9;&#9;j.PlayerGui.PublicGui.SeasonFrame.SeasonText.Text = script.Parent.SeasonFrame.SeasonText.Text
&#9;&#9;end
&#9;end
end)
script.Parent.TimeFrame.TimeText.Changed:connect(function()
&#9;for i,j in pairs(game.Players:GetChildren()) do
&#9;&#9;if j and j:findFirstChild(&quot;PlayerGui&quot;) and j.PlayerGui:findFirstChild(&quot;PublicGui&quot;) and j.PlayerGui.PublicGui:findFirstChild(&quot;TimeFrame&quot;) then
&#9;&#9;&#9;j.PlayerGui.PublicGui.TimeFrame.TimeText.Text = script.Parent.TimeFrame.TimeText.Text
&#9;&#9;end
&#9;end
end)

game.Player.ChildAdded:connect(function(j)
&#9;repeat wait() until j and j:findFirstChild(&quot;PlayerGui&quot;) and j.PlayerGui:findFirstChild(&quot;PublicGui&quot;) and j.PlayerGui.PublicGui:findFirstChild(&quot;TimeFrame&quot;) and j.PlayerGui.PublicGui:findFirstChild(&quot;SeasonFrame&quot;)
&#9;j.PlayerGui.PublicGui.SeasonFrame.SeasonImage.Image = script.Parent.SeasonFrame.SeasonImage.Image
&#9;j.PlayerGui.PublicGui.SeasonFrame.SeasonText.Text = script.Parent.SeasonFrame.SeasonText.Text
&#9;j.PlayerGui.PublicGui.TimeFrame.TimeText.Text = script.Parent.TimeFrame.TimeText.Text
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
