&#9;&#9;if h ~= nil then
&#9;&#9;&#9;local p = game.Players:playerFromCharacter(part.Parent)
&#9;&#9;&#9;if not p or p.TeamColor == script.Parent.creator.Value.TeamColor then return end
&#9;&#9;&#9;h:TakeDamage(100)
&#9;&#9;&#9;weld.Part1 = h.Parent.Torso
&#9;&#9;else&#9;
&#9;&#9;&#9;weld.Part1 = part
&#9;&#9;&#9;weld.C0 = CFrame.new(trident.Position - part.Position)
