				<Item class="Script" referent="RBX6420">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">RayGun</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true

local reloadCount = 0

function fire(v)

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local PewPew = Tool.Handle:FindFirstChild(&quot;PewPew&quot;)

&#9;local t = vCharacter:findFirstChild(&quot;Torso&quot;)


&#9;if (PewPew == nil) then
&#9;&#9;PewPew = Instance.new(&quot;Sound&quot;)
&#9;&#9;PewPew.Name = &quot;PewPew&quot;
&#9;&#9;PewPew.SoundId = &quot;http://www.roblox.com/asset/?id=16433315&quot;
&#9;&#9;PewPew.Parent = Tool.Handle
&#9;&#9;PewPew.Volume = 1
&#9;end

&#9;local missile = Instance.new(&quot;Part&quot;)

&#9;missile.Size = Vector3.new(1,1,1)
&#9;missile.BrickColor = BrickColor.new(26)
&#9;missile.Shape = 0
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;lead&quot;
&#9;missile.Reflectance = 0

&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,95,0)
&#9;force.Parent = missile

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;&#9;
&#9;local new_script = script.Parent.LaserBlast:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile

&#9;for i = 1, 5 do
&#9;&#9;local missileClone= missile:clone()
&#9;&#9;missileClone.creator.Value = vPlayer
&#9;&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;&#9;local fireDirect = Vector3.new(v.x + math.random(-2,2)/50,v.y + math.random(-2,2)/50,v.z + math.random(-2,2)/50)
&#9;&#9;spawnPos  = spawnPos + (fireDirect * 10)

&#9;&#9;missileClone.Position = spawnPos
&#9;&#9;missileClone.Velocity = fireDirect * 170

&#9;&#9;if t then
&#9;&#9;&#9;local s = Instance.new(&quot;Vector3Value&quot;)
&#9;&#9;&#9;s.Name = &quot;ShotFrom&quot;
&#9;&#9;&#9;s.Value = t.Position
&#9;&#9;&#9;local b = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;b.Name = &quot;ball&quot;
&#9;&#9;&#9;b.Value = missileClone
&#9;&#9;&#9;b.Parent = s
&#9;&#9;&#9;s.Parent = vPlayer
&#9;&#9;end

&#9;&#9;missileClone.Parent = game.Workspace
&#9;end

&#9;PewPew:Play()

end



function gunUp()
&#9;Tool.GripForward = Vector3.new(0,.981,-.196)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,.196,.981)
end

function gunOut()
&#9;Tool.GripForward = Vector3.new(0,1,0)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,0,1)
end

function isTurbo(character)
&#9;return character:FindFirstChild(&quot;BoltHelm&quot;) ~= nil
end


function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false


&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit

&#9;local reload = 12

&#9;gunUp()
&#9;fire(lookAt)
&#9;wait(0.1)
&#9;gunOut()
&#9;wait(reload)

&#9;reloadCount = reloadCount + 1
&#9;if reloadCount &gt;= 1 then
&#9;&#9;Tool.Handle.Reload:Play()
&#9;&#9;reloader()
&#9;&#9;reloadCount = 0
&#9;end

&#9;enabled = true

end

function reloader()

&#9;Tool.GripUp = Vector3.new(0,1,0)
&#9;Tool.GripForward = Vector3.new(0,0,-1)
&#9;Tool.GripPos = Vector3.new(0,0,0)
&#9;Tool.GripRight = Vector3.new(1,0,0)

&#9;wait(0.3)
&#9;Tool.GripPos = Vector3.new(0,-0.1,0)
&#9;wait(0.3)
&#9;Tool.GripPos = Vector3.new(0,0.1,0)
&#9;wait(0.3)

&#9;Tool.GripUp = Vector3.new(0,0,1)
&#9;Tool.GripForward = Vector3.new(0,1,0)
&#9;Tool.GripPos = Vector3.new(0,-0.5,-0.5)
&#9;Tool.GripRight = Vector3.new(1,0,0)

end

function onEquipped()
&#9;Tool.Handle.Reload:Stop()
&#9;Tool.Handle.PewPew:Stop()
end

function onUnequipped()
&#9;Tool.Handle.Reload:Stop()
&#9;Tool.Handle.PewPew:Stop()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
</ProtectedString>
