								<string name="Name">Script</string>
								<ProtectedString name="Source">local colors = { &quot;Banjo&quot;, &quot;Hook&quot;, &quot;Dynamite Bundle&quot;, &quot;Compass&quot;, &quot;Sword&quot;, &quot;Teddy Bear&quot;, &quot;Hair Dryer&quot;, &quot;Turkey Leg&quot; }
local color = colors[math.random(1,#colors)]
script.Parent.Value = color

local phrases = {
{ &quot;I want a &quot;, &quot;.&quot; },
{ &quot;Gimme a &quot;, &quot;.&quot; },
{ &quot;Eh... I want a &quot;, &quot;.&quot; },
{ &quot;Meh wants a &quot;, &quot;.&quot; }
}

local phrase = phrases[math.random(1,#phrases)]
script.Parent.Parent.Saying.Name = phrase[1] .. color .. phrase[2]
</ProtectedString>
