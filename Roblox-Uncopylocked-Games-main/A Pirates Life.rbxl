							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.Changed:connect(function()
&#9;local P = script.Parent.Parent:GetChildren()
&#9;for i = 1, #P do
&#9;&#9;if P[i].className == &quot;Model&quot; and P[i]:findFirstChild(&quot;ST&quot;) ~= nil then
&#9;&#9;&#9;P[i].Name = &quot;Stored Treasure: &quot; .. tostring(script.Parent.Value + 5)
&#9;&#9;end
&#9;end
end)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
