				<Item class="Script" referent="RBX6018">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SammichScript</string>
						<ProtectedString name="Source">local Tool = script.Parent;
enabled = true

Tool.GripForward = Vector3.new(-0.976,0,0.217)
Tool.GripPos = Vector3.new(0.55, 0, 0)
Tool.GripRight = Vector3.new(0.217,0,-0.976)
Tool.GripUp = Vector3.new(0,1,0)

function onActivated()
&#9;if not enabled  then return end
&#9;local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil then
&#9;&#9;if h.Health == h.MaxHealth then
&#9;&#9;&#9;return
&#9;&#9;end
&#9;else
&#9;&#9;return
&#9;end
&#9;enabled = false

&#9;Tool.GripForward = Vector3.new(0.675, -0.675, -0.3)
&#9;Tool.GripPos = Vector3.new(0.2, -0.65, 1.2)
&#9;Tool.GripRight = Vector3.new(0.212, -0.212, 0.954)
&#9;Tool.GripUp = Vector3.new(0.707, 0.707, 0)
&#9;Tool.Handle.DrinkSound:Play()

&#9;wait(3)
&#9;h.Health = h.MaxHealth

&#9;Tool.Parent = nil
end

script.Parent.Activated:connect(onActivated)
</ProtectedString>
