						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LaserBlast</string>
						<ProtectedString name="Source">ball = script.Parent
damage = 100

debris = game:GetService(&quot;Debris&quot;)
debris:AddItem(ball, 10)

HitSound = Instance.new(&quot;Sound&quot;)
HitSound.Name = &quot;HitSound&quot;
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=11945266&quot;
HitSound.Pitch = .5
HitSound.Parent = ball

function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
--&#9;connection:disconnect()
&#9;if humanoid then
&#9;&#9;local p = ball.creator.Value
&#9;&#9;local e = game.Players:playerFromCharacter(humanoid.Parent)
&#9;&#9;if e and p and p.TeamColor ~= e.TeamColor then
&#9;&#9;&#9;if humanoid.Health == 0 then return end
&#9;&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;&#9;local t = hit.Parent:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if t then
&#9;&#9;&#9;&#9;local s = Instance.new(&quot;Vector3Value&quot;)
&#9;&#9;&#9;&#9;s.Name = &quot;ShotAt&quot;
&#9;&#9;&#9;&#9;s.Value = t.Position
&#9;&#9;&#9;&#9;local w = Instance.new(&quot;StringValue&quot;)
&#9;&#9;&#9;&#9;w.Value = e.Name
&#9;&#9;&#9;&#9;w.Name = &quot;who&quot;
&#9;&#9;&#9;&#9;w.Parent = s
&#9;&#9;&#9;&#9;local h = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;h.Value = ball
&#9;&#9;&#9;&#9;h.Name = &quot;ball&quot;
&#9;&#9;&#9;&#9;h.Parent = s
&#9;&#9;&#9;&#9;s.Parent = p
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;HitSound:Play()
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;&#9;debris:AddItem(new_tag, 1)
&#9;end
end

connection = ball.Touched:connect(onTouched)
</ProtectedString>
