							<ProtectedString name="Source">repeat wait() until script.Parent.Value ~= &quot;&quot;
wait()

script.Parent.Parent.Owner.Name = &quot;Owner: &quot; .. script.Parent.Value
local player = game.Players:findFirstChild(script.Parent.Value)
local name = player.Name

if player ~= nil then
&#9;player.Character.Humanoid.Died:connect(function()
&#9;&#9;script.Parent.Parent.Health.Value = 0
&#9;end)
end

while true do
&#9;wait()
&#9;if game.Players:findFirstChild(name) == nil then
&#9;&#9;script.Parent.Parent.Health.Value = 0
&#9;end
end
