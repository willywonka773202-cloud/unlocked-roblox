						<Item class="Script" referent="RBX5688">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Parent.ChildAdded:connect(function(new)
&#9;if new.className == &quot;Weld&quot; then
&#9;&#9;local player = game.Players:playerFromCharacter(new.Part1.Parent)
&#9;&#9;if player ~= nil then
&#9;&#9;&#9;local t = script.Parent.Parent.Parent:findFirstChild(&quot;TeamColor&quot;)
&#9;&#9;&#9;if t ~= nil and t.Value == player.TeamColor then
&#9;&#9;&#9;&#9;local c = game.Lighting.Cannon:clone()--script.Cannon:clone()
&#9;&#9;&#9;&#9;c.Cannon.Value = script.Parent.Parent
&#9;&#9;&#9;&#9;c.Parent = player.Backpack
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;new:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
</ProtectedString>
