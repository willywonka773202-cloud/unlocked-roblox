						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Tool = script.Parent
local last_attack = 0
local r = game:service(&quot;RunService&quot;)
local humanoid = nil

function onTouched(part)

&#9;local h = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil and h ~= humanoid and humanoid and Tool.Attacking.Value == true then
&#9;&#9;local vp = game.Players:playerFromCharacter(humanoid.Parent)
&#9;&#9;if not vp then return end
&#9;&#9;local ep = game.Players:playerFromCharacter(part.Parent)
&#9;&#9;if not ep or ep.TeamColor == vp.TeamColor then return end
&#9;&#9;h:TakeDamage(90)
&#9;end

end

function onEquipped()
&#9;humanoid = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
end

Tool.Equipped:connect(onEquipped)
Tool.Handle.Touched:connect(onTouched)

function throwTrident()

&#9;wait(0.3)

&#9;local v = (humanoid.TargetPoint - Tool.Parent.Head.Position).unit

&#9;local trident = Tool.Handle:clone()
&#9;trident.CanCollide = true
&#9;trident.Locked = true
&#9;trident.Position = Vector3.new(trident.Position.x,trident.Position.y + 5, trident.Position.z)
&#9;trident.Velocity = v * 70
&#9;trident.CFrame = CFrame.new(trident.Position, humanoid.TargetPoint)
&#9;trident.CFrame = trident.CFrame * CFrame.Angles(math.pi,0,0)

&#9;local script = Tool.TridentScript:clone()
&#9;script.Parent = trident
&#9;script.Disabled = false
&#9;
&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,400,0)
&#9;force.Parent = trident

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = game.Players:playerFromCharacter(humanoid.Parent)
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = trident

&#9;Tool.Handle.Transparency = 1
&#9;trident.Name = &quot;Trident&quot;
&#9;trident.Parent = game.Workspace

&#9;wait(4)
&#9;Tool.Handle.Transparency = 0

end

Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;t = r.Stepped:wait()

&#9;if (t - last_attack &lt; .2) then
&#9;&#9;changeValueTo(&quot;throw&quot;)
&#9;&#9;Tool.Handle.Throw:Play()
&#9;&#9;throwTrident()
&#9;else
&#9;&#9;Tool.Handle.Stab:Play()
&#9;&#9;changeValueTo(&quot;stab&quot;)
&#9;end

&#9;last_attack = t

&#9;Tool.Enabled = true
&#9;
end

function changeValueTo(string)

&#9;Tool.Action.Value = &quot;changer&quot;
&#9;wait()
&#9;Tool.Action.Value = string
&#9;
end


Tool.Activated:connect(onActivated)
</ProtectedString>
