								<X>0</X>
								<Y>173.5</Y>
								<Z>0</Z>
							</Vector3>
						</Properties>
					</Item>
					<Item class="NumberValue" referent="RBX5991">
						<Properties>
							<string name="Name">A</string>
							<double name="Value">0</double>
						</Properties>
						<Item class="Script" referent="RBX5992">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">script.Parent.Value = math.pi - 0.5

while true do
&#9;wait()
&#9;for i = 1, 10 do
&#9;&#9;script.Parent.Value = script.Parent.Value + 0.1
&#9;&#9;wait()
&#9;end
&#9;for i = 1, 10 do
&#9;&#9;script.Parent.Value = script.Parent.Value - 0.1
&#9;&#9;if i ~= 10 then
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;end
end
</ProtectedString>
