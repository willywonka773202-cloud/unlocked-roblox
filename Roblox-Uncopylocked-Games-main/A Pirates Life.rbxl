							<string name="Name">Script</string>
							<ProtectedString name="Source">function changed()
&#9;script.Parent.Parent.Name = &quot;Treasure (&quot; .. tostring(script.Parent.Parent.Treas.Value) .. &quot;)&quot;
end

wait(.2)
script.Parent.Parent.Treas.Changed:connect(changed)
changed()

script.Parent.Touched:connect(function(hit)
&#9;local p = game.Players:playerFromCharacter(hit.Parent)
&#9;if p == nil then
&#9;&#9;script.Parent.Anchored = true
&#9;&#9;return
&#9;end
&#9;if p.Character ~= nil then
&#9;&#9;local h = p.Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if h ~= nil then
&#9;&#9;&#9;if h.Health &gt; 0 then
&#9;&#9;&#9;&#9;for i = 1, script.Parent.Parent.Treas.Value do
&#9;&#9;&#9;&#9;&#9;if p.Treasure.Value &lt; p.MaxMoney.Value then
&#9;&#9;&#9;&#9;&#9;&#9;p.Treasure.Value = p.Treasure.Value + 1
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Treas.Value = script.Parent.Parent.Treas.Value - 1
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if script.Parent.Parent.Treas.Value &lt;= 0 then
&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Parent = nil
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)

if script.Parent.Parent.Parent.className ~= &quot;Lighting&quot; then
&#9;wait(10)
&#9;script.Parent.Parent:remove()
end
</ProtectedString>
