				</Properties>
				<Item class="Script" referent="RBX5987">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Reset</string>
						<ProtectedString name="Source">--Created by Vitos

bin = script.Parent
player = game.Players.LocalPlayer

function onButton1Down(mouse)
&#9;char = player.Character
&#9;char.Humanoid.Health=0
&#9;char.Head:remove()
&#9;char.Torso:remove()
&#9;char:findFirstChild(&quot;Left Leg&quot;):remove()
&#9;char:findFirstChild(&quot;Right Leg&quot;):remove()
&#9;char:findFirstChild(&quot;Left Arm&quot;):remove()
&#9;char:findFirstChild(&quot;Right Arm&quot;):remove()
end

function onSelected(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX5988">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Drown</string>
					<ProtectedString name="Source">--[[
script.Parent.Touched:connect(function(hit)
&#9;if hit == nil or hit.Parent == nil then return end
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then
&#9;&#9;if hit.Parent:findFirstChild(&quot;Treas&quot;) ~= nil then
&#9;&#9;&#9;hit.Parent:remove()
&#9;&#9;end
&#9;&#9;return
&#9;end
&#9;if hit.Parent:findFirstChild(&quot;Torso&quot;) == nil then return end
&#9;if hit.Parent:findFirstChild(&quot;Animate&quot;) == nil then return end
&#9;local s = script.Drowning:clone()
&#9;s.Disabled = false
&#9;s.A.Script.Disabled = false
&#9;s.Parent = hit.Parent.Torso
end)
]]

local player = script.Parent.Parent
repeat wait() until player.Character
wait()

repeat wait() until player.Character:findFirstChild(&quot;Torso&quot;)
local torso = player.Character.Torso

while true do
&#9;repeat wait() until torso.Position.y &lt; 172 and player.Character:findFirstChild(&quot;Animate&quot;) and not torso:findFirstChild(&quot;Drowning&quot;)
&#9;local sc = script.Drowning:clone()
&#9;sc.Disabled = false
&#9;sc.A.Script.Disabled = false
&#9;sc.Parent = torso
&#9;wait()
end
</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX5989">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Drowning</string>
						<ProtectedString name="Source">local ls = script.Parent:findFirstChild(&quot;Left Shoulder&quot;)
local rs = script.Parent:findFirstChild(&quot;Right Shoulder&quot;)
local anim = script.Parent.Parent:findFirstChild(&quot;Animate&quot;)
if anim ~= nil then anim.Parent = script end

local val = false

local bp = script.BodyPosition
bp.Parent = script.Parent

while true do
&#9;wait()
&#9;if script.Parent.Position.y &gt; 174 then
&#9;&#9;bp.Parent = nil
&#9;&#9;if anim ~= nil then anim.Parent = script.Parent.Parent end
&#9;&#9;script:remove()
&#9;else
&#9;&#9;val = not val
--&#9;&#9;if val then
&#9;&#9;&#9;script.Parent.Parent.Humanoid.Health = script.Parent.Parent.Humanoid.Health - 1
--&#9;&#9;end
&#9;&#9;if ls ~= nil then ls.DesiredAngle = script.A.Value end
&#9;&#9;if rs ~= nil then rs.DesiredAngle = script.A.Value * -1 end
&#9;end
end
</ProtectedString>
					</Properties>
					<Item class="BodyPosition" referent="RBX5990">
						<Properties>
							<float name="D">1250</float>
							<string name="Name">BodyPosition</string>
