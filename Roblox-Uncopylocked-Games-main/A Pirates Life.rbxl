game:service(&quot;Teams&quot;).ChildAdded:connect(function(new)
&#9;if string.sub(new.Name, -7) ~= &quot;Pirates&quot; or new.TeamColor ~= &quot;Really black&quot; or new.TeamColor ~= &quot;Bright red&quot; then
&#9;&#9;new.Parent = nil
&#9;end
end)
</ProtectedString>
