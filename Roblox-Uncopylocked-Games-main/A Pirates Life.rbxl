				<Item class="StringValue" referent="RBX5892">
					<Properties>
						<string name="Name">OwnerValue</string>
						<string name="Value">GeneralBaal</string>
					</Properties>
					<Item class="Script" referent="RBX5893">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">repeat wait() until script.Parent.Value ~= &quot;&quot;
wait()

script.Parent.Parent.Owner.Name = &quot;Owner: &quot; .. script.Parent.Value
local player = game.Players:findFirstChild(script.Parent.Value)
local name = player.Name

if player ~= nil then
&#9;player.Character.Humanoid.Died:connect(function()
&#9;&#9;script.Parent.Parent.Health.Value = 0
&#9;end)
end

while true do
&#9;wait()
&#9;if game.Players:findFirstChild(name) == nil then
&#9;&#9;script.Parent.Parent.Health.Value = 0
&#9;end
end
</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX5894">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Control</string>
						<ProtectedString name="Source">--script.Parent:BreakJoints()
wait()

function weld(a, b)
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;w.Part0 = a
&#9;w.Part1 = b
&#9;w.C0 = w.Part0.CFrame:inverse() * CFrame.new(w.Part0.Position)
&#9;w.C1 = w.Part1.CFrame:inverse() * CFrame.new(w.Part0.Position)
&#9;w.Parent = w.Part0
&#9;b.Anchored = false
end

local t = script.Parent:getChildren()
for i = 1, #t do
&#9;if (t[i].className == &quot;Part&quot; and t[i].Name ~= &quot;Engine&quot;) or t[i].className == &quot;Seat&quot; then
&#9;&#9;weld(script.Parent.Engine, t[i])
&#9;elseif t[i].className == &quot;Model&quot; and t[i]:findFirstChild(&quot;Head&quot;) ~= nil then
&#9;&#9;weld(script.Parent.Engine, t[i].Head)
&#9;end
end

function Shark()
&#9;local c0 = CFrame.new(300, -174.199997, 97, -1, -0, -0, 0, 1, 0, -0, -0, -1)
&#9;local Finc1 = CFrame.new(297, -108, -167.899704, -1, 0, 0, 0, 0, 1, 0, 1, 0)
&#9;local Fin2c1 = CFrame.new(-305, 86, -167.899887, 1, 0, 0, 0, 0, -1, 0, 1, 0)
&#9;local Sharkc1 = CFrame.new(-96.5, -187.699997, 299, 0, 0, 1, 0, 1, 0, -1, -0, -0)
&#9;local part1 = Instance.new(&quot;Part&quot;)
&#9;part1.formFactor = 2
&#9;part1.Size = Vector3.new(1,0.4,1)
&#9;part1.Anchored = true
&#9;part1.CanCollide = false
&#9;part1.Transparency = 1
&#9;part1.CFrame = script.Parent.Engine.CFrame + Vector3.new(0,-8,0)
&#9;part1.Parent = script.Parent
&#9;local p1 = part1:clone()
&#9;p1.Anchored = false
&#9;p1.Transparency = 0
&#9;p1.BrickColor = BrickColor.new(&quot;Bright bluish green&quot;)
&#9;script.FinMesh:clone().Parent = p1
&#9;local p2 = p1:clone()
&#9;p1.Parent = script.Parent
&#9;p2.Parent = script.Parent
&#9;local w = Instance.new(&quot;Weld&quot;)
&#9;w.C0 = c0
&#9;w.C1 = Finc1
&#9;w.Part0 = part1
&#9;w.Part1 = p1
&#9;w.Parent = w.Part0
&#9;w = Instance.new(&quot;Weld&quot;)
&#9;w.C0 = c0
&#9;w.C1 = Fin2c1
&#9;w.Part0 = part1
&#9;w.Part1 = p2
&#9;w.Parent = w.Part0
&#9;script.Parent.Engine.BPos:clone().Parent = part1
&#9;script.Parent.Engine.Gyro:clone().Parent = part1
&#9;script.Parent.Engine.BAVe:clone().Parent = part1
&#9;part1.BPos.maxForce = Vector3.new(1000,300,1000)
&#9;part1.BAVe.maxTorque = Vector3.new(100,100,100)
&#9;part1.BAVe.angularvelocity = Vector3.new(0,15,0)
&#9;part1.Anchored = false
&#9;wait(6)
&#9;part1.BPos.position = part1.BPos.position + Vector3.new(0,-8,0)
&#9;wait(0.8)
&#9;p1.Parent = nil
&#9;p2.Parent = nil
&#9;part1.BPos:remove()
&#9;part1.Gyro:remove()
&#9;part1.BAVe:remove()
&#9;local m = Instance.new(&quot;Motor&quot;)
&#9;m.C0 = CFrame.new(0,0,0)
&#9;m.Part0 = script.Parent.Engine
&#9;m.Part1 = part1
&#9;m.Parent = m.Part0
&#9;local p3 = part1:clone()
&#9;p3.Anchored = false
&#9;p3.Transparency = 0
&#9;script.SharkMesh:clone().Parent = p3
&#9;p3.Parent = script.Parent
&#9;part1.CFrame = script.Parent.Engine.CFrame * CFrame.fromEulerAnglesXYZ(0,0,math.pi/2)
&#9;w = Instance.new(&quot;Weld&quot;)
&#9;w.C0 = c0
&#9;w.C1 = Sharkc1
