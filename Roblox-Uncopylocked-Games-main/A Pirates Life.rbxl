							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.Changed:connect(function()
&#9;local P = script.Parent.Parent:GetChildren()
&#9;for i = 1, #P do
&#9;&#9;if P[i].className == &quot;Model&quot; and P[i]:findFirstChild(&quot;owner&quot;) ~= nil then
&#9;&#9;&#9;P[i].Name = &quot;Storage Owner: &quot; .. script.Parent.Value
&#9;&#9;end
&#9;end
end)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
