					<Item class="Script" referent="RBX6478">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local player = script.Parent.Parent.Parent.Parent
local frame = script.Parent

local enemies, friends

function getEnemies()
&#9;local e = 0
&#9;for i, j in pairs(game.Players:GetChildren()) do
&#9;&#9;if j.TeamColor ~= player.TeamColor then
&#9;&#9;&#9;e = e + 1
&#9;&#9;end
&#9;end
&#9;enemies = e
end

function getFriends()
&#9;local f = 0
&#9;for i, j in pairs(game.Players:GetChildren()) do
&#9;&#9;if j.TeamColor == player.TeamColor then
&#9;&#9;&#9;f = f + 1
&#9;&#9;end
&#9;end
&#9;friends = f
end

function balanced()
&#9;getEnemies()
&#9;getFriends()
&#9;return (((friends-1)-(enemies+1)) &gt;= -1)
end

frame.betray.MouseButton1Click:connect(function()
&#9;frame.betray.Visible = false
--&#9;if not balanced() then
--&#9;&#9;frame.Imbalance.Visible = true
--&#9;else
&#9;&#9;frame.RUSure.Visible = true
--&#9;end
end)

frame.Imbalance.ok.MouseButton1Click:connect(function()
&#9;frame.Imbalance.Visible = false
&#9;frame.betray.Visible = true
end)

frame.Imbalance2.ok.MouseButton1Click:connect(function()
&#9;frame.Imbalance2.Visible = false
&#9;frame.betray.Visible = true
end)

frame.NoMoney.ok.MouseButton1Click:connect(function()
&#9;frame.NoMoney.Visible = false
&#9;frame.betray.Visible = true
end)

frame.RUSure.cancel.MouseButton1Click:connect(function()
&#9;frame.RUSure.Visible = false
&#9;frame.betray.Visible = true
end)

frame.RUSure.yes.MouseButton1Click:connect(function()
&#9;frame.RUSure.Visible = false
&#9;if not balanced() then
&#9;&#9;frame.Imbalance.Visible = true --Imbalance2.Visible = true
&#9;elseif player.Treasure.Value &lt; 5 then
&#9;&#9;frame.NoMoney.Visible = true
&#9;else
&#9;&#9;for i, j in pairs(workspace:GetChildren()) do
&#9;&#9;&#9;if j:IsA(&quot;Model&quot;) and j.Name == &quot;Storage&quot; and j:findFirstChild(&quot;Owner&quot;) and j.Owner.Value == player.Name then
&#9;&#9;&#9;&#9;j.Owner.Value = &quot;---&quot;
&#9;&#9;&#9;&#9;j.StoredTreasure.Value = 0
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;player.Treasure.Value = 0
&#9;&#9;player.MaxMoney.Value = 15
&#9;&#9;player.Squids.Value = 0
&#9;&#9;player.Helps.Value = 0
&#9;&#9;player.Food.Value = 0
&#9;&#9;player.Pet.Value = &quot;&quot;
&#9;&#9;for i, j in pairs(player:GetChildren()) do
&#9;&#9;&#9;if j:IsA(&quot;BoolValue&quot;) and string.sub(j.Name, 1, 3) == &quot;Has&quot; then
&#9;&#9;&#9;&#9;j.Value = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if player.TeamColor == BrickColor.new(&quot;Bright red&quot;) then
&#9;&#9;&#9;player.TeamColor = BrickColor.new(&quot;Really black&quot;)
&#9;&#9;elseif player.TeamColor == BrickColor.new(&quot;Really black&quot;) then
&#9;&#9;&#9;player.TeamColor = BrickColor.new(&quot;Bright red&quot;)
&#9;&#9;end
&#9;&#9;for i, j in pairs(player.Character:GetChildren()) do
&#9;&#9;&#9;if j:IsA(&quot;BasePart&quot;) then
&#9;&#9;&#9;&#9;j:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;player.Character.Humanoid.Health = 0 -- just to ensure that they DIE!
&#9;end
end)
</ProtectedString>
