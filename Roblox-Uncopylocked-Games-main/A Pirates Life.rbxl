					<Item class="Script" referent="RBX4484">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.Touched:connect(function(hit)
&#9;if script.Parent.Parent.Owner.Value == &quot;---&quot; then
&#9;&#9;local p = game.Players:playerFromCharacter(hit.Parent)
&#9;&#9;if p ~= nil then
&#9;&#9;&#9;print(p.Name)
&#9;&#9;&#9;if p.TeamColor ~= BrickColor.new(script.Parent.Parent.TeamColor.Value) then return end
&#9;&#9;&#9;local hasStorage = false
&#9;&#9;&#9;local P = workspace:GetChildren()
&#9;&#9;&#9;for i = 1, #P do
&#9;&#9;&#9;&#9;if P[i].Name == &quot;Storage&quot; and P[i]:findFirstChild(&quot;Owner&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if P[i].Owner.Value == p.Name then
&#9;&#9;&#9;&#9;&#9;&#9;hasStorage = true
&#9;&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;print(hasStorage)
&#9;&#9;&#9;if not hasStorage then
&#9;&#9;&#9;&#9;script.Parent.Parent.Owner.Value = p.Name
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
