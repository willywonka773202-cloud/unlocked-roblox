				<Item class="Script" referent="RBX2206">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">ChatFrame = script.Parent
wait(0.5)
Gui = ChatFrame.Parent
Pg = Gui.Parent
Player = Pg.Parent
repeat wait() until _G.GetTablePlayer(Player.Name) ~= nil 

Hide = 2 --2Maximize 1Hide -1 hidden

ChatTxt = {}
for i=1,#_G.ChatLog do
table.insert(ChatTxt,ChatFrame[&quot;Chat&quot; ..i])
end

Cbounce = false 
ChatFrame.Enter.MouseButton1Up:connect(function()
if Cbounce == false and ChatFrame.Type.Text ~= &quot;Click Here and Type to chat.&quot; then
Cbounce = true 
_G.AddChat(Player,ChatFrame.Type.Text) 
ChatFrame.Type.Text = &quot;Click Here and Type to chat.&quot;
wait(2.5)
Cbounce = false
end 
end)

Max = 0
Half = -0.2
Hidez = -0.28

ChatFrame.HideShow.MouseButton1Up:connect(function()
if Hide == 2 then
ChatFrame.Position = UDim2.new(0,0,Half,0)
ChatFrame.HideShow.Text1.Text = &quot;Hide&quot;
Hide = 1
elseif Hide == 1 and ChatFrame.HideShow.Text1.Text == &quot;Hide&quot; then
ChatFrame.Position = UDim2.new(0,0,Hidez,0)
ChatFrame.HideShow.Text1.Text = &quot;Show&quot;
Hide = -1
elseif Hide == -1  then
ChatFrame.Position = UDim2.new(0,0,Half,0)
ChatFrame.HideShow.Text1.Text = &quot;Maximize&quot;
Hide = 1
elseif Hide == 1 and ChatFrame.HideShow.Text1.Text == &quot;Maximize&quot; then
ChatFrame.Position = UDim2.new(0,0,Max,0)
ChatFrame.HideShow.Text1.Text = &quot;Minimize&quot;
Hide = 2
end 
end)

while true do 
wait()
local x = 0
for z=1,#ChatTxt,1 do
x = x + 1
ChatTxt[x].Text = _G.ChatLog[x]
ChatTxt[x].TextColor3 = BrickColor.new(_G.ChatTextColor[x]).Color
end
end 

</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
