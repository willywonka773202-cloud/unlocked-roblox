w(0.5)
local killer,klz = GetMostKills()
for i=1,#_G.Kills2 do
_G.Kills2[i] = 0
end 
if killer ~= nil then
_G.UpdateSW(_G.Players[killer].. &quot; has won with &quot; ..klz.. &quot; kills!&quot;)
w(0.5)
