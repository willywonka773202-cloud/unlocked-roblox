function GiveAdminFace(pname)
local playerz = game:service(&quot;Players&quot;)
if playerz:findFirstChild(pname) == nil then return end
local playorz = playerz[pname]
if playorz.Character == nil then return end
local charactorz = playorz.Character
if charactorz:findFirstChild(&quot;Head&quot;) == nil then return end 
local headzorz = charactorz.Head
if headzorz:findFirstChild(&quot;face&quot;) == nil then return end 
headzorz.face.Texture = &quot;http://www.roblox.com/asset/?id=34723158&quot;
end

_G.ActivateAdmin = function(pname)
if game.Players:findFirstChild(pname) ~= nil then
if game.Players:findFirstChild(pname).Name:sub(1,6) == &quot;Guest &quot; or game.Players:findFirstChild(pname).Name == &quot;Player&quot; then return false end 
for i=1,#_G.Admin do 
if pname:lower() == _G.Admin[i]:lower() then
game.Players:findFirstChild(pname):SaveString(&quot;Rank&quot;,&quot;Admin&quot;)
_G.UpdateSW(&quot;Admin Detected... (&quot; ..pname.. &quot;)&quot;)
GiveAdminFace(pname)
return true
end
end
return false 
end
end
_G.IsAdmin = function(pname)
if game.Players:findFirstChild(pname) ~= nil then
if game.Players:findFirstChild(pname).Name:sub(1,6) == &quot;Guest &quot; or game.Players:findFirstChild(pname).Name == &quot;Player&quot; then return false end 
if game.Players:findFirstChild(pname):LoadString(&quot;Rank&quot;) == &quot;Admin&quot; then
return true
else
return false
end 
end 
end
----
_G.IsMember = function(pname)
if game.Players:findFirstChild(pname) ~= nil then
if game.Players:findFirstChild(pname).Name:sub(1,6) == &quot;Guest &quot; or game.Players:findFirstChild(pname).Name == &quot;Player&quot; then return false end 
if game.Players:findFirstChild(pname):LoadString(&quot;Rank&quot;) == &quot;Member&quot; then
return true
else
return false
end 
end 
end
----
_G.ActivateMembership = function(pname)
if game.Players:findFirstChild(pname) ~= nil then
if game.Players:findFirstChild(pname).Name:sub(1,6) == &quot;Guest &quot; or game.Players:findFirstChild(pname).Name == &quot;Player&quot; then return false end 
local p = game.Players[pname]
if p.Character ~= nil then
if p.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
if p.Character.Torso:findFirstChild(&quot;roblox&quot;) ~= nil then 
if _G.IsAdmin(pname) == true then return false end 
local Memberz = p.Character.Torso.roblox.Texture
if Memberz == &quot;http://www.roblox.com/asset/?id=&quot; .._G.MemberId then
game.Players:findFirstChild(pname):SaveString(&quot;Rank&quot;,&quot;Member&quot;)
return true
else
--p:SaveString(&quot;Rank&quot;,&quot;Free&quot;)
return false 
end 
end
end
end 
return false 
end 
end


_G.Killed = function(i1,i2,txtz)
local p1 = _G.Players2[i1] --killer
local p2 = _G.Players2[i2] --victim 
pcall(function()
p2.PlayerGui.WepGui.KilledBy.Visible = true
p2.PlayerGui.WepGui.KilledBy.Reason.Text = txtz
p2.PlayerGui.WepGui.KilledBy.Avatar.Image = [[http://www.roblox.com/Thumbs/Avatar.ashx?x=100&amp;y=100&amp;Format=Png&amp;username=]] ..p1.Name.. [[&amp;RAND]] .. math.random(1,100000000)
end)

pcall(function()
local obh = Instance.new(&quot;ObjectValue&quot;)
obh.Name = &quot;Killer&apos;s Camera&quot;
obh.Value = p1.Character.Humanoid
obh.Parent = p2.Backpack:findFirstChild(&quot;ToolScript&quot;)
end)
end 
--:P

function GiveTeam(t1,t2,n)
local t1s = 0
local t2s = 0
for iz=1,#_G.Team do 
if _G.Team[iz] == t1 then
t1s = t1s + 1
elseif _G.Team[iz] == t2 then
t2s = t2s + 1
end
end
if t2s &gt; t1s then
--table.insert(_G.Team,t1)
_G.UpdateSW(n.. &quot; has been set to &quot; ..t1.. &quot;.&quot;)
return t1
elseif t1s &gt; t2s then
--table.insert(_G.Team,t2)
_G.UpdateSW(n.. &quot; has been set to &quot; ..t2.. &quot;.&quot;)
return t2
else
if math.random(1,2) == 1 then
--table.insert(_G.Team,t1)
_G.UpdateSW(n.. &quot; has been set to &quot; ..t1.. &quot;.&quot;)
return t1
else
--table.insert(_G.Team,t2)
_G.UpdateSW(n.. &quot; has been set to &quot; ..t2.. &quot;.&quot;)
return t2
end
end
end
--

function GiveCharType(t1,t2,n)
local t1s = 0
local t2s = 0
for iz,t in pairs(_G.CharType) do
if _G.CharType[iz] == t1 then
t1s = t1s + 1
elseif _G.CharType[iz] == t2 then
t2s = t2s + 1
end
end
if t1s &gt; t2s then
_G.UpdateSW(n.. &quot; is now a &quot; ..t1.. &quot;.&quot;)
return t1
elseif t2s &gt; t1s then
table.insert(_G.CharType,t2)
_G.UpdateSW(n.. &quot; is now a &quot; ..t2.. &quot;.&quot;)
return t2
else
if math.random(1,2) == 1 then
_G.UpdateSW(n.. &quot; is now a &quot; ..t1.. &quot;.&quot;)
return t1
else
_G.UpdateSW(n.. &quot; is now a &quot; ..t2.. &quot;.&quot;)
return t2
end
end
end
