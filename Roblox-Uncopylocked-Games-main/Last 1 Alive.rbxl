Informed = 0

function Inform(iMsgz)
coroutine.resume(coroutine.create(function()
Informed = Informed + 1
infz = Informed
inf2.Text = iMsgz
inf1.Position = UDim2.new(0,-inf2.TextBounds.x/2,0,0)
for i=1,8 do
if Informed ~= infz then break end
for gt=0.4,0,-0.1 do
inf1.BackgroundTransparency = gt
inf1.TextTransparency = gt
inf2.TextTransparency = gt
wait(0.07)
end
for gt=0,0.4,0.1 do
inf1.BackgroundTransparency = gt
inf1.TextTransparency = gt
inf2.TextTransparency = gt
wait(0.07)
end
wait()
end
if Informed ~= infz then return
else
inf1.BackgroundTransparency = 1
inf1.TextTransparency = 1
inf2.TextTransparency = 1
end
end))
end


function ws(walkspeedz)
Human.WalkSpeed = walkspeedz
end 


function stick(hit2,hit)
    -- if hit2 hits hit, hit2 sticks to hit

    local weld = Instance.new(&quot;Weld&quot;)

    weld.Part0 = hit2
    weld.Part1 = hit

    -- correction term to account for average skew between physics update and heartbeat
    local HitPos = hit2.Position --+ (-arrow.Velocity * (1/60)) --+ (arrow.CFrame.lookVector * .5)

    local CJ = CFrame.new(HitPos)
    local C0 = hit2.CFrame:inverse() *CJ
    local C1 = hit.CFrame:inverse() * CJ
 
    weld.C0 = C0
    weld.C1 = C1

    weld.Parent = hit2

end

