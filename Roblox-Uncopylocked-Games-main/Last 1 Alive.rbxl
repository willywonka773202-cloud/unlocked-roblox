-- Create Weld --
local function iWeld(P0, P1, C0, C1)
 local Weld = iNew(&quot;Weld&quot;)
 Weld.Part0 = P0
 Weld.Part1 = P1
 Weld.C0 = C0 or cfNew()
 Weld.C1 = C1 or cfNew()
 Weld.Parent = P0
 return Weld
end
-- Fake Head --
local fHead = Head:Clone()
for _, Child in Next, fHead:GetChildren() do
 if not Child.className:find(&quot;Mesh&quot;) then
  Child:Remove()
 end
end
iWeld(Head, fHead)
fHead.Name = &quot;Fake Head&quot;
fHead.Parent = Char
Head.Transparency = 1
--Remove Stupid Hats
r(Char,&quot;Swordpack&quot;)
-- Fake Torso --
local Suit = iNew(&quot;Part&quot;)
Suit.Size = v3New(2, 2, 1)
Suit.TopSurface = &quot;Smooth&quot;
Suit.CanCollide = false 
Suit.BottomSurface = &quot;Smooth&quot;
Suit.FormFactor = &quot;Symmetric&quot;
Suit.Size = Vector3.new(2,2,1)
Suit.BrickColor = Player.TeamColor
iWeld(Suit, Torso, cfAng(0, mPi / 4, 0))
Torso.Transparency = 1
Suit.Parent = Char
