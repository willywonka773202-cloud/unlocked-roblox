function GetMostKills()
local highestkills = 0
for i=1,#_G.Kills2 do 
if _G.Kills2[i] &gt; highestkills then 
highestkills = _G.Kills2[i]
end end
local tiecheck = 0
local killerid = nil
for i=1,#_G.Kills2 do 
if _G.Kills2[i] == highestkills then 
tiecheck = tiecheck + 1
killerid = i
end end

if tiecheck == 1 then return killerid,highestkills end 
if tiecheck &gt; 1 then return nil,nil end
end


function GetTeamMostKills(t1z,t2z)
team15xzxzx = 0
team25xzxzx = 0
for xi=1,#_G.Team do 
if _G.Team[xi] == t1z then 
team15xzxzx = team15xzxzx + _G.Kills2[xi]
elseif _G.Team[xi] == t2z then
team25xzxzx = team25xzxzx + _G.Kills2[xi]
end
end

if team15xzxzx &gt; team25xzxzx then return t1z,team15xzxzx end
if team15xzxzx &lt; team25xzxzx then return t2z,team25xzxzx end
if team15xzxzx == team25xzxzx then return nil,nil end
return nil,nil
end 


function CheckLastTeam(t1,t2)
local t1s = 0
local t2s = 0 
for i=1,#_G.Team do
if _G.Team[i] == t1 then
t1s = t1s + 1
elseif _G.Team[i] == t2 then
t2s = t2s + 1
end
end
if t2s == 0 then 
return t1
elseif t1s == 0 then 
return t2
else
return nil
end
end
