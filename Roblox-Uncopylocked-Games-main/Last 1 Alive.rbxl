								<string name="Name">Script</string>
								<ProtectedString name="Source">f = script.Parent
sg = f.StartGame
w0 = f.Welcome0
w1 = f.Welcome1
w2 = f.Welcome2
ft = f.FirstTime
i1 = f.Information1
ra = f.Rank
lo = f.lol
Gui = f.Parent
PlayerGui = Gui.Parent
Player = PlayerGui.Parent 

a = false
sg.MouseButton1Up:connect(function()
if a == true then return end a = true 
for i=0,1,0.02 do 
f.BackgroundTransparency = i
sg.BackgroundTransparency = i
sg.Text1.TextTransparency = i
w0.TextTransparency = i
w1.TextTransparency = i
w2.TextTransparency = i
ft.TextTransparency = i
i1.TextTransparency = i
ra.TextTransparency = i
lo.TextTransparency = i
wait()
end
Gui:Remove()
end) 

rank = nil
vis = nil
if Player.Name:sub(1,6) ~= &quot;Guest &quot; and Player.Name ~= &quot;Player&quot; then
rank = Player:LoadString(&quot;Rank&quot;)
vis = f.Visits.Value
else
rank = &quot;CREATE AN ACCOUNT AND VERIFY IT!&quot;
vis = 1
end 
w0.Text = &quot;Welcome &quot; ..Player.Name.. &quot; , to RMDX&apos;s Game!&quot;
if vis &lt; 2 then ft.Visible = true else ft.Visible = false end 
ra.Text = &quot;Your Current Rank: &quot; ..rank
w2.Text = &quot;You Visited this Game &quot; ..vis.. &quot; Times! :3&quot;






</ProtectedString>
