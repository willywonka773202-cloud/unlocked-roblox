coroutine.resume(coroutine.create(function()
repeat 
wait()
until Char ~= nil and Char:findFirstChild(&quot;Health&quot;) ~= nil
Char.Health:Remove() 
repeat 
wait()
until Char ~= nil and Char:findFirstChild(&quot;HealthScript v3.0&quot;) ~= nil
Char[&quot;HealthScript v3.0&quot;]:Remove() 
repeat 
