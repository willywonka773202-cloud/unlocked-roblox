						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MouseIconReturn</string>
						<ProtectedString name="Source">if game.Players.LocalPlayer.Character then
local t = Instance.new(&quot;Tool&quot;)
local p = Instance.new(&quot;Part&quot;,t) p.Name = &quot;Handle&quot;

for i,v in pairs(workspace.CurrentCamera:children()) do 
v:Remove()
end 


coroutine.resume(coroutine.create(function()
if game.Players.LocalPlayer.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then 
if game.Players.LocalPlayer.Character:findFirstChild(&quot;Head&quot;) ~= nil then  
repeat wait() until game.Players.LocalPlayer.Character.Head.Anchored == false 
--workspace.CurrentCamera.CoordinateFrame = game.Players.LocalPlayer.Character.Head.CFrame
workspace.CurrentCamera.CameraSubject = game.Players.LocalPlayer.Character.Humanoid
 end 
else game.Players.LocalPlayer.Character:BreakJoints() -- end
end
end))

local function rayCast(Pos, Dir, Max, Ignore) 
return Workspace:FindPartOnRay(Ray.new(Pos, Dir.unit * (Max or 999.999)), Ignore) 
end 

t.Equipped:connect(function(mouse) t:Remove() Selecting = true
mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot; 
if script.Parent.Parent.Character ~= nil and script.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;) ~= nil and script.Parent.Parent.Character.Torso:findFirstChild(&quot;Neck&quot;) ~= nil then
script.Parent.Parent.Character.Torso.Neck.C0 = CFrame.new(0,1,0) *CFrame.Angles(math.rad(-90),0,math.rad(180))
end 
wait(0.5)
if workspace.CurrentCamera.CameraSubject ~= game.Players.LocalPlayer.Character.Humanoid then 
game.Players.LocalPlayer:BreakJoints() end 
script:Remove()
end)

wait(1)
t.Parent = game.Players.LocalPlayer.Character
else
script:Remove()
end 


