								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">TeamScript</string>
								<ProtectedString name="Source">hb = script.Parent
msg = hb.Parent
t = msg.Parent
gui = t.Parent
pg = gui.Parent
Player = pg.Parent
teamer = hb.Team
while true do 
wait()
if hb.Visible == true then
if game.Players:findFirstChild(msg.Text) ~= nil then 
local i1 = _G.GetTablePlayer(Player.Name)
local i2 = _G.GetTablePlayer(msg.Text)
if _G.Team[i1] == &quot;None&quot; and _G.Team[i2] == &quot;None&quot; then
teamer.BackgroundColor3 = Color3.new(255,0,0)
teamer.Text = &quot;Enemy&quot;
else
if _G.Team[i1] == _G.Team[i2] then 
teamer.BackgroundColor3 = Color3.new(0,0,255)
teamer.Text = &quot;Team&quot;
else
teamer.BackgroundColor3 = Color3.new(255,0,0)
teamer.Text = &quot;Enemy&quot;
end
end 
end
end
end 
----</ProtectedString>
