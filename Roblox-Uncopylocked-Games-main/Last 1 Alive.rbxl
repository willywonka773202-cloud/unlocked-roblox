function LaserRay(mpos,divac,plusacu,FireRate,Accuracy,Automatic,Damage,g)
local gg = Gun
if g ~= nil then gg = g end 
if Crouch == true then Accuracy = Accuracy + plusacu end
if LaserSight == true then Accuracy = Accuracy + 10 end
   local Pos0, Pos1 = gg.Position + Torso.CFrame.lookVector*2, mpos
   local Dist = (Pos0 - Pos1).magnitude
   local Pos1 = Pos1 + v3New(
    mRandom(-100, 100) / Accuracy / divac * (Dist/1.5),
    mRandom(-100, 100) / Accuracy / divac * (Dist/1.5),
    mRandom(-100, 100) / Accuracy / divac * (Dist/1.5))
    local Pos1, Hit, Dist, Face = RayCast(Pos0, (Pos1 - Pos0).unit)
   local Dist = (Pos0 - Pos1).magnitude
   local Dir = (Pos1 - Pos0).unit
   if Hit then Mark(Pos1,Face,Hit) LaserHit(Hit,Damage) end
   -- Create Laser --
   local Laser = iNew(&quot;Part&quot;)
   Laser.Transparency = 0.7
   Laser.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
   Laser.Anchored = true
   Laser.CanCollide = false
   Laser.formFactor = &quot;Custom&quot;
   Laser.Size = v3New(0.2, 0.2, 1)
   Laser.CFrame = cfNew(Pos0, Pos1)
   local Mesh = iNew(&quot;BlockMesh&quot;)
   Mesh.Offset = v3New(0, 0, -Dist / 2)
   Mesh.Scale = v3New(1, 1, Dist)
   Mesh.Parent, Laser.Parent = Laser, workspace
   Debris:AddItem(Laser, 0.3)
PlayAnim(&quot;fire&quot;)
end
-- Laser Hit --
function LaserHit(Hitxx, Dam,killwith,hitshow) 
if Hitxx.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end 
if Hitxx.Parent:findFirstChild(&quot;Humanoid&quot;).Health == 0 then return end 
if req.Name == &quot;Request1&quot; then
req = script.Request2
else
req = script.Request1
end
local req2 = req
if killwith ~= nil then
req2.KilledBy.Value = tostring(killwith)
else
if Use == &quot;Gun&quot; then
req2.KilledBy.Value = Use2.Gun
elseif Use == &quot;Secondary&quot; then
req2.KilledBy.Value = Use2.Secondary
end 
end
req2.Damage.Value = Dam
req2.creator.Value = Player
req2.Hit.Value = Hitxx
if hitshow == false then
else 
print(hitshow)
if Hitxx.Name == &quot;Head&quot; then
EnemyHit(&quot;Head Shot!&quot;)
else
EnemyHit(&quot;Hit!&quot;)
end
end 
end
