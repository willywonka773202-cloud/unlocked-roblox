							<Item class="Script" referent="RBX10724">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">for i,v in pairs(script.Parent:GetChildren()) do
if v.Name == &quot;Seat&quot; then 
v.ChildAdded:connect(function(a)
if a.Name == &quot;SeatWeld&quot; then
if _G.CharType[_G.GetTablePlayer(a.Part1.Parent.Name)] == &quot;Zombie&quot; then 
a.Part1.Parent.Humanoid.Jump = true 
else
table.insert(_G.Seated,a.Part1.Parent.Name)
end
end
end)
v.ChildRemoved:connect(function(a)
for ii,x in pairs(_G.Seated) do
if x == a.Part1.Parent.Name then 
table.remove(_G.Seated,ii)
end
end 
end)
end
end 
-----</ProtectedString>
								</Properties>
							</Item>
