						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">Frame = script.Parent
Gui = Frame.Parent
PlayerGui = Gui.Parent
Player = PlayerGui.Parent
n = Player.Name
c = Gui.Chat
of = Frame.OptionFrame
SprayImage = of.SprayImage
SprayImage2 = of.SprayImage2
SprayImage3 = of.SprayImage3
hel = of.Help
hel2 = of.Help2


opt = c.Options
repeat wait() until _G.GetTablePlayer(Player.Name) ~= nil 
wait()
tf = Gui.TimeFrame
t = tf.Time

function Getenum(l)
local x = 0
for i=#l,0,-1 do 
if l:sub(i,i) == &quot;.&quot; then
x = i
break
end
end 
return l:sub(x+1)
end 

entershowuse = false
mTypes = {
[&quot;BuildersClub&quot;] = &quot;rbxasset://textures//ui//TinyBcIcon.png&quot;;
[&quot;TurboBuildersClub&quot;] = &quot;rbxasset://textures//ui//TinyTbcIcon.png&quot;;
[&quot;OutrageousBuildersClub&quot;] = &quot;rbxasset://textures//ui//TinyObcIcon.png&quot;;
}
entered = Gui.Entered
av = entered.avatar
typ = entered.mtype
nam = entered.name
function ShowEnterGui(p)
if entershowuse == true then return end 
entershowuse = true
nam.Text = p.Name
av.Image = [[http://www.roblox.com/Thumbs/Avatar.ashx?x=100&amp;y=100&amp;Format=Png&amp;username=]] ..p.Name.. [[&amp;RAND]] .. math.random(1,100000000)
if p:IsA(&quot;Player&quot;) then
local type = Getenum(tostring(p.MembershipType))
if mTypes[type] ~= nil then 
typ.Image = mTypes[type]
end
end 
for i=-0.2,0,0.01 do
entered.Position = UDim2.new(0.6,0,i,0)
wait()
end
wait(2)
for i=0,-0.2,-0.01 do
entered.Position = UDim2.new(0.6,0,i,0)
wait()
end
av.Image = &quot;&quot;
typ.Image = &quot;&quot;
nam.Text = &quot;&quot;
entershowuse = false
end
game.Players.ChildAdded:connect(function(p) ShowEnterGui(p) end)

coroutine.resume(coroutine.create(function()
repeat wait(0.02) until PlayerGui:findFirstChild(&quot;HealthGUI&quot;) ~= nil
PlayerGui.HealthGUI:Remove()
end))

coroutine.resume(coroutine.create(function()
while true do 
if _G.GameProcess == &quot;Lobby1&quot; then 
c.Button1.Text1.Text = &quot;Vote Quick Start&quot;
if _G.Votes3[_G.GetTablePlayer(n)] == 1 then
c.Button1.Visible = true
else
c.Button1.Visible = false
end

end
for i=1,10 do
Frame[&quot;Text&quot; ..i].Text = _G.Software[i]
end 
if _G.Map == nil then
Frame.Map.Text = &quot;Map: None&quot;
else
Frame.Map.Text = &quot;Map: &quot; .._G.Map
end
if _G.Mode == nil then
Frame.Mode.Text = &quot;Mode: None&quot;
else
Frame.Mode.Text = &quot;Mode: &quot; .._G.Mode
end
Frame.Version.Text = &quot;Version: &quot; .._G.Version
local disttime = (workspace.DistributedGameTime/60)*100
Frame.Time.Text = &quot;Server Time: &quot; .._G.GetTime(math.floor(workspace.DistributedGameTime)).. &quot; m&quot;
Frame.Points.Text = &quot;Points: &quot; ..tostring(math.floor(_G.Points[_G.GetTablePlayer(n)]))
Frame.Kills.Text = &quot;Kills: &quot; .._G.Kills[_G.GetTablePlayer(n)]
Frame.Deaths.Text = &quot;Deaths: &quot; .._G.Deaths[_G.GetTablePlayer(n)]
local as = &quot;&quot;
if _G.CharType[_G.GetTablePlayer(n)] == &quot;Player&quot; then 
as = &quot;Player&quot;
else
as = &quot;Zombie&quot;
end
Frame.Type.Text = &quot;Type: &quot; ..as.. &quot; &quot;
Frame.Team.Text = &quot;Team: &quot; .._G.Team[_G.GetTablePlayer(n)] 
if Player.Character ~= nil then
local c = Player.Character 
local col = nil
local perc = ((c.Humanoid.Health/c.Humanoid.MaxHealth)*100)
if  perc &gt; 75 then 
col = game.Lighting.Stuff.Special.Alder.BackgroundColor3
elseif perc &lt; 76 and perc &gt; 25 then
col = game.Lighting.Stuff.Special.Yellow.BackgroundColor3
else
col = game.Lighting.Stuff.Special.Red.BackgroundColor3
end 
script.Parent.Parent.Healthx.Pic.Fill.Size = UDim2.new(0.5,0,(c.Humanoid.Health/c.Humanoid.MaxHealth)*-0.45,0)
script.Parent.Parent.Healthx.Pic.Fill.BackgroundColor3 = col
pcall(function()
Frame.Speed.Text = &quot;Speed: &quot; ..math.floor(c.Humanoid.WalkSpeed)
Frame.Health.Text = &quot;Health: &quot; ..math.floor(c.Humanoid.Health).. &quot;/&quot; ..math.floor(c.Humanoid.MaxHealth)
end)
end
t.Text = _G.Timer
wait()
end
end))

plusvote = 1
c.Button1.MouseButton1Up:connect(function()
if _G.Votes3[_G.GetTablePlayer(n)] == 1 then
_G.Votes3[_G.GetTablePlayer(n)] = 0
if Player.Name:sub(1,6) == &quot;Guest &quot; then
else
if _G.IsAdmin(Player.Name) == true then plusvote = plusvote + 2.5 end
if _G.IsMember(Player.Name) == true then plusvote = plusvote + 0.8 end
end
_G.Vote3 = _G.Vote3 + plusvote
end
end)

Minimizedz = 1

Frame.Minimize.MouseButton1Up:connect(function()
if Minimizedz == 1 then
Minimizedz = 0
Frame.Position = UDim2.new(-0.2,0,0.4,0)
Frame.Minimize.Text = &quot;&gt;&quot;
Minimizedz = -1
elseif Minimizedz == -1 then
Minimizedz = 0
Frame.Position = UDim2.new(0,0,0.4,0)
Frame.Minimize.Text = &quot;&lt;&quot;
Minimizedz = 1
end
end)
