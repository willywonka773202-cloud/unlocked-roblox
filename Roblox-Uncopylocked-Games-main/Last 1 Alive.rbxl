function GetNearPlayer(urpos,maxmag)
for i,v in pairs(game.Players:GetChildren()) do 
if v.Character ~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil and math.abs((v.Character.Torso.Position-urpos).magnitude) &lt; maxmag then 
return v.Character.Torso
end
end 
return nil
end 

function Puke(ts)
for i=1,ts do
local pu = Instance.new(&quot;Part&quot;)
pu.Parent = workspace.Stuff.FinishClean
pu.BrickColor = BrickColor.new(&quot;Dark green&quot;)
pu.formFactor = &quot;Custom&quot;
pu.Shape = &quot;Ball&quot;
pu.CanCollide = false
pu.Transparency = 0.4
pu.Size = Vector3.new(2,2,2)
pu.TopSurface = 0
pu.BottomSurface = 0
pu.CFrame = Head.CFrame + Head.CFrame.lookVector*2.5
pu.Velocity = pu.Velocity + pu.CFrame.lookVector *100
local pud = false
coroutine.resume(coroutine.create(function()
while pud == false do
local hit = GetNearPlayer(pu.Position,4)
if hit ~= nil and hit:IsDescendantOf(Char) == false then 
