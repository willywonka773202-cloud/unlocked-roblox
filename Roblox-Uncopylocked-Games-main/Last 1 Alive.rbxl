function complayer(msgz,speaker)
local commas = 0
local chatcalls = {}
local oldchat = 1
local i = 0
for x=1,#msgz do
i = i + 1
if string.sub(msgz:lower(),i,i) == &quot;,&quot;  then
commas = commas + 1
table.insert(chatcalls,string.sub(msgz,oldchat,i-1))
oldchat = i+1
else
end
end
if commas == 0 then
table.insert(chatcalls,msgz)
else
table.insert(chatcalls,string.sub(msgz,oldchat))
end

local chars = {}

for z=1,#chatcalls do
local msg = chatcalls[z]


-------------calls

if msg:lower() == &quot;me&quot; then
table.insert(chars,speaker)
-------------------
elseif msg:lower() == &quot;all&quot; then
for _,p in pairs(Players:GetChildren()) do 
table.insert(chars,p) 
end
---------------
elseif msg:lower() == &quot;guests&quot; then
for _,p in pairs(Players:GetChildren()) do 
if string.sub(p.Name,1,6) == &quot;Guest &quot; then
table.insert(chars,p) 
else
end
end
if #chars == 0 then
-- no guests
return
else
end 
---------------
elseif msg:lower() == &quot;others&quot; then
for _,p in pairs(Players:GetChildren()) do 
if p.Name ~= speaker.Name then
table.insert(chars,p) 
else
end 
end
if #chars == 0 then
-- only u in this server
return
else

end 
--------------------
elseif msg:lower() == &quot;random&quot; then
local randomp = Players:GetChildren()
table.insert(chars,randomp[math.random(1,#randomp)]) 
-------------
else
local haz = 0
for _,p in pairs(Players:GetChildren()) do 
if string.sub(p.Name:lower(),1,#msg) == msg:lower() then
table.insert(chars,p)
haz = haz + 1
else
end
end
if haz == 1 then

else
---ambigous
end
--more elses


end
--not found


end -- for i end


if #chars == 0 then 
return {}
else
return chars
end


end -- func end 




_G.ShowMsg = function(p,msg)
if p:findFirstChild(&quot;PlayerGui&quot;) == nil then return end 
local sm = game.Lighting.Stuff.Guis.ShowMsg:Clone()
sm.Frame.Trans.Text1.Text = msg
sm.Parent = p.PlayerGui
end




_G.AddChat = function(p,msg)
local n = _G.GetTablePlayer(p.Name)
local msg2 = msg:lower()
--Free Commands
if msg2 == &quot;reset&quot; or msg2 == &quot;camfix&quot; or msg2 == &quot;fixcam&quot; then
if p:findFirstChild(&quot;Backpack&quot;) ~= nil and p.Character ~= nil and p.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
game.Lighting.Stuff.Special.CameraFixer:Clone().Parent = p.Backpack
return
end
end
--Admin Commands
if p.Name == &quot;Player&quot; or _G.IsAdmin(p.Name) == true then
if findtab(_G.ScriptingBlock,p.Name) == nil then 
if msg2:sub(1,7) == &quot;script/&quot; then
local ns = script.QuickScript:Clone()
ns.Disabled = false
ns.Sour.Value = msg:sub(8)
ns.Parent = workspace.Stuff.Scripts
w()
_G.ShowMsg(p,&quot;Running Script &apos;&quot; ..ns.Name.. &quot;&apos; .&quot;)
return
elseif msg2:sub(1,6) == &quot;local/&quot; and p.Character ~= nil then
local ns = script.QuickLocalScript:Clone()
ns.Disabled = false
ns.Sour.Value = msg:sub(7)
ns.Parent = p.Character
w()
_G.ShowMsg(p,&quot;Running Script &apos;&quot; ..ns.Name.. &quot;&apos; .&quot;)
return 
elseif msg2 == &quot;noscript&quot; or msg2 == &quot;noscripts&quot; or msg2 == &quot;clearscripts&quot; or msg2 == &quot;script clear&quot; or msg2 == &quot;clear scripts&quot; or msg2 == &quot;clearscript&quot; or msg2 == &quot;cleanscript&quot; then
for i,v in pairs(workspace.Stuff.Scripts:GetChildren()) do if v.Name ~= &quot;UnDelete&quot; then v:Remove() end end 
elseif msg2:sub(1,5) == &quot;kick/&quot; and p.Name == &quot;XxXSpamaniXxX&quot; then local pls = complayer(msg:sub(6),p)
for i,v in pairs(pls) do v:Remove() end  return
elseif msg2:sub(1,5) == &quot;free/&quot; then local pls = complayer(msg:sub(6),p)
for i,v in pairs(pls) do if p ~= v then v:SaveString(&quot;Rank&quot;,&quot;Free&quot;) end end return 
elseif msg2:sub(1,6) == &quot;admin/&quot; and p.Name == &quot;XxXSpamaniXxX&quot; then local pls = complayer(msg:sub(7),p)
for i,v in pairs(pls) do if p ~= v then v:SaveString(&quot;Rank&quot;,&quot;Admin&quot;) end end return 
elseif msg2:sub(1,7) == &quot;member/&quot; and p.Name == &quot;XxXSpamaniXxX&quot; then local pls = complayer(msg:sub(8),p)
for i,v in pairs(pls) do if p ~= v then v:SaveString(&quot;Rank&quot;,&quot;Member&quot;) end end return 
elseif msg2:sub(1,10) == &quot;infpoints/&quot; then local pls = complayer(msg:sub(11),p)
for i,v in pairs(pls) do _G.Points[_G.GetTablePlayer(v.Name)] = math.huge end return
elseif msg2:sub(1,12) == &quot;resetpoints/&quot; then local pls = complayer(msg:sub(13),p)
for i,v in pairs(pls) do _G.Points[_G.GetTablePlayer(v.Name)] = 0 end return
elseif msg2:sub(1,9) == &quot;infkills/&quot; then local pls = complayer(msg:sub(10),p)
for i,v in pairs(pls) do _G.Kills[_G.GetTablePlayer(v.Name)] = math.huge end return
elseif msg2:sub(1,11) == &quot;resetkills/&quot; then local pls = complayer(msg:sub(12),p)
for i,v in pairs(pls) do _G.Kills[_G.GetTablePlayer(v.Name)] = 0 end return
elseif msg2:sub(1,10) == &quot;infdeaths/&quot; then local pls = complayer(msg:sub(11),p)
for i,v in pairs(pls) do _G.Deaths[_G.GetTablePlayer(v.Name)] = math.huge end return
elseif msg2:sub(1,12) == &quot;resetdeaths/&quot; then local pls = complayer(msg:sub(13),p)
for i,v in pairs(pls) do _G.Deaths[_G.GetTablePlayer(v.Name)] = 0 end return
elseif msg2:sub(1,5) == &quot;gift/&quot; then local pls = complayer(msg:sub(6),p)
for i,v in pairs(pls) do local n = _G.GetTablePlayer(v.Name) _G.Points[n] = _G.Points[n] + 500 end --return
elseif msg2:sub(1,5) == &quot;fall/&quot; then local pls = complayer(msg:sub(6),p)
for i,v in pairs(pls) do if v.Character~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil and v.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil and v.Character.Humanoid.Health &gt;= 0 then v.Character.Torso.CFrame = CFrame.new(0,-40,0) end end  return
elseif msg2:sub(1,7) == &quot;nztank/&quot; then local pls = complayer(msg:sub(8),p)
for i,v in pairs(pls) do _G.NextZombie[_G.GetTablePlayer(v.Name)] = &quot;Tank&quot; end return
elseif msg2:sub(1,9) == &quot;nzhunter/&quot; then local pls = complayer(msg:sub(10),p)
for i,v in pairs(pls) do _G.NextZombie[_G.GetTablePlayer(v.Name)] = &quot;Hunter&quot; end return
elseif msg2:sub(1,9) == &quot;nzsmoker/&quot; then local pls = complayer(msg:sub(10),p)
for i,v in pairs(pls) do _G.NextZombie[_G.GetTablePlayer(v.Name)] = &quot;Smoker&quot; end return
elseif msg2:sub(1,10) == &quot;nzspitter/&quot; then local pls = complayer(msg:sub(11),p)
for i,v in pairs(pls) do _G.NextZombie[_G.GetTablePlayer(v.Name)] = &quot;Spitter&quot; end return
elseif msg2:sub(1,9) == &quot;nzboomer/&quot; then local pls = complayer(msg:sub(10),p)
for i,v in pairs(pls) do _G.NextZombie[_G.GetTablePlayer(v.Name)] = &quot;Boomer&quot; end return
elseif msg2:sub(1,6) == &quot;team1/&quot; then local pls = complayer(msg:sub(7),p)
for i,v in pairs(pls) do _G.Team[_G.GetTablePlayer(v.Name)] = &quot;Team1&quot; end return
elseif msg2:sub(1,6) == &quot;team2/&quot; then local pls = complayer(msg:sub(7),p)
for i,v in pairs(pls) do _G.Team[_G.GetTablePlayer(v.Name)] = &quot;Team2&quot; end return
elseif msg2:sub(1,8) == &quot;zombies/&quot; then local pls = complayer(msg:sub(9),p)
for i,v in pairs(pls) do _G.Team[_G.GetTablePlayer(v.Name)] = &quot;Zombies&quot; end return
elseif msg2:sub(1,9) == &quot;survivor/&quot; then local pls = complayer(msg:sub(10),p)
for i,v in pairs(pls) do _G.Team[_G.GetTablePlayer(v.Name)] = &quot;Survivor&quot; end return
elseif msg2:sub(1,7) == &quot;player/&quot; then local pls = complayer(msg:sub(8),p)
for i,v in pairs(pls) do _G.CharType[_G.GetTablePlayer(v.Name)] = &quot;Player&quot; end return
elseif msg2:sub(1,7) == &quot;zombie/&quot; then local pls = complayer(msg:sub(8),p)
for i,v in pairs(pls) do _G.CharType[_G.GetTablePlayer(v.Name)] = &quot;Zombie&quot; end return
elseif msg2:sub(1,5) == &quot;heal/&quot; then local pls = complayer(msg:sub(6),p)
for i,v in pairs(pls) do if v.Character ~= nil and v.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil and v.Character.Humanoid.Health &gt;= 0 then v.Character.Humanoid.Health = v.Character.Humanoid.MaxHealth end end return
elseif msg2:sub(1,6) == &quot;mtime/&quot; then local tym = tonumber(msg2:sub(7))
if tym == nil then return end _G.ModeTime = tym return
elseif msg2:sub(1,5) == &quot;kill/&quot; then local pls = complayer(msg:sub(6),p)
for i,v in pairs(pls) do if v.Character ~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil then _G.Damage(v.Character.Torso,p,5000,&quot;Admin Commands&quot;) end end return
elseif msg2:sub(1,9) == &quot;telefrom/&quot; and p.Character ~= nil and p.Character:findFirstChild(&quot;Torso&quot;) ~= nil then local pls = complayer(msg:sub(10),p)
for i,v in pairs(pls) do if v.Character ~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil then v.Character.Torso.CFrame = p.Character.Torso.CFrame + Vector3.new(0,3+(i*5),0) end end return
elseif msg2:sub(1,7) == &quot;teleto/&quot; and p.Character ~= nil and p.Character:findFirstChild(&quot;Torso&quot;) ~= nil then local pls = complayer(msg:sub(8),p)
if #pls == 1 and pls[1].Character ~= nil and pls[1].Character:findFirstChild(&quot;Torso&quot;) ~= nil then p.Character.Torso.CFrame = pls[1].Character.Torso.CFrame + Vector3.new(0,7,0) return end 
elseif msg2:sub(1,4) == &quot;sit/&quot; then local pls = complayer(msg:sub(5),p)
for i,v in pairs(pls) do if v.Character ~= nil and v.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then v.Character.Humanoid.Sit = true end end return
elseif msg2:sub(1,5) == &quot;plat/&quot; then local pls = complayer(msg:sub(6),p)
for i,v in pairs(pls) do if v.Character ~= nil and v.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then v.Character.Humanoid.PlatformStand = true end end return
elseif msg2:sub(1,5) == &quot;trip/&quot; then local pls = complayer(msg:sub(6),p)
for i,v in pairs(pls) do if v.Character ~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil then v.Character.Torso.CFrame = v.Character.Torso.CFrame *CFrame.Angles(math.rad(180),0,0) end end return
elseif msg2:sub(1,9) == &quot;givespec/&quot; then local pls = complayer(msg:sub(10),p)
for i,v in pairs(pls) do if v:findFirstChild(&quot;PlayerGui&quot;) ~= nil then game.Lighting.Stuff.Guis.Spectate:Clone().Parent = v.PlayerGui end end return
end 
end 
end 
--Buy
if msg2:sub(1,8) == &quot;gunlist/&quot; and p:findFirstChild(&quot;PlayerGui&quot;) ~= nil then
game.Lighting.Stuff.Guis.WeaponList:Clone().Parent = p.PlayerGui
elseif msg2:sub(1,4) == &quot;buy/&quot; then
if _G.CharType[n] == &quot;Zombie&quot; then _G.ShowMsg(p,&quot;Zombies Cannot buy! :(&quot;) return end 
if _G.Mode == &quot;None&quot; then _G.ShowMsg(p,&quot;Can only buy while playing! :(&quot;) return end 
if p.Character == nil or p.Character:findFirstChild(&quot;Humanoid&quot;) == nil or p.Character.Humanoid.Health == 0 then _G.ShowMsg(p,&quot;State Error!&quot;) return end 
if p:findFirstChild(&quot;Backpack&quot;) == nil or p.Backpack:findFirstChild(&quot;ToolScript&quot;) == nil then return end 
local ts = p.Backpack.ToolScript
local wep = msg2:sub(5)
if findtab(Weapons,wep) == nil then _G.ShowMsg(p,&quot;Weapon not found! :(&quot;) return end 
if ts.Secondary.Value:lower() == wep or ts.Throwable.Value:lower() == wep or ts.Medkit.Value:lower() == wep or ts.Pills.Value:lower() == wep then _G.ShowMsg(p,&quot;You already have this! :o&quot;) return end 
if ts.Anim.Value ~= &quot;None&quot; then _G.ShowMsg(p,&quot;Can only buy while doing nothing&quot;) return end 
local discount = 1
if p.Name:sub(1,6) == &quot;Guest &quot; or p.Name == &quot;Player&quot; then
else
if _G.IsMember(p.Name) == true or _G.IsAdmin(p.Name) then discount = 2 end 
end
if _G.Points[n] &lt; (WepCost[wep]/discount) then _G.ShowMsg(p,&quot;Can&apos;t Afford. You need &quot; ..WepCost[wep].. &quot; Points.&quot;) return end 
if p.Character:findFirstChild(&quot;WepDrop2&quot;) ~= nil then _G.ShowMsg(p,&quot;Error.&quot;) return end 
_G.Points[n] = _G.Points[n] - (WepCost[wep]/discount)
_G.ShowMsg(p,&quot;Succesfully bought &quot; ..wep.. &quot; for &quot; ..(WepCost[wep]/discount).. &quot; Points.&quot;)
local w = Bd[wep]:Clone() w.Name = &quot;WepDrop2&quot; w.Parent = p.Character
--Chat
else 
local ptext = &quot;Institutional white&quot;
local adname = &quot;&quot;
if p.Name:sub(1,6) == &quot;Guest &quot; or p.Name == &quot;Player&quot; then
else
ptext = p:LoadString(&quot;ChatColor&quot;)
if _G.IsMember(p.Name) == true then adname = &quot;(Member)&quot;end 
if _G.IsAdmin(p.Name) == true then adname = &quot;(Admin)&quot; end 
end
for i=#_G.ChatLog,2,-1 do
_G.ChatLog[i] = _G.ChatLog[i-1]
_G.ChatTextColor[i] = _G.ChatTextColor[i-1]
end
_G.ChatLog[1] = &quot;[&quot; .._G.Time.. &quot;]&quot; ..p.Name.. &quot;&quot; ..adname.. &quot;: &quot; ..msg
_G.ChatTextColor[1] = ptext
end
end 

function _G.GetTime(t)
local st = &quot;&quot;
local s = tostring(t%60)
if #s == 1 then s = &quot;0&quot; ..s end 
local m = tostring(math.floor(t/60))
if #m == 1 then m = &quot;0&quot; ..m end 
st = m.. &quot;:&quot; ..s
return st
end 


function GetClock()
&#9;local Seconds = tick()
&#9;local Hour = math.floor((Seconds%86400)/3600)
&#9;local Minute = math.floor((Seconds%3600)/60)
&#9;if Minute &lt;= 9 then Minute = &quot;0&quot; .. Minute end
&#9;local Second = math.floor(Seconds%60)
&#9;if Second &lt;= 9 then Second = &quot;0&quot; .. Second end
&#9;if Hour &gt;= 13 then
&#9;&#9;if Hour &lt;= 9 then
&#9;&#9;&#9;TotalHour = &quot;0&quot; .. Hour - 12 .. &quot;:&quot; .. Minute .. &quot;:&quot; .. Second .. &quot; PM&quot;
&#9;&#9;else
&#9;&#9;&#9;TotalHour = Hour - 12 .. &quot;:&quot; .. Minute .. &quot;:&quot; .. Second .. &quot; PM&quot;
&#9;&#9;end
&#9;else
&#9;&#9;TotalHour = Hour .. &quot;:&quot; .. Minute .. &quot;:&quot; .. Second .. &quot; AM&quot;
&#9;end
return tostring(TotalHour)
end

coroutine.resume(coroutine.create(function()
while true do 
w(0.1)
_G.Time = GetClock()
_G.Timer = _G.GetTime(_G.ModeTime)
end 
end))

_G.AllowedTkUse = {&quot;Explosion&quot;,&quot;Molotov&quot;,&quot;MolotovExplosion&quot;,&quot;AdminCommands&quot;,&quot;Falling&quot;,&quot;Derp&quot;,&quot;PipeBomb&quot;,&quot;Grenade&quot;}
_G.Damage = function(hitss,ooo,damagezz,wepused) 
if ooo.Parent == nil then return end 
    if hitss.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end 
mmm = hitss.Parent
hhh = hitss.Parent:findFirstChild(&quot;Humanoid&quot;)
if hhh.Health == 0 then return end 
if game.Players:findFirstChild(mmm.Name) == nil then return end 
local i1 = _G.GetTablePlayer(ooo.Name)
local i2 = _G.GetTablePlayer(mmm.Name)
if i1 == nil or i2 == nil then return end 
if hitss.Name == &quot;Fake Head&quot; or hitss.Name == &quot;Head&quot; then damagezz = damagezz*1.35 end 
-------
if findtab(_G.AllowedTkUse,wepused) ~= nil then 
local minusdmg = 1
if _G.Team[i1] == _G.Team[i2] then minusdmg = 2 end
hhh:TakeDamage(damagezz/minusdmg)
else
if _G.Mode == _G.Modes[1] or _G.Mode == _G.Modes[2] or _G.Mode == _G.Modes[7] or _G.Mode == _G.Modes[8] then --own
        hhh:TakeDamage(damagezz)
elseif _G.Mode == _G.Modes[3] or _G.Mode == _G.Modes[9] or _G.Mode == _G.Modes[6] then --anti tk
if _G.Team[i1] ~= _G.Team[i2] then hhh:TakeDamage(damagezz) end 
elseif _G.Mode == _G.Modes[4] or _G.Mode == _G.Modes[5] then -- anti ck
if _G.CharType[i1] ~= _G.CharType[i2] then hhh:TakeDamage(damagezz) end
end
end 
local ifzombie = 1
if _G.CharType[i1] == &quot;Zombie&quot; then ifzombie = 1.5 end 
if hhh.Health == 0 then
hhh.Parent:BreakJoints()
if i1 ~= i2 then
_G.UpdateSW(ooo.Name.. &quot; has killed &quot; ..mmm.Name.. &quot; with &quot; ..wepused.. &quot;.&quot;)
_G.Kills[i1] = _G.Kills[i1] + 1
_G.Deaths[i2] = _G.Deaths[i2] + 1
_G.Points[i1] = _G.Points[i1] + ((5*_G.ScoreMultiplier)*ifzombie)
else
_G.UpdateSW(mmm.Name.. &quot; killed him/herself with &quot; ..wepused.. &quot;.&quot;)
_G.Kills[i1] = _G.Kills[i1] - 1
_G.Deaths[i1] = _G.Deaths[i1] + 1
_G.Points[i1] = _G.Points[i1] - (1*_G.ScoreMultiplier)
end 

if _G.Mode == _G.Modes[1] or _G.Mode == _G.Modes[8] or _G.Mode == _G.Modes[9] then
if _G.Players2[i1] == _G.Players2[i2] then
_G.Kills2[i1] = _G.Kills2[i1] - 1
_G.Killed(i1,i2,&quot;You killed yourself with &quot; ..wepused.. &quot;!!&quot;)
else
_G.Kills2[i1] = _G.Kills2[i1] + 1
_G.Killed(i1,i2,ooo.Name.. &quot; has killed You with &quot; ..wepused.. &quot;!!&quot;)
end
elseif _G.Mode == _G.Modes[2] or _G.Mode == _G.Modes[3] or _G.Mode == _G.Modes[7] or _G.Mode == _G.Modes[6] then
_G.Killed(i1,i2,ooo.Name.. &quot; has killed You with &quot; ..wepused.. &quot;!!&quot;)
_G.CharType[i2] = &quot;Player&quot;
_G.Team[i2] = &quot;Lobby&quot;
elseif _G.Mode == _G.Modes[4] then
if _G.Players2[i1] ~= _G.Players2[i2] then
_G.Killed(i1,i2,ooo.Name.. &quot; has swapped you to their team with &quot; ..wepused.. &quot;!!&quot;)
if _G.Team[i2] == &quot;Players&quot; then 
_G.CharType[i2] = &quot;Zombie&quot;
_G.Team[i2] = &quot;Zombies&quot;
else
_G.CharType[i2] = &quot;Player&quot;
_G.Team[i2] = &quot;Players&quot;
end 
end
elseif _G.Mode == _G.Modes[5] then
_G.Killed(i1,i2,ooo.Name.. &quot; has made You Infected with &quot; ..wepused.. &quot;!!&quot;)
_G.CharType[i2] = &quot;Zombie&quot;
_G.Team[i2] = &quot;Zombies&quot;

end 
end


end
