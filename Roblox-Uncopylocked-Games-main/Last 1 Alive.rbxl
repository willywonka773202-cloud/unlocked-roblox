Sprays = 0
SprayDebounce = false
function Spray()
local mag = (Mouse.hit.p - Head.Position).magnitude 
if mag &gt; 14 or Sprays &gt;= 10 then return end 
if SprayDebounce == true then return end
if Information.Spray2 == false then Information.Spray2 = true Inform(&quot;Go to Options to change Image.&quot;) end 
SprayDebounce = true 
Sprays = Sprays + 1
    local Pos1, Hit, Dist, Face = RayCast(Head.Position, (Mouse.Hit.p - Head.Position).unit)
Sound(Sounds.SpraySound,1,1)
    -- Hit --
    if Hit then
if Hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return else end 
if Hit.Name == &quot;Table&quot; or Hit.Name == &quot;MagazineClip&quot; then return else end 
      local Mark = iNew(&quot;Part&quot;)
      Mark.FormFactor = &quot;Symmetric&quot;
      Mark.BottomSurface = &quot;Smooth&quot;
Mark.Parent = workspace.Stuff.FinishClean
      Mark.TopSurface = &quot;Smooth&quot;
Mark.formFactor = &quot;Custom&quot;
Mark.Transparency = 1
      Mark.Size = v3New(6, 0, 6)
      Mark.CanCollide = false
      Mark.Anchored = true
      Mark.CFrame = cfNew(Pos1) * cfAng(Hit.CFrame:toEulerAnglesXYZ()) * AngularFrames[Face]
local d = Instance.new(&quot;Decal&quot;)
d.Parent = Mark
d.Face = &quot;Top&quot;
d.Texture = &quot;http://www.roblox.com/asset/?id=&quot; ..SprayImage
      Debris:AddItem(Mark,150)
if Hit.Anchored then
else
stick(Mark,Hit)
Mark.Anchored = false 
end
wait(4)
SprayDebounce = false 
end
end 

