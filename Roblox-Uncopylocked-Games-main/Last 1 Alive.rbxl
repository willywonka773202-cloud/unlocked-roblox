function ThrowDash(ob,se)
pcall(function()
coroutine.resume(coroutine.create(function()
local dashin = true 
local oldpos = ob.Position
coroutine.resume(coroutine.create(function()
wait(se) dashin = false end))
for i=1,9999 do 
if dashin == false then break end 
local np = Instance.new(&quot;Part&quot;)
np.BrickColor = ob.BrickColor np.CanCollide = false 
np.BottomSurface = 0 np.TopSurface = 0 np.Anchored = true np.Transparency = 0.4
np.formFactor = &quot;Custom&quot; np.Parent = ob local mag = math.abs((ob.Position - oldpos).magnitude)
np.Size = Vector3.new(0.8,0.8,mag) local mp = Instance.new(&quot;BlockMesh&quot;,np)
np.CFrame = CFrame.new(ob.Position,oldpos)
np.CFrame = np.CFrame + np.CFrame.lookVector* (mag/2)
oldpos = ob.Position
coroutine.resume(coroutine.create(function()
for i=1,0,-0.05 do 
np.Transparency = np.Transparency + 0.03
mp.Scale = Vector3.new(i,i,1)
wait()
end 
np:Remove()
end))
wait(0.1)
end
end))
end)
end 


PillsHealth = 0
function Pills(pillheal)
local healneed = (Human.MaxHealth-Human.Health)
if healneed &gt; pillheal then
healneed = pillheal end
PillsHealth = PillsHealth + healneed
Human.Health = Human.Health + healneed
if Information.Pills == false then Information.Pills = true Inform(&quot;Pills give temporary Health Boost.&quot;) end
end

AdrenalineDebounce = false 
function Adrenaline()
AdrenalineDebounce = true 
Speed = 1.4
AdrenalineSpeed = 4
if Information.Adrenaline == false then Information.Adrenaline = true Inform(&quot;Adrenaline shots makes you act faster&quot;) end
coroutine.resume(coroutine.create(function()
wait(15)
Speed = 1
AdrenalineSpeed = 0
AdrenalineDebounce = false
end))
end 

function Explode(onb,scale,col)
coroutine.resume(coroutine.create(function()
e1 = Instance.new(&quot;Part&quot;)
e1.Anchored = true
e1.formFactor = &quot;Custom&quot;
e1.CanCollide = false
e1.Size = Vector3.new(1,1,1)
e1.BrickColor = BrickColor.new(col)
e1.Transparency = 0.6
e1.TopSurface = 0
e1.BottomSurface = 0
e1.Parent = workspace.Stuff.FinishClean
e1.CFrame = onb.CFrame
e1m = Instance.new(&quot;SpecialMesh&quot;)
e1m.MeshType = &quot;Sphere&quot;
e1m.Parent = e1
r1 = Instance.new(&quot;Part&quot;)
r1.Anchored = true
r1.formFactor = &quot;Custom&quot;
r1.CanCollide = false
r1.Size = Vector3.new(1,1,1)
r1.BrickColor = BrickColor.new(col)
r1.Transparency = 0.6
r1.TopSurface = 0
r1.BottomSurface = 0
r1.Parent = workspace.Stuff.FinishClean
r1.CFrame = e1.CFrame *CFrame.Angles(math.rad(180),0,0)
r1m = Instance.new(&quot;SpecialMesh&quot;)
r1m.MeshType = &quot;FileMesh&quot;
r1m.Scale = Vector3.new(3,3,3)
r1m.Parent = r1
r1m.MeshId = WeaponMesh.Ring
r2 = Instance.new(&quot;Part&quot;)
r2.Anchored = true
r2.formFactor = &quot;Custom&quot;
r2.CanCollide = false
r2.Size = Vector3.new(1,1,1)
r2.BrickColor = BrickColor.new(col)
r2.Transparency = 0.6
r2.TopSurface = 0
r2.BottomSurface = 0
r2.Parent = workspace.Stuff.FinishClean
r2.CFrame = e1.CFrame *CFrame.Angles(0,math.rad(180),0)
r2m = Instance.new(&quot;SpecialMesh&quot;)
r2m.MeshType = &quot;FileMesh&quot;
r2m.Parent = r2
r2m.Scale = Vector3.new(3,3,3)
r2m.MeshId = WeaponMesh.Ring
bla = Instance.new(&quot;Part&quot;)
bla.Anchored = true
bla.formFactor = &quot;Custom&quot;
bla.CanCollide = false
bla.Size = Vector3.new(1,1,1)
bla.BrickColor = BrickColor.new(col)
bla.Transparency = 0.6
bla.TopSurface = 0
bla.BottomSurface = 0
bla.Parent = workspace.Stuff.FinishClean
bla.CFrame = CFrame.new(e1.Position.x,e1.Position.y,e1.Position.z)
blam = Instance.new(&quot;SpecialMesh&quot;)
blam.MeshType = &quot;FileMesh&quot;
blam.Parent = bla
blam.Scale = Vector3.new(5,5,5)
blam.MeshId = WeaponMesh.Blast
for i=1,30 do
local pluscal = scale/38
e1m.Scale = e1m.Scale + Vector3.new(pluscal,pluscal,pluscal)
r1m.Scale = r1m.Scale + Vector3.new(pluscal,pluscal,pluscal)
r2m.Scale = r1m.Scale + Vector3.new(pluscal,pluscal,pluscal)
blam.Scale = blam.Scale + Vector3.new(pluscal,pluscal/2,pluscal)
bla.CFrame = bla.CFrame * CFrame.Angles(0,math.rad(12),0)
r1.CFrame = r1.CFrame * CFrame.Angles(math.rad(6),0,0)
r2.CFrame = r2.CFrame * CFrame.Angles(0,math.rad(6),0)
wait()
end
for i=1,30 do
local pluscal = scale/38
e1m.Scale = e1m.Scale + Vector3.new(pluscal,pluscal,pluscal)
r1m.Scale = r1m.Scale + Vector3.new(pluscal,pluscal,pluscal)
r2m.Scale = r1m.Scale + Vector3.new(pluscal,pluscal,pluscal)
blam.Scale = blam.Scale + Vector3.new(pluscal,pluscal/2,pluscal)
bla.CFrame = bla.CFrame * CFrame.Angles(0,math.rad(12),0)
r1.CFrame = r1.CFrame * CFrame.Angles(math.rad(6),0,0)
r2.CFrame = r2.CFrame * CFrame.Angles(0,math.rad(6),0)
bla.Transparency = bla.Transparency + 0.1
e1.Transparency = e1.Transparency + 0.1
r1.Transparency = r1.Transparency + 0.1
r2.Transparency = r2.Transparency + 0.1
wait()
end
e1m:Remove()
r1m:Remove()
r2m:Remove()
end))
end

