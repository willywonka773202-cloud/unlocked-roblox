_G.Players2[i].Character.Humanoid.Sit = false
end


if _G.Players2[i]:findFirstChild(&quot;PlayerGui&quot;) then 
for k,l in pairs(_G.Players2[i].PlayerGui:children()) do 
if l.Name == &quot;Spectate&quot; then Instance.new(&quot;Model&quot;,l).Name = &quot;RemoveGui&quot; else l:Remove() end end game.StarterGui.WepGui:Clone().Parent = _G.Players2[i].PlayerGui game.StarterGui.Gui:Clone().Parent = _G.Players2[i].PlayerGui end 
if _G.Players2[i].Character then for o,p in pairs(_G.Players2[i].Character:children()) do if p:IsA(&quot;StringValue&quot;) or p:IsA(&quot;NumberValue&quot;) then p:Remove() end end end 

if _G.Players2[i].Character and _G.Players2[i].Character:findFirstChild(&quot;Humanoid&quot;) and _G.Players2[i].Character.Humanoid.Health &gt; 0 and _G.Players2[i]:findFirstChild(&quot;Backpack&quot;) then for o,p in pairs(_G.Players2[i].Backpack:children()) do p:Remove() end end game.StarterPack.Spawner:Clone().Parent = _G.Players2[i].Backpack
if _G.Players2[i].Character and _G.Players2[i].Character:findFirstChild(&quot;Humanoid&quot;) and _G.Players2[i].Character.Humanoid.Health &gt; 0 then for o,p in pairs(_G.Players2[i].Character:children()) do
local bodyparts = {&quot;Left Arm&quot;,&quot;Right Arm&quot;,&quot;Torso&quot;,&quot;Head&quot;,&quot;Left Leg&quot;,&quot;Right Leg&quot;}
if p:IsA(&quot;Part&quot;) then p.Transparency = 0 end 
if p:IsA(&quot;Part&quot;) and findtab(bodyparts,p.Name) == nil then p:Remove() end
if p:IsA(&quot;Model&quot;) or p.Name == &quot;Animate&quot; then p:Remove() end 
if p.Name == &quot;Left Arm&quot; or p.Name == &quot;Right Arm&quot; then for oo,pp in pairs(p:children()) do pp:Remove() end end
if p.Name == &quot;Torso&quot; then  for oo,pp in pairs(p:children()) do
if pp.Name == &quot;Neck&quot; then  pp.C0 = CFrame.new(0,1,0) *CFrame.Angles(math.rad(-90),0,math.rad(180)) end  if pp.Name ~= &quot;roblox&quot; and pp.Name ~= &quot;Neck&quot; then pp:Remove() end end 
local Char = _G.Players2[i].Character
if Char:findFirstChild(&quot;Left Arm&quot;) ~= nil and Char:findFirstChild(&quot;Right Arm&quot;) ~= nil and Char:findFirstChild(&quot;Left Leg&quot;) ~= nil and Char:findFirstChild(&quot;Right Leg&quot;) ~= nil then
local rls = game.Lighting.Stuff.Special[&quot;Left Shoulder&quot;]:Clone() rls.Parent = p
rls.Part0 = p
rls.Part1 = Char[&quot;Left Arm&quot;]
local lls = game.Lighting.Stuff.Special[&quot;Right Shoulder&quot;]:Clone() lls.Parent = p
lls.Part0 = p
lls.Part1 = Char[&quot;Right Arm&quot;]
local rlh = game.Lighting.Stuff.Special[&quot;Left Hip&quot;]:Clone() rlh.Parent = p
rlh.Part0 = p
rlh.Part1 = Char[&quot;Left Leg&quot;]
local rrh = game.Lighting.Stuff.Special[&quot;Right Hip&quot;]:Clone() rrh.Parent = p
rrh.Part0 = p
rrh.Part1 = Char[&quot;Right Leg&quot;]
game.Lighting.Stuff.Special.Animate:Clone().Parent = Char
if _G.Players2[i]:findFirstChild(&quot;Backpack&quot;) then game.Lighting.Stuff.Special.MouseIconReturn:Clone().Parent = _G.Players2[i].Backpack end
else
Char:BreakJoints()
end


end 
end
end
end 
end
end)) 
end
