ro.CanCollide = false 
ro.formFactor = &quot;Custom&quot;
ro.BottomSurface = 0
ro.Material = &quot;Concrete&quot;
ro.Friction = 2
ro.Elasticity = 0
ro.Parent = Char --workspace.Stuff.FinishClean
ro.Size = Vector3.new(1,1,1) -- 10 5 15
ro.Anchored = true 
ro.CFrame = CFrame.new((Torso.CFrame * CFrame.new(0,-4,-6.5)).p) *CFrame.Angles(math.rad(180),0,0)
