								<string name="Name">Script</string>
								<ProtectedString name="Source">Frame = script.Parent
b = Frame.Bar
t2 = b.Text
t = Frame.Text
Gui = Frame.Parent
PGui = Gui.Parent
p = PGui.Parent


while true do 
wait()
if _G.Mode == _G.Modes[6] then
local tankname = workspace.MainScript.Mode6Tank.Value
t.Text = &quot;Boss: &quot; ..tankname
if game.Players:findFirstChild(tankname) ~= nil and game.Players[tankname].Character ~= nil and game.Players[tankname].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
local h = game.Players[tankname].Character.Humanoid
t2.Text = tostring(math.floor(h.Health)).. &quot; / &quot; ..tostring(math.floor(h.MaxHealth))
b.Size = UDim2.new((h.Health/h.MaxHealth)*0.992999,0,0.85,0)
end
end 
end 
----


