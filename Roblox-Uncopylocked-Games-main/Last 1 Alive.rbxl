for i=1,#_G.Team do if _G.Team[i] == teamz then _G.Points[i] = _G.Points[i] + tonumber((70+tonumber(klz))*_G.ScoreMultiplier) end end 
else
_G.UpdateSW(&quot;Tie...&quot;)
end





