coroutine.resume(coroutine.create(function()
while true do 
wait(0.2)
if Player:findFirstChild(&quot;Team&quot;) == nil then Instance.new(&quot;StringValue&quot;,Player).Name = &quot;Team&quot; end Player.Team.Value = _G.Team[_G.GetTablePlayer(Player.Name)] 
ct.Value = tostring(_G.CharType[i2])
if Player:findFirstChild(&quot;Rank&quot;) == nil then 
if Player.Name:sub(1,6) == &quot;Guest &quot; or Player.Name == &quot;Player&quot; then 
