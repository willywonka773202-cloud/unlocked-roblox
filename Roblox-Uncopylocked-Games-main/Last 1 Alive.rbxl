-- Ray Cast --
function RayCast(Pos, Dir)
 local Dist = 1000
 local Face = 0
 local Hit
 local function Ray(Obj)
  for _, Child in Next, Obj do
   local Cf = Child.CFrame
   local Size = Child.Size / 2
   local Pos2 = Cf:pointToObjectSpace(Pos)
   local Dir2 = Cf:pointToObjectSpace(Cf.p + Dir)
   local Sx, Sy, Sz = Pos2.x, Pos2.y, Pos2.z
   local Dx, Dy, Dz = Dir2.x, Dir2.y, Dir2.z
   local Px, Py, Pz = Size.x, Size.y, Size.z
   local C = {
    ( Px - Sx) / Dx;
    (-Px - Sx) / Dx;
    ( Py - Sy) / Dy;
    (-Py - Sy) / Dy;
    ( Pz - Sz) / Dz;
    (-Pz - Sz) / Dz;
   }
   for i = 1, 6 do local M = C[i]
    if M &lt; Dist and M &gt;= 0 then
     local P = Pos2 + M * Dir2
     if mAbs(P.x) &lt;= Px * 1.01 and mAbs(P.y) &lt;= Py * 1.01 and mAbs(P.z) &lt;= Pz * 1.01 then
      Hit = Child
      Dist = M
      Face = i
     end
    end
   end
  end
 end
 local Players = {}
 for _, oPlayer in Next, Game.Players:GetPlayers() do
  if oPlayer.Character and oPlayer ~= Player and not oPlayer.Character:FindFirstChild(&quot;ForceField&quot;) then
   for _, Child in Next, oPlayer.Character:GetChildren() do
    if Child.className == &quot;Part&quot; then
     Players[#Players + 1] = Child
    end
   end
  end
 end
 Ray(Objects)
 Ray(Players)
 return Pos + Dir * Dist, Hit, Dist, Face
end

