						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">spawn = script.Parent
l = spawn.Parent

local re = false
for i=1,8 do 
local p = Instance.new(&quot;Part&quot;,script) p.Anchored = true p.formFactor = &quot;Custom&quot; p.BottomSurface = 0 p.TopSurface = 0
p.BrickColor = BrickColor.new(&quot;Pastel brown&quot;) p.Size = Vector3.new(9,4,4)
p.CFrame = spawn.CFrame *CFrame.Angles(0,math.rad(i*45),0) *CFrame.new(0,0,12)
local hai = 0
coroutine.resume(coroutine.create(function()
if re then
re = false
while true do wait() hai = hai - 1  p.CFrame = spawn.CFrame *CFrame.Angles(0,math.rad(i*45)+math.rad(hai),0) *CFrame.new(0,(i*4),24+(-i*1.5))  end
else
re = true
while true do wait() hai = hai + 1  p.CFrame = spawn.CFrame *CFrame.Angles(0,math.rad(i*45)+math.rad(hai),0) *CFrame.new(0,(i*4),24+(-i*1.5))  end 
end 
end))

end </ProtectedString>
