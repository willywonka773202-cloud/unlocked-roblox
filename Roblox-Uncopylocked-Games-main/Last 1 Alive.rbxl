function ChangeWep(WepType)
if Use2.Gun == &quot;Dual&quot; and WepType == 2 then 
else 
rs2.Parent = nil
ls2.Parent = nil
RWeld = iWeld(RArm, Torso, cfNew(-1, 0, 0.5) * cfAng(-mPi / 2, 0, 0))
LWeld = iWeld(LArm, Torso, cfNew(1, 0, 0.5) * cfAng(-mPi / 2, mPi / 2, 0))
end 
if WepType == 1 then
Gmesh.MeshId = WeaponMesh[Use2.Gun]
Gmesh.Scale = WeaponMeshSize[Use2.Gun]
gholdw:Remove() if Use2.Gun ~= &quot;Pistol&quot; and Use2.Gun ~= &quot;Dual&quot; then gholdw = iWeld(gHolder, Suit, cfNew(-1.8,0,0) * cfAng(math.rad(-45),math.rad(90),0)) else gholdw = iWeld(gHolder, RLeg, cfNew(-0.6,0,-0.5) * cfAng(math.rad(90),0,0)) end
sgmesh.MeshId = &quot;&quot;
if Use2.Medkit == &quot;None&quot; then mHolder.Transparency = 1 mdec.Parent = nil else mHolder.Transparency = 0 mdec.Parent = mHolder end 
tmesh.MeshId = WeaponMesh[Use2.Throwable]
tmesh.Scale = WeaponMeshSize[Use2.Throwable]
elseif WepType == 2 then
sgmesh.MeshId = WeaponMesh[Use2.Secondary]
sgmesh.Scale = WeaponMeshSize[Use2.Secondary]
if Use2.Medkit == &quot;None&quot; then mHolder.Transparency = 1 mdec.Parent = nil else mHolder.Transparency = 0 mdec.Parent = mHolder end 
tmesh.MeshId = WeaponMesh[Use2.Throwable]
tmesh.Scale = WeaponMeshSize[Use2.Throwable]
Gmesh.MeshId = &quot;&quot;
elseif WepType == 3 then
sgmesh.MeshId = WeaponMesh[Use2.Secondary]
sgmesh.Scale = WeaponMeshSize[Use2.Secondary]
gholdw:Remove() if Use2.Gun ~= &quot;Pistol&quot; and Use2.Gun ~= &quot;Dual&quot; then gholdw = iWeld(gHolder, Suit, cfNew(-1.8,0,0) * cfAng(math.rad(-45),math.rad(90),0)) else gholdw = iWeld(gHolder, RLeg, cfNew(-0.6,0,-0.5) * cfAng(math.rad(90),0,0)) end
if Use2.Medkit == &quot;None&quot; then mHolder.Transparency = 1 mdec.Parent = nil else mHolder.Transparency = 0 mdec.Parent = mHolder end 
tmesh.MeshId = &quot;&quot;
gholdw:Remove() if Use2.Gun ~= &quot;Pistol&quot; and Use2.Gun ~= &quot;Dual&quot; then gholdw = iWeld(gHolder, Suit, cfNew(-1.8,0,0) * cfAng(math.rad(-45),math.rad(90),0)) else gholdw = iWeld(gHolder, RLeg, cfNew(-0.6,0,-0.5) * cfAng(math.rad(90),0,0)) end 
Gmesh.MeshId = WeaponMesh[Use2.Gun]
Gmesh.Scale = WeaponMeshSize[Use2.Gun]
elseif WepType == 4 then
Gmesh.MeshId = WeaponMesh[Use2.Gun]
Gmesh.Scale = WeaponMeshSize[Use2.Gun]
sgmesh.MeshId = WeaponMesh[Use2.Secondary]
sgmesh.Scale = WeaponMeshSize[Use2.Secondary]
tmesh.MeshId = WeaponMesh[Use2.Throwable]
tmesh.Scale = WeaponMeshSize[Use2.Throwable]
gholdw:Remove() if Use2.Gun ~= &quot;Pistol&quot; and Use2.Gun ~= &quot;Dual&quot; then gholdw = iWeld(gHolder, Suit, cfNew(-1.8,0,0) * cfAng(math.rad(-45),math.rad(90),0)) else gholdw = iWeld(gHolder, RLeg, cfNew(-0.6,0,-0.5) * cfAng(math.rad(90),0,0)) end
mHolder.Transparency = 1 mdec.Parent = nil
elseif WepType == 5 then
if Use2.Medkit == &quot;None&quot; then mHolder.Transparency = 1 mdec.Parent = nil else mHolder.Transparency = 0 mdec.Parent = mHolder end 
Gmesh.MeshId = WeaponMesh[Use2.Gun]
Gmesh.Scale = WeaponMeshSize[Use2.Gun]
sgmesh.MeshId = WeaponMesh[Use2.Secondary]
sgmesh.Scale = WeaponMeshSize[Use2.Secondary]
tmesh.MeshId = WeaponMesh[Use2.Throwable]
tmesh.Scale = WeaponMeshSize[Use2.Throwable]
gholdw:Remove() if Use2.Gun ~= &quot;Pistol&quot; and Use2.Gun ~= &quot;Dual&quot; then gholdw = iWeld(gHolder, Suit, cfNew(-1.8,0,0) * cfAng(math.rad(-45),math.rad(90),0)) else gholdw = iWeld(gHolder, RLeg, cfNew(-0.6,0,-0.5) * cfAng(math.rad(90),0,0)) end
end
