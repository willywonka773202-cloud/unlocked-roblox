function GiveMorphsAndTools()
for _,p in pairs(_G.Players2) do
pcall(function() _G.GiveToolsAndMorph2(p) end)
end
end
--
_G.GiveToolsAndMorph2 = function(p)
if p:findFirstChild(&quot;Backpack&quot;) ~= nil then 
game.Lighting.Stuff.Special.Morpher:Clone().Parent = p.Backpack
end
end
