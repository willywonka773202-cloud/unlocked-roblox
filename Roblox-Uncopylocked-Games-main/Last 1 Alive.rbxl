function UpdateGui()
if Mouse.Target ~= nil then
local mx = Mouse.X
local my = Mouse.Y
local o = Mouse.Target
if game.Players:findFirstChild(o.Parent.Name) ~= nil and o.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
local pp = game.Players[o.Parent.Name]
local hh = o.Parent.Humanoid.Health
local hmh = o.Parent.Humanoid.MaxHealth
tmsg.Visible = true
hb.Visible = true
tmsg.Text = pp.Name
tmsg.Position = UDim2.new(0,mx,0,my-125)
hb.Bar.Size = UDim2.new(0,(hh/hmh)*117,0,17)
else
tmsg.Visible = false
hb.Visible = false 
end
end
