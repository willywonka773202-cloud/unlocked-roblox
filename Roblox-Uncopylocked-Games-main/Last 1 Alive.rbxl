function GetTeams(tm)
tms = {}
for i=1,#_G.Team do 
if _G.Team[i] == tm then 
table.insert(tms,i)
end
end 
return tms
end

function CheckFrozenTeam(t1x,t2x)
local t1 = 0
local t2 = 0 
t1s = GetTeams(t1x)
t2s = GetTeams(t2x)
for i=1,#t1s do 
if _G.Players2[t1s[i]].Character ~= nil then
if _G.Players2[t1s[i]].Character:findFirstChild(&quot;Head&quot;) ~= nil then
if _G.Players2[t1s[i]].Character.Head:findFirstChild(&quot;Frozen&quot;) ~= nil then
t1 = t1 + 1
end
end
end
end
for i=1,#t2s do 
if _G.Players2[t2s[i]].Character ~= nil then
if _G.Players2[t2s[i]].Character:findFirstChild(&quot;Head&quot;) ~= nil then
if _G.Players2[t2s[i]].Character.Head:findFirstChild(&quot;Frozen&quot;) ~= nil then
t2 = t2 + 1
end
end
end
end
if #t2s == t2 then 
return t1x
elseif #t1s == t1 then 
return t2x
else
return nil
end
end
