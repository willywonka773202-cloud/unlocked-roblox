veh.Body.Angle.cframe = CFrame.new(veh.Body.Positionz.position,_G.ModeMap.Mode5[&quot;Dir&quot; ..i].Position)
veh.Body.Positionz.position = veh.Body.Positionz.position + facep.CFrame.lookVector*5
w(0.1)
until _G.ModeMap.Parent == nil or (_G.ModeMap.Mode5[&quot;Dir&quot; ..i].Position - veh.Body.Positionz.position).magnitude &lt; 14
w()
if _G.ModeMap ~= nil and _G.ModeMap.Parent ~= nil and _G.ModeMap.Mode5:findFirstChild(&quot;Dir&quot; ..(i+1)) ~= nil then
facep.CFrame = CFrame.new(veh.Body.Positionz.position)
facep.CFrame = CFrame.new(veh.Body.Positionz.position,_G.ModeMap.Mode5[&quot;Dir&quot; ..(i+1)].Position) end
end 
end))
w(5)
_G.UpdateSW(&quot;The Survivors have escaped!&quot;)
ShowBlackGui(&quot;The Survivors have escaped!&quot;)
w(2)
RewardSittedSurvivors()
end 

end -- if end 
end
------
function CheckMembers(theteam)
local fmembez = 0
for i=1,#_G.Team do 
if _G.Team[i] == theteam then 
fmembez = fmembez + 1 
end 
end 
return fmembez
end

function CheckLastZombie()
local zom = nil
local zoms = 0
for i=1,#_G.CharType do
if _G.CharType[i] == &quot;Zombie&quot; then
zom = i
zoms = zoms + 1
end 
end

if zoms == 1 then 
return zom 
else 
return nil 
end
end
