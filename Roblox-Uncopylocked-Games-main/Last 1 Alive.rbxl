rom.Parent = ro
rom.Scale = Vector3.new(10,5,15)
rom.MeshType = &quot;Wedge&quot;
for i=1,5 do
ro.CFrame = ro.CFrame + Vector3.new(0,0.8,0)
wait(0.1)
end 
for i=20,200,10 do
LW.C0 = CFrame.new(-1.5,i/60,0) *CFrame.Angles(math.rad(i),0.3,0)
RW.C0 = CFrame.new(1.5,i/60,0) *CFrame.Angles(math.rad(i),-0.3,0)
local x,y,z = ra.CFrame:toEulerAnglesXYZ()
ro.CFrame = CFrame.new((ra.CFrame * CFrame.new(-2.5,-3.5,0)).p) *CFrame.Angles(x+math.rad(180),y,z)
wait()
end
rom:Remove()
ro.Size = Vector3.new(10,5,15)
ro.CFrame = ro.CFrame + Vector3.new(0,2,0)
ro.CFrame = CFrame.new(ro.Position,Mouse.hit.p)
