local function iWeld(P0, P1, C0, C1)
 local Weld = iNew(&quot;Weld&quot;)
 Weld.Part0 = P0
 Weld.Part1 = P1
 Weld.C0 = C0 or cfNew()
 Weld.C1 = C1 or cfNew()
 Weld.Parent = P0
 return Weld
end
