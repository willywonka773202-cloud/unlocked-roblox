bpz = Instance.new(&quot;BodyPosition&quot;)
bgz = Instance.new(&quot;BodyGyro&quot;)
facep = Instance.new(&quot;Part&quot;)
function Pounce()
climbbp.Parent = nil
climbbg.Parent = nil
Anim = &quot;PounceReady&quot;
bgz.Parent = Torso
bgz.maxTorque = Vector3.new(2500,2500,2500)
Man.WalkSpeed = Man.WalkSpeed - 10
Man.PlatformStand = true 
repeat wait(0.1) bgz.cframe = CFrame.new(Torso.Position,Mouse.hit.p) *CFrame.Angles(math.rad(-90),0,0) until Anim == &quot;PounceAttack&quot;
facep.Anchored = true 
facep.Parent = Char
facep.Transparency = 1
facep.CFrame = Torso.CFrame *CFrame.Angles(math.rad(90),0,0) 
bpz.Parent = Torso
bpz.position = Torso.Position
bpz.maxForce = Vector3.new(math.huge,math.huge,math.huge)
    local Pos1, Hit, Dist, Face = RayCast(Head.Position, (Mouse.Hit.p - Torso.Position).unit)
local mag = (Pos1 - Torso.Position).magnitude/2
if mag &lt; 30 then mag = 30 end
if mag &gt; 200 and Hit == nil then mag = 200 end 
if mag &gt; 200 then mag = 200 end 
local plusfly = 0.5
LAnim = &quot;Slash&quot;
RAnim = &quot;Slash&quot;
LW.C0 = CFrame.new(-1.5,0.5,0) *CFrame.Angles(math.rad(170),0.4,0)
RW.C0 = CFrame.new(1.5,0.5,0) *CFrame.Angles(math.rad(170),-0.4,0)
for i=1,10 do
bpz.position = bpz.position + facep.CFrame.lookVector* (mag/10)
bpz.position = bpz.position + Vector3.new(0,plusfly,0)
bgz.cframe = bgz.cframe * CFrame.Angles(math.rad(5),0,0)
wait()
end
for i=1,10 do
bpz.position = bpz.position + facep.CFrame.lookVector* (1.2+(mag/10))
bpz.position = bpz.position - Vector3.new(0,plusfly+0.2,0)
bgz.cframe = bgz.cframe * CFrame.Angles(math.rad(-7),0,0)
wait()
end
wait(0.1)
LW.C0 = CFrame.new(-1.5,0,0) *CFrame.Angles(-0.3,0.3,0)
RW.C0 = CFrame.new(1.5,0,0) *CFrame.Angles(-0.3,-0.3,0)
bpz.Parent = nil
bgz.Parent = nil
LAnim = &quot;None&quot;
RAnim = &quot;None&quot;
facep.Parent = nil 
Man.PlatformStand = false 
Man.WalkSpeed = Man.WalkSpeed + 10
climbbp.Parent = Torso
climbbg.Parent = Torso
end 


