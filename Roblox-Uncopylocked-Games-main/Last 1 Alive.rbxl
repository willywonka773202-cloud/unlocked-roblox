						<Item class="Script" referent="RBX10436">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">Frame = script.Parent
Gui = Frame.Parent
PlayerGui = Gui.Parent
Player = PlayerGui.Parent
n = Player.Name
lold = true

--http://www.roblox.com/asset/?id=48965809

Buttonz = (#Frame:GetChildren()-3)/2

hax = 10 
if Player.Name:sub(1,6) == &quot;Guest &quot; or Player.Name == &quot;Player&quot; then
else
if Player.Name == &quot;XxXSpamaniXxX&quot; or Player.Name == &quot;Player&quot; then
hax = hax + 1337
end 
if Player:IsBestFriendsWith(_G.CreatorId) == true then
hax = hax +1
end
if Player:IsFriendsWith(_G.CreatorId) == true then
hax = hax + 2
end 
if _G.IsAdmin(Player.Name) == true then
hax = hax + 25
end 
if _G.IsMember(Player.Name) == true then
hax = hax + 6
end 
end 


Frame.vp.Text1.Text = &quot;Vote Strength: &quot; ..tostring(hax)

for i=1,Buttonz do
if _G.LastMode == i then
Frame[&quot;Button&quot; ..i].Visible = false 
else
Frame[&quot;Button&quot; ..i].MouseButton1Up:connect(function()
if lold == true then
if Gui.Name:sub(1,4) == &quot;Mode&quot; then
_G.ModeVote[i] = _G.ModeVote[i] + hax 
lold = false
else
_G.MapVote[i] = _G.MapVote[i] + hax
lold = false
end
end 
end)
end 
end


while true do
for i=1,Buttonz do
if Gui.Name:sub(1,4) == &quot;Mode&quot; then
Frame[&quot;Voted&quot; ..i].Text1.Text = &quot;Vote Points: &quot; .._G.ModeVote[i]
else
Frame[&quot;Voted&quot; ..i].Text1.Text = &quot;Vote Points: &quot; .._G.MapVote[i]
end
end
wait()
end

</ProtectedString>
