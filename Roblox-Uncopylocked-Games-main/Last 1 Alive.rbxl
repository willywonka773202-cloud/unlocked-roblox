function ShowBlackGui(txt)
for x=1,-0.1,-0.05 do 
for i,v in pairs(_G.Players2) do
if v:findFirstChild(&quot;PlayerGui&quot;) ~= nil then 
if v.PlayerGui:findFirstChild(&quot;WepGui&quot;) ~= nil then 
v.PlayerGui.WepGui.Blackf.Visible = true 
v.PlayerGui.WepGui.Blackf.BackgroundTransparency = x
v.PlayerGui.WepGui.Blackf.Textz.TextTransparency = x
v.PlayerGui.WepGui.Blackf.Textz.Text = txt
end 
end
end
w(0.1)
end 
end 

function ShowBlackGui2(txt,v)
if v:findFirstChild(&quot;PlayerGui&quot;) == nil or v.PlayerGui:findFirstChild(&quot;WepGui&quot;) == nil or v.PlayerGui.WepGui:findFirstChild(&quot;Blackf&quot;) == nil or v.PlayerGui.WepGui.Blackf.Visible then return end 
for x=1,-0.1,-0.04 do 
if v:findFirstChild(&quot;PlayerGui&quot;) ~= nil then 
if v.PlayerGui:findFirstChild(&quot;WepGui&quot;) ~= nil  then 
v.PlayerGui.WepGui.Blackf.Visible = true 
v.PlayerGui.WepGui.Blackf.BackgroundTransparency = x
v.PlayerGui.WepGui.Blackf.Textz.TextTransparency = x
v.PlayerGui.WepGui.Blackf.Textz.Text = txt
end 
end
w()
end
for x=-0.1,1.1,1 do 
if v:findFirstChild(&quot;PlayerGui&quot;) ~= nil then 
if v.PlayerGui:findFirstChild(&quot;WepGui&quot;) ~= nil  then 
v.PlayerGui.WepGui.Blackf.Visible = true 
v.PlayerGui.WepGui.Blackf.BackgroundTransparency = x
v.PlayerGui.WepGui.Blackf.Textz.TextTransparency = x
v.PlayerGui.WepGui.Blackf.Textz.Text = txt
end 
end
w()
end
v.PlayerGui.WepGui.Blackf.Visible = false 
end 

