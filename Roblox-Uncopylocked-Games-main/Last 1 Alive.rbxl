c.CFrame = spa.CFrame + Vector3.new(math.random(-0.5,0.5),math.random(-0.5,0.5),math.random(-0.5,0.5))
c.Velocity = Vector3.new(math.random(-10,10),math.random(-10,10),math.random(-10,10))
coroutine.resume(coroutine.create(function()
wait(0.5)
for i=1,10 do
wait(0.1)
pcall(function() c.Transparency = c.Transparency + 0.1 end) 
end
pcall(function() c:Remove() end)
end))
end))]]
end

function ClipAct(spa)
coroutine.resume(coroutine.create(function()
local c = Instance.new(&quot;Part&quot;)
c.Name = &quot;UsedClip&quot;
c.formFactor = &quot;Custom&quot;
c.TopSurface = 0 
c.BottomSurface = 0 
c.Size = Vector3.new(0.6,1,0.15)
c.BrickColor = BrickColor.new(&quot;Black&quot;)
c.Parent = spa
c.CFrame = spa.CFrame + Vector3.new(math.random(-0.5,0.5),math.random(-0.5,0.5),math.random(-0.5,0.5))
c.Velocity = Vector3.new(math.random(-10,10),math.random(-10,10),math.random(-10,10))
coroutine.resume(coroutine.create(function()
wait(3)
for i=1,10 do
wait(0.1)
pcall(function() c.Transparency = c.Transparency + 0.1 end) 
end
pcall(function() c:Remove() end)
end))
end))
end


function stick(hit2,hit)
    -- if hit2 hits hit, hit2 sticks to hit

    local weld = Instance.new(&quot;Weld&quot;)

    weld.Part0 = hit2
    weld.Part1 = hit

    -- correction term to account for average skew between physics zupdzate and heartbeat
    local HitPos = hit2.Position --+ (-arrow.Velocity * (1/60)) --+ (arrow.CFrame.lookVector * .5)

    local CJ = CFrame.new(HitPos)
    local C0 = hit2.CFrame:inverse() *CJ
    local C1 = hit.CFrame:inverse() * CJ
 
    weld.C0 = C0
    weld.C1 = C1

    weld.Parent = hit2

end

function FlashLight()
if Light.Transparency == 1 then
Light.Transparency = 0.5
Sound(Sounds.FlashLight,1,1)
else
Light.Transparency = 1
Sound(Sounds.FlashLight,1,1)
end
end 

function ThrowVelo(ob,mpos)
local ts = ((ob - mpos).magnitude)*2 if ts &gt; ThrowStrength then ts = ThrowStrength end  
return ts
end 

Sprays = 0
SprayDebounce = false
function Spray()
local mag = (Mouse.hit.p - Head.Position).magnitude 
if SprayDebounce == true then return end
if Information.Spray2 == false then Information.Spray2 = true Inform(&quot;Go to Options to change Image.&quot;) end 
SprayDebounce = true 

    local Pos1, Hit, Dist, Face = RayCast(Head.Position, (Mouse.Hit.p - Head.Position).unit)
if Hit ~= nil and Hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return end 
if mag &gt; 14 or Sprays &gt;= 10 then return end Sprays = Sprays + 1
Sound(Sounds.SpraySound,1,1)
    -- Hit --
    if Hit then
if Hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return else end 
if Hit.Name == &quot;Table&quot; or Hit.Name == &quot;MagazineClip&quot; then return else end 
      local Mark = iNew(&quot;Part&quot;)
      Mark.FormFactor = &quot;Symmetric&quot;
      Mark.BottomSurface = &quot;Smooth&quot;
Mark.Parent = workspace.Stuff.FinishClean
      Mark.TopSurface = &quot;Smooth&quot;
Mark.formFactor = &quot;Custom&quot;
Mark.Transparency = 1
      Mark.Size = v3New(6, 0, 6)
      Mark.CanCollide = false
      Mark.Anchored = true
      Mark.CFrame = cfNew(Pos1) * cfAng(Hit.CFrame:toEulerAnglesXYZ()) *Surfz[Face] --* AngularFrames[Face]
local d = Instance.new(&quot;Decal&quot;)
d.Parent = Mark
d.Face = &quot;Top&quot;
d.Texture = &quot;http://www.roblox.com/asset/?id=&quot; ..SprayImage
      Debris:AddItem(Mark,150)
if Hit.Anchored then
else
stick(Mark,Hit)
Mark.Anchored = false 
end
wait(4)
SprayDebounce = false 
end
end 

function Mark(Pos1,Face,Hit)
    -- Hit --
    if Hit then
if Hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then return else end 
      local Mark = iNew(&quot;Part&quot;)
--      Mark.BrickColor = Laser.BrickColor
      Mark.FormFactor = &quot;Symmetric&quot;
      Mark.BottomSurface = &quot;Smooth&quot;
Mark.Parent = Char --workspace.Stuff.FinishClean
      Mark.TopSurface = &quot;Smooth&quot;
Mark.formFactor = &quot;Custom&quot;
Mark.Transparency = 1
if Hit.Transparency &lt;= 0 then
      Mark.Size = v3New(0.6, 0, 0.6)
else
      Mark.Size = v3New(1.6, 0, 1.6)
end
      Mark.CanCollide = false
      Mark.Anchored = true
      Mark.CFrame = cfNew(Pos1) * cfAng(Hit.CFrame:toEulerAnglesXYZ()) *Surfz[Face] --* AngularFrames[Face]
local d = Instance.new(&quot;Decal&quot;)
d.Parent = Mark
d.Face = &quot;Top&quot;
if Hit.Transparency &lt;= 0 then
d.Texture = BulletHoles[math.random(1,#BulletHoles)]
else
d.Texture = GlassCracks[math.random(1,#GlassCracks)]
end
      Debris:AddItem(Mark,10)
if Hit.Anchored then
else
stick(Mark,Hit)
Mark.Anchored = false 
end
end
end 


