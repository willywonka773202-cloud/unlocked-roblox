function GetNearPlayer(urpos,maxmag)
for i,v in pairs(game.Players:GetChildren()) do 
if v.Character ~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil and math.abs((v.Character.Torso.Position-urpos).magnitude) &lt; maxmag then 
return v.Character.Torso
end
end 
return nil
end 

function Spit(ts)
for i=1,ts do
local pu = Instance.new(&quot;Part&quot;)
pu.Parent = workspace.Stuff.FinishClean
pu.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
pu.formFactor = &quot;Custom&quot;
--pu.Shape = &quot;Ball&quot; --:D
pu.Transparency = 0.4
pu.Size = Vector3.new(0.75,0.75,2.7)
pu.TopSurface = 0
pu.CanCollide = false
pu.BottomSurface = 0
pu:BreakJoints()
pu.CFrame = Head.CFrame + Head.CFrame.lookVector*2.5
pu.Velocity = pu.Velocity + pu.CFrame.lookVector *150
pu.Friction = 2
game.Debris:AddItem(pu,15)
local pud = false
coroutine.resume(coroutine.create(function()
while pud == false do
local hit = GetNearPlayer(pu.Position,4)
if hit ~= nil and not hit:IsDescendantOf(Char) then 
pud = true 
local p = game.Players[hit.Parent.Name]
if p.Character ~= nil then 
if req.Name == &quot;Request1&quot; then
req = script.Request2
else
req = script.Request1
end
local req2 = req
req2.KilledBy.Value = &quot;Acid Spit&quot;
req2.Damage.Value = math.floor(math.random(MinSlashDmg/2,MaxSlashDmg/2))
req2.creator.Value = Player
req2.Hit.Value = hit
wait(0.5)
pu:Remove()
end 
end
wait(0.1)
end
end))
wait(0.1)
end 
end 
