						<Item class="LocalScript" referent="RBX10404">
							<Properties>
								<bool name="Archivable">true</bool>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">f = script.Parent
pl = f.Players
s = f.Spec
g = f.Parent
pg = g.Parent
p = game.Players.LocalPlayer
cam = workspace.CurrentCamera
repeat wait() until p.Character ~= nil
repeat wait() until p.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil
c = p.Character
h = c.Humanoid
Spectate = false 
r = pl.Ref

g.ChildAdded:connect(function(add)
if add.Name == &quot;RemoveGui&quot; then
repeat wait() until v.Character.Head.Anchored == false 
workspace.CurrentCamera.CameraSubject = v.Character.Humanoid 
g:Remove()
end
end)

s.MouseButton1Up:connect(function()
if Spectate == true then 
for i,v in pairs(pl:GetChildren()) do if v.Name == &quot;Namex&quot; then v:Remove() end end 
cam.CameraSubject = h
pl.Visible = false
Spectate = false
s.Text1.Text = &quot;Spectate&quot;
else
for i,v in pairs(game.Players:GetChildren()) do
local b = script.Namex:Clone()
b.Parent = pl
b.Text1.Text = v.Name
b.Position = UDim2.new(0,700,0,300+(i*25))
Buttz(b,v)
end 
pl.Visible = true 
Spectate = true 
end
end)

r.MouseButton1Up:connect(function()
for i,v in pairs(pl:GetChildren()) do if v.Name == &quot;Name&quot; then v:Remove() end end 
ps = {}
for i,v in pairs(game.Players:GetChildren()) do
local b = script.Namex:Clone()
b.Parent = pl
b.Text1.Text = v.Name
b.Position = UDim2.new(0,700,0,300+(i*25))
Buttz(b,v)
end 
end)
-----
function Buttz(b,v)
b.MouseButton1Up:connect(function()
if v.Character == nil then return end
if v.Character:findFirstChild(&quot;Humanoid&quot;) == nil or v.Character:findFirstChild(&quot;Humanoid&quot;).Health &lt;= 0 then return end
workspace.CurrentCamera.CameraSubject = v.Character.Humanoid 
s.Text1.Text = &quot;Back&quot;
end)
end 
</ProtectedString>
