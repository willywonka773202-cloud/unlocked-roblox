mol.Parent = t
ThrowDash(t,1.7)
wait(1.5)
for i=1.2,0,-0.1 do 
wait(i)
Sound(Sounds.Beep,1,1)
end 
Sound(Sounds.PipeExplode,1,1)
Explode(t,35,&quot;New Yeller&quot;) 
end 


