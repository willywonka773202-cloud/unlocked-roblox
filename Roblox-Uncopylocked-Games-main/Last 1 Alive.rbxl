wait(3)
local mk2 = workspace.MainScript.MagKill --game.Lighting.Stuff.Special.MagKill:Clone()
mk2.Dam.Value = 50
mk2.Mag.Value = 18
mk2.KilledBy.Value = &quot;Explosion&quot;
mk2.creator.Value = Player
mk2.Projectile.Value = t
Explode(t,35,&quot;Deep orange&quot;) 
Sound(Sounds.PipeExplode,1,1)
wait(1)
t:Remove()
end 

function PipeBomb(t)
