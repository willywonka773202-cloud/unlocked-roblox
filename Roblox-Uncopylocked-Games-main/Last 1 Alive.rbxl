Tar = Gui.Target
tmsg = Tar.Msg
hb = tmsg.HealthBar
function UpdateGui()
local Pal = Gui.Pallette
Pal.Gun.Ammo.Text = Ammo.GunAmmo
Pal.Secondary.Ammo.Text = Ammo.SecondaryAmmo
Pal.Secondary.Clip.Text = Ammo.SecondaryClip
Pal.Gun.WepImage.Image = Huds[Use2.Gun]
Pal.Secondary.WepImage.Image = Huds[Use2.Secondary]
Pal.Throwable.WepImage.Image = Huds[Use2.Throwable]
local mkit = &quot;&quot;
if Use2.Medkit == &quot;Medkit&quot; then
mkit = Huds.Medkit
else
mkit = Huds.None
end 
Pal.Medkit.WepImage.Image = mkit
Pal.Pills.WepImage.Image = Huds[Use2.Pills]
if Mouse.Target ~= nil then
local mx = Mouse.X
local my = Mouse.Y
local o = Mouse.Target

if o.Name == &quot;WepDrop1&quot; or o.Name == &quot;WepDrop2&quot; then
if (Torso.Position - o.Position).magnitude &lt; 20 then 
if Information.ReClip == false then Information.ReClip = true Inform(&quot;Press X to Take the Weapon&quot;) end 
tmsg.Visible = true
hb.Visible = false
tmsg.Text = o.Type2.Value
tmsg.Position = UDim2.new(0,mx,0,my-75)
end
elseif o.Name == &quot;Magazines&quot; or o.Name == &quot;MagazineClip&quot; then
if (Torso.Position - o.Position).magnitude &lt; 20 then 
if Information.GunDrop == false then Information.GunDrop = true Inform(&quot;Press C to ReClip your Secondary/Primary Weapon&quot;) end 
tmsg.Visible = true
hb.Visible = false
tmsg.Text = &quot;Clips&quot;
tmsg.Position = UDim2.new(0,mx,0,my-75)
end 
elseif game.Players:findFirstChild(o.Parent.Name) ~= nil and o.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
local pp = game.Players[o.Parent.Name]
local hh = o.Parent.Humanoid.Health
local hmh = o.Parent.Humanoid.MaxHealth
tmsg.Visible = true
hb.Visible = true
tmsg.Text = pp.Name
local col = nil
local perc = ((hh/hmh)*100)
if  perc &gt; 75 then 
col = game.Lighting.Stuff.Special.Alder.BackgroundColor3
elseif perc &lt; 76 and perc &gt; 25 then
col = game.Lighting.Stuff.Special.Yellow.BackgroundColor3
else
col = game.Lighting.Stuff.Special.Red.BackgroundColor3
end 
tmsg.Position = UDim2.new(0,mx,0,my-125)
hb.Bar.Size = UDim2.new(0,(hh/hmh)*117,0,17)
hb.Bar.BackgroundColor3 = col
elseif o.Name == &quot;UpgradeDrop&quot; then
if (Torso.Position - o.Position).magnitude &lt; 20 then 
if Information.Upgrade == false then Information.Upgrade = true Inform(&quot;Press X to Upgrade your Weapon&quot;) end 
tmsg.Visible = true
hb.Visible = false
tmsg.Text = o.Type.Value 
tmsg.Position = UDim2.new(0,mx,0,my-75)
end 
else
tmsg.Visible = false
hb.Visible = false 
end
end
end
---

coroutine.resume(coroutine.create(function()
while true do wait(0.1) UpdateGui() end
end))

HealOther = false 
Healz = false 
function MedkitHeal()
if HealOther == false then
if Human.Health == Human.MaxHealth then return end 
ws(0)
Anim = &quot;Healing&quot;
Healg.Visible = true
Healg.Heal2.Text = &quot;Healing...&quot;
local healx = 0
repeat Healg.Bar.Text1.Text = tostring(math.floor((healx/5)*100)).. &quot;%&quot; healx = healx + 0.1 Healg.Bar.Size = UDim2.new((healx/5)*0.992999,0,0.85,0) wait(0.1) until Healz == false or healx &gt;= 5
if healx &gt;= 5 then
Human.Health = Human.Health + 80
Use2.Medkit = &quot;None&quot;
Healg.Visible = false 
ChangeWep(2)
else
end
Healg.Visible = false 
Anim = &quot;None&quot;
else
local targ2 = Mouse.Target
if targ2 == nil then return end 
if (Torso.Position - targ2.Position).magnitude &gt; 10 then return end 
local targ = targ2.Parent
if game.Players:findFirstChild(targ.Name) == nil then return end 
local pla = game.Players[targ.Name]
if pla.Backpack:findFirstChild(&quot;ToolScript&quot;) == nil then return end 
if pla.Character == nil or pla.Character:findFirstChild(&quot;Humanoid&quot;) == nil or pla.Character.Head:findFirstChild(&quot;Frozen&quot;) ~= nil then return end 
local bhh = pla.Character.Humanoid
local gsc = pla.Backpack.ToolScript
if bhh.Health == bhh.MaxHealth then return end 
ws(0)
Anim = &quot;Healing&quot;
Healg.Visible = true
Healg.Heal2.Text = &quot;Healing:&quot; ..pla.Name
local healx = 0
local tagz = Instance.new(&quot;ObjectValue&quot;)
tagz.Name = &quot;Heal&quot;
tagz.Value = Player
local healx2 = Instance.new(&quot;NumberValue&quot;)
healx2.Parent = tagz
healx2.Name = &quot;healx2&quot;
local perc = Instance.new(&quot;NumberValue&quot;)
perc.Parent = tagz
perc.Name = &quot;perc&quot;
local canc = Instance.new(&quot;BoolValue&quot;)
canc.Parent = tagz
canc.Name = &quot;cancel&quot;
wait()
tagz.Parent = gsc
repeat perc.Value = math.floor((healx/5)*100) Healg.Bar.Text1.Text = tostring(math.floor((healx/5)*100)).. &quot;%&quot; healx = healx + 0.1 healx2.Value = healx*10 Healg.Bar.Size = UDim2.new((healx/5)*0.992999,0,0.85,0) wait(0.1) until Human.Health == 0 or bhh.Health == 0 or Healz == false or healx &gt;= 5 or pla.Parent == nil
if healx &gt;= 5 then
healx2.Value = 51
bhh.Health = bhh.Health + 80
Use2.Medkit = &quot;None&quot;
Healg.Visible = false 
ChangeWep(2)
else
canc.Value = true 
end
Healg.Visible = false 
Anim = &quot;None&quot;
end 
end 

EHits = 0
function EnemyHit(txt)
coroutine.resume(coroutine.create(function()
EHits = EHits + 1
local tmsg = Gui.Target2.Msg
local ehit = EHits
if Mouse ~= nil then
local mx = Mouse.X
local my = Mouse.Y
tmsg.Visible = true 
