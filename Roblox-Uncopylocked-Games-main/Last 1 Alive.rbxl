						<ProtectedString name="Source">bp = script.Parent
p = bp.Parent

function Zombify(nn)
local perc = math.random(1,490)
if _G.Players2[nn]:findFirstChild(&quot;Rank&quot;) ~= nil and _G.Players2[nn].Rank.Value &gt; 1 then perc = math.random(100,500) end 
local zn = &quot;Zombie&quot;
if _G.Mode == _G.Modes[6] then 
zn = &quot;Tank&quot;
else
if _G.NextZombie[nn] == &quot;&quot; then
if perc &gt; 485 then
zn = &quot;Tank&quot; -- tank
elseif perc &gt; 270 then
zn = &quot;Hunter&quot;
elseif perc &gt; 380 then
zn = &quot;Smoker&quot;
elseif perc &gt; 290 then
zn = &quot;Spitter&quot;
elseif perc &gt; 200 then
zn = &quot;Boomer&quot;
else
zn = &quot;Zombie&quot;
end
else
zn = _G.NextZombie[nn]
_G.NextZombie[nn] = &quot;&quot;
end 
end
for i,v in pairs(bp:GetChildren()) do
if v.Name == zn then
tr = Instance.new(&quot;StringValue&quot;)
tr.Name = &quot;Trigger&quot;
tr.Value = _G.SprayImage[nn]
tr.Parent = v
else
tr = Instance.new(&quot;Model&quot;)
tr.Name = &quot;Delete&quot;
tr.Parent = v
end
end
end
--

local n = p.Name
local nn = _G.GetTablePlayer(n)
repeat wait() until p.Backpack:findFirstChild(&quot;Gun&quot;) ~= nil wait(0.5)
if p.Parent == nil then return end 
if _G.CharType[nn] ~= &quot;Zombie&quot; then
for i,v in pairs(p.Backpack:GetChildren()) do
if v.Name == &quot;Gun&quot; then
tr = Instance.new(&quot;StringValue&quot;)
tr.Value = _G.SprayImage[nn]
tr.Name = &quot;Trigger&quot;
tr.Parent = v
else
tr = Instance.new(&quot;Model&quot;)
tr.Name = &quot;Delete&quot;
tr.Parent = v
end
end
else
Zombify(nn)
end 
