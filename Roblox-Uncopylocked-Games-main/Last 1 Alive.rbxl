req2.KilledBy.Value = &quot;Boulder&quot;
req2.Damage.Value = Dam
req2.creator.Value = Player
req2.Hit.Value = hit
ro.Reflectance = 0.02
end
wait(0.1)
end
end))
for i=200,20,-10 do
LW.C0 = CFrame.new(-1.5,i/60,0) *CFrame.Angles(math.rad(i),0.3,0)
RW.C0 = CFrame.new(1.5,i/60,0) *CFrame.Angles(math.rad(i),-0.3,0)
wait()
end
LW.C0 = CFrame.new(-1.5,0,0) *CFrame.Angles(-0.3,0.3,0)
RW.C0 = CFrame.new(1.5,0,0) *CFrame.Angles(-0.3,-0.3,0)
wait(2)
Anim = &quot;None&quot;
end 
