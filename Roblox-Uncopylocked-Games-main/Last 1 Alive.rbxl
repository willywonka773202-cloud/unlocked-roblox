smoketongue = Instance.new(&quot;Part&quot;)
smoketongue.BrickColor = BrickColor.new(&quot;Sand red&quot;)
smoketongue.formFactor = &quot;Custom&quot;
smoketongue.BottomSurface = 0
smoketongue.TopSurface = 0
smoketongue.Anchored = true 
smoketongue.CanCollide = false 
smoketongue.Name = &quot;Tongue&quot; 
bps = Instance.new(&quot;BodyPosition&quot;)
bps.maxForce = Vector3.new(math.huge,math.huge,math.huge)
smoketongue.Size = Vector3.new(0.5,0.3,1)
stm = Instance.new(&quot;BlockMesh&quot;,smoketongue)
SmokeMag = 0
SmokeDrop = false
function Smoke(animx)
if animx == &quot;Attack&quot; then
Man.WalkSpeed = Man.WalkSpeed - 16
    local Pos1, Hit, Dist, Face = RayCast(Head.Position, (Mouse.Hit.p - Head.Position).unit)
local mag = (Pos1 - Head.Position).magnitude
if mag &gt; 120 then mag = 120 end 
Anim = &quot;Smoke0&quot;
smoketongue.Parent = Char
smoketongue.CFrame = Head.CFrame
smoketongue.CFrame = CFrame.new(smoketongue.Position,Pos1)
SmokeMag = mag
for i=0,mag,5 do
stm.Offset = Vector3.new(1,1,-i/2)
stm.Scale = Vector3.new(1,1,-i)
wait()
end
    local Pos1, Hit, Dist, Face = RayCast(Head.Position, (Pos1 - Head.Position).unit)
if Hit == nil or Hit.Parent:findFirstChild(&quot;Torso&quot;) == nil or Hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then
Anim = &quot;Smoke1&quot;
else
Anim = &quot;Smoke2&quot;
local vichum = Hit.Parent.Humanoid
bps.position = smoketongue.Position + smoketongue.CFrame.lookVector*(-stm.Scale.z)
bps.Parent = Hit.Parent.Torso
for i=SmokeMag,0,-5 do
if vichum.Parent == nil or SmokeDrop == true then break end 
if vichum.Sit == true then vichum.Sit = false end 
vichum.Health = vichum.Health - 2
if vichum.Health &lt; 3 then 
if req.Name == &quot;Request1&quot; then
req = script.Request2
else
req = script.Request1
end
local req2 = req
req2.KilledBy.Value = &quot;Tongue&quot;
req2.Damage.Value = 5
req2.creator.Value = Player
req2.Hit.Value = Hit
break 
end
bps.position = smoketongue.Position + smoketongue.CFrame.lookVector*(-stm.Scale.z)
wait(0.3)
end
wait(1)
SmokeDrop = false
smoketongue.Parent = nil
bps.Parent = nil
if vichum.Parent ~= nil then vichum.Sit = true end 
Man.WalkSpeed = Man.WalkSpeed + 16 
wait(2)
Anim = &quot;None&quot;
end
elseif animx == &quot;Back&quot; then
Anim = &quot;Smoke3&quot;
for i=SmokeMag,0,-6 do
stm.Offset = Vector3.new(1,1,-i/2)
stm.Scale = Vector3.new(1,1,-i)
wait()
end
Man.WalkSpeed = Man.WalkSpeed + 16 
smoketongue.Parent = nil
bps.Parent = nil
wait(2)
Anim = &quot;None&quot;
end 
end

