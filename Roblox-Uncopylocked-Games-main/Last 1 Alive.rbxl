function GetNearPlayer(urpos,maxmag)
for i,v in pairs(game.Players:GetChildren()) do 
if v.Character ~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil and math.abs((v.Character.Torso.Position-urpos).magnitude) &lt; maxmag then 
return v.Character.Torso
end
end 
return nil
end 

coroutine.resume(coroutine.create(function()
while true do 
wait()
if MeleeHit ~= &quot;None&quot; and MeleeHit2 == true then 
local ps = GetNearPlayer(Gun.Position,3)
if ps ~= nil and ps.Parent ~= Char then
MeleeHit2 = false 
if req.Name == &quot;Request1&quot; then
req = script.Request2
else
req = script.Request1
end
local req2 = req
req2.KilledBy.Value = MeleeHit
local psh = ps.Parent.Humanoid
Sound(Sounds.Hit,1,1)
if MeleeHit == &quot;Pan&quot; then
req2.Damage.Value = 10
ps.Velocity = Torso.CFrame.lookVector*30
elseif MeleeHit == &quot;Guitar&quot; then
req2.Damage.Value = 15
psh.Sit = true 
elseif MeleeHit == &quot;Ironbat&quot; then
req2.Damage.Value = 10
psh.Sit = true 
ps.Velocity = Torso.CFrame.lookVector*30
elseif MeleeHit == &quot;Katana&quot; then
req2.Damage.Value = 25
end 
req2.creator.Value = Player
req2.Hit.Value = ps
else -- window breaker
end 
end 
end 
end))
