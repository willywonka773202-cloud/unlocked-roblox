function GetDrop(getyp)
local ob = nil 
if getyp == nil then 
ob = Mouse.Target
else
ob = getyp
end
if ob == nil then return end 
if ob.Parent ~= Char and (Torso.Position - ob.Position).magnitude &gt; 10 then return end 
if ob.Name == &quot;WepDrop1&quot; or ob.Name == &quot;WepDrop2&quot; then
if ob.Type.Value == &quot;Gun&quot; then 
if Use2.Gun == ob.Type2.Value and Information.One3or4 == false then Information.One3or4 = true Inform(&quot;You can&apos;t take a weapon you already have.&quot;) return end 
if Use2.Gun ~= &quot;None&quot; and Information.OneType == false then Information.OneType = true Inform(&quot;You can only hold one Weapon of a Type&quot;) end 
if Use2.Gun == ob.Type2.Value then return end 
if Use2.Gun ~= &quot;None&quot; and Use2.Gun ~= ob.Type2.Value and ob.Name == &quot;WepDrop2&quot; then CreateDrop(&quot;WepDrop2&quot;,&quot;Gun&quot;,Use2.Gun) end 
if ob.Name == &quot;WepDrop2&quot; then ob.Parent = nil else CreateDrop(&quot;WepDrop2&quot;,&quot;Secondary&quot;,Use2.Gun) end 
Use2.Gun = ob.Type2.Value
Ammo.GunMaxAmmo = Weaponz[Use2.Gun].MaxAmmo
ChangeWep(2) 
elseif ob.Type.Value == &quot;Secondary&quot; then
if Use2.Secondary == ob.Type2.Value and Information.One3or4 == false then Information.One3or4 = true Inform(&quot;You can&apos;t take a weapon you already have.&quot;) return end 
if Use2.Secondary ~= &quot;None&quot; and Information.OneType == false then Information.OneType = true Inform(&quot;You can only hold one Weapon of a Type&quot;) end 
if Use2.Secondary == ob.Type2.Value then return end 
if Use2.Secondary ~= &quot;None&quot; and Use2.Secondary ~= ob.Type2.Value and ob.Name == &quot;WepDrop2&quot; then CreateDrop(&quot;WepDrop2&quot;,&quot;Secondary&quot;,Use2.Secondary,Ammo.SecondaryAmmo,Ammo.SecondaryClip) end 
if ob.Name == &quot;WepDrop2&quot; then ob.Parent = nil else CreateDrop(&quot;WepDrop2&quot;,&quot;Secondary&quot;,Use2.Secondary) end 
Use2.Secondary = ob.Type2.Value
Ammo.SecondaryMaxAmmo = Weaponz[ob.Type2.Value].MaxAmmo
Ammo.SecondaryMaxClip = Weaponz[ob.Type2.Value].MaxClip
local amomax = Ammo.SecondaryMaxAmmo
local clipmax = Ammo.SecondaryMaxClip - Ammo.SecondaryMaxAmmo
if ob.Name == &quot;WepDrop2&quot; and ob:findFirstChild(&quot;Ammo&quot;) ~= nil then amomax = ob.Ammo.Value clipmax = ob.Clip.Value end 
Ammo.SecondaryAmmo = amomax
Ammo.SecondaryClip = clipmax
LaserSight = false 
Laser.Parent = nil
ChangeWep(1) 
elseif ob.Type.Value == &quot;Throwable&quot; then
if Use2.Throwable == ob.Type2.Value and Information.One3or4 == false then Information.One3or4 = true Inform(&quot;You can&apos;t take a weapon you already have.&quot;) return end 
if Use2.Throwable == ob.Type2.Value then return end 
if Use2.Throwable ~= &quot;None&quot; and ob.Name == &quot;WepDrop2&quot; then CreateDrop(&quot;WepDrop2&quot;,&quot;Throwable&quot;,Use2.Throwable) end 
if ob.Name == &quot;WepDrop2&quot; then ob.Parent = nil end 
Use2.Throwable = ob.Type2.Value
ChangeWep(3) 
elseif ob.Type.Value == &quot;Medkit&quot; then
if Use2.Medkit == ob.Type2.Value and Information.One3or4 == false then Information.One3or4 = true Inform(&quot;You can&apos;t take a weapon you already have.&quot;) return end 
if Use2.Medkit == ob.Type2.Value then return end 
if ob.Name == &quot;WepDrop2&quot; then ob.Parent = nil end 
if Use2.Medkit ~= &quot;None&quot; and ob.Name == &quot;WepDrop2&quot; then CreateDrop(&quot;WepDrop2&quot;,&quot;Medkit&quot;,&quot;Medkit&quot;) end 
Use2.Medkit = ob.Type2.Value
ChangeWep(4) 
elseif ob.Type.Value == &quot;Pills&quot; then
if Use2.Pills == ob.Type2.Value and Information.One3or4 == false then Information.One3or4 = true Inform(&quot;You can&apos;t take a weapon you already have.&quot;) return end 
if Use2.Pills == ob.Type2.Value then return end 
if ob.Name == &quot;WepDrop2&quot; then ob.Parent = nil end 
if Use2.Pills ~= &quot;None&quot; and ob.Name == &quot;WepDrop2&quot; then CreateDrop(&quot;WepDrop2&quot;,&quot;Pills&quot;,Use2.Pills) end 
Use2.Pills = ob.Type2.Value
ChangeWep(5) 
end
elseif ob.Name == &quot;UpgradeDrop&quot; then
if ob.Type.Value == &quot;LaserSight&quot; then
if Information.LaserSight == false then Information.LaserSight = true Inform(&quot;Laser sight gives you more accuracy.&quot;) end 
LaserSight = true 
Laser.Parent = workspace.Stuff.FinishClean
end
end
end


function FindClips()
if Mouse.Target == nil then return end
if Mouse.Target.Name ~= &quot;MagazineClip&quot; then return end
if (Torso.Position - Mouse.Target.Position).magnitude &gt; 10 then return end 
if Use ~= &quot;Secondary&quot; and Use ~= &quot;Gun&quot; then return end 
if Use2.Secondary ~= &quot;None&quot; then
Ammo.SecondaryAmmo = Ammo.SecondaryMaxAmmo
Ammo.SecondaryClip = Ammo.SecondaryMaxClip - Ammo.SecondaryMaxAmmo
end
if Use2.Gun ~= &quot;None&quot; then
Ammo.GunAmmo = Ammo.GunMaxAmmo
end
if Use == &quot;Gun&quot; or Use == &quot;Secondary&quot; then 
Anim = &quot;reclip&quot;
PlayAnim(&quot;reclip&quot;) --bleh
Anim = &quot;None&quot;
end
end 

function reload()
if Use == &quot;Gun&quot; or Use == &quot;Secondary&quot; then
if Use == &quot;Gun&quot; and Ammo.GunAmmo == Ammo.GunMaxAmmo then return end
if Use == &quot;Secondary&quot; and Ammo.SecondaryAmmo == Ammo.SecondaryMaxAmmo and Ammo.SecondaryClip == 0 then return end 
Anim = &quot;Reloading&quot;
PlayAnim(&quot;reload&quot;)
if Use == &quot;Gun&quot; then
Ammo.GunAmmo = Ammo.GunMaxAmmo
elseif Use == &quot;Secondary&quot; then
if Ammo.SecondaryClip &gt; 0 then
local ammoneed =  Ammo.SecondaryMaxAmmo - Ammo.SecondaryAmmo --idk
if Ammo.SecondaryClip &gt;= ammoneed then
Ammo.SecondaryAmmo = Ammo.SecondaryMaxAmmo
Ammo.SecondaryClip = Ammo.SecondaryClip - ammoneed
else
Ammo.SecondaryAmmo = Ammo.SecondaryAmmo + Ammo.SecondaryClip
Ammo.SecondaryClip = 0
end
end
end
Anim = &quot;None&quot;
if Use == &quot;Gun&quot; and Information.GunReload == false then
Information.GunReload = true Inform(&quot;Primary guns have Infinite Clips.&quot;) end 
end
end

function PlayAnim(Animx,exad) if exad == nil then exad = 1 end 
lxa,lya,lza = 0,0,0
lxo,lyo,lzo = 0,0,0
rxa,rya,rza = 0,0,0
rxo,ryo,rzo = 0,0,0
local usex = false if ls2.Parent ~= nil then usex = true end 
if Animx == &quot;reload&quot; or Animx == &quot;wepchange&quot; then
Cursor(&quot;reload&quot;)
ls2.Parent = Suit
rs2.Parent = Suit
RWeld.Parent = nil
LWeld.Parent = nil
ls2.Part0 = Suit
ls2.Part1 = LArm
rs2.Part0 = Suit
rs2.Part1 = RArm
for i = 0, 25.5, 1.5*Speed*exad do 
ls2.C0 = CFrame.new() 
ls2.C1 = CFrame.new(-0.55 + (i / 50), 0.75 - (i / 50), 0.35 + (i / 22.5)) * CFrame.fromEulerAnglesXYZ(math.rad(315 - (i * 2)), math.rad(-i * 3.5), math.rad(-90)) 
rs2.C0 = CFrame.new() 
rs2.C1 = CFrame.new(-1, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(-90 + i), math.rad(-5), 0) 
wait() 
end 
wait(0.5)
if Animx == &quot;reload&quot; then
animagaz = iNew(&quot;Part&quot;)
animagaz.Name = &quot;magazine&quot;
animagaz.formFactor = &quot;Custom&quot;
animagaz.TopSurface = 0 
animagaz.BottomSurface = 0 
animagaz.Size = Vector3.new(0.6,1,0.15)
animagaz.BrickColor = BrickColor.new(&quot;Black&quot;)
animagaz.Parent = LArm
iWeld(animagaz, LArm, cfNew(0,1.4,0)*CFrame.Angles(0,0,0))
else

end
for i = 25.5, 0, -1.5*Speed*exad do 
ls2.C0 = CFrame.new() 
ls2.C1 = CFrame.new(-0.55 + (i / 50), 0.75 - (i / 50), 0.35 + (i / 22.5)) * CFrame.fromEulerAnglesXYZ(math.rad(315 - (i * 2)), math.rad(-i * 3.5), math.rad(-90)) 
rs2.C0 = CFrame.new() 
rs2.C1 = CFrame.new(-1, 0.5, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(-90 + i), math.rad(-5), 0) 
wait() 
end 
if usex == false then 
