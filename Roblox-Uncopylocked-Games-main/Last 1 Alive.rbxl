function Zombify(nn)
pcall(function()
local bp = _G.Players2[nn].Backpack
local perc = math.random(1,200)
local zn = &quot;Zombie&quot;
if _G.NextZombie[nn] == &quot;&quot; then
if perc &gt; 197 then
zn = &quot;Tank&quot; -- tank
elseif perc &gt; 177 then
zn = &quot;Hunter&quot;
elseif perc &gt; 157 then
zn = &quot;Smoker&quot;
elseif perc &gt; 137 then
zn = &quot;Spitter&quot;
elseif perc &gt; 107 then
zn = &quot;Boomer&quot;
else
zn = &quot;Zombie&quot;
end
else
zn = _G.NextZombie[nn]
_G.NextZombie[nn] = &quot;&quot;
end 
for i,v in pairs(bp:GetChildren()) do
if v.Name == zn then
tr = Instance.new(&quot;StringValue&quot;)
tr.Name = &quot;Trigger&quot;
tr.Value = _G.SprayImage[nn]
tr.Parent = v
else
tr = Instance.new(&quot;Model&quot;)
tr.Name = &quot;Delete&quot;
tr.Parent = v
end
end
end)
end
--

function CheckAllZombie()
local zoms = #_G.Players2
local zom = 0
for i=1,#_G.CharType do
if _G.CharType[i] == &quot;Zombie&quot; then 
zom = zom + 1
end
end
if zom == zoms then
return true
else
return false
end 
end

function MoveCamera(mcam,foc)
for i=1,#_G.Players2 do
if _G.Players2[i]:findFirstChild(&quot;Backpack&quot;) ~= nil then
if _G.Players2[i].Backpack:findFirstChild(&quot;ToolScript&quot;) ~= nil then
local obh = Instance.new(&quot;ObjectValue&quot;)
obh.Name = &quot;SpecialMode2&quot;
obh.Value = mcam.Humanoid
local obh2 = Instance.new(&quot;ObjectValue&quot;,obh)
obh2.Name = &quot;Focus&quot;
obh2.Value = foc
obh.Parent = _G.Players2[i].Backpack:findFirstChild(&quot;ToolScript&quot;)
end
end
end
for i=1,#_G.Players2 do
if _G.Players2[i]:findFirstChild(&quot;PlayerGui&quot;) ~= nil then
if _G.Players2[i].PlayerGui:findFirstChild(&quot;WepGui&quot;) ~= nil then
_G.Players2[i].PlayerGui.WepGui.MovieScreen.Visible = true 
end 
end
end
coroutine.resume(coroutine.create(function()
while _G.ModeMap.Parent ~= nil do
mcam.Head.CFrame = mcam.Head.CFrame + Vector3.new(0,0.25,0)
w()
end
end))
end

function RewardSittedSurvivors()
for i=1,#_G.Seated do 
local nx = _G.GetTablePlayer(_G.Seated[i])
if nx ~= nil then
_G.Points[nx] = _G.Points[nx] + 50*_G.ScoreMultiplier
end
end
end

function SurvivorModeAct()
if _G.ModeMap.Name == &quot;Map1&quot; then
local allzombie = false
_G.ModeTime = 60
_G.ModeMap.Mode5.s1.Smoke.Enabled = true
_G.ModeMap.Mode5.s2.Smoke.Enabled = true
w(4)
local veh = game.Lighting.Stuff.Special.Vehicles.Rancher:Clone()
veh.Parent = _G.ModeMap.Mode5
veh:MakeJoints()
veh.Body.Positionz.maxForce = Vector3.new(math.huge,math.huge,math.huge)
veh.Body.Angle.maxTorque = Vector3.new(math.huge,math.huge,math.huge)
veh.Body.Angle.cframe = CFrame.new(veh.Body.Positionz.position,_G.ModeMap.Mode5.Dir1.Position)
local facep = Instance.new(&quot;Part&quot;)
facep.Anchored = true
facep.CFrame = CFrame.new(veh.Body.Positionz.position)
facep.CFrame = CFrame.new(veh.Body.Positionz.position,_G.ModeMap.Mode5[&quot;Dir1&quot;].Position)
for i=1,6 do 
repeat
veh.Body.Angle.cframe = CFrame.new(veh.Body.Positionz.position,_G.ModeMap.Mode5[&quot;Dir&quot; ..i].Position)
veh.Body.Positionz.position = veh.Body.Positionz.position + facep.CFrame.lookVector*8
w(0.1)
until _G.ModeMap.Parent == nil or (_G.ModeMap.Mode5[&quot;Dir&quot; ..i].Position - veh.Body.Positionz.position).magnitude &lt; 14
w()
if _G.ModeMap ~= nil and _G.ModeMap.Parent ~= nil and _G.ModeMap.Mode5:findFirstChild(&quot;Dir&quot; ..(i+1)) ~= nil then
facep.CFrame = CFrame.new(veh.Body.Positionz.position)
facep.CFrame = CFrame.new(veh.Body.Positionz.position,_G.ModeMap.Mode5[&quot;Dir&quot; ..(i+1)].Position) end
end 
repeat
_G.ModeTime = _G.ModeTime - 1
allzombie = CheckAllZombie()
w(1)
_G.UpdateSW(&quot;Get on the Rancher! &quot; .._G.ModeTime.. &quot; seconds till we go&quot;)
until allzombie == true or _G.ModeTime == 0
if allzombie == true then
_G.UpdateSW(&quot;The Survivors have been overwhelmed...&quot;)
ShowBlackGui(&quot;The Survivors have been overwhelmed...&quot;)
w(5)
else
_G.UpdateSW(&quot;DERPY RANCHER GO!!!&quot;)
local mcam = _G.ModeMap.Mode5.Camzor
MoveCamera(mcam,veh.Body)
coroutine.resume(coroutine.create(function()
for i=7,10,1 do 
repeat
veh.Body.Angle.cframe = CFrame.new(veh.Body.Positionz.position,_G.ModeMap.Mode5[&quot;Dir&quot; ..i].Position)
veh.Body.Positionz.position = veh.Body.Positionz.position + facep.CFrame.lookVector*6
w(0.1)
until _G.ModeMap.Parent == nil or (_G.ModeMap.Mode5[&quot;Dir&quot; ..i].Position - veh.Body.Positionz.position).magnitude &lt; 14
w()
if _G.ModeMap ~= nil and _G.ModeMap.Parent ~= nil and _G.ModeMap.Mode5:findFirstChild(&quot;Dir&quot; ..(i+1)) ~= nil then
facep.CFrame = CFrame.new(veh.Body.Positionz.position)
facep.CFrame = CFrame.new(veh.Body.Positionz.position,_G.ModeMap.Mode5[&quot;Dir&quot; ..(i+1)].Position) end
end 
end))
w(6)
_G.UpdateSW(&quot;The Survivors have escaped!&quot;)
ShowBlackGui(&quot;The Survivors have escaped!&quot;)
w(2)
RewardSittedSurvivors()
end
