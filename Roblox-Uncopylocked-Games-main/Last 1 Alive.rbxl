							<Item class="Script" referent="RBX11324">
								<Properties>
									<bool name="Archivable">true</bool>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Bump</string>
									<ProtectedString name="Source">p = script.Parent
print(&quot;bumper&quot;)
p.Touched:connect(function(hit)
if hit.Transparency == 0.4 and hit.BrickColor == BrickColor.new(&quot;Really black&quot;) then 
hit.CanCollide = false
end 
if hit.Parent.Name == &quot;UnAnchor&quot; then 
hit.Anchored = false
wait(0.06)
hit.Velocity = Vector3.new(0,0,0)
end
end)
----</ProtectedString>
								</Properties>
							</Item>
