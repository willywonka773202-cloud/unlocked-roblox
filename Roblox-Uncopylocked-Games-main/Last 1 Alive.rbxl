function DiveFixBrokenStuff(a)
for i,v in pairs(a:GetChildren()) do
if v.Name == &quot;Window&quot; then v.Anchored = true v.CanCollide = true end
if v.Name == &quot;Door&quot; then v.Velocity = Vector3.new(0,0,0) end
if v.Name == &quot;WepDrop2&quot; then v.Anchored = true  v.Velocity = Vector3.new(0,0,0) end
DiveFixBrokenStuff(v)
end
end

function LoadMap(ii)
newmap = _G.Mapx[ii]:Clone()
newmap.Parent = workspace
newmap:MakeJoints()
_G.T1Spawn = newmap.T1Spawn:GetChildren()
_G.T2Spawn = newmap.T2Spawn:GetChildren()
DiveFixBrokenStuff(newmap)
return newmap
end

function IsAlive(playername)
if game.Players:findFirstChild(playername) == nil then return nil end 
local p = game.Players[playername]
if p.Character == nil then return nil end 
local ch = p.Character
if ch:findFirstChild(&quot;Humanoid&quot;) == nil then return nil end 
if ch.Humanoid.Health &lt; 1 then return nil end 
return ch.Humanoid.Health
end



function ArrangeTeams()
local tankran = math.random(1,#_G.Players)
local ToZoms = math.floor(#_G.Players2/5)+1
local zombiez = {}
for i=1,ToZoms do
if ZombieTurn &gt;= #_G.Players2 then ZombieTurn = 0 end ZombieTurn = ZombieTurn + 1 table.insert(zombiez,ZombieTurn)
end 
local zomz = {}
for _,p in pairs(_G.Players2) do
local n = p.Name
local nn = _G.GetTablePlayer(n)
if _G.Mode == _G.Modes[1] or _G.Mode == _G.Modes[7] or _G.Mode == _G.Modes[8] then 
_G.CharType[nn] = &quot;Player&quot;
_G.Team[nn] = &quot;None&quot;
elseif _G.Mode == _G.Modes[2] then  
_G.CharType[nn] = &quot;Zombie&quot;
_G.Team[nn] = &quot;None&quot;
elseif _G.Mode == _G.Modes[3] or _G.Mode == _G.Modes[9] then  
_G.CharType[nn] = &quot;Player&quot;
local plzlz = {}
for _,playerz in pairs(_G.Players2) do 
table.insert(plzlz,playerz)
end 
local teamturng = 1
for lolololol=1,#plzlz do
local pickrandom = math.random(1,#plzlz)
local nn2 = _G.GetTablePlayer(plzlz[pickrandom].Name)
table.remove(plzlz,pickrandom)
if teamturng == 1 then _G.Team[nn2] = &quot;Team1&quot; teamturng = 2 elseif teamturng == 2 then _G.Team[nn2] = &quot;Team2&quot; teamturng = 1 end
end
elseif _G.Mode == _G.Modes[4] then  
local plzlz = {}
for _,playerz in pairs(_G.Players2) do 
table.insert(plzlz,playerz)
end 
local teamturng = 1
for lolololol=1,#plzlz do
local pickrandom = math.random(1,#plzlz)
local nn2 = _G.GetTablePlayer(plzlz[pickrandom].Name)
table.remove(plzlz,pickrandom)
if teamturng == 1 then  _G.CharType[nn2] = &quot;Player&quot; _G.Team[nn2] = &quot;Players&quot; teamturng = 2 elseif teamturng == 2 then _G.CharType[nn2] = &quot;Zombie&quot;  _G.Team[nn2] = &quot;Zombies&quot; teamturng = 1 end
end
elseif _G.Mode == _G.Modes[5] then
if findtab(_G.AntiZombiePick,_G.Players[ZombieTurn]) == nil and findtab(zombiez,nn) then
table.insert(zomz,_G.Players[nn])
_G.CharType[nn] = &quot;Zombie&quot;
_G.Team[nn] = &quot;Zombies&quot;
else
_G.CharType[nn] = &quot;Player&quot;
_G.Team[nn] = &quot;Survivor&quot;
end 
elseif _G.Mode == _G.Modes[6] then 
if _ == tankran then
_G.CharType[nn] = &quot;Zombie&quot;
_G.Team[nn] = &quot;Zombies&quot;
_G.NextZombie[nn] = &quot;Tank&quot;
else 
_G.CharType[nn] = &quot;Player&quot;
_G.Team[nn] = &quot;Survivor&quot;
end

end
end
