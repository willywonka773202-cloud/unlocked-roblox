Torso[&quot;Right Hip&quot;].Part0 = Suit
Torso[&quot;Left Hip&quot;].Part0 = Suit
local RWeld = iWeld(RArm, Torso, cfNew(-1, 0, 0.5) * cfAng(-mPi / 2, 0, 0))
local LWeld = iWeld(LArm, Torso, cfNew(1, 0, 0.5) * cfAng(-mPi / 2, mPi / 2, 0))
-- Arm Movement --
Spawn(function() while true do 
 Wait(0.05)
if HeadReady == true then 
  local yDif = (Torso.Position - Mouse.Hit.p).unit.y
   local Dif3 = yDif &lt; -0.5 and -0.5 or (yDif &gt; 1 and 1 or yDif)
Neck.C0 = CFrame.new(0,1,0) *cfAng(math.rad(-90)-Dif3,0,math.rad(180)) 
if Anim ~= &quot;Reloading&quot;  and Use2.Gun ~= &quot;Dual&quot; then
 local Dif2 = yDif &lt; -0.5 and -0.5 or (yDif &gt; 0.5 and 0.5 or yDif)
 RWeld.C0 = cfNew(-1, 0, 0.65) * cfAng(-mPi / 2 + Dif2+wepfire, 0, 0)
 LWeld.C0 = cfNew(1, 0, 0.65) * cfAng(-mPi / 2 + Dif2+wepfire, mPi / 2, 0)
end
end 
end end)
