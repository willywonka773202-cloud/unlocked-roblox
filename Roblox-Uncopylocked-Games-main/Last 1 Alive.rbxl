ro.CanCollide = true 
ro.Parent = workspace.Stuff.FinishClean
ro.Velocity = ro.Velocity + ro.CFrame.lookVector* 280
game.Debris:AddItem(ro,15)
coroutine.resume(coroutine.create(function()
while ro.Parent ~= nil and ro.Reflectance == 0 do
local hit = GetNearPlayer(ro.Position,14)
if hit ~= nil and hit.Parent.Name ~= Player.Name then 
local hu = hit.Parent.Humanoid
local to = hit.Parent.Torso
hu.Sit = true 
