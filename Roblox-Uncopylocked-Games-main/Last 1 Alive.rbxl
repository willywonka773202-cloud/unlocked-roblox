					<ProtectedString name="Source">game.Debris:AddItem(game:findFirstChild(&quot;ChatHud&quot;,true),0)
Bp = script.Parent.Parent
Player = Bp.Parent
repeat wait() until Player.Character ~= nil
Char = Player.Character
repeat wait() until Char:findFirstChild(&quot;Torso&quot;) ~= nil and Char:findFirstChild(&quot;Humanoid&quot;) ~= nil 
t = Char.Torso
h = Char.Humanoid
PG = Player:findFirstChild(&quot;PlayerGui&quot;)


cam = workspace.CurrentCamera
local Mode = workspace.MainScript.Mode
coroutine.resume(coroutine.create(function()
local m = Instance.new(&quot;Model&quot;) m.Parent = cam
local h = Char:findFirstChild(&quot;Humanoid&quot;)
h.Died:connect(function(a) m:Remove() end)
while true do
 wait()
if Mode.Value == 3 or Mode.Value == 4 or Mode.Value == 9 or Mode.Value == 5 then
 for i,v in pairs(game.Players:children()) do 
if v.Name ~= Player.Name and Player:findFirstChild(&quot;Team&quot;) ~= nil and v:findFirstChild(&quot;Team&quot;) ~= nil and m:findFirstChild(v.Name) ~= nil then    if Player.Team.Value == v.Team.Value then m[v.Name].BrickColor = BrickColor.new(&quot;New Yeller&quot;) else m[v.Name].BrickColor = BrickColor.new(&quot;Bright red&quot;) end   end 
if v.Name ~= Player.Name then 
   if m:findFirstChild(v.Name) == nil and v.Character ~= nil and v.Character:findFirstChild(&quot;Torso&quot;) ~= nil and v.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil and v.Character.Humanoid.Health &gt; 0 then 
    local p = Instance.new(&quot;Part&quot;,m) p.Name = v.Name p.BottomSurface = 0 p.TopSurface = 0 p.Transparency = 0.4 p.formFactor = &quot;Custom&quot; p.Shape = &quot;Ball&quot;
   p.CanCollide = false p.Size = Vector3.new(1.5,1.5,1.5) local w = Instance.new(&quot;Weld&quot;,p) w.Part0 = v.Character.Torso w.Part1 = p w.C0 = CFrame.new(0,4,0) 
v.Character.Humanoid.Died:connect(function(a) p:Remove() end) 
else
end
end
end
end
end
end))
