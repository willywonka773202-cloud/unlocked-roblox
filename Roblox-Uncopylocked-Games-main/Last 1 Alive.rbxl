function ChangeWepq()
local usex = Use3
for i=1,9 do
if usex == 1 then
usex = 6
end
if usex-1 == 1 and Use2.Secondary ~= &quot;None&quot; and usex-1 ~= Use3 then
ChangeWep(usex-1) break 
elseif usex-1 == 2 and Use2.Gun ~= &quot;None&quot; and usex-1 ~= Use3 then
ChangeWep(usex-1) break 
elseif usex-1 == 3 and Use2.Throwable ~= &quot;None&quot; and usex-1 ~= Use3 then
ChangeWep(usex-1) break 
elseif usex-1 == 4 and Use2.Medkit ~= &quot;None&quot; and usex-1 ~= Use3 then
ChangeWep(usex-1) break 
elseif usex-1 == 5 and Use2.Pills ~= &quot;None&quot; and usex-1 ~= Use3 then
ChangeWep(usex-1) break 
else 
usex = usex - 1 end
end
end 

function ChangeWepe()
local usex = Use3
for i=1,9 do
if usex == 5 then
usex = 0
end
if usex+1 == 1 and Use2.Secondary ~= &quot;None&quot; and usex+1 ~= Use3 then
ChangeWep(usex+1) break 
elseif usex+1 == 2 and Use2.Gun ~= &quot;None&quot; and usex+1 ~= Use3 then
ChangeWep(usex+1) break 
elseif usex+1 == 3 and Use2.Throwable ~= &quot;None&quot; and usex+1 ~= Use3 then
ChangeWep(usex+1) break 
elseif usex+1 == 4 and Use2.Medkit ~= &quot;None&quot; and usex+1 ~= Use3 then
ChangeWep(usex+1) break 
elseif usex+1 == 5 and Use2.Pills ~= &quot;None&quot; and usex+1 ~= Use3 then
ChangeWep(usex+1) break 
else 
usex = usex + 1 end
end
end 

function Cursor(cur)
cur:lower()
if cur == &quot;guncursor&quot; then
if Crouch == true then
Mouse.Icon = Decals.GunCrouchCursor
else
Mouse.Icon = Decals.GunCursor
end
elseif cur == &quot;crouchcursor&quot; or cur == &quot;crouch&quot; then
Mouse.Icon = Decals.GunCrouchCursor
elseif cur == &quot;reload&quot; or cur == &quot;gunwait&quot; then
Mouse.Icon = Decals.GunWaitCursor
end 
end

function RobloxrayCast(Pos, Dir, Max, Ignore) 
return Workspace:FindPartOnRay(Ray.new(Pos, Dir.unit * 999.1),Char) 
end 

Surfz = {
[&quot;Enum.NormalId.Left&quot;] = CFrame.Angles(0,math.pi/2,0) *CFrame.Angles(-math.pi/2,0,0);
[&quot;Enum.NormalId.Right&quot;] = CFrame.Angles(0,-math.pi/2,0) *CFrame.Angles(-math.pi/2,0,0);
[&quot;Enum.NormalId.Front&quot;] = CFrame.Angles(-math.pi/2,0,0);
[&quot;Enum.NormalId.Back&quot;] = CFrame.Angles(0,math.pi,0) *CFrame.Angles(-math.pi/2,0,0);
[&quot;Enum.NormalId.Bottom&quot;] = CFrame.Angles(0,0,math.pi);
[&quot;Enum.NormalId.Top&quot;] = CFrame.Angles(0,0,0);
}

function surface(part, hit)
local n = 2 * part.CFrame:pointToObjectSpace(hit) / part.Size
if part:IsA(&quot;Part&quot;) then
if part.Shape == Enum.PartType.Block then
if n.x &lt; -.999 then
return Enum.NormalId.Left
elseif n.x &gt; .999 then
return Enum.NormalId.Right
elseif n.y &lt; -.999 then
return Enum.NormalId.Bottom
elseif n.y &gt; .999 then
return Enum.NormalId.Top
elseif n.z &lt; -.999 then
return Enum.NormalId.Front
elseif n.z &gt; .999 then
return Enum.NormalId.Back
end
elseif part.Shape == Enum.PartType.Ball then
local left = n:Dot(Vector3.FromNormalId(Enum.NormalId.Left))
local right = n:Dot(Vector3.FromNormalId(Enum.NormalId.Right))
local bottom = n:Dot(Vector3.FromNormalId(Enum.NormalId.Bottom))
local top = n:Dot(Vector3.FromNormalId(Enum.NormalId.Top))
local front = n:Dot(Vector3.FromNormalId(Enum.NormalId.Front))
local back = n:Dot(Vector3.FromNormalId(Enum.NormalId.Back))
local val = math.max(left, right, bottom, top, front, back)
if val == left then
return Enum.NormalId.Left
elseif val == right then
return Enum.NormalId.Right
elseif val == bottom then
return Enum.NormalId.Bottom
elseif val == top then
return Enum.NormalId.Top
elseif val == front then
return Enum.NormalId.Front
elseif val == back then
return Enum.NormalId.Back
end
end
elseif part:IsA(&quot;WedgePart&quot;) then
if n.x &lt; -.999 then
return Enum.NormalId.Left
elseif n.x &gt; .999 then
return Enum.NormalId.Right
elseif n.y &lt; -.999 then
return Enum.NormalId.Bottom
elseif n.z &gt; .999 then
return Enum.NormalId.Back
else
return Enum.NormalId.Front
end
end
end

function RayCast(Pos,Dir)
local Hit1,Pos1 = RobloxrayCast(Pos,Dir)
local Faic = nil
local Dist2 = nil
if Hit1 ~= nil then Faic = tostring(surface(Hit1,Pos)) end 
if Pos ~= nil and Pos1 ~= nil then Dist2 = ((Pos-Pos1).magnitude) end 
return Pos1,Hit1,Dist2,Faic
end 

--[[
-- Get Objects --
function GetObjects(Path)
 for _, Child in Next, Path:GetChildren() do
  if Child.Parent ~= workspace.CurrentCamera and Child.Name ~= &quot;unray&quot; and Child.Name ~= &quot;Lobby&quot; and  Child:IsA(&quot;BasePart&quot;) and (Child.CanCollide or Child.Name == &quot;Water&quot;) and Child.className ~= &quot;SpawnLocation&quot; then
   Objects[#Objects + 1] = Child
  elseif #Child:GetChildren() &gt; 0 and not Child:FindFirstChild(&quot;Humanoid&quot;) then
   GetObjects(Child)
  end
 end
end
coroutine.resume(coroutine.create(function()
while true do 
Objects = {}
GetObjects(Workspace)
wait(0.2)
end end))
-- Ray Cast --
function RayCast(Pos, Dir)
 local Dist = 1000
 local Face = 0
 local Hit
 local function Ray(Obj)
  for _, Child in Next, Obj do
   local Cf = Child.CFrame
   local Size = Child.Size / 2
   local Pos2 = Cf:pointToObjectSpace(Pos)
   local Dir2 = Cf:pointToObjectSpace(Cf.p + Dir)
   local Sx, Sy, Sz = Pos2.x, Pos2.y, Pos2.z
   local Dx, Dy, Dz = Dir2.x, Dir2.y, Dir2.z
   local Px, Py, Pz = Size.x, Size.y, Size.z
   local C = {
    ( Px - Sx) / Dx;
    (-Px - Sx) / Dx;
    ( Py - Sy) / Dy;
    (-Py - Sy) / Dy;
    ( Pz - Sz) / Dz;
    (-Pz - Sz) / Dz;
   }
   for i = 1, 6 do local M = C[i]
    if M &lt; Dist and M &gt;= 0 then
     local P = Pos2 + M * Dir2
     if mAbs(P.x) &lt;= Px * 1.01 and mAbs(P.y) &lt;= Py * 1.01 and mAbs(P.z) &lt;= Pz * 1.01 then
      Hit = Child
      Dist = M
      Face = i
     end
    end
   end
  end
 end
 local Players = {}
 for _, oPlayer in Next, Game.Players:GetPlayers() do
  if oPlayer.Character and oPlayer ~= Player and not oPlayer.Character:FindFirstChild(&quot;ForceField&quot;) then
   for _, Child in Next, oPlayer.Character:GetChildren() do
    if Child.className == &quot;Part&quot; then
     Players[#Players + 1] = Child
    end
   end
  end
 end
 Ray(Objects)
 Ray(Players)
 return Pos + Dir * Dist, Hit, Dist, Face
end]]

function Sound(sid,pit,vol)
local ss = Instance.new(&quot;Sound&quot;)
ss.Name = &quot;Sound&quot;
ss.Parent = Gun
ss.SoundId = sid
ss.Pitch = pit 
ss.Volume = vol/2.3
ss.PlayOnRemove = true
wait()
ss:Remove()
end


function CreateDrop(name,val,val2,amo,clip)
local drop = Instance.new(&quot;Part&quot;)
drop.BrickColor = BrickColor.new(&quot;Black&quot;)
drop.formFactor = &quot;Custom&quot;
if val == &quot;Secondary&quot; then
drop.Size = Vector3.new(1,1,4)
elseif val == &quot;Throwable&quot; or val == &quot;Pills&quot; or val == &quot;Gun&quot; then
drop.Size = Vector3.new(1,1,1)
elseif val == &quot;Medkit&quot; then
drop.Size = WeaponMeshSize.Medkit
drop.BrickColor = BrickColor.new(&quot;Bright red&quot;)
local d = Instance.new(&quot;Decal&quot;) 
d.Parent = drop
d.Face= &quot;Top&quot;
d.Texture = Decals.MedkitTexture
end 
drop.Name = name
drop.Parent = workspace.Stuff.FinishClean
drop.BottomSurface = 0 
drop.TopSurface = 0
drop.CFrame = Torso.CFrame + Vector3.new(math.random(-5,5),0,math.random(-5,5))
if val2 ~= &quot;Medkit&quot; and val2 ~= &quot;Bile&quot; and val2 ~= &quot;Pills&quot; then 
local dropmesh = Instance.new(&quot;FileMesh&quot;)
dropmesh.Parent = drop
pcall(function()
dropmesh.MeshId = &quot;&quot; ..WeaponMesh[val2]
dropmesh.Scale = WeaponMeshSize[val2]
end)
else
end 
if val2 == &quot;Bile&quot; then
local dropmesh = Instance.new(&quot;CylinderMesh&quot;)
dropmesh.Scale = WeaponMeshSize.Bile
dropmesh.Parent = drop 
drop.BrickColor = BrickColor.new(&quot;Dark green&quot;)
elseif val2 == &quot;Pills&quot; then
local dropmesh = Instance.new(&quot;CylinderMesh&quot;)
dropmesh.Scale = WeaponMeshSize.Pills
dropmesh.Parent = drop 
drop.BrickColor = BrickColor.new(&quot;White&quot;)
elseif val2 == &quot;Medkit&quot; or val2 == &quot;Molotov&quot; then
drop.BrickColor = BrickColor.new(&quot;Bright red&quot;)
end
local valz = Instance.new(&quot;StringValue&quot;)
valz.Name = &quot;Type&quot;
valz.Value = val
valz.Parent = drop
local valz2 = Instance.new(&quot;StringValue&quot;)
valz2.Name = &quot;Type2&quot;
valz2.Parent = drop
valz2.Value = val2
if val == &quot;Gun&quot; then
elseif val == &quot;Secondary&quot; then
valz2.Value = Use2.Secondary
if amo ~= nil then
local amoval = Instance.new(&quot;NumberValue&quot;)
amoval.Name = &quot;Ammo&quot;
amoval.Value = Ammo.SecondaryAmmo
amoval.Parent = drop
local clival = Instance.new(&quot;NumberValue&quot;)
clival.Name = &quot;Clip&quot;
clival.Value = Ammo.SecondaryClip
clival.Parent = drop
elseif val == &quot;Medkit&quot; then

elseif val == &quot;Throwable&quot; then

end
end
end 


function FireEffect(spa)
--[[
coroutine.resume(coroutine.create(function()
local c = Instance.new(&quot;Part&quot;)
c.Name = &quot;FireEffect&quot;
c.formFactor = &quot;Custom&quot;
c.TopSurface = 0 
c.CanCollide = false
c.BottomSurface = 0 
c.Size = Vector3.new(1,1,2)
c.Transparency = 0.5
c.BrickColor = BrickColor.new(&quot;New Yeller&quot;)
local cc = Instance.new(&quot;SpecialMesh&quot;)
cc.MeshType = &quot;Sphere&quot;
cc.Parent = c
c.Anchored = true
c.Parent = spa
c.CFrame = spa.CFrame + spa.CFrame.lookVector * (spa.Size.z)
coroutine.resume(coroutine.create(function()
for i=1,5 do
wait(0.07)
pcall(function() c.Transparency = c.Transparency + 0.1 end) 
end
pcall(function() c:Remove() end)
end))
end))]]
end

Informed = 0

function Inform(iMsgz)
coroutine.resume(coroutine.create(function()
Informed = Informed + 1
infz = Informed
inf2.Text = iMsgz
inf1.Position = UDim2.new(0,-inf2.TextBounds.x/2,0,0)
for i=1,8 do
if Informed ~= infz then break end
for gt=0.4,0,-0.1 do
inf1.BackgroundTransparency = gt
inf1.TextTransparency = gt
inf2.TextTransparency = gt
wait(0.07)
end
for gt=0,0.4,0.1 do
inf1.BackgroundTransparency = gt
inf1.TextTransparency = gt
inf2.TextTransparency = gt
wait(0.07)
end
wait()
end
if Informed ~= infz then return
else
inf1.BackgroundTransparency = 1
inf1.TextTransparency = 1
inf2.TextTransparency = 1
end
end))
end


function ws(walkspeedz)
Human.WalkSpeed = walkspeedz
end 

function Shell(spa) -- eh lag
--[[
coroutine.resume(coroutine.create(function()
local c = Instance.new(&quot;Part&quot;)
c.Name = &quot;Shell&quot;
c.formFactor = &quot;Custom&quot;
c.TopSurface = 0 
