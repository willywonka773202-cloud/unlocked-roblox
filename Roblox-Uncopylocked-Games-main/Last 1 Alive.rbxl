				<ProtectedString name="Source">Bp = script.Parent
for i,v in pairs(game.Lighting.Stuff.Tools:children()) do v:Clone().Parent = Bp end 
Player = Bp.Parent
repeat wait() until Player.Character ~= nil
Char = Player.Character
repeat wait() until Char:findFirstChild(&quot;Torso&quot;) ~= nil and Char:findFirstChild(&quot;Humanoid&quot;) ~= nil 
t = Char.Torso
t.Velocity = Vector3.new(0,0,0)
PG = Player:findFirstChild(&quot;PlayerGui&quot;)

function damage(hitss,ooo,damagezz,wepused) --_G.Damage(t,Player,9999,&quot;Falling&quot;)
if ooo.Parent == nil then return end 
if hitss.Parent:IsA(&quot;Hat&quot;) then hitss.Parent:Remove() return end 
    if hitss.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end 
mmm = hitss.Parent
hhh = hitss.Parent:findFirstChild(&quot;Humanoid&quot;)
if game.Players:findFirstChild(mmm.Name) == nil then return end 
local i1 = _G.GetTablePlayer(ooo.Name)
hhh.Health = 0 
if hhh.Health == 0 then
hhh.Parent:BreakJoints()
_G.Killed(i1,i1,&quot;You killed yourself by &quot; ..wepused.. &quot;!!&quot;)
_G.UpdateSW(mmm.Name.. &quot; killed him/herself with &quot; ..wepused.. &quot;.&quot;)
_G.Kills[i1] = _G.Kills[i1] - 1
_G.Deaths[i1] = _G.Deaths[i1] + 1
_G.Points[i1] = _G.Points[i1] - (1*_G.ScoreMultiplier)
if _G.Mode == _G.Modes[1] or _G.Mode == _G.Modes[8] or _G.Mode == _G.Modes[9] then -- temporary kill
_G.Kills2[i1] = _G.Kills2[i1] - 1
elseif _G.Mode == _G.Modes[2] or _G.Mode == _G.Modes[3] or _G.Mode == _G.Mode[7] or _G.Modes == _G.Mode[6] then --lobby on died
_G.CharType[i1] = &quot;Player&quot;
_G.Team[i1] = &quot;Lobby&quot;
elseif _G.Mode == _G.Modes[4] then -- team switcher
if _G.Team[i1] == &quot;Players&quot; then 
_G.CharType[i1] = &quot;Zombie&quot;
_G.Team[i1] = &quot;Zombies&quot;
else
_G.CharType[i1] = &quot;Player&quot;
_G.Team[i1] = &quot;Players&quot;
end 
elseif _G.Mode == _G.Modes[5] then -- infection
_G.CharType[i1] = &quot;Zombie&quot;
_G.Team[i1] = &quot;Zombies&quot;
--elseif _G.Mode == _G.Modes[] then -- Nothing.
end 
end


end

Teles = {}
for i=1,#_G.T1Spawn do
table.insert(Teles,_G.T1Spawn[i])
end
for i=1,#_G.T2Spawn do
table.insert(Teles,_G.T2Spawn[i])
end

repeat wait() until _G.GetTablePlayer(Player.Name) ~= nil 
local i2 = _G.GetTablePlayer(Player.Name)
local ct2 = _G.CharType[i2]
local tt2 = _G.Team[i2]

if _G.GameProcess ~= &quot;RoundPlaying&quot; and _G.GameProcess ~= &quot;RoundEnded&quot; then
t.CFrame = _G.Spawn1.CFrame + Vector3.new(math.random(-12,12),2.5,math.random(-12,12))
else

p = Player

wait(0.2)

if p.Character ~= nil then
if p.Character:findFirstChild(&quot;Torso&quot;) ~= nil then

if tt2 == &quot;Lobby&quot; then
t.CFrame = _G.Spawn1.CFrame + Vector3.new(math.random(-12,12),2.5,math.random(-12,12))
game.Lighting.Stuff.Guis.Spectate:Clone().Parent = Player.PlayerGui
else 
if _G.Mode == _G.Modes[1] or _G.Mode == _G.Modes[7] or _G.Mode == _G.Modes[8] then
t.CFrame = Teles[math.random(1,#_G.T1Spawn)].CFrame + Vector3.new(0,2.5,0)
_G.GiveToolsAndMorph2(p)

elseif _G.Mode == _G.Modes[2] then
if tt2 == &quot;Zombies&quot; or tt2 == &quot;None&quot; then
t.CFrame = Teles[math.random(1,#_G.T1Spawn)].CFrame + Vector3.new(0,2.5,0)
_G.GiveToolsAndMorph2(p)
else
t.CFrame = _G.Spawn1.CFrame + Vector3.new(math.random(-3,3),2.5,math.random(-3,3))
end

elseif _G.Mode == _G.Modes[3] then
if _G.Team[i2] == &quot;Team1&quot; then
t.CFrame = _G.T1Spawn[math.random(1,#_G.T1Spawn)].CFrame + Vector3.new(0,2.5,0)
_G.GiveToolsAndMorph2(p)
elseif _G.Team[o2] == &quot;Team2&quot; then
t.CFrame = _G.T2Spawn[math.random(1,#_G.T2Spawn)].CFrame + Vector3.new(0,2.5,0)
_G.GiveToolsAndMorph2(p)
end


elseif _G.Mode == _G.Modes[4] then 
if _G.Team[i2] == &quot;Players&quot; then
t.CFrame = _G.T1Spawn[math.random(1,#_G.T1Spawn)].CFrame + Vector3.new(0,2.5,0)
else
t.CFrame = _G.T2Spawn[math.random(1,#_G.T2Spawn)].CFrame + Vector3.new(0,2.5,0)
end
_G.GiveToolsAndMorph2(p)

elseif _G.Mode == _G.Modes[5] then
_G.Team[i2] = &quot;Zombies&quot;
_G.CharType[i2] = &quot;Zombie&quot;
t.CFrame = Teles[math.random(1,#_G.T1Spawn)].CFrame + Vector3.new(0,2.5,0)
_G.GiveToolsAndMorph2(p)

elseif _G.Mode == _G.Modes[6] or _G.Mode == _G.Modes[9] then
if _G.Team[i2] == &quot;Team1&quot; then
t.CFrame = _G.T1Spawn[math.random(1,#_G.T1Spawn)].CFrame + Vector3.new(0,2.5,0)
else 
t.CFrame = _G.T2Spawn[math.random(1,#_G.T2Spawn)].CFrame + Vector3.new(0,2.5,0)
end
_G.GiveToolsAndMorph2(p)

end

end
end
end
end
--[[
if _G.Team[nn] == &quot;Players&quot; then
t.CFrame = _G.T1Spawn[math.random(1,#_G.T1Spawn)].CFrame + Vector3.new(0,2.5,0)
else
