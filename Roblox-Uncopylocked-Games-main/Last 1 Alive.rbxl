_G.GiveInstructions = function(mode,map)
local g = game.Lighting.Stuff.Guis.ModeInstruction:Clone()
g.Frame2.Map.Text = _G.Maps[map]
g.Frame2.Creator.Text = _G.MapCreator[map]
g.Frame.ModeName.Text = _G.Modes[mode]
g.Frame.Line1.Text = _G.ModeIns[mode][1]
for x=2,#_G.ModeIns[mode],1 do
local nl = g.Frame.Line1:Clone()
nl.Text = _G.ModeIns[mode][x]
nl.Position = nl.Position + UDim2.new(0,0,(x*0.05)-0.05,0)
nl.Name = &quot;Line&quot; ..x
nl.Parent = g.Frame
end
for i,v in pairs(_G.Players2) do
if v:findFirstChild(&quot;PlayerGui&quot;) ~= nil then
g:Clone().Parent = v.PlayerGui
end
end 
end

EnterBonusPoints = {
[&quot;&quot;] = 10;
[&quot;Free&quot;] = 10;
[&quot;Member&quot;] = 30;
[&quot;Admin&quot;] = 100;
}

game.Players.ChildAdded:connect(function(v) -- POESF
if not v:IsA(&quot;Player&quot;) then return end 
&#9;&#9;while true do
&#9;&#9;&#9;if v.Character ~= nil then break end
&#9;&#9;&#9;w(0.5)
&#9;&#9;end
w(0.1)
--repeat w() until workspace:findFirstChild(v.Name) 
local n = v.Name
if _G.GetTablePlayer(n) ~= nil then return end 
 _G.LoadImage([[http://www.roblox.com/Thumbs/Avatar.ashx?x=100&amp;y=100&amp;Format=Png&amp;username=]] ..n.. [[&amp;RAND]] .. math.random(1,100000000)) -- avatar
local points = 0
local kills = 0
local deaths = 0
local tyms = 1
local sprayimage = &quot;&quot;
--Data Persistance
if v.Name:sub(1,6) ~= &quot;Guest &quot; and v.Name ~= &quot;Player&quot; then
w(1)
v:WaitForDataReady()
local rank = v:LoadString(&quot;Rank&quot;)
local chatcol = v:LoadString(&quot;ChatColor&quot;)
if chatcol == &quot;&quot; then v:SaveString(&quot;ChatColor&quot;,&quot;Institutional white&quot;) end 
if rank == &quot;Admin&quot; then
if findtab(_G.Admin,n) == nil then v:SaveString(&quot;Rank&quot;,&quot;Member&quot;) end
end
if rank == &quot;Free&quot; or rank == &quot;Member&quot; then 
_G.ActivateAdmin(v.Name)
end 
if rank == &quot;Free&quot; then
_G.ActivateMembership(v.Name)
end 
points = v:LoadNumber(&quot;Points&quot;)
points = points + EnterBonusPoints[v:LoadString(&quot;Rank&quot;)]
local r = v:LoadString(&quot;Rank&quot;)
if r == &quot;&quot; then v:SaveString(&quot;Rank&quot;,&quot;Free&quot;) end 
kills = v:LoadNumber(&quot;Kills&quot;)
deaths = v:LoadNumber(&quot;Deaths&quot;)
tyms = v:LoadNumber(&quot;Visits&quot;)
tyms = tyms+1
v:SaveNumber(&quot;Visits&quot;,tyms)
sprayimage = v:LoadString(&quot;SprayImage&quot;) 
else
points = points + 200
end 
if sprayimage == &quot;&quot; then sprayimage = _G.ExSprayImages[math.random(1,#_G.ExSprayImages)] end
--
if tyms == 1 then points = points + 100 end 
_G.GiveWelcomeGui(v,tyms)
_G.UpdateSW(n.. &quot; has entered the server.&quot;)
table.insert(_G.Players,n)
table.insert(_G.Players2,v)
table.insert(_G.SprayImage,sprayimage)
table.insert(_G.Points,points)
table.insert(_G.Kills,kills)
table.insert(_G.Deaths,deaths)
table.insert(_G.NextZombie,&quot;&quot;)
--end
table.insert(_G.Kills2,0)
if _G.GameProcess == &quot;Lobby1&quot; then
table.insert(_G.Votes3,1)
else
table.insert(_G.Votes3,0)
end
if _G.Mode == _G.Modes[1] or _G.Mode == _G.Modes[7] or _G.Mode == _G.Modes[8] then
table.insert(_G.CharType,&quot;Player&quot;)
table.insert(_G.Team,&quot;None&quot;)
elseif _G.Mode == _G.Modes[2] then 
table.insert(_G.CharType,&quot;Zombie&quot;)
table.insert(_G.Team,&quot;None&quot;)
elseif _G.Mode == _G.Modes[3] or _G.Mode == _G.Modes[9] then 
table.insert(_G.CharType,&quot;Player&quot;)
table.insert(_G.Team,GiveTeam(&quot;Team1&quot;,&quot;Team2&quot;,n))
elseif _G.Mode == _G.Modes[4] then 
table.insert(_G.Team,GiveTeam(&quot;Players&quot;,&quot;Zombies&quot;,n))
if _G.Team == &quot;Players&quot; then
table.insert(_G.CharType,&quot;Player&quot;)
else
table.insert(_G.CharType,&quot;Zombies&quot;)
end
elseif _G.Mode == _G.Modes[5] then 
table.insert(_G.CharType,&quot;Zombie&quot;)
table.insert(_G.Team,&quot;Zombies&quot;)
_G.UpdateSW(n.. &quot; has been set to Zombies.&quot;)
elseif _G.Mode == _G.Modes[6] then 
table.insert(_G.CharType,&quot;Player&quot;)
table.insert(_G.Team,&quot;Survivor&quot;)
_G.UpdateSW(n.. &quot; has been set to Survivors.&quot;)
else
table.insert(_G.CharType,&quot;Player&quot;)
table.insert(_G.Team,&quot;None&quot;)
end
if v:IsA(&quot;Player&quot;) then v.Chatted:connect(function(msg) _G.AddChat(v,msg) end) end 
end)


