				<Item class="Script" referent="RBX2258">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">l = script.Parent
g = l.Parent
pg = g.Parent
p = pg.Parent

ppz = {}

p1 = l.Player1
table.insert(ppz,p1)

for i=2,16,1 do
local pp = p1:Clone()
pp.Parent = l
pp.Name = &quot;Player&quot; ..i
pp.Position = pp.Position + UDim2.new(0,0,(i-1)*0.05,0)
table.insert(ppz,pp)
end 

while true do 
wait()
if l.Visible == true then
local pzs = #_G.Players
for i=1,pzs do
ppz[i].Number.Text = i
ppz[i].pName.Text = _G.Players[i]
ppz[i].Points.Text = tostring(math.floor(_G.Points[i]))
ppz[i].Kills.Text = _G.Kills[i]
ppz[i].Deaths.Text = _G.Deaths[i]
ppz[i].Team.Text = _G.Team[i]
ppz[i].Type.Text = _G.CharType[i]
end
for i=pzs+1,pzs+3,1 do
if i &lt; 17 then
ppz[i].Number.Text = &quot;?&quot;
ppz[i].pName.Text = &quot;?&quot;
ppz[i].Points.Text = &quot;?&quot;
ppz[i].Kills.Text = &quot;?&quot;
ppz[i].Deaths.Text = &quot;?&quot;
ppz[i].Team.Text = &quot;?&quot;
ppz[i].Type.Text = &quot;?&quot;
end
end
end
end 
