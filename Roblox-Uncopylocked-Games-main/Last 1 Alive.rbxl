function ft(tab,nam)
for i=1,#tab do 
if tab[i] == nam then
return i
else
end
end
return nil
end

function rclass(Par,cn)
for _,c in pairs(Par:GetChildren()) do 
if c.className:lower() == cn:lower() then 
c:Remove()
else
end
end
end 

