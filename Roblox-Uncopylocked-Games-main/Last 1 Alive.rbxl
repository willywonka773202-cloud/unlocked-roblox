KeyDown = true 
key:lower()
if key == &quot;q&quot; and LAnim == &quot;None&quot; and Anim == &quot;None&quot; then 
LAnim = &quot;Slash&quot;
for i=-0.2,-1.6,-0.2 do 
LW.C0 = CFrame.new(-1.5,-i/3.5,0) *CFrame.Angles(-i,0.3,i)
wait()
end
Humanoid.WalkSpeed = Humanoid.WalkSpeed + 3
for i=-1.6,0.8,0.2 do
LW.C0 = CFrame.new(-1.5+((i+1.6)/3.5),1.6/3,-(i+1.6)/1.2) *CFrame.Angles(1.6,0.3,i)
wait()
end
for i=0.8,-1.6,-0.2 do
LW.C0 = CFrame.new(-1.5+((i+1.6)/3.5),1.6/3,-(i+1.6)/1.2) *CFrame.Angles(1.6,0.3,i)
wait()
end
Humanoid.WalkSpeed = Humanoid.WalkSpeed - 3
for i=-1.6,-0.2,0.2 do 
LW.C0 = CFrame.new(-1.5,-i/3.5,0) *CFrame.Angles(-i,0.3,i)
wait()
end
LAnim = &quot;None&quot;
elseif key == &quot;e&quot; and RAnim == &quot;None&quot; and Anim == &quot;None&quot; then 
RAnim = &quot;Slash&quot;
for i=-0.2,-1.6,-0.2 do 
RW.C0 = CFrame.new(1.5,-i/3.5,0) *CFrame.Angles(-i,-0.3,-i)
wait()
end
Humanoid.WalkSpeed = Humanoid.WalkSpeed + 2
for i=-1.6,0.8,0.2 do
RW.C0 = CFrame.new(1.5-((i+1.6)/3.5),1.6/3,-(i+1.6)/1.2) *CFrame.Angles(1.6,-0.3,-i)
wait()
end
for i=0.8,-1.6,-0.2 do
RW.C0 = CFrame.new(1.5-((i+1.6)/3.5),1.6/3,-(i+1.6)/1.2) *CFrame.Angles(1.6,-0.3,-i)
wait()
end
Humanoid.WalkSpeed = Humanoid.WalkSpeed - 2
for i=-1.6,-0.2,0.2 do
RW.C0 = CFrame.new(1.5,-i/3.5,0) *CFrame.Angles(-i,-0.3,-i)
wait()
end
RAnim = &quot;None&quot;



elseif key == &quot;2&quot; then
if Anim ~= &quot;None&quot; then return end 
Crouch = true
CrouchAnim(Crouch)
repeat wait(0.1) until Crouch == false 
Crouch = false
CrouchAnim(Crouch)


elseif key == &quot;0&quot; then
Gui.Leaderboard.Visible = true
repeat wait(0.1) until KeyDown == false 
Gui.Leaderboard.Visible = false

elseif key == &quot;g&quot; and Anim == &quot;None&quot; then
Pounce()
wait(2) 
Anim = &quot;None&quot;


elseif key == &quot;t&quot; then
Spray()

elseif key == &quot;f&quot; and Anim == &quot;None&quot; and climbdebounce == false and ClimbSur.Transparency == 0 then
Climbing = true
climbdebounce = true 
Man.PlatformStand = true
climbsupport.CFrame = CFrame.new(Torso.CFrame * CFrame.new(0,-3,0).p)
climbbp.position = Vector3.new(climbsupport.Position.x,climbsupport.Position.y,climbsupport.Position.z)
climbbg.maxTorque = Vector3.new(math.huge,math.huge,math.huge)
climbbp.maxForce = Vector3.new(math.huge,math.huge,math.huge)
local climbz = 0
local animz = 1
wait(0.2)
repeat 
wait(0.1) 
climbz = climbz + 1  
climbbg.cframe = CFrame.new(Torso.Position,ClimbSur.Position) *CFrame.Angles(math.rad(-90),0,0) 
climbsupport.CFrame = CFrame.new(Torso.CFrame * CFrame.new(0,2,0).p) 
climbbp.position = Vector3.new(climbsupport.Position.x,climbsupport.Position.y,climbsupport.Position.z) 
if animz == 1 then
animz = 2
LW.C0 = CFrame.new(-1.5,1,0) *CFrame.Angles(math.rad(170),0.3,0)
RW.C0 = CFrame.new(1.5,1,0) *CFrame.Angles(math.rad(160),-0.3,0)
else
animz = 1
LW.C0 = CFrame.new(-1.5,1,0) *CFrame.Angles(math.rad(160),0.3,0)
RW.C0 = CFrame.new(1.5,1,0) *CFrame.Angles(math.rad(170),-0.3,0)
end 
until Climbing == false or climbz == 160
LW.C0 = CFrame.new(-1.5,0,0) *CFrame.Angles(-0.3,0.3,0)
RW.C0 = CFrame.new(1.5,0,0) *CFrame.Angles(-0.3,-0.3,0)
Climbing = false
climbbg.cframe = CFrame.Angles(0,0,0)
wait(0.5)
climbbg.maxTorque = Vector3.new(0,0,0)
climbbp.maxForce = Vector3.new(0,0,0)
Man.PlatformStand = false
wait(2)
climbdebounce = false


end
end)

