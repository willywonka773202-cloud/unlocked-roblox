for i=1,6 do 
if str:sub(i,i) ~= &quot;&quot; and str:sub(i,i) ~= &quot; &quot; then 
Plate[&quot;b&quot; ..i].d.Texture = as .. Bets[str:sub(i,i)]
else
Plate[&quot;b&quot; ..i].d.Texture = &quot;&quot;
end
end
elseif n == &quot;Kills&quot; then
for i=1,5 do 
if str:sub(i,i) ~= &quot;&quot; and str:sub(i,i) ~= &quot; &quot; then 
Plate[&quot;c&quot; ..i].d.Texture = as .. Bets[str:sub(i,i)]
else
Plate[&quot;c&quot; ..i].d.Texture = &quot;&quot;
end
end
elseif n == &quot;Team&quot; then
for i=1,8 do 
if str:sub(i,i) ~= &quot;&quot; and str:sub(i,i) ~= &quot; &quot; then 
Plate[&quot;d&quot; ..i].d.Texture = as .. Bets[str:sub(i,i)]
else
Plate[&quot;d&quot; ..i].d.Texture = &quot;&quot;
end
end
elseif n == &quot;Label&quot; then
for i=1,37 do 
if str:sub(i,i) ~= &quot;&quot; and str:sub(i,i) ~= &quot; &quot; then 
Plate[&quot;0&quot; ..i].d.Texture = as .. Bets[str:sub(i,i)]
else
Plate[&quot;0&quot; ..i].d.Texture = &quot;&quot;
end
end
end -- n if end
end -- func end 



function findtab(tab,var)
for i=1,#tab do 
if tab[i] == var then 
return i 
end
end
return nil
end 
---
Plates = {}
for i=1,14 do 
table.insert(Plates,m[i])
end

Pied = {}
for i=1,14,1 do 
if findtab(Pied,ts(i)) == nil then
Plates[i].Transparency = 1
SetLet(Plates[i],&quot;None&quot;,&quot;Name&quot;)
SetLet(Plates[i],&quot;0&quot;,&quot;Points&quot;)
SetLet(Plates[i],&quot;0&quot;,&quot;Kills&quot;)
SetLet(Plates[i],&quot;None&quot;,&quot;Team&quot;)
end
end
for x=1,#_G.Team do 
if x &lt; 15 then 
table.insert(Pied,ts(x))
if _G.Players[x] ~= nil and _G.Points[x] ~= nil and _G.Kills[x] ~= nil and _G.Team[x] ~= nil then
Plates[x].Transparency = 0
SetLet(Plates[x],ts(_G.Players[x]),&quot;Name&quot;)
SetLet(Plates[x],ts(mf(_G.Points[x])),&quot;Points&quot;)
SetLet(Plates[x],ts(mf(_G.Kills[x])),&quot;Kills&quot;)
SetLet(Plates[x],ts(_G.Team[x]),&quot;Team&quot;)
else 
Plates[x].Transparency = 1
SetLet(Plates[x],&quot;None&quot;,&quot;Name&quot;)
SetLet(Plates[x],&quot;0&quot;,&quot;Points&quot;)
SetLet(Plates[x],&quot;0&quot;,&quot;Kills&quot;)
SetLet(Plates[x],&quot;None&quot;,&quot;Team&quot;)
end
end
end
for i=1,14,1 do 
if findtab(Pied,ts(i)) == nil then
Plates[i].Transparency = 1
SetLet(Plates[i],&quot;None&quot;,&quot;Name&quot;)
SetLet(Plates[i],&quot;0&quot;,&quot;Points&quot;)
SetLet(Plates[i],&quot;0&quot;,&quot;Kills&quot;)
SetLet(Plates[i],&quot;None&quot;,&quot;Team&quot;)
end
end
