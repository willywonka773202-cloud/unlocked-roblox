local bp = Instance.new(&quot;BodyPosition&quot;,t) bp.position = t.Position bp.maxForce = Vector3.new(1/0,1/0,1/0) game.Debris:AddItem(bp,3)
else
t.CFrame = _G.T2Spawn[math.random(1,#_G.T2Spawn)].CFrame + Vector3.new(math.random(-2,2),2.5,math.random(-2,2))
local bp = Instance.new(&quot;BodyPosition&quot;,t) bp.position = t.Position bp.maxForce = Vector3.new(1/0,1/0,1/0) game.Debris:AddItem(bp,3)
end

elseif _G.Mode == _G.Modes[3] or _G.Mode == _G.Modes[4] or _G.Mode == _G.Modes[9] then --team
if _G.Team[nn] == &quot;Team1&quot; then
t.CFrame = _G.T1Spawn[math.random(1,#_G.T1Spawn)].CFrame + Vector3.new(math.random(-2,2),2.5,math.random(-2,2))
local bp = Instance.new(&quot;BodyPosition&quot;,t) bp.position = t.Position bp.maxForce = Vector3.new(1/0,1/0,1/0) game.Debris:AddItem(bp,3)
else
t.CFrame = _G.T2Spawn[math.random(1,#_G.T2Spawn)].CFrame + Vector3.new(math.random(-2,2),2.5,math.random(-2,2))
local bp = Instance.new(&quot;BodyPosition&quot;,t) bp.position = t.Position bp.maxForce = Vector3.new(1/0,1/0,1/0) game.Debris:AddItem(bp,3)
end

end
end
end 
end)
end))
end
end
