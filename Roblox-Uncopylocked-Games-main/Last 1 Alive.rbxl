_G.UpdateSW(&quot;The Tank(&quot; ..tankname.. &quot;) gets &quot; ..(_G.ScoreMultiplier*(wastime2-wastime)).. &quot; points!&quot;)
if _G.GetTablePlayer(tankname) ~= nil then local tid = _G.GetTablePlayer(tankname) _G.Points[tid] = _G.Points[tid] + ((wastime2-wastime)*_G.ScoreMultiplier) end
elseif cond == &quot;tie&quot; then
_G.UpdateSW(&quot;Its a Tie!!&quot;)
end
elseif _G.Mode == _G.Modes[7] then 
local killedppl = nil 
