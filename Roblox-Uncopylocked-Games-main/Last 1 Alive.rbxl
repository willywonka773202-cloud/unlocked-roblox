if Vomited.Visible == true and Vomited.BackgroundTransparency &gt;= 0.9 then 
Vomited.Visible = false
end
if Vomited.BackgroundTransparency &lt; 0.9 then
Vomited.BackgroundTransparency = Vomited.BackgroundTransparency + 0.01
end
end </ProtectedString>
