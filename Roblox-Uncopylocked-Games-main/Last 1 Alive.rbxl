until Char ~= nil and Char:findFirstChild(&quot;Sound&quot;) ~= nil
Char.Sound:Remove() 
end))

local ct = Instance.new(&quot;StringValue&quot;)
ct.Name = &quot;CharType&quot;
ct.Value = tostring(_G.CharType[i2])
ct.Parent = Char
if Player.Name:sub(1,6) == &quot;Guest &quot; or Player.Name == &quot;Player&quot; then 
else
Player:WaitForDataReady()
local rank = Player:LoadString(&quot;Rank&quot;)
if rank == &quot;Free&quot; or rank == &quot;Member&quot; then 
_G.ActivateAdmin(Player.Name)
end 
if rank == &quot;Free&quot; then
_G.ActivateMembership(Player.Name)
end 
end 

coroutine.resume(coroutine.create(function()
repeat wait(0.4) until Bp:findFirstChild(&quot;ToolScript&quot;) ~= nil
wait(0.5)
Char.Humanoid.Health = Char.Humanoid.MaxHealth
end)) 

coroutine.resume(coroutine.create(function()
fell = false 
while true do 
wait()
if Char.Humanoid.Health &gt; 0 then 
if fell == false and t.Position.y &lt; -50 then 
t.Velocity = Vector3.new(0,1,0)
damage(t,Player,99999,&quot;Falling&quot;)
fell = true 
end
if fell == false and math.abs(t.Position.x) &gt; 4000 then 
t.Velocity = Vector3.new(0,1,0)
damage(t,Player,99999,&quot;Glitching&quot;)
fell = true 
end
if fell == false and math.abs(t.Position.z) &gt; 4000 then 
t.Velocity = Vector3.new(0,1,0)
damage(t,Player,99999,&quot;Glitching&quot;)
fell = true 
end

end 
end
end))
