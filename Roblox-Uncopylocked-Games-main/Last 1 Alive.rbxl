						<ProtectedString name="Source">-----


t = script.Parent
t.CFrame = CFrame.new(t.Position.x,t.Position.y,t.Position.z) *CFrame.Angles(0,0,0)
wait(1.2)
local hurt = true
Magnitude = 90
Weapon = &quot;PipeBomb&quot;
Damage = 105
coroutine.resume(coroutine.create(function()
for i=7.8,0,-0.1 do 
wait(0.1)
end 
hurt = false 
wait(1)
t:Remove()
end))

 for i,vx in pairs(game.Players:GetChildren()) do
  coroutine.resume(coroutine.create(function()
local v = vx
    repeat 
--Follow the birdy
print(math.abs((v.Character.Torso.Position - t.Position).magnitude))
    if v.Character ~= nil and v.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil and math.abs((v.Character.Torso.Position - t.Position).magnitude) &lt; Magnitude and _G.CharType[_G.GetTablePlayer(v.Name)] == &quot;Zombie&quot; then 
local h = v.Character.Humanoid h:MoveTo(t.Position,t) if math.random(1,10) == math.random(1,10) then h.Jump = true end 
    end
   wait()
until hurt == false 
--Get an ouch (for everyone)
    if v.Character ~= nil and v.Character:findFirstChild(&quot;Humanoid&quot;) ~= nil and v.Character.Humanoid.Health &gt; 0 and  math.abs((v.Character.Torso.Position - t.Position).magnitude) &lt; 12 then 
    local tor = v.Character.Torso
    _G.Damage(tor,script.creator.Value,Damage,Weapon)
    end
-----------
  end))
 end

