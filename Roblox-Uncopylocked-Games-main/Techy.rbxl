script.Parent.Visible = false
wait(5)
script.Parent.Visible = true
if character:FindFirstChild(&quot;Shirt&quot;) then
&#9;if character.Shirt.ShirtTemplate ~= &quot;http://www.roblox.com/asset/?id=56458810&quot; then
&#9;&#9;script.Parent.MouseButton1Down:connect(function()
&#9;&#9;&#9;character.Shirt.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=56458810&quot;
&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;end)
&#9;else
&#9;&#9;script.Parent:remove()
&#9;end
else
&#9;script.Parent.MouseButton1Down:connect(function()
&#9;&#9;local shirt = Instance.new(&quot;Shirt&quot;, character)
&#9;&#9;shirt.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=56458810&quot;
&#9;&#9;script.Parent:remove()
&#9;end)
end
