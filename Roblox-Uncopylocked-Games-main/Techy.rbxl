		<Item class="Script" referent="RBX229">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Haze Functionality</string>
				<ProtectedString name="Source">local enemies = {}
local ops = {&quot;Tenal&quot;, &quot;Infinitive&quot;, &quot;Clubpen&quot;, &quot;Player&quot;}

function IsEnemy(player)
&#9;for i = 1, #enemies do
&#9;&#9;if player:IsInGroup(enemies[i]) then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
end

game.Players.PlayerAdded:connect(function(player)
&#9;player.CharacterAdded:connect(function(character)
&#9;&#9;repeat wait() until character:FindFirstChild(&quot;RobloxTeam&quot;)
&#9;&#9;character.RobloxTeam:remove()
&#9;end)
&#9;-- Team Assignment
&#9;player.Neutral = false
&#9;if player:IsInGroup(296396) then
&#9;&#9;player.TeamColor = BrickColor.new(&quot;Bright green&quot;)
&#9;elseif IsEnemy(player) then
&#9;&#9;player.TeamColor = BrickColor.new(&quot;Bright red&quot;)
&#9;else
&#9;&#9;player.TeamColor = BrickColor.new(&quot;Dark stone grey&quot;)
&#9;end

&#9;-- OP Guns
&#9;local function IsOp(player)
&#9;&#9;for i = 1, #ops do
&#9;&#9;&#9;if player.Name:lower() == ops[i]:lower() then
&#9;&#9;&#9;&#9;return true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return false
&#9;end
&#9;if IsOp(player) then
&#9;&#9;for i, tool in pairs(game.Lighting:GetChildren()) do
&#9;&#9;&#9;if tool:IsA(&quot;Tool&quot;) or tool:IsA(&quot;HopperBin&quot;) then
&#9;&#9;&#9;&#9;tool:clone().Parent = player.Backpack
&#9;&#9;&#9;&#9;tool:clone().Parent = player.StarterGear
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)
</ProtectedString>
