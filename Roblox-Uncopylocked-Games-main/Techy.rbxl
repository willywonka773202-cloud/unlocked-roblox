				<Item class="Script" referent="RBX379">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">README</string>
						<ProtectedString name="Source">--Set the value of &quot;CurrentOwner&quot; to the color of the team that defaultly owns this flag.

--Set the value of &quot;CaptureDistance&quot; to the distance away from the flag base a player needs to be able to capture it.

--Set the value of &quot;StepsToBottom&quot; to how many &quot;Steps&quot; it takes for the flag to get down/up.

--Set the value of &quot;NeutralColor&quot; to the color you want to signify neutrality with. If there is a team with this color, they will not be able to capture!

--To make this flag neutral, just make sure the CurrentOwner value is the same as the NeutralColor value</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX380">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FlagManager</string>
						<ProtectedString name="Source">teams = game.Teams:children()
owner = script.Parent.CurrentOwner
neutral = script.Parent.NeutralColor.Value
a = script.Parent.Flag
b = script.Parent.FlagDetail
namer = script.Parent.Naming:children()[1]
spawns = script.Parent.Spawns
steps = script.Parent.StepsToBottom
maxsteps = steps.Value

function setup(color)
local found = false
for i,v in pairs(teams) do
if v.TeamColor == color and v.TeamColor ~= neutral then
found = true
a.BrickColor = color
b.BrickColor = color
namer.Name = &quot;Owned by &quot; ..v.Name
namer.Head.Smoke.Color = color.Color
spawns.Parent = script.Parent
for j,w in pairs(spawns:children()) do
w.TeamColor = color
w.BrickColor = color
end
break
end
end
if not found and color == neutral then
a.BrickColor = color
b.BrickColor = color
namer.Name = &quot;No one owns this flag!&quot;
namer.Head.Smoke.Color = color.Color
spawns.Parent = nil
a.CFrame = a.CFrame-Vector3.new(0,(steps.Value/maxsteps)*14,0)
b.CFrame = b.CFrame-Vector3.new(0,(steps.Value/maxsteps)*14,0)
steps.Value = 0
elseif not found and color ~= neutral then
print(&quot;Flag has no identity! Self-Destructing.&quot;)
script.Parent:Remove()
end
end


setup(owner.Value)

owner.Changed:connect(function() setup(owner.Value) end)</ProtectedString>
					</Properties>
