								<R20>0</R20>
								<R21>0</R21>
								<R22>1</R22>
							</CoordinateFrame>
							<string name="Name">Owned by Imperial Legionairres</string>
							<Ref name="PrimaryPart">null</Ref>
						</Properties>
						<Item class="Humanoid" referent="RBX383">
							<Properties>
								<float name="Health">0</float>
								<float name="MaxHealth">0</float>
								<string name="Name">Humanoid</string>
								<float name="WalkSpeed">16</float>
							</Properties>
						</Item>
					</Item>
				</Item>
				<Item class="NumberValue" referent="RBX384">
					<Properties>
						<string name="Name">CaptureDistance</string>
						<double name="Value">5</double>
					</Properties>
				</Item>
				<Item class="IntValue" referent="RBX385">
					<Properties>
						<string name="Name">StepsToBottom</string>
						<int name="Value">200</int>
					</Properties>
				</Item>
				<Item class="BrickColorValue" referent="RBX386">
					<Properties>
						<string name="Name">CurrentOwner</string>
						<int name="Value">104</int>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX387">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Capture</string>
						<ProtectedString name="Source">bin = script.Parent.Base
owner = script.Parent.CurrentOwner
distance = script.Parent.CaptureDistance.Value
steps = script.Parent.StepsToBottom
maxsteps = steps.Value
a = script.Parent.Flag
b = script.Parent.FlagDetail
neutral = script.Parent.NeutralColor.Value

attackingteam = nil
defendingteam = nil

script.Parent.FlagManager.Disabled = false

players = {}

for i,v in pairs(game.Players:GetPlayers()) do
table.insert(players, v)
end

game.Players.PlayerAdded:connect(function(p) table.insert(players, p) end)

function findTeamByColor(color)
returnee = &quot;&quot;
for i,v in pairs(game.Teams:children()) do
if v.TeamColor == color then
returnee = v.Name
break
end
end
return returnee
end

function moveFlag(team, name, name2)
if (team ~= owner.Value) and (owner.Value ~= neutral) then
if steps.Value &gt; 0 then
a.CFrame = a.CFrame-Vector3.new(0,14/maxsteps,0)
b.CFrame = b.CFrame-Vector3.new(0,14/maxsteps,0)
steps.Value = steps.Value-1
if steps.Value == 0 then
attackingteam = team
defendingteam = owner.Value
owner.Value = neutral
if m~=nil then m:Remove() end
m = Instance.new(&quot;Hint&quot;, workspace)
m.Text = &quot;THE FLAG &quot; ..script.Parent.Name.. &quot;, OWNED BY &quot; ..name2.. &quot;, IS BEING CAPTURED BY THE &quot; ..name.. &quot;!&quot;
game:service(&quot;Debris&quot;):AddItem(m, 5)
end
end
elseif (team == owner.Value) and (owner.Value ~= neutral) then
if steps.Value &lt; maxsteps then
a.CFrame = a.CFrame+Vector3.new(0,14/maxsteps,0)
b.CFrame = b.CFrame+Vector3.new(0,14/maxsteps,0)
steps.Value = steps.Value+1
if steps.Value == maxsteps then
owner.Value = team
end
end
elseif (team ~= owner.Value) and (owner.Value == neutral) then
if team == defendingteam then
if steps.Value &gt; 0 then
a.CFrame = a.CFrame-Vector3.new(0,14/maxsteps,0)
b.CFrame = b.CFrame-Vector3.new(0,14/maxsteps,0)
steps.Value = steps.Value-1
if steps.Value == 0 then
if m~=nil then m:Remove() end
m = Instance.new(&quot;Hint&quot;, workspace)
m.Text = &quot;THE FLAG &quot; ..script.Parent.Name.. &quot; HAS BEEN RECOVERED FROM THE &quot; ..findTeamByColor(attackingteam).. &quot; BY THE &quot; ..name.. &quot;!&quot;
game:service(&quot;Debris&quot;):AddItem(m, 5)
attackingteam = nil
defendingteam = nil
owner.Value = team
end
end
else
a.CFrame = a.CFrame+Vector3.new(0,14/maxsteps,0)
b.CFrame = b.CFrame+Vector3.new(0,14/maxsteps,0)
steps.Value = steps.Value+1
if steps.Value == maxsteps then
if m~=nil then m:Remove() end
m = Instance.new(&quot;Hint&quot;, workspace)
if defendingteam then
m.Text = &quot;THE FLAG &quot; ..script.Parent.Name.. &quot; HAS BEEN CAPTURED BY THE &quot; ..name.. &quot; FROM THE &quot; ..findTeamByColor(defendingteam).. &quot;!&quot;
else
m.Text = &quot;THE FLAG &quot; ..script.Parent.Name.. &quot; HAS BEEN CLAIMED BY THE &quot; ..name.. &quot;.&quot;
end
-------------------------------------------
if name == &quot;Raiders&quot; then
script.Parent.Timer.Disabled = false
else
script.Parent.Timer.Disabled = true
for i,v in pairs(script.Parent.BrickTimer:GetChildren()) do --Gotta get that timer&apos;s name derp.
v.Name = &quot;Raiders do not have the flag.&quot;
end
end
------------------------------------------- Everything in this block is all that I did XD.
game:service(&quot;Debris&quot;):AddItem(m, 5)
attackingteam = nil
defendingteam = nil
owner.Value = team
end
end
end
end

while true do
wait()
for i,v in pairs(players) do
if v.Character ~= nil then
torso = v.Character:findFirstChild(&quot;Torso&quot;)
if torso ~= nil then
if (torso.Position-bin.Position).magnitude &lt;= distance then
if v.TeamColor ~= neutral then
moveFlag(v.TeamColor, findTeamByColor(v.TeamColor), findTeamByColor(owner.Value))
end
end
end
end
end
end
</ProtectedString>
					</Properties>
				</Item>
				<Item class="BrickColorValue" referent="RBX388">
					<Properties>
						<string name="Name">NeutralColor</string>
						<int name="Value">208</int>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX389">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Timer</string>
						<ProtectedString name="Source">--Here you go Lord, tell me how it works.

Time = 1200 --20 minutes.

for i = 1, Time do 
for b, v in pairs(script.Parent.BrickTimer:GetChildren()) do --We got no idea what the Timer&apos;s name could be :O.
v.Name = &quot;Time: &quot; ..i.. &quot;/&quot; ..Time.. &quot;.&quot;
wait(1) --HOLD UP A SECOND.
end end

--If the script gets atleast this far, you know the raiders have won.

Clone = script.RaiderWin:clone()

Clone.Parent = game.Workspace

Clone.Disabled = false </ProtectedString>
					</Properties>
					<Item class="Script" referent="RBX390">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">RaiderWin</string>
							<ProtectedString name="Source">--This is done so that if we capture the flag during the 30 second gloating time, the script doesn&apos;t break.

Message = Instance.new(&quot;Message&quot;)
Message.Parent = game.Workspace
Message.Text = &quot;The raiders have won! NFC has lost! :[&quot;
game:GetService(&quot;Debris&quot;):AddItem(Message, 10) --Bout 10 seconds to gloat.


script:Remove() --Suicide made fun!
</ProtectedString>
