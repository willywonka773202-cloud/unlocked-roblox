					</Properties>
					<Item class="Script" referent="RBX3611">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local msgs = {
&#9;&quot;Welcome to Fort Neon, Haze Corporation&apos;s official fort!&quot;,
&#9;&quot;Did a gun break? Click backspace to drop it, then pick it up!&quot;,
&#9;&quot;You can buy VIP for benefits! [Coming Soon]&quot;,
&#9;&quot;Do you want to join Haze? Talk to an active Haze member (you can also use PM)!&quot;,
&#9;&quot;Supremacy Prevails!&quot;,
}

while true do
&#9;for i = 1, #msgs do
&#9;&#9;Spawn(function()
&#9;&#9;&#9;while script.Parent.TextTransparency &gt;= 0 and wait() do
&#9;&#9;&#9;&#9;script.Parent.TextTransparency = script.Parent.TextTransparency - 0.1
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;&#9;for j = 1, #msgs[i] do
&#9;&#9;&#9;script.Parent.Text = string.sub(msgs[i], 1, j)
&#9;&#9;&#9;wait()
&#9;&#9;end
&#9;&#9;wait(10)
&#9;&#9;while script.Parent.TextTransparency &lt;= 1 and wait() do
&#9;&#9;&#9;script.Parent.TextTransparency = script.Parent.TextTransparency + 0.1
&#9;&#9;end
&#9;end
end
</ProtectedString>
						</Properties>
					</Item>
				</Item>
