CreateModule(&quot;BackupGame&quot;,function(BackupIndex)
&#9;local BackupServices={&quot;Lighting&quot;,&quot;StarterPack&quot;,&quot;StarterGui&quot;,&quot;SoundService&quot;,&quot;Workspace&quot;}
&#9;local BackupData={};
&#9;for Index,BackupService in pairs(BackupServices) do
