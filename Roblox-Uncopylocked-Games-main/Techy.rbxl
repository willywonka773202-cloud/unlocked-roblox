&#9;&#9;&#9;RunModule(&quot;DisposePlayer&quot;,Target,Speaker);
&#9;&#9;end
&#9;end
end)
RunModule(&quot;CommandModule&quot;,&quot;newbase&quot;,&quot;Creates a new baseplate&quot;,&quot;nb&quot;,&quot;#cs#&quot;,function(Speaker)
