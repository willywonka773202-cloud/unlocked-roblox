&#9;&#9;end
&#9;end
end)
RunModule(&quot;CommandModule&quot;,RunModule(&quot;ParseMatch&quot;,&quot;ban#cs#p&quot;),&quot;Uses data persistence to ban the given user for the given amount of hours.&quot;,&quot;db&quot;,&quot;#cs#(.-)#cs#(%d+)&quot;,function(Speaker,Input,Length)
