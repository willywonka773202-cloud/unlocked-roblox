					<ProtectedString name="Source">local ScreenGui &#9;= script.Parent
local Haze &#9;&#9;&#9;= ScreenGui.Haze
local Neutral &#9;&#9;= ScreenGui.Neutral
local Raiders &#9;&#9;= ScreenGui.Raiders
local player &#9;&#9;= ScreenGui.Parent.Parent
--repeat wait() until player.Character
local character &#9;= player.Character

Haze.MouseButton1Down:connect(function()
&#9;if player:IsInGroup(296396) then
&#9;&#9;player.TeamColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;if character:FindFirstChild(&quot;Torso&quot;) then
&#9;&#9;&#9;character.Torso.CFrame = game.Workspace.NeutralSpawn.CFrame
&#9;&#9;end
&#9;end
end)

Neutral.MouseButton1Down:connect(function()
&#9;player.TeamColor = BrickColor.new(&quot;Medium stone grey&quot;)
&#9;if character:FindFirstChild(&quot;Torso&quot;) then
&#9;&#9;character.Torso.CFrame = game.Workspace.NeutralSpawn.CFrame
&#9;end
end)

Raiders.MouseButton1Down:connect(function()
&#9;player.TeamColor = BrickColor.new(&quot;Bright red&quot;)
&#9;if character:FindFirstChild(&quot;Torso&quot;) then
&#9;&#9;character.Torso.CFrame = game.Workspace.NeutralSpawn.CFrame
&#9;end
end)
