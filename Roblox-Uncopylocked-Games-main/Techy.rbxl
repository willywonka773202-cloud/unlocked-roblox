				<Item class="Script" referent="RBX2514">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local HasMessageDisplaying = false
game.Players.PlayerAdded:connect(function(player)
&#9;player.Chatted:connect(function(msg)
&#9;&#9;if not HasMessageDisplaying then
&#9;&#9;&#9;if player.Character then
&#9;&#9;&#9;&#9;if player.Character:FindFirstChild(&quot;Head&quot;) then
&#9;&#9;&#9;&#9;&#9;if (player.Character.Head.Position - script.Parent.Position).magnitude &lt; 2 then
&#9;&#9;&#9;&#9;&#9;&#9;local message = Instance.new(&quot;Message&quot;, game.Workspace)
&#9;&#9;&#9;&#9;&#9;&#9;message.Text = msg
&#9;&#9;&#9;&#9;&#9;&#9;HasMessageDisplaying = true
&#9;&#9;&#9;&#9;&#9;&#9;wait(5)
&#9;&#9;&#9;&#9;&#9;&#9;HasMessageDisplaying = false
&#9;&#9;&#9;&#9;&#9;&#9;message:Destroy()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
