			<Item class="Script" referent="RBX3649">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Weld</string>
					<ProtectedString name="Source">local prev
local parts = script.Parent:GetChildren()
for i = 1,#parts do
--remove any of the following parts that say &quot;(parts[i].className == [className])&quot; if you want to exclude that particular className type from the Weld
&#9;if ((parts[i].className == &quot;Part&quot;) or (parts[i].className == &quot;Seat&quot;) or (parts[i].className == &quot;TrussPart&quot;) or (parts[i].className == &quot;VehicleSeat&quot;) or (parts[i].className == &quot;SkateboardPlatform&quot;)) then
&#9;&#9;if (prev ~= nil) then
&#9;&#9;&#9;local weld = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;weld.Part0 = prev
&#9;&#9;&#9;weld.Part1 = parts[i]
&#9;&#9;&#9;weld.C0 = prev.CFrame:inverse()
&#9;&#9;&#9;weld.C1 = parts[i].CFrame:inverse()
&#9;&#9;&#9;weld.Parent = prev
&#9;&#9;&#9;parts[i].Anchored = false
&#9;&#9;end
&#9;&#9;prev = parts[i]
&#9;end
end
wait(3)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX3650">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">H1Functionality</string>
					<ProtectedString name="Source">-- To-do: Make the ammo bar turn red as it goes lower.

-- HAZE CORPORATION PRESENTS: H1 Functionality Script --
local tool = script.Parent
-- GUN INFORMATION --
local Weapon = {
&#9;Name &#9;&#9;&#9;&#9;= &quot;H1Carbine&quot;,
&#9;Barrel &#9;&#9;&#9;= tool.Barrel1,
&#9;Spread &#9;&#9;&#9;= 0.04,
&#9;RateOfFire &#9;&#9;= 0.04,
&#9;LaserDamage &#9;= 10,
&#9;Ammo &#9;&#9;&#9;&#9;= 50,
&#9;ReloadTime &#9;&#9;= 10,
}

local user
local player
local equipped = false
local OkayToShoot = true
local reloading = false
local WeaponGui
local MouseDown = false

tool.Equipped:connect(function(mouse)
&#9;equipped = true
&#9;user = tool.Parent
&#9;player = game.Players:GetPlayerFromCharacter(user)

&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=67172285&quot;

&#9;WeaponGui = tool.WeaponGui:clone()
&#9;WeaponGui.Parent = player.PlayerGui
&#9;WeaponGui.Title.WeaponName.Text = Weapon.Name
&#9;WeaponGui.MainFrame.AmmoBar.Size  = UDim2.new(0, (tool.Ammo.Value/Weapon.Ammo)*284, 0, 20)
&#9;WeaponGui.MainFrame.AmmoText.Text = &quot;Ammo: &quot; .. tool.Ammo.Value .. &quot;/&quot; .. Weapon.Ammo

&#9;tool.Ammo.Changed:connect(function()
&#9;&#9;WeaponGui.MainFrame.AmmoBar:TweenSize(UDim2.new(0, (tool.Ammo.Value/Weapon.Ammo)*284, 0, 20), _, _, Weapon.RateOfFire)
&#9;&#9;WeaponGui.MainFrame.AmmoText.Text = &quot;Ammo: &quot; .. tool.Ammo.Value .. &quot;/&quot; .. Weapon.Ammo
&#9;end)

&#9;WeaponGui.MainFrame.AmmoBar.Changed:connect(function(value)
&#9;&#9;if value == &quot;Size&quot; then
&#9;&#9;&#9;local function Color(r, g, b)
&#9;&#9;&#9;&#9;return Color3.new(r/255, g/255, b/255)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)

&#9;function Reload()
&#9;&#9;if not reloading then
&#9;&#9;&#9;WeaponGui.ReloadingText.Visible = true
&#9;&#9;&#9;reloading = true
&#9;&#9;&#9;for i = 1, Weapon.Ammo - tool.Ammo.Value do
&#9;&#9;&#9;&#9;wait(Weapon.RateOfFire*2)
&#9;&#9;&#9;&#9;if equipped then
&#9;&#9;&#9;&#9;&#9;tool.Ammo.Value = tool.Ammo.Value + 1
&#9;&#9;&#9;&#9;&#9;tool.ReloadSound:play()
&#9;&#9;&#9;&#9;else break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;if not equipped then reloading = false return end
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;WeaponGui.ReloadingText.Visible = false
&#9;&#9;&#9;reloading = false
&#9;&#9;end
&#9;end

&#9;mouse.KeyDown:connect(function(key)
&#9;&#9;key = key:lower()
&#9;&#9;if key == &quot;r&quot; and tool.Ammo.Value ~= 0 then
&#9;&#9;&#9;Reload()
&#9;&#9;end
&#9;end)

&#9;mouse.Button1Up:connect(function()
&#9;&#9;MouseDown = false
&#9;end)

&#9;mouse.Button1Down:connect(function()
&#9;&#9;MouseDown = true
&#9;&#9;if OkayToShoot and not reloading then
&#9;&#9;&#9;local function randomDirectionVector()  
&#9;&#9;&#9;&#9;-- Marsaglia method
&#9;&#9;&#9;&#9;local v
&#9;&#9;&#9;&#9;repeat  
&#9;&#9;&#9;&#9;&#9;v = Vector3.new(  
&#9;&#9;&#9;&#9;&#9;&#9;math.random()*2 - 1,  
&#9;&#9;&#9;&#9;&#9;&#9;math.random()*2 - 1,  
&#9;&#9;&#9;&#9;&#9;&#9;math.random()*2 - 1  
&#9;&#9;&#9;&#9;&#9;)  
&#9;&#9;&#9;&#9; until v.magnitude &lt;= 1  
&#9;&#9;&#9;&#9; return v.unit  
&#9;&#9;&#9;end  

&#9;&#9;&#9;local function randomRayBetween(from, to, randomness --[[Between 0 and 1. randomness = sin(spreadAngle)]])  
&#9;&#9;&#9;&#9; local direction = (to - from).unit  
&#9;&#9;&#9;&#9; direction = direction + randomDirectionVector()*randomness  
&#9;&#9;&#9;&#9; return Ray.new(  
&#9;&#9;&#9;&#9;&#9;  from,  
&#9;&#9;&#9;&#9;&#9;  direction.unit*500
&#9;&#9;&#9;&#9; )  
&#9;&#9;&#9;end

&#9;&#9;&#9;while OkayToShoot and not reloading and tool.Ammo.Value ~= 0 and MouseDown do
&#9;&#9;&#9;&#9;local hit, position = game.Workspace:FindPartOnRay(
&#9;&#9;&#9;&#9;&#9;randomRayBetween(Weapon.Barrel.Position, mouse.Hit.p, Weapon.Spread), user)

&#9;&#9;&#9;&#9;function ShootVisibleRay(position)
&#9;&#9;&#9;&#9;&#9;local direction = (position - Weapon.Barrel.Position).magnitude

&#9;&#9;&#9;&#9;&#9;local laser = Instance.new(&quot;Part&quot;, game.Workspace)
&#9;&#9;&#9;&#9;&#9;laser.Name = &quot;Laser&quot;
&#9;&#9;&#9;&#9;&#9;laser.Anchored = true
&#9;&#9;&#9;&#9;&#9;laser.CanCollide = false
&#9;&#9;&#9;&#9;&#9;laser.Transparency = 0.5
&#9;&#9;&#9;&#9;&#9;laser.BrickColor = BrickColor.new(&quot;White&quot;)
&#9;&#9;&#9;&#9;&#9;laser.TopSurface = &quot;Smooth&quot;
&#9;&#9;&#9;&#9;&#9;laser.BottomSurface = &quot;Smooth&quot;
&#9;&#9;&#9;&#9;&#9;laser.formFactor = &quot;Custom&quot;
&#9;&#9;&#9;&#9;&#9;laser.Size = Vector3.new(0.2, 0.2, direction)
&#9;&#9;&#9;&#9;&#9;laser.CFrame = CFrame.new(position, Weapon.Barrel.Position)*CFrame.new(0, 0, -direction/2)

&#9;&#9;&#9;&#9;&#9;game.Debris:AddItem(laser, 0.04)
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;function DoDamage(hit)
&#9;&#9;&#9;&#9;&#9;if hit then
&#9;&#9;&#9;&#9;&#9;&#9;if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent.Humanoid:TakeDamage(Weapon.LaserDamage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if hit.Parent.Humanoid.Health == 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local creator = Instance.new(&quot;ObjectValue&quot;, hit.Parent.Humanoid)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator.Name = &quot;creator&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator.Value = player
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;elseif hit.Parent:IsA(&quot;Hat&quot;) and hit.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;hit.Parent.Parent.Humanoid:TakeDamage(Weapon.LaserDamage)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if hit.Parent.Parent.Humanoid.Health == 0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;local creator = Instance.new(&quot;ObjectValue&quot;, hit.Parent.Parent.Humanoid)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator.Name = &quot;creator&quot;
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;creator.Value = player
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;tool.Ammo.Value = tool.Ammo.Value - 1

&#9;&#9;&#9;&#9;DoDamage(hit) ShootVisibleRay(position)

&#9;&#9;&#9;&#9;tool.FireSound:play()

&#9;&#9;&#9;&#9;OkayToShoot = false

&#9;&#9;&#9;&#9;wait(Weapon.RateOfFire)
&#9;&#9;&#9;&#9;OkayToShoot = true

&#9;&#9;&#9;&#9;if tool.Ammo.Value == 0 then
&#9;&#9;&#9;&#9;&#9;Reload()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end)
end)

tool.Unequipped:connect(function()
&#9;equipped = false
&#9;player = nil
&#9;WeaponGui:remove()
end)
</ProtectedString>
				</Properties>
				<Item class="LocalScript" referent="RBX3651">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer.Character
script.Parent.Disabled = false
</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Sound" referent="RBX3652">
				<Properties>
					<bool name="Looped">false</bool>
					<string name="Name">ReloadSound</string>
					<float name="Pitch">1</float>
					<bool name="PlayOnRemove">false</bool>
					<Content name="SoundId"><url>http://roblox.com/asset/?id=10209636</url></Content>
					<float name="Volume">0.5</float>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX3653">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldArm</string>
					<ProtectedString name="Source">Tool = script.Parent;
local arms = nil
local torso = nil
local welds = {}

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Name = &quot;LArmWeld&quot;
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C0 = CFrame.new(0, 0.5, -1.5) * CFrame.Angles(math.rad(0), math.rad(50), math.rad(90))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Name = &quot;RArmWeld&quot;
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C0 = CFrame.new(1, 0.4, 0) * CFrame.Angles(math.rad(90), math.rad(0), 0)
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
Tool.Equipped:connect(Equip)
Tool.Unequipped:connect(Unequip)
</ProtectedString>
				</Properties>
			</Item>
