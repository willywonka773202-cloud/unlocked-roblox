				<Item class="Script" referent="RBX2229">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Add</string>
						<ProtectedString name="Source">tabs = {}

function check(yo)
local y = yo:GetChildren()
for i = 1,#y do
if y[i] ~= nil then
return y[i]
end
end
return nil
end


function place(tab)
local g = script.Parent:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Part&quot; then
if g[i].Name ~= &quot;border&quot; then
if check(g[i]) == nil then

tab.Parent = g[i]
return
end
end
end
end
end


function allign(tab)
if tab.className == &quot;Decal&quot; then
place(tab)
end
end

script.Parent.Storage.ChildAdded:connect(allign)




</ProtectedString>
