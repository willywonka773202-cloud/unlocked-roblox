						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function change()
if script.Parent.Value == true then
script.Parent.Parent.Ringing.Value = true
end
end
script.Parent.Changed:connect(change)</ProtectedString>
						</Properties>
					</Item>
