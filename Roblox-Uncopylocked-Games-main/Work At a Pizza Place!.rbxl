a = script.Parent.Brick
tar = nil
dir = &quot;North&quot;
function check(space)
local g = game.Workspace:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Model&quot; then
local f = g[i]:FindFirstChild(&quot;Pos&quot;)
if f ~= nil then
if f.Value == space then
return true
end
end
end
end
return false
end



function visable(yo)
local g = yo:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Part&quot; then
g[i].Transparency = 0.5
g[i].CanCollide = false
end
end
end

function onMove(mouse)
if mouse.Target ~= nil and mouse.Target.Name == &quot;Tile&quot; and mouse.Target.Parent.Owner.Value == script.Parent.Parent.Parent.Name then
a:remove()
tar = mouse.Target
if check(tar) == false then
a = game.Lighting.Furniture:FindFirstChild(dir):FindFirstChild(script.Parent.Items.Value):clone()
visable(a)
a.Pos.Value = tar
a.Parent = game.Workspace
a:MakeJoints()
a:MoveTo(Vector3.new(tar.Position.x + script.Parent.X.Value, tar.Position.y + script.Parent.Y.Value, tar.Position.z+ script.Parent.Z.Value))
end
end
end


function onButton1Down(mouse)
a:remove()
tar = mouse.Target
local t = game.Lighting.Furniture:FindFirstChild(dir):FindFirstChild(script.Parent.Items.Value):clone()
t.Pos.Value = tar
t.Parent = game.Workspace
t.Owner.Value = script.Parent.Parent.Parent.Name
t:MakeJoints()
t:MoveTo(Vector3.new(tar.Position.x + script.Parent.X.Value, tar.Position.y + script.Parent.Y.Value, tar.Position.z + script.Parent.Z.Value))
script.Parent:remove()
end

function onSelected(mouse)


     

        mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
        mouse.KeyDown:connect(onKeyDown)
     mouse.Move:connect(function() onMove(mouse) end)

end

function onKeyDown(key) 
if key == &quot;r&quot; then
if dir == &quot;North&quot; then
dir = &quot;West&quot; 

elseif dir == &quot;West&quot; then
dir = &quot;South&quot; 

elseif dir == &quot;South&quot; then
dir = &quot;East&quot; 

elseif dir == &quot;East&quot; then
dir = &quot;North&quot;
end
end
end 
bin.Selected:connect(onSelected)



function onDeS(mouse) 
a.Parent = nil
end
script.Parent.Deselected:connect(onDeS)
