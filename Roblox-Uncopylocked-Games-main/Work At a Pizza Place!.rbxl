&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;spawnDe = true
&#9;&#9;&#9;wait(30)
&#9;&#9;&#9;spawnDe = false
&#9;&#9;&#9;return
&#9;&#9;end
&#9;end



