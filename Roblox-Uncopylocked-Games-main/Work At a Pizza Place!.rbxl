						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function open()
if script.Parent.Open.Value == true then
script.Parent.Door2.Transparency = 0
script.Parent.Door1.Transparency = 1
script.Parent.Open.Value = false
elseif script.Parent.Open.Value == false then
script.Parent.Door2.Transparency = 1
script.Parent.Door1.Transparency = 0
script.Parent.Open.Value = true
end
end
script.Parent.Door1.ClickDetector.MouseClick:connect(open)
script.Parent.Door2.ClickDetector.MouseClick:connect(open)

</ProtectedString>
