						<string name="Name">Spawn</string>
						<ProtectedString name="Source">q = {&quot;Hello, I would like a Pepperoni pizza.&quot;, &quot;I&apos;ll have a Cheese pizza&quot;, &quot;I want a Sausage Pizza&quot;,&quot;I guess I will get a Mountain Dew&quot;}
house = {&quot;a1&quot;,&quot;a2&quot;,&quot;a3&quot;,&quot;b1&quot;,&quot;b2&quot;,&quot;b3&quot;,&quot;c1&quot;,&quot;c2&quot;,&quot;c3&quot;}



while true do
wait(2.5)
if script.Parent.OCC.Value == false then
wait(math.random(1,30))
script.Parent.OCC.Value = true
local h = game.Lighting.Cary.Car:clone()
h.Parent = game.Workspace
h:MoveTo(script.Parent.Position)
local p = math.random(1,4)
h.Order.Value = p
h.Say.Value = q[h.Order.Value]
h.House.Value = house[math.random(1,9)]
h.Lane.Value = 1
end
end </ProtectedString>
					</Properties>
