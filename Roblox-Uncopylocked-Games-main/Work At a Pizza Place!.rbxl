bin=script.Parent
ee = nil

local sr = script.Parent[&quot;&quot;]:clone()
sr.Parent = game.Workspace
sr.Name = bin.Parent.Parent.Name .. &quot;storage&quot;

function dis(s)
local g = s.Character:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Part&quot; then
g[i].Transparency = 1
end
end
end

function ss(s)
local rr = sr:GetChildren()
for i = 1,#rr do
rr[i]:remove()
end
local g = s.Character:GetChildren()
for i = 1,#g do
if g[i].className ~= &quot;Part&quot; and g[i].className ~= &quot;Humanoid&quot; then
g[i].Parent = sr
end
end
local d =s.Character.Head:FindFirstChild(&quot;face&quot;)
if d ~= nil then
--d.Parent = sr
d:remove()
end
end


function parts(s)
ee =  Instance.new(&quot;Model&quot;)
ee.Parent = game.Workspace
ee.Name = s.Name

local g = s.Character:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Part&quot; or g[i].className == &quot;Humanoid&quot; then
g[i]:clone().Parent = ee
end
end
end


function get(s)
local g = sr:GetChildren()
for i = 1,#g do
g[i].Parent = s.Character
end
local e = s.Character:GetChildren()
for i = 1,#e do
if e[i].className == &quot;Part&quot; then
e[i].Transparency = 0
end
end
--sr.face.Parent = s.Character.Head
end



function onMove(mouse)
end

function onButton1Down(mouse)
local s = script.Parent.Parent.Parent
if s ~= nil and s.Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
parts(s)
dis(s)
ss(s)

end
end


function onButton1Up(mouse)
local s = script.Parent.Parent.Parent
if s ~= nil and s.Character:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
get(s)
ee:remove()
end
end

function onKeyDown(key)
end

function onSelected(mouse)


mouse.Icon = &quot;http://www.roblox.com/asset/?id=7566408&quot;
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.Move:connect(function() onMove(mouse) end)
--mouse.Idle:connect(function() onIdle(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end
bin.Selected:connect(onSelected)

function de()
end
bin.Deselected:connect(de)
