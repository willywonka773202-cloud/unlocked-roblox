function icony(mouse)
&#9;local size = mouse.ViewSizeY
&#9;local threeOp = {size / 5, (size / 5 + size/5), (size / 5 + size/5)+ size /5,(size / 5 + size/5)+ (size/5+size/5),size}
&#9;if mouse.Y &lt;= threeOp[1] then
&#9;&#9;mouse.Icon = give
&#9;&#9;options = 1
&#9;elseif mouse.Y &lt;= threeOp[2] then
&#9;&#9;mouse.Icon = take
&#9;&#9;options = 2
&#9;elseif mouse.Y &lt;= threeOp[3] then
&#9;&#9;mouse.Icon = eod
&#9;&#9;options = 3
&#9;elseif mouse.Y &lt;= threeOp[4] then
&#9;&#9;mouse.Icon = home
&#9;&#9;options = 4
&#9;elseif mouse.Y &lt;= threeOp[5] then
&#9;&#9;mouse.Icon = spawn
&#9;&#9;options = 5
&#9;end
end
&#9;&#9;



function sitDown()
&#9;if script.Parent.Person.Value == nil then return end
&#9;local g = game.Workspace:GetChildren()
&#9;for i = 1,#g do
&#9;&#9;if g[i].Name == &quot;CustomerDis&quot; and g[i].Torso.Transparency == 1 then

&#9;&#9;&#9;g[i].Torso.BrickColor = script.Parent.Person.Value.Torso.BrickColor
&#9;&#9;&#9;g[i].Head.BrickColor = script.Parent.Person.Value.Head.BrickColor
&#9;&#9;&#9;g[i][&quot;Right Arm&quot;].BrickColor = script.Parent.Person.Value[&quot;Right Arm&quot;].BrickColor
&#9;&#9;&#9;g[i][&quot;Left Arm&quot;].BrickColor = script.Parent.Person.Value[&quot;Left Arm&quot;].BrickColor
&#9;&#9;&#9;g[i][&quot;Left Leg&quot;].BrickColor = script.Parent.Person.Value[&quot;Left Leg&quot;].BrickColor
&#9;&#9;&#9;g[i][&quot;Right Leg&quot;].BrickColor = script.Parent.Person.Value[&quot;Right Leg&quot;].BrickColor
&#9;&#9;&#9;local s = script.Script:clone()
&#9;&#9;&#9;s.Disabled = false
&#9;&#9;&#9;s.Parent = g[i]
&#9;&#9;&#9;return
&#9;&#9;end
&#9;end

end



function deliver(mouse)
&#9;if mouse.Target.Name == &quot;FullBox&quot; then
&#9;&#9;local y = game.Lighting.Storage.Pizza:clone()
&#9;&#9;y.Name = &quot;To: &quot; .. string.upper(mouse.Target.House.Value)
&#9;&#9;y.Parent = script.Parent.Parent.Parent.Backpack
&#9;&#9;y.House.Value = mouse.Target.House.Value
&#9;&#9;mouse.Target:remove()
&#9;&#9;script.Parent.Step:Play()
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Step:Stop()
&#9;end
&#9;if mouse.Target.Name == &quot;MountainDew&quot; then
&#9;&#9;local yy = game.Lighting.Storage.MountainDew:clone()
&#9;&#9;yy.Name = &quot;To: &quot; .. string.upper(mouse.Target.House.Value)
&#9;&#9;yy.Parent = script.Parent.Parent.Parent.Backpack
&#9;&#9;yy.House.Value = mouse.Target.House.Value
&#9;&#9;mouse.Target:remove()
&#9;&#9;script.Parent.Step:Play()
&#9;&#9;wait(0.2)
&#9;&#9;script.Parent.Step:Stop()
&#9;end
end




function cook(mouse)
&#9;if mouse.Target.Name == &quot;Dough&quot; and top ~= &quot;&quot; then
&#9;&#9;st = game.Workspace.Items
&#9;&#9;if top == &quot;Sausage1&quot; and mouse.Target.Topping.Value ~= 1 and mouse.Target.Topping.Value ~= 2 and st.Sausage.Value ~= 0 then
&#9;&#9;&#9;mouse.Target.Owner.Value = script.Parent.Parent.Parent
&#9;&#9;&#9;game.Lighting.Storage.Sausage:clone().Parent = mouse.Target
&#9;&#9;&#9;mouse.Target.Topping.Value =  2 
&#9;&#9;&#9;st.Sausage.Value = st.Sausage.Value - 1
&#9;&#9;&#9;script.Parent.Splat:Play()

&#9;&#9;elseif top == &quot;Pepperoni1&quot;  and mouse.Target.Topping.Value ~= 1 and mouse.Target.Topping.Value ~= 2 and st.Pepperoni.Value ~= 0 then
&#9;&#9;&#9;game.Lighting.Storage.Pepperoni:clone().Parent = mouse.Target
&#9;&#9;&#9;mouse.Target.Topping.Value =  1
&#9;&#9;&#9;mouse.Target.Owner.Value = script.Parent.Parent.Parent
&#9;&#9;&#9;st.Pepperoni.Value = st.Pepperoni.Value - 1
&#9;&#9;&#9;script.Parent.Splat:Play()

&#9;&#9;elseif top == &quot;Cheese1&quot; and mouse.Target.Cheese.Value ~= true and st.Cheese.Value ~= 0 then
&#9;&#9;&#9;game.Lighting.Storage.Cheese:clone().Parent = mouse.Target
&#9;&#9;&#9;mouse.Target.Cheese.Value =  true
&#9;&#9;&#9;mouse.Target.Owner.Value = script.Parent.Parent.Parent
&#9;&#9;&#9;st.Cheese.Value = st.Cheese.Value - 1
&#9;&#9;&#9;script.Parent.Splat:Play()

&#9;&#9;elseif top == &quot;TomatoSauce1&quot; and mouse.Target.TomatoSauce.Value ~= true and st.TomatoSauce.Value ~= 0 then
&#9;&#9;&#9;game.Lighting.Storage.TomatoSauce:clone().Parent = mouse.Target
&#9;&#9;&#9;mouse.Target.TomatoSauce.Value =  true
&#9;&#9;&#9;mouse.Target.Owner.Value = script.Parent.Parent.Parent
&#9;&#9;&#9;st.TomatoSauce.Value = st.TomatoSauce.Value - 1
&#9;&#9;&#9;script.Parent.Splat:Play()
&#9;&#9;end

&#9;end
&#9;if mouse.Target.Name == &quot;Sausage1&quot; or mouse.Target.Name == &quot;Pepperoni1&quot; or mouse.Target.Name == &quot;Cheese1&quot; or mouse.Target.Name == &quot;TomatoSauce1&quot; then
&#9;&#9;top = mouse.Target.Name
&#9;&#9;local targ = mouse.Target
&#9;&#9;targ.BrickColor = BrickColor.new(21)
&#9;&#9;wait()
&#9;&#9;targ.BrickColor = BrickColor.new(1)
&#9;end
end





function find()
&#9;local g = game.Workspace.Customers:GetChildren()
&#9;return g[math.random(1,#g)]
end
ab = nil

function phone(mouseTarget)
&#9;
&#9;if mouseTarget.Parent.Name == &quot;Phone&quot; and mouseTarget.Parent.Ringing.Value == true and mouseTarget.Parent.Order.Value == false then
&#9;&#9;e = find()
&#9;&#9;mess = Instance.new(&quot;Hint&quot;)
&#9;&#9;mess.Text = r[e.Value]
&#9;&#9;mess.Parent = script.Parent.Parent.Parent
&#9;&#9;script.Parent.Person.Value = e
&#9;&#9;mode = 2
&#9;&#9;mouseTarget.Parent.Ringing.Value = false
&#9;elseif mouseTarget.Parent.Name == &quot;Phone&quot; and mouseTarget.Parent.Ringing.Value == true and mouseTarget.Parent.Order.Value == true then
&#9;&#9;human = true
&#9;&#9;ab = mouseTarget.Parent.House.Value
&#9;&#9;e = game.Workspace.Customers.Cheese
&#9;&#9;mess = Instance.new(&quot;Hint&quot;)
