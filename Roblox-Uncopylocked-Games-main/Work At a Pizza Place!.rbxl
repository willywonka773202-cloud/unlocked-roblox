				<Item class="Script" referent="RBX2449">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function dew(hit)
&#9;if hit.Name ~= &quot;Dew&quot; then return end
&#9;local yo = check(&quot;MountainDew&quot;)
&#9;if yo ~= nil then
&#9;&#9;hit.House.Value = yo.House.Value
&#9;&#9;hit.Name = &quot;MountainDew&quot;
&#9;&#9;yo:remove()
&#9;end
&#9;if hit.Name == &quot;Dew&quot; and yo == nil then
&#9;&#9;hit:remove()
&#9;&#9;game.Workspace.Items.MountainDew.Value = game.Workspace.Items.MountainDew.Value + 1
&#9;end
end


function checksomemore(item)
&#9;local s = game.Workspace.Items
&#9;if item.Cheese.Value == true then
&#9;&#9;s.Cheese.Value = s.Cheese.Value + 1
&#9;end
&#9;if item.TomatoSauce.Value == true then
&#9;&#9;s.TomatoSauce.Value = s.TomatoSauce.Value + 1
&#9;end
&#9;if item.Topping.Value == 2 then
&#9;&#9;s.Sausage.Value = s.Sausage.Value + 1
&#9;end
&#9;if item.Topping.Value == 1 then
&#9;&#9;s.Pepperoni.Value = s.Pepperoni.Value + 1
&#9;end
&#9;s.Dough.Value = s.Dough.Value + 1
end


function check(u)
&#9;local h = game.Workspace.Orders:GetChildren()
&#9;for i = 1,#h do
&#9;&#9;if h[i].className == &quot;Part&quot; then
&#9;&#9;&#9;local y = h[i]:FindFirstChild(u)
&#9;&#9;&#9;if y ~= nil then
&#9;&#9;&#9;&#9;return y
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return nil
end

function checky(hit)
&#9;if hit.Topping.Value == 0 and check(&quot;Cheese&quot;) == true then
&#9;&#9;return true
&#9;elseif hit.Topping.Value == 1 and check(&quot;Pepperoni&quot;) == true then
&#9;&#9;return true
&#9;elseif hit.Topping.Value == 2 and check(&quot;Sausage&quot;) == true then
&#9;&#9;return true
&#9;end
&#9;return false
end


function touch(hit)
&#9;if hit:FindFirstChild(&quot;Owner&quot;) ~= nil and hit.Owner.Value ~= nil then
&#9;&#9;hit.Owner.Value.Cook.Value = hit.Owner.Value.Cook.Value + 1
&#9;end
&#9;dew(hit)
&#9;if hit.Name ~= &quot;Dough&quot; then return end
&#9;local a = hit:FindFirstChild(&quot;Cheese&quot;)
&#9;local b = hit:FindFirstChild(&quot;TomatoSauce&quot;)
&#9;local c = hit:FindFirstChild(&quot;Topping&quot;)
&#9;local d = hit:FindFirstChild(&quot;Cooked&quot;)
&#9;local house = hit:FindFirstChild(&quot;House&quot;)

&#9;if a.Value == true and b.Value == true and d.Value == true then

&#9;&#9;local cheese = check(&quot;Cheese&quot;)
&#9;&#9;local sausage = check(&quot;Sausage&quot;)
&#9;&#9;local pepperoni = check(&quot;Pepperoni&quot;)

&#9;&#9;if c.Value == 0 and cheese ~= nil then
&#9;&#9;&#9;house.Value = cheese.House.Value
&#9;&#9;&#9;hit.Name = &quot;Pizza&quot;
&#9;&#9;&#9;cheese:remove()

&#9;&#9;elseif c.Value == 1 and pepperoni ~= nil then
&#9;&#9;&#9;house.Value = pepperoni.House.Value
&#9;&#9;&#9;hit.Name = &quot;Pizza&quot;
&#9;&#9;&#9;pepperoni:remove()

&#9;&#9;elseif c.Value == 2 and sausage ~= nil then
&#9;&#9;&#9;house.Value = sausage.House.Value
&#9;&#9;&#9;hit.Name = &quot;Pizza&quot;
&#9;&#9;&#9;sausage:remove()
&#9;&#9;end
&#9;end
&#9;if hit.Name == &quot;Dough&quot; then
&#9;&#9;if a.Value == false or b.Value == false or d.Value == false or checky(hit) == false then
&#9;&#9;&#9;checksomemore(hit)
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;hit:remove()
&#9;&#9;end
&#9;end
end  
script.Parent.Touched:connect(touch)</ProtectedString>
