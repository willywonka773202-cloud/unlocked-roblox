							<string name="Name">Script</string>
							<ProtectedString name="Source">function open()
if script.Parent.On.Value == true then
script.Parent.Part3.BrickColor = BrickColor.new(1)
script.Parent.On.Value = false
elseif script.Parent.On.Value == false then
script.Parent.Part3.BrickColor = BrickColor.new(24)
script.Parent.On.Value = true
end
end
script.Parent.Part1.ClickDetector.MouseClick:connect(open)
script.Parent.Part2.ClickDetector.MouseClick:connect(open)
script.Parent.Part3.ClickDetector.MouseClick:connect(open)

</ProtectedString>
