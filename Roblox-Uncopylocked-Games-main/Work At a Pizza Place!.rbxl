							<ProtectedString name="Source">wait(0.5)
bin=script.Parent
plane=nil
hold=false
local debounce = false
local planedebounce = false
local stuntdebounce = false
local controlling = false
on = false
mode = 25

script.Parent.Parent.Parent.Character.Animate:remove()
local a = script.Animate:clone()
a.Disabled = false
a.Parent = script.Parent.Parent.Parent.Character

pp = Instance.new(&quot;Part&quot;)
pp.Size = Vector3.new(0,0,0)
pp.Name = &quot;Block&quot;
pp.Transparency = 1
pp.Parent = script.Parent.Parent.Parent.Character

ww = Instance.new(&quot;Weld&quot;)
ww.Part0 = script.Parent.Parent.Parent.Character.Torso
ww.Part1 = pp
ww.C0 = CFrame.fromEulerAnglesXYZ(1.6,0,0)
ww.Parent = ww.Part0
dir = nil

gg = Instance.new(&quot;BodyGyro&quot;)
gg.maxTorque = Vector3.new(0,0,0)
gg.Parent = pp

vv = Instance.new(&quot;BodyVelocity&quot;)
vv.maxForce = Vector3.new(0,0,0)
vv.Parent = pp

--[[function cloud()
local c = script.Parent.Cloud:clone()
c.CanCollide = false
c.Parent = game.Workspace
c.Position = script.Parent.Parent.Parent.Character.Torso.Position
local s = Instance.new(&quot;Script&quot;)
s.Source = 
p = 0
while true do
wait(0.05)
p = p + 1
if p &lt; 5 then
local r = script.Parent.Mesh
r.Scale = Vector3.new(r.Scale.x+5, r.Scale.y+5, r.Scale.z+5)
elseif p &gt; 5 then
script.Parent:remove()
end
end
s.Parent = c
end
]]



--[[function fire()
&#9;local missile = bin.Arrow:clone()
&#9;missile.CFrame = script.Parent.Parent.Parent.Character.Torso.CFrame * CFrame.new(0, 0, -10)

&#9;--missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = script.Parent.Parent.Parent
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile

end]]



--[[function wings(c)
local w = script.Parent.Wing:clone()
w.Parent = script.Parent.Parent.Parent.Character
