				<Item class="Script" referent="RBX8638">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function water()
if script.Parent.Watery.Value == true then
script.Parent.Water.Transparency = 0
script.Parent.Water1.Transparency = 0
script.Parent.Watery.Value = false
elseif script.Parent.Watery.Value == false then
script.Parent.Water.Transparency = 1
script.Parent.Water1.Transparency = 1
script.Parent.Watery.Value = true
end
end
script.Parent.Sink1.ClickDetector.MouseClick:connect(water)
script.Parent.Sink.ClickDetector.MouseClick:connect(water)

</ProtectedString>
					</Properties>
