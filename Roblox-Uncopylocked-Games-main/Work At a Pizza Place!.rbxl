						<string name="Name">6</string>
						<ProtectedString name="Source">de = false
function check(y)
local u = y.Backpack:FindFirstChild(&quot;Select&quot;)
if u ~= nil then
local e = game.Workspace:FindFirstChild(y.Name .. &quot;storage&quot;)
if e ~= nil then
local t = y.Backpack:GetChildren()
for i = 1,#t do
if t[i].className == &quot;HopperBin&quot; then
if t[i].Name ~= &quot;Fly&quot; and t[i].Name ~= &quot;FakeDeath&quot; then
t[i].Parent = e
end
end
end
end
end
end


--[[function gear(g)
local gea= g.Parent.StarterGear:GetChildren()
for i = 1,#gea do
wait(0.1)
local a = gea[i]:clone()
a.Parent = g
end
if g.Parent.Character ~= nil then
local gg = g.Parent.Character:GetChildren()
for i = 1,#gg do
if gg[i].className == &quot;Tool&quot; then
gg[i]:remove()
end
end
end
end]]


function find(g)
script.Parent:FindFirstChild(&quot;Deliver&quot;):clone().Parent = g
wait(0.1)
script.Parent:FindFirstChild(&quot;Reset&quot;):clone().Parent = g
wait(0.1)
script.Parent:FindFirstChild(&quot;Help&quot;):clone().Parent = g
--gear(g)
end


function remo(player)
local g = player.Backpack:GetChildren()
for i = 1,#g do
if g[i].className == &quot;HopperBin&quot; then
if g[i].Name ~= &quot;Fly&quot; and g[i].Name ~= &quot;FakeDeath&quot; then
g[i]:remove()
end
end
end
end

function touch(hit)
local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil and de == false  then
local gg = game.Players:FindFirstChild(hit.Parent.Name)
if gg ~= nil then
de = true
check(gg)
remo(gg)
find(gg.Backpack)
end
end
wait(1)
de = false
end
script.Parent.Touched:connect(touch)</ProtectedString>
