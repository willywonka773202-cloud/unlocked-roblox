s.Dough.Changed:connect(change)
s.Cheese.Changed:connect(change)
s.Pepperoni.Changed:connect(change)
s.MountainDew.Changed:connect(change)
s.Sausage.Changed:connect(change)
s.TomatoSauce.Changed:connect(change)]]</ProtectedString>
