				<Item class="Script" referent="RBX1006">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">action</string>
						<ProtectedString name="Source">b1 = script.Parent.a
b2 = script.Parent.b

g = nil
--spell = false

storage = game.Lighting.Storage.Numbers
score = script.Parent.Content
num = {}







function check()
local characters = {&quot;~&quot;,    &quot;@&quot;,    &quot;#&quot;,    &quot;^&quot;,    &quot;&amp;&quot;,    &quot;*&quot;,    &quot;(&quot;,    &quot;)&quot;,    &quot;-&quot;,    &quot;_&quot;,    &quot;+&quot;,    &quot;=&quot;,    &quot;[&quot;,    &quot;]&quot;,    &quot;}&quot;,    &quot;{&quot;,    &quot;:&quot;,    &quot;/&quot;,    &quot;&apos;&quot;,    &quot;;&quot;,    &quot;&lt;&quot;,    &quot;.&quot;,    &quot;?&quot;,    &quot;/&quot;,    &quot;*&quot;,    &quot;-&quot;}

for i = 1,#characters do
if string.match (score.Value, characters[i]) then
print(characters[i])
return characters[i]
end
end
return nil
end


function show(number,board)
local chili = board:GetChildren()
if chili[1] ~= nil then
chili[1]:remove()
end
local find = storage:FindFirstChild(num[number])
if find ~= nil then
local low = find:clone()
low.Parent = board
end
--[[if find == nil then
script.Parent.Content.Value = &quot;INVALID&quot;
end]]
end


while true do
wait(0.5)


score.Value = tostring(game.Workspace.Items:FindFirstChild(script.Parent.Name).Value)
wait()
num = {string.sub(score.Value, 1,1),string.sub(score.Value, 2,2 )}


show(1,b1)
show(2,b2)

--[[if spell == true then
spell = false
wait(2)
script.Parent.Content.Value = g
end]]
end </ProtectedString>
					</Properties>
