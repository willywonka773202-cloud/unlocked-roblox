			<Item class="Script" referent="RBX909">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Seasons</string>
					<ProtectedString name="Source">script.Season.Value = math.random(1,4)
wait()

&#9;if script.Season.Value == 1 then -- Summer
&#9;&#9;script.Season.Value = 2
&#9;&#9;game.Lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?id=2326662&quot;
&#9;&#9;game.Lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?id=2326681&quot;
&#9;&#9;game.Lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?id=2326652&quot;
&#9;&#9;game.Lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?id=2326666&quot;
&#9;&#9;game.Lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?id=2326670&quot;
&#9;&#9;game.Lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?id=2326677&quot;
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Tree&quot; then
&#9;&#9;&#9;&#9;g[i].Part.BrickColor = script.Summer.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Baseo&quot; then
&#9;&#9;&#9;&#9;g[i].BrickColor = script.Summer.Value
&#9;&#9;&#9;end
&#9;&#9;end



&#9;elseif script.Season.Value == 2 then -- Fall
&#9;&#9;script.Season.Value = 3
&#9;&#9;game.Lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014350&quot;
&#9;&#9;game.Lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014351&quot;
&#9;&#9;game.Lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014348&quot;
&#9;&#9;game.Lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014349&quot;
&#9;&#9;game.Lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014347&quot;
&#9;&#9;game.Lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?id=2326677&quot;
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Tree&quot; then
&#9;&#9;&#9;&#9;g[i].Part.BrickColor = script.Fall.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Baseo&quot; then
&#9;&#9;&#9;&#9;g[i].BrickColor = script.Fall.Value
&#9;&#9;&#9;&#9;g[i].Texture.Face = &quot;Top&quot;
&#9;&#9;&#9;end
&#9;&#9;end


&#9;elseif script.Season.Value == 3 then -- Winter
&#9;&#9;script.Season.Value = 4
&#9;&#9;game.Lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013852&quot;
&#9;&#9;game.Lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013853&quot;
&#9;&#9;game.Lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013850&quot;
&#9;&#9;game.Lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013851&quot;
&#9;&#9;game.Lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013849&quot;
&#9;&#9;game.Lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013854&quot;
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Tree&quot; then
&#9;&#9;&#9;&#9;g[i].Part.BrickColor = script.Winter.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Baseo&quot; then
&#9;&#9;&#9;&#9;g[i].BrickColor = script.Winter.Value
&#9;&#9;&#9;&#9;g[i].Texture.Face = &quot;Front&quot;
&#9;&#9;&#9;elseif g[i].Name == &quot;Roofy&quot; then
&#9;&#9;&#9;&#9;g[i].Transparency = 0
&#9;&#9;&#9;end
&#9;&#9;end


&#9;elseif script.Season.Value == 4 then -- Spring
&#9;&#9;script.Season.Value = 1
&#9;&#9;game.Lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?id=2326662&quot;
&#9;&#9;game.Lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?id=2326681&quot;
&#9;&#9;game.Lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?id=2326652&quot;
&#9;&#9;game.Lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?id=2326666&quot;
&#9;&#9;game.Lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?id=2326670&quot;
&#9;&#9;game.Lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?id=2326677&quot;
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Tree&quot; then
&#9;&#9;&#9;&#9;g[i].Part.BrickColor = script.Spring.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Baseo&quot; then
&#9;&#9;&#9;&#9;g[i].BrickColor = script.Spring.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Roofy&quot; then
&#9;&#9;&#9;&#9;g[i].Transparency = 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end



while true do
&#9;wait(600)
&#9;game.Lighting.Ambient = Color3.new(1,0.7,0.4) -- aternoon
&#9;game.Lighting.TimeOfDay = &quot;17:50:00&quot;
&#9;wait(120)
&#9;game.Lighting.Ambient = Color3.new(0.5,0.5,0.5) -- night
&#9;game.Lighting.TimeOfDay = &quot;20:00:00&quot;
&#9;wait(300)
&#9;game.Lighting.Ambient = Color3.new(1,1,0.5) --morning
&#9;game.Lighting.TimeOfDay = &quot;06:20:00&quot;
&#9;wait(120)
&#9;game.Lighting.Ambient = Color3.new(1,1,1) -- 
&#9;game.Lighting.TimeOfDay = &quot;12:00:00&quot;
&#9;wait(600)
&#9;game.Lighting.Ambient = Color3.new(1,0.7,0.4)
&#9;game.Lighting.TimeOfDay = &quot;17:50:00&quot;
&#9;wait(120)
&#9;game.Lighting.Ambient = Color3.new(0.5,0.5,0.5)
&#9;game.Lighting.TimeOfDay = &quot;20:00:00&quot;
&#9;wait(300)
&#9;game.Lighting.Ambient = Color3.new(1,1,0.5)
&#9;game.Lighting.TimeOfDay = &quot;06:20:00&quot;
&#9;wait(120)
&#9;game.Lighting.Ambient = Color3.new(1,1,1)
&#9;game.Lighting.TimeOfDay = &quot;12:00:00&quot;
&#9;if script.Season.Value == 1 then -- Summer
&#9;&#9;script.Season.Value = 2
&#9;&#9;game.Lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?id=2326662&quot;
&#9;&#9;game.Lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?id=2326681&quot;
&#9;&#9;game.Lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?id=2326652&quot;
&#9;&#9;game.Lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?id=2326666&quot;
&#9;&#9;game.Lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?id=2326670&quot;
&#9;&#9;game.Lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?id=2326677&quot;
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Tree&quot; then
&#9;&#9;&#9;&#9;g[i].Part.BrickColor = script.Summer.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Baseo&quot; then
&#9;&#9;&#9;&#9;g[i].BrickColor = script.Summer.Value
&#9;&#9;&#9;end
&#9;&#9;end



&#9;elseif script.Season.Value == 2 then -- Fall
&#9;&#9;script.Season.Value = 3
&#9;&#9;game.Lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014350&quot;
&#9;&#9;game.Lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014351&quot;
&#9;&#9;game.Lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014348&quot;
&#9;&#9;game.Lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014349&quot;
&#9;&#9;game.Lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1014347&quot;
&#9;&#9;game.Lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?id=2326677&quot;
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Tree&quot; then
&#9;&#9;&#9;&#9;g[i].Part.BrickColor = script.Fall.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Baseo&quot; then
&#9;&#9;&#9;&#9;g[i].BrickColor = script.Fall.Value
&#9;&#9;&#9;&#9;g[i].Texture.Face = &quot;Top&quot;
&#9;&#9;&#9;end
&#9;&#9;end


&#9;elseif script.Season.Value == 3 then -- Winter
&#9;&#9;script.Season.Value = 4
&#9;&#9;game.Lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013852&quot;
&#9;&#9;game.Lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013853&quot;
&#9;&#9;game.Lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013850&quot;
&#9;&#9;game.Lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013851&quot;
&#9;&#9;game.Lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013849&quot;
&#9;&#9;game.Lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?version=1&amp;id=1013854&quot;
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Tree&quot; then
&#9;&#9;&#9;&#9;g[i].Part.BrickColor = script.Winter.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Baseo&quot; then
&#9;&#9;&#9;&#9;g[i].BrickColor = script.Winter.Value
&#9;&#9;&#9;&#9;g[i].Texture.Face = &quot;Front&quot;
&#9;&#9;&#9;elseif g[i].Name == &quot;Roofy&quot; then
&#9;&#9;&#9;&#9;g[i].Transparency = 0
&#9;&#9;&#9;end
&#9;&#9;end


&#9;elseif script.Season.Value == 4 then -- Spring
&#9;&#9;script.Season.Value = 1
&#9;&#9;game.Lighting.Sky.SkyboxBk = &quot;http://www.roblox.com/asset/?id=2326662&quot;
&#9;&#9;game.Lighting.Sky.SkyboxDn = &quot;http://www.roblox.com/asset/?id=2326681&quot;
&#9;&#9;game.Lighting.Sky.SkyboxFt = &quot;http://www.roblox.com/asset/?id=2326652&quot;
&#9;&#9;game.Lighting.Sky.SkyboxLf = &quot;http://www.roblox.com/asset/?id=2326666&quot;
&#9;&#9;game.Lighting.Sky.SkyboxRt = &quot;http://www.roblox.com/asset/?id=2326670&quot;
&#9;&#9;game.Lighting.Sky.SkyboxUp = &quot;http://www.roblox.com/asset/?id=2326677&quot;
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Tree&quot; then
&#9;&#9;&#9;&#9;g[i].Part.BrickColor = script.Spring.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Baseo&quot; then
&#9;&#9;&#9;&#9;g[i].BrickColor = script.Spring.Value
&#9;&#9;&#9;elseif g[i].Name == &quot;Roofy&quot; then
&#9;&#9;&#9;&#9;g[i].Transparency = 1
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

