				<Item class="Script" referent="RBX2323">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function check()
local p = 0
local f = game.Workspace:GetChildren()
for i = 1,#f do
if f[i].Name == &quot;Dough&quot; then
p = p + 1
end
end 
return p
end

while true do
wait(2)
if check() &lt; 5 then
if game.Workspace.Items.Dough.Value ~= 0 then
game.Workspace.Items.Dough.Value = game.Workspace.Items.Dough.Value - 1
local p = game.Lighting.Storage.Dough:clone()
p.Parent = game.Workspace
p.Position = script.Parent.Position
end
end
end </ProtectedString>
					</Properties>
				</Item>
