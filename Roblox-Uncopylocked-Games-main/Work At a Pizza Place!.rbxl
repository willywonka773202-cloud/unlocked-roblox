if t.TeamColor == f[i].TeamColor then
if (f[i].Position - t.Character.Torso.Position).magnitude &gt; f[i].Dis.Value then
t.Character.Torso.CFrame = CFrame.new(Vector3.new(f[i].Position.x,f[i].Position.y+ 2,f[i].Position.z))
end
end
end
end
end

