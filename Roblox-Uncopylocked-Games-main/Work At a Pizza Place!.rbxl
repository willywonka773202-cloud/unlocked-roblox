				<Item class="Script" referent="RBX867">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function display(y)
y = tostring(y)
local g = script.Parent:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Decal&quot; then
if g[i].Name == y then
g[i].Face = &quot;Back&quot;
elseif g[i].Name ~= y then
g[i].Face = &quot;Front&quot;
end
end
end
end


while true do
wait(5)
display(1)
wait(5)
display(2)
wait(5)
display(3)
wait(5)
display(4)
end
</ProtectedString>
