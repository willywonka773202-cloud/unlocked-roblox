&#9;if mouse.Target.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and game.Players:GetPlayerFromCharacter(mouse.Target.Parent) ~= nil and option == false and s.TeamColor == BrickColor.new(28) then
