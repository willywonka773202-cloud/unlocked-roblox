				<Item class="Script" referent="RBX162">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function check()
local dis = 10000
local to = nil
local g = game.Players:GetChildren()
for i = 1,#g do
if g[i].TeamColor == BrickColor.new(1) and g[i].Character ~= nil then
if g[i].Character:FindFirstChild(&quot;Torso&quot;) ~= nil and (g[i].Character.Torso.Position - script.Parent.Position).magnitude &lt; dis then
dis = (g[i].Character.Torso.Position - script.Parent.Position).magnitude
to = g[i]
end
end
end
if to == nil then return end
to.Supplier.Value = to.Supplier.Value + 1
end



function touch(hit)
local g = hit:FindFirstChild(&quot;Refill&quot;)
if g ~= nil then
local r = game.Workspace.Items:FindFirstChild(g.Value)
if r ~= nil then
r.Value = r.Value + 10
hit:remove()
check()
end
end
end
script.Parent.Touched:connect(touch)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
