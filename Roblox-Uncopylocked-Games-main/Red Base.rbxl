					<string name="Name">Script</string>
					<ProtectedString name="Source">debounce = false

function onClick(player)
script.Parent.Sound:Play()

if debounce == false then

debounce = true
local request = script.RequestUI:clone()
request.Parent = player.PlayerGui.ScreenGui

wait(2)

request:Destroy()
debounce = false



end
end

script.Parent.ClickDetector.MouseClick:connect(onClick)

