						<ProtectedString name="Source">debounce = false

local mon = game.Workspace.TowerMonitorA


function onClick(player)

if debounce == false then

debounce = true
local request = script.RequestUI:clone()
request.Parent = player.PlayerGui.ScreenGui
script.Parent.Parent.Name = &quot;- &quot;..player.Name.. &quot; - is requesting to pass&quot;
script.Parent.Parent.Head.Reflectance = 2
script.Parent.Reflectance = 0.5
mon.Monitor.Decal.Texture = &quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=100&amp;y=100&amp;Format=Png&amp;username=&quot; ..player.Name
script.Parent.Parent.Head.Sound:Play()

&#9;if player:IsInGroup(131688) then
&#9;mon.VAKbool.Decal.Transparency = 0
&#9;end

wait(2)

request:Destroy()
script.Parent.Parent.Name = &quot;&quot;
script.Parent.Parent.Head.Reflectance = 0
script.Parent.Reflectance = 0
mon.Monitor.Decal.Texture = &quot;&quot;
debounce = false
mon.VAKbool.Decal.Transparency = 1


end
end

script.Parent.ClickDetector.MouseClick:connect(onClick)

