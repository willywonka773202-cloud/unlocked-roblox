				<Item class="Script" referent="RBX2623">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Teleport</string>
						<ProtectedString name="Source">local exitname = &quot;TeleportFloor1&quot;


function onTouch(hit)

&#9;if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then

&#9;if hit.Parent:FindFirstChild(&quot;HasTeleported&quot;) == nil then

&#9;&#9;&#9;local exit = script.Parent.Parent:FindFirstChild(exitname)&#9;-- Director
&#9;&#9;&#9;local decider = script.HasTeleported:clone()

&#9;&#9;&#9;hit.Parent:MoveTo(exit.Position)
&#9;&#9;&#9;decider.Parent = hit.Parent

&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
					</Properties>
					<Item class="BoolValue" referent="RBX2624">
						<Properties>
							<string name="Name">HasTeleported</string>
							<bool name="Value">false</bool>
						</Properties>
						<Item class="Script" referent="RBX2625">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Remover</string>
								<ProtectedString name="Source">if script.Parent.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
wait(3)
script.Parent:Destroy()
end
</ProtectedString>
							</Properties>
						</Item>
					</Item>
				</Item>
