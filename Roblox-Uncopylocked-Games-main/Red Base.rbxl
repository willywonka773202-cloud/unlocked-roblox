				<Item class="Script" referent="RBX601">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local mon = game.Workspace.TowerMonitorA.Monitor


function onTouch(hit)

if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then

local player = game.Players:FindFirstChild(hit.Parent.Name)

script.Parent.Parent.Name = &quot;- &quot;..player.Name.. &quot; - has passed through the gate&quot;
script.Parent.Parent.Head.Reflectance = 2
mon.Decal.Texture = &quot;http://www.roblox.com/Thumbs/Avatar.ashx?x=100&amp;y=100&amp;Format=Png&amp;username=&quot; ..player.Name

&#9;if player:IsInGroup(131688) then
&#9;mon.Parent.VAKbool.Decal.Transparency = 0
&#9;end

wait(2.5)

script.Parent.Parent.Name = &quot;&quot;
script.Parent.Parent.Head.Reflectance = 0

mon.Decal.Texture = &quot;&quot;
debounce = false
mon.Parent.VAKbool.Decal.Transparency = 1



end

script.Parent.Parent.Name = &quot;&quot;

end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
